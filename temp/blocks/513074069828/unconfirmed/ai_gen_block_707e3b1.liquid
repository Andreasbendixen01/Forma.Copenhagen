{% doc %}
  @prompt
    Create a new Shopify section called “Shop the Story”.
    
    Match the existing “Journal slider” section EXACTLY in design, typography, fonts, spacing, padding, margins, colors, borders, container width, product/card styling and responsive behavior. Reuse existing theme styles/components wherever possible.
    
    Instead of blog articles, this section should automatically display the Shopify products that are internally linked inside the current blog article content.
    
    Detect links containing /products/, extract the product handles, remove duplicates, and keep the order in which they appear in the article. Do NOT use a manual product picker and do NOT hard-code products.
    
    Add these settings:
    - Color scheme
    - Subheading text (default: “FORMA JOURNAL”)
    - Title text (default: “Shop the Story”)
    - Number of products: range 1–12, default 6
    
    Display the detected products as the theme’s existing product cards, including image, title and price. The entire card should link to the product.
    
    Create a horizontal responsive slider identical to the existing Journal slider, including its navigation arrows, spacing and mobile swipe behavior.
    
    The “Number of products” setting controls how many detected products are displayed.
    
    If fewer products are linked in the article, show only those available. If no products are linked, hide the entire section.
    
    Do not change any other sections or introduce new styling., Fix this section.
    
    The section must display the PRODUCTS featured/linked inside the CURRENT blog post that the visitor is viewing.
    
    Use the current article/blog post context (article object/content) and automatically detect all Shopify product links inside that blog post. Extract the linked product handles and display those products.
    
    Do NOT use manually selected products and do NOT use featured products from a collection.
    
    The section must show:
    - Subheading: “FORMA JOURNAL”
    - Title: “Shop the Story”
    - The products from the current blog post
    
    Keep the exact same typography, fonts, spacing, padding, colors, product-card design and carousel styling as the existing “Journal slider” section.
    
    Add a “Number of products” range slider (1–12, default 6) controlling how many of the detected products are displayed.
    
    If the current blog post contains no linked products, hide the section.
    
    IMPORTANT: The products must come specifically from the blog post currently being viewed, not from the store, collection, or manually selected products., The section is currently completely empty. Rewrite the section so it actually works.
    
    The products MUST come from the CURRENT blog post being viewed.
    
    Use the current Shopify `article.content` and find all internal links pointing to Shopify products (`/products/...`). Extract their product handles and automatically load those products.
    
    These are products that are linked as internal links within the blog post text. Do NOT use a collection, product picker, or manually selected products.
    
    Display the detected products as product cards in a horizontal slider.
    
    Keep the exact design of the existing “Journal slider”: same fonts, typography, spacing, padding, colors, product card styling, arrows and responsive behavior.
    
    Add:
    - Subheading
    - Title
    - Number of products slider (1–12, default 6)
    
    The number setting controls how many products from the current article are displayed.
    
    If the article has no product links, hide the section.
    
    IMPORTANT: Do not render an empty section. The products must be dynamically extracted from the current blog post's `article.content`.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% if article != blank and article.content != blank %}
  {% assign href_chunks = article.content | split: 'href="' %}
  {% assign found_handles = '|' %}
  {% capture ordered_handles %}{% endcapture %}
  {% for chunk in href_chunks %}
    {% assign raw_url = chunk | split: '"' | first | replace: '&amp;', '&' %}
    {% if raw_url contains '/products/' %}
      {% assign product_handle = raw_url | split: '/products/' | last | split: '?' | first | split: '#' | first | split: '/' | first | downcase | strip %}
      {% assign marker = '|' | append: product_handle | append: '|' %}
      {% if product_handle != blank %}
        {% unless found_handles contains marker %}
          {% assign found_handles = found_handles | append: product_handle | append: '|' %}
          {% capture ordered_handles %}{{ ordered_handles }}{{ product_handle }}~{% endcapture %}
        {% endunless %}
      {% endif %}
    {% endif %}
  {% endfor %}
  {% assign product_handles = ordered_handles | split: '~' %}
  {% assign found_count = 0 %}
  {% for product_handle in product_handles %}
    {% if product_handle != blank %}
      {% assign story_product = all_products[product_handle] %}
      {% if story_product != blank %}{% assign found_count = found_count | plus: 1 %}{% endif %}
    {% endif %}
  {% endfor %}
  {% if found_count > 0 %}
    {% style %}
      .ai-shop-story-{{ ai_gen_id }}{display:block;width:100%;}
      .ai-shop-story-{{ ai_gen_id }} .ai-shop-story__inner{width:100%;max-width:var(--page-width,1600px);margin:0 auto;padding:48px 40px;color:rgb(var(--text-color));background:rgb(var(--background));}
      .ai-shop-story-{{ ai_gen_id }} .ai-shop-story__header{margin:0 0 28px;}
      .ai-shop-story-{{ ai_gen_id }} .ai-shop-story__subheading{margin:0 0 8px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;}
      .ai-shop-story-{{ ai_gen_id }} .ai-shop-story__title{margin:0;font-family:var(--heading-font-family);font-weight:var(--heading-font-weight);letter-spacing:var(--heading-letter-spacing);text-transform:var(--heading-text-transform);}
      .ai-shop-story-{{ ai_gen_id }} .ai-shop-story__track{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 72px)/4);gap:24px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;}
      .ai-shop-story-{{ ai_gen_id }} .ai-shop-story__track::-webkit-scrollbar{display:none;}
      .ai-shop-story-{{ ai_gen_id }} .ai-shop-story__item{min-width:0;scroll-snap-align:start;}
      .ai-shop-story-{{ ai_gen_id }} .ai-shop-story__card{display:block;color:inherit;text-decoration:none;}
      .ai-shop-story-{{ ai_gen_id }} .ai-shop-story__image{display:block;width:100%;height:auto;}
      .ai-shop-story-{{ ai_gen_id }} .ai-shop-story__details{padding-top:12px;font-size:13px;line-height:1.4;}
      .ai-shop-story-{{ ai_gen_id }} .ai-shop-story__name{margin:0 0 4px;}
      .ai-shop-story-{{ ai_gen_id }} .ai-shop-story__arrows{display:flex;justify-content:flex-end;gap:10px;margin-top:24px;}
      .ai-shop-story-{{ ai_gen_id }} .ai-shop-story__arrow{width:42px;height:42px;display:grid;place-items:center;padding:0;border:1px solid currentColor;border-radius:50%;background:transparent;color:inherit;cursor:pointer;}
      .ai-shop-story-{{ ai_gen_id }} .ai-shop-story__arrow:focus-visible,.ai-shop-story-{{ ai_gen_id }} .ai-shop-story__card:focus-visible{outline:2px solid currentColor;outline-offset:3px;}
      @media(max-width:749px){.ai-shop-story-{{ ai_gen_id }} .ai-shop-story__inner{padding:36px 20px;}.ai-shop-story-{{ ai_gen_id }} .ai-shop-story__track{grid-auto-columns:72%;gap:16px;}.ai-shop-story-{{ ai_gen_id }} .ai-shop-story__arrows{display:none;}}
    {% endstyle %}
    <shop-story-{{ ai_gen_id }} class="ai-shop-story-{{ ai_gen_id }} color-scheme color-scheme--{{ block.settings.color_scheme }}" {{ block.shopify_attributes }}>
      <div class="ai-shop-story__inner">
        <header class="ai-shop-story__header">
          {% if block.settings.subheading != blank %}<p class="ai-shop-story__subheading">{{ block.settings.subheading | escape }}</p>{% endif %}
          {% if block.settings.title != blank %}<h2 class="ai-shop-story__title">{{ block.settings.title | escape }}</h2>{% endif %}
        </header>
        <div class="ai-shop-story__track" role="list">
          {% assign shown_count = 0 %}
          {% for product_handle in product_handles %}
            {% if product_handle != blank and shown_count < block.settings.product_limit %}
              {% assign story_product = all_products[product_handle] %}
              {% if story_product != blank %}
                {% assign shown_count = shown_count | plus: 1 %}
                <div class="ai-shop-story__item" role="listitem"><a class="ai-shop-story__card" href="{{ story_product.url }}" aria-label="{{ story_product.title | escape }}">
                  {% if story_product.featured_image %}{{ story_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 750px) 25vw, 72vw', class: 'ai-shop-story__image', alt: story_product.featured_image.alt | default: story_product.title | escape }}{% endif %}
                  <div class="ai-shop-story__details"><p class="ai-shop-story__name">{{ story_product.title | escape }}</p><span>{{ story_product.price | money }}</span></div>
                </a></div>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
        <div class="ai-shop-story__arrows">
          <button class="ai-shop-story__arrow" type="button" data-direction="previous" aria-label="Previous products"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m15 18-6-6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <button class="ai-shop-story__arrow" type="button" data-direction="next" aria-label="Next products"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 18 6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        </div>
      </div>
    </shop-story-{{ ai_gen_id }}>
    <script>
      (()=>{const tag='shop-story-{{ ai_gen_id }}';if(customElements.get(tag))return;class ShopStory extends HTMLElement{connectedCallback(){const track=this.querySelector('.ai-shop-story__track');this.querySelectorAll('.ai-shop-story__arrow').forEach(button=>button.addEventListener('click',()=>{const item=track.querySelector('.ai-shop-story__item');if(!item)return;const gap=parseFloat(getComputedStyle(track).columnGap)||0;track.scrollBy({left:(button.dataset.direction==='next'?1:-1)*(item.getBoundingClientRect().width+gap),behavior:'smooth'});}));}}customElements.define(tag,ShopStory)})();
    </script>
  {% endif %}
{% endif %}
{% schema %}
{"name":"Shop the Story","settings":[{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"},{"type":"text","id":"subheading","label":"Subheading","default":"FORMA JOURNAL"},{"type":"text","id":"title","label":"Title","default":"Shop the Story"},{"type":"range","id":"product_limit","label":"Number of products","min":1,"max":12,"step":1,"default":6},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Shop the Story"}],"tag":null,"class":"shop-the-story-block"}
{% endschema %}