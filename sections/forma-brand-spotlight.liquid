{% liquid
  assign current_brand = blank
  assign product_brand_name = product.vendor | strip | downcase

  for brand in shop.metaobjects.brand_profile.values
    assign saved_brand_name = brand.brand_name.value | strip | downcase

    if saved_brand_name == product_brand_name
      assign current_brand = brand
      break
    endif
  endfor

  if current_brand != blank
    assign brand_name = current_brand.brand_name.value
    assign brand_story = current_brand.brand_story.value | strip_html | strip
    assign brand_image = current_brand.brand_image.value
    assign brand_url = current_brand.brand_url.value
    assign brand_story_short = brand_story | truncate: 190
  endif
%}

{% if current_brand != blank %}
  <section
    id="forma-brand-spotlight-{{ section.id }}"
    class="forma-brand-spotlight"
    aria-label="The brand behind {{ brand_name | escape }}"
  >
    <div class="forma-brand-spotlight__topline">
      <span>THE BRAND BEHIND THE PIECE</span>
      <span class="forma-brand-spotlight__number">FORMA / BRAND PROFILE</span>
    </div>

    <div class="forma-brand-spotlight__body">
      {% if brand_image != blank %}
        <a
          class="forma-brand-spotlight__image-wrap"
          {% if brand_url != blank %}href="{{ brand_url | escape }}" target="_blank" rel="noopener noreferrer"{% else %}aria-hidden="true"{% endif %}
          tabindex="{% if brand_url != blank %}0{% else %}-1{% endif %}"
          aria-label="{% if brand_url != blank %}Discover {{ brand_name | escape }}{% else %}{{ brand_name | escape }}{% endif %}"
        >
          {{
            brand_image
            | image_url: width: 700
            | image_tag:
              class: 'forma-brand-spotlight__image',
              widths: '240, 360, 500, 700',
              sizes: '(max-width: 749px) 34vw, 180px',
              loading: 'lazy',
              alt: brand_name
          }}
        </a>
      {% endif %}

      <div class="forma-brand-spotlight__copy">
        <p class="forma-brand-spotlight__eyebrow">A LITTLE MORE ABOUT THE LABEL</p>
        <h2 class="forma-brand-spotlight__title">{{ brand_name | escape }}<span>.</span></h2>
        {% if brand_story != blank %}
          <p class="forma-brand-spotlight__story">{{ brand_story_short | escape }}</p>
        {% endif %}
        {% if brand_url != blank %}
          <a class="forma-brand-spotlight__link" href="{{ brand_url | escape }}" target="_blank" rel="noopener noreferrer">
            <span>DISCOVER THE BRAND</span>
            <span class="forma-brand-spotlight__arrow" aria-hidden="true">‚Üó</span>
          </a>
        {% endif %}
      </div>
    </div>
  </section>

  <style>
    #shopify-section-{{ section.id }} .forma-brand-spotlight {
      --fbs-ink: #242421;
      --fbs-muted: #77766f;
      width: 100%;
      margin: 0;
      padding: 22px 0 24px;
      color: var(--fbs-ink);
      background: transparent;
      border-top: 1px solid rgba(36, 36, 33, .14);
      border-bottom: 1px solid rgba(36, 36, 33, .14);
    }

    #shopify-section-{{ section.id }} .forma-brand-spotlight * { box-sizing: border-box; }

    #shopify-section-{{ section.id }} .forma-brand-spotlight__topline {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin: 0 0 18px;
      color: var(--fbs-muted);
      font-size: 9px;
      font-weight: 600;
      line-height: 1.4;
      letter-spacing: .13em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .forma-brand-spotlight__number {
      text-align: right;
      font-size: 8px;
      letter-spacing: .1em;
    }

    #shopify-section-{{ section.id }} .forma-brand-spotlight__body {
      display: grid;
      grid-template-columns: minmax(110px, 180px) minmax(0, 1fr);
      align-items: center;
      gap: clamp(20px, 3vw, 42px);
    }

    #shopify-section-{{ section.id }} .forma-brand-spotlight__image-wrap {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      background: rgba(36, 36, 33, .035);
    }

    #shopify-section-{{ section.id }} .forma-brand-spotlight__image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 450ms ease;
    }

    @media (hover: hover) {
      #shopify-section-{{ section.id }} .forma-brand-spotlight__image-wrap:hover .forma-brand-spotlight__image {
        transform: scale(1.025);
      }
    }

    #shopify-section-{{ section.id }} .forma-brand-spotlight__copy { min-width: 0; max-width: 620px; }

    #shopify-section-{{ section.id }} .forma-brand-spotlight__eyebrow {
      margin: 0 0 8px;
      color: var(--fbs-muted);
      font-size: 8px;
      font-weight: 600;
      line-height: 1.5;
      letter-spacing: .13em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .forma-brand-spotlight__title {
      margin: 0;
      color: var(--fbs-ink);
      font: inherit;
      font-size: clamp(25px, 2.5vw, 36px);
      font-weight: 400;
      letter-spacing: -.055em;
      line-height: 1.05;
      overflow-wrap: anywhere;
    }

    #shopify-section-{{ section.id }} .forma-brand-spotlight__title span { color: #a18b65; }

    #shopify-section-{{ section.id }} .forma-brand-spotlight__story {
      max-width: 560px;
      margin: 10px 0 0;
      color: var(--fbs-muted);
      font-size: 12px;
      line-height: 1.7;
    }

    #shopify-section-{{ section.id }} .forma-brand-spotlight__link {
      display: inline-flex;
      align-items: center;
      gap: 18px;
      margin-top: 15px;
      padding-bottom: 5px;
      border-bottom: 1px solid currentColor;
      color: var(--fbs-ink);
      font-size: 8px;
      font-weight: 600;
      line-height: 1.5;
      letter-spacing: .12em;
      text-decoration: none;
      transition: opacity 180ms ease, gap 180ms ease;
    }

    #shopify-section-{{ section.id }} .forma-brand-spotlight__link:hover { gap: 24px; opacity: .68; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__arrow { font-size: 14px; font-weight: 400; }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .forma-brand-spotlight { padding: 18px 0 20px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__topline { margin-bottom: 14px; font-size: 8px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__number { font-size: 7px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__body { grid-template-columns: minmax(96px, 34%) minmax(0, 1fr); gap: 16px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__title { font-size: clamp(23px, 6vw, 30px); }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__story { margin-top: 8px; font-size: 11px; line-height: 1.55; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__link { margin-top: 12px; gap: 10px; font-size: 7px; }
    }

    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .forma-brand-spotlight__image,
      #shopify-section-{{ section.id }} .forma-brand-spotlight__link { transition: none; }
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "Forma brand spotlight",
  "settings": [],
  "presets": [
    { "name": "Forma brand spotlight" }
  ]
}
{% endschema %}

