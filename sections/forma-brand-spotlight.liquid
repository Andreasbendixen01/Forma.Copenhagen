{% liquid
  assign current_brand = blank
  assign product_brand_name = product.vendor | strip | downcase

  for brand in shop.metaobjects.brand_profile.values
    assign saved_brand_name = brand.brand_name.value | strip | downcase

    if saved_brand_name == product_brand_name
      assign current_brand = brand
      break
    endif
  endfor

  if current_brand != blank
    assign brand_name = current_brand.brand_name.value
    assign brand_story = current_brand.brand_story.value
    assign brand_image = current_brand.brand_image.value
    assign brand_url = current_brand.brand_url.value
  endif
%}

{% if current_brand != blank %}
<section
  id="forma-brand-issue-{{ section.id }}"
  class="forma-brand-issue"
  aria-label="The world of {{ brand_name | escape }}"
>
  <div class="forma-brand-issue__inner">
    <header class="forma-brand-issue__masthead">
      <span class="forma-brand-issue__masthead-name">FORMA JOURNAL <span>/</span> BRAND STORIES</span>
      <span class="forma-brand-issue__issue">THE BRAND ISSUE <span>001</span></span>
    </header>

    <div class="forma-brand-issue__intro">
      <p class="forma-brand-issue__eyebrow">A CLOSER LOOK AT THE BRAND</p>
      <h2 class="forma-brand-issue__title">
        <span class="forma-brand-issue__title-prefix">The world of</span>
        <span class="forma-brand-issue__title-name">{{ brand_name | escape }}<span class="forma-brand-issue__period">.</span></span>
      </h2>
    </div>

    {% if brand_image != blank %}
      <div class="forma-brand-issue__image-wrap">
        {{
          brand_image
          | image_url: width: 2200
          | image_tag:
            class: 'forma-brand-issue__image',
            widths: '750, 1100, 1500, 1800, 2200',
            sizes: '(max-width: 749px) 100vw, 92vw',
            loading: 'lazy',
            alt: brand_name
        }}
        <span class="forma-brand-issue__image-label">DISCOVERED BY FORMA</span>
        <span class="forma-brand-issue__image-index" aria-hidden="true">F.</span>
      </div>
    {% endif %}

    <div class="forma-brand-issue__story-row">
      <div class="forma-brand-issue__story-heading">
        <span class="forma-brand-issue__story-number">01 /</span>
        <p class="forma-brand-issue__story-label">THE BRAND PERSPECTIVE</p>
      </div>

      <div class="forma-brand-issue__story-content">
        {% if brand_story != blank %}
          <div class="forma-brand-issue__story rte">
            {{ brand_story | metafield_tag }}
          </div>
        {% endif %}

        {% if brand_url != blank %}
          <a
            class="forma-brand-issue__link"
            href="{{ brand_url }}"
            aria-label="Explore the {{ brand_name | escape }} brand"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>DISCOVER THE BRAND</span>
            <span class="forma-brand-issue__link-arrow" aria-hidden="true">‚Üó</span>
          </a>
        {% endif %}
      </div>

      <div class="forma-brand-issue__signature" aria-hidden="true">F.</div>
    </div>

    <footer class="forma-brand-issue__footer">
      <span>THE PEOPLE. THE PERSPECTIVE. THE DESIGN.</span>
      <span>FORMA COPENHAGEN <span class="forma-brand-issue__footer-dot">.</span></span>
    </footer>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} {
    --fbi-ink: #22221f;
    --fbi-muted: #77766f;
    --fbi-line: rgba(34, 34, 31, .19);
    --fbi-paper: #f7f6f2;
    background: var(--fbi-paper) !important;
    color: var(--fbi-ink);
  }

  #shopify-section-{{ section.id }} .forma-brand-issue,
  #shopify-section-{{ section.id }} .forma-brand-issue * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue {
    width: 100%;
    margin: 0;
    padding: clamp(28px, 4vw, 54px) clamp(18px, 3.2vw, 48px) clamp(22px, 3vw, 40px);
    background: var(--fbi-paper);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__inner {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__masthead {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 0 0 12px;
    border-bottom: 1px solid var(--fbi-line);
    color: var(--fbi-muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__masthead-name {
    color: var(--fbi-ink);
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__masthead-name span {
    padding: 0 5px;
    color: #a18b65;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__issue span {
    margin-left: 8px;
    color: var(--fbi-ink);
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__intro {
    padding: clamp(28px, 4.2vw, 58px) 0 clamp(20px, 3vw, 38px);
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__eyebrow {
    margin: 0 0 14px;
    color: var(--fbi-muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .17em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    margin: 0;
    color: var(--fbi-ink);
    font-family: inherit;
    font-weight: 400;
    letter-spacing: -.065em;
    line-height: .98;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__title-prefix {
    font-size: clamp(25px, 3.1vw, 43px);
    font-weight: 400;
    letter-spacing: -.055em;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__title-name {
    max-width: 100%;
    margin-top: 2px;
    font-size: clamp(46px, 7.3vw, 108px);
    overflow-wrap: anywhere;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__period {
    color: #a18b65;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__image-wrap {
    position: relative;
    width: 100%;
    height: clamp(280px, 48vw, 650px);
    overflow: hidden;
    background: #e7e5df;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 800ms cubic-bezier(.2,.65,.3,1);
  }

  @media (hover: hover) {
    #shopify-section-{{ section.id }} .forma-brand-issue__image-wrap:hover .forma-brand-issue__image {
      transform: scale(1.015);
    }
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__image-label {
    position: absolute;
    left: 18px;
    bottom: 18px;
    padding: 9px 11px;
    background: rgba(31, 31, 28, .72);
    color: #fff;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: .13em;
    line-height: 1.4;
    backdrop-filter: blur(8px);
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__image-index {
    position: absolute;
    right: 18px;
    bottom: -38px;
    color: rgba(255,255,255,.9);
    font-family: Georgia, serif;
    font-size: clamp(100px, 17vw, 240px);
    letter-spacing: -.1em;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__story-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(150px, .75fr) minmax(0, 1.25fr) minmax(60px, .3fr);
    gap: clamp(20px, 4vw, 60px);
    align-items: start;
    padding: clamp(28px, 4.5vw, 64px) 0 clamp(28px, 4vw, 54px);
    border-bottom: 1px solid var(--fbi-line);
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__story-heading {
    display: flex;
    gap: 10px;
    align-items: baseline;
    padding-top: 4px;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__story-number,
  #shopify-section-{{ section.id }} .forma-brand-issue__story-label {
    margin: 0;
    color: var(--fbi-muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .12em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__story-number {
    color: #a18b65;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__story-content {
    min-width: 0;
    max-width: 650px;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__story {
    color: #57564f;
    font-size: 14px;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__story > *:first-child {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__story > *:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    min-width: 220px;
    margin-top: 28px;
    padding: 0 0 11px;
    border-bottom: 1px solid var(--fbi-ink);
    color: var(--fbi-ink);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .13em;
    line-height: 1.5;
    text-decoration: none;
    transition: opacity 180ms ease, gap 180ms ease;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__link:hover {
    gap: 38px;
    opacity: .68;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__link-arrow {
    font-size: 18px;
    font-weight: 400;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__signature {
    justify-self: end;
    margin-top: -22px;
    color: rgba(34, 34, 31, .07);
    font-family: Georgia, serif;
    font-size: clamp(70px, 9vw, 130px);
    letter-spacing: -.1em;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-top: 13px;
    color: var(--fbi-muted);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: .13em;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .forma-brand-issue__footer-dot {
    color: #a18b65;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .forma-brand-issue {
      padding: 24px 18px 22px;
    }

    #shopify-section-{{ section.id }} .forma-brand-issue__masthead {
      gap: 12px;
      font-size: 7px;
      letter-spacing: .1em;
    }

    #shopify-section-{{ section.id }} .forma-brand-issue__issue {
      text-align: right;
    }

    #shopify-section-{{ section.id }} .forma-brand-issue__intro {
      padding: 30px 0 22px;
    }

    #shopify-section-{{ section.id }} .forma-brand-issue__title-prefix {
      font-size: clamp(25px, 7vw, 34px);
    }

    #shopify-section-{{ section.id }} .forma-brand-issue__title-name {
      font-size: clamp(42px, 11vw, 66px);
    }

    #shopify-section-{{ section.id }} .forma-brand-issue__image-wrap {
      height: auto;
      aspect-ratio: 4 / 5;
    }

    #shopify-section-{{ section.id }} .forma-brand-issue__image-label {
      left: 12px;
      bottom: 12px;
      font-size: 7px;
    }

    #shopify-section-{{ section.id }} .forma-brand-issue__story-row {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 28px 0 30px;
    }

    #shopify-section-{{ section.id }} .forma-brand-issue__story-heading {
      gap: 8px;
    }

    #shopify-section-{{ section.id }} .forma-brand-issue__story {
      font-size: 13px;
      line-height: 1.8;
    }

    #shopify-section-{{ section.id }} .forma-brand-issue__link {
      min-width: 205px;
      margin-top: 24px;
    }

    #shopify-section-{{ section.id }} .forma-brand-issue__signature {
      position: absolute;
      right: 0;
      bottom: 20px;
      font-size: 70px;
    }

    #shopify-section-{{ section.id }} .forma-brand-issue__footer {
      gap: 12px;
      font-size: 7px;
      letter-spacing: .08em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .forma-brand-issue__image,
    #shopify-section-{{ section.id }} .forma-brand-issue__link {
      transition: none;
    }
  }
</style>
{% endif %}

{% schema %}
{
  "name": "Explore the brand",
  "settings": [],
  "presets": [
    {
      "name": "Explore the brand"
    }
  ]
}
{% endschema %}

