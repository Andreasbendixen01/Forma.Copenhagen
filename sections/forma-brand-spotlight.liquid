{% assign brand_name = product.vendor | default: section.settings.fallback_brand_name %}
{% assign brand_story = product.metafields.custom.brand_story.value | default: section.settings.brand_story %}
{% assign brand_image = product.metafields.custom.brand_image.value | default: section.settings.brand_image | default: product.featured_media.preview_image %}
{% assign brand_link = product.metafields.custom.brand_link.value | default: section.settings.brand_link %}
{% if brand_link == blank and product.vendor != blank %}
  {% assign brand_link = routes.all_products_collection_url | append: '?filter.p.vendor=' | append: product.vendor | url_encode %}
{% endif %}
{% if brand_name != blank %}
<section class="forma-brand-spotlight section-spacing" id="forma-brand-{{ section.id }}">
  <div class="forma-brand-spotlight__inner">
    <div class="forma-brand-spotlight__media">
      {% if brand_image != blank %}
        {{ brand_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480,720,960,1200,1400', sizes: '(min-width: 1000px) 50vw, 100vw', alt: brand_name | escape }}
      {% endif %}
    </div>
    <div class="forma-brand-spotlight__content">
      <p class="forma-brand-spotlight__eyebrow">THE BRAND</p>
      <h2 class="forma-brand-spotlight__title">Explore {{ brand_name | escape }}</h2>
      {% if brand_story != blank %}
        <div class="forma-brand-spotlight__story rte">{{ brand_story }}</div>
      {% else %}
        <p class="forma-brand-spotlight__story">Discover the world of {{ brand_name | escape }} ‚Äî its point of view, signature style and the pieces that define the brand.</p>
      {% endif %}
      {% if brand_link != blank %}
        <a class="forma-brand-spotlight__link" href="{{ brand_link }}">Explore the brand <span aria-hidden="true">‚Üó</span></a>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}
<style>
  #forma-brand-{{ section.id }} { padding-block: clamp(42px,7vw,100px); }
  #forma-brand-{{ section.id }} .forma-brand-spotlight__inner { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(280px,.9fr); align-items:center; gap:clamp(28px,6vw,90px); max-width:1440px; margin:0 auto; padding-inline:clamp(20px,5vw,72px); }
  #forma-brand-{{ section.id }} .forma-brand-spotlight__media { overflow:hidden; background:#eeece7; }
  #forma-brand-{{ section.id }} .forma-brand-spotlight__media img { display:block; width:100%; height:100%; max-height:720px; aspect-ratio:4/5; object-fit:cover; }
  #forma-brand-{{ section.id }} .forma-brand-spotlight__content { max-width:490px; }
  #forma-brand-{{ section.id }} .forma-brand-spotlight__eyebrow { margin:0 0 18px; font-size:10px; letter-spacing:.18em; text-transform:uppercase; opacity:.62; }
  #forma-brand-{{ section.id }} .forma-brand-spotlight__title { margin:0 0 22px; font-size:clamp(30px,4vw,54px); line-height:1.04; letter-spacing:-.045em; font-weight:500; }
  #forma-brand-{{ section.id }} .forma-brand-spotlight__story { max-width:430px; margin:0 0 28px; font-size:14px; line-height:1.85; opacity:.78; }
  #forma-brand-{{ section.id }} .forma-brand-spotlight__link { display:inline-flex; align-items:center; gap:22px; padding-bottom:8px; border-bottom:1px solid currentColor; color:inherit; text-decoration:none; font-size:11px; letter-spacing:.1em; text-transform:uppercase; }
  @media(max-width:749px) { #forma-brand-{{ section.id }} .forma-brand-spotlight__inner { grid-template-columns:1fr; gap:28px; } #forma-brand-{{ section.id }} .forma-brand-spotlight__media img { aspect-ratio:4/3; } }
</style>
{% schema %}
{
  "name": "FORMA ‚Äî Explore the brand",
  "settings": [
    { "type": "text", "id": "fallback_brand_name", "label": "Fallback brand name", "default": "The brand" },
    { "type": "image_picker", "id": "brand_image", "label": "Fallback brand image" },
    { "type": "richtext", "id": "brand_story", "label": "Fallback brand story", "default": "<p>A closer look at the people, perspective and design language behind the brand.</p>" },
    { "type": "url", "id": "brand_link", "label": "Fallback brand link" }
  ],
  "presets": [{ "name": "FORMA ‚Äî Explore the brand" }]
}
{% endschema %}

