{% liquid
  assign current_brand = blank
  assign product_brand_name = product.vendor | strip | downcase
  assign product_brand_handle = product.vendor | handleize

  for brand in shop.metaobjects.brand_profile.values
    assign saved_brand_name = brand.brand_name.value | strip | downcase
    if saved_brand_name == product_brand_name
      assign current_brand = brand
      break
    endif
  endfor

  if current_brand != blank
    assign brand_name = current_brand.brand_name.value | default: product.vendor
    assign brand_image = current_brand.brand_image.value
    assign story_text = current_brand.brand_story | metafield_text | strip_html | strip | truncatewords: 38

    assign brand_collection = collections[product_brand_handle]
    if brand_collection.url != blank
      assign brand_link = brand_collection.url
    else
      assign brand_link = product.vendor | url_for_vendor
    endif

    assign button_label = section.settings.button_label | default: 'Discover'
    assign section_bg = section.settings.background | default: '#f3ede3'
  endif
%}

{% if current_brand != blank %}
  <section
    id="forma-brand-spotlight-{{ section.id }}"
    class="forma-brand-spotlight"
    style="--fbs-bg: {{ section_bg }};"
    aria-label="{{ button_label | escape }} {{ brand_name | escape }}"
  >
    <div class="forma-brand-spotlight__main">
      {% if brand_image != blank %}
        <a
          class="forma-brand-spotlight__image-link"
          href="{{ brand_link }}"
          tabindex="-1"
          aria-hidden="true"
        >
          {{
            brand_image
            | image_url: width: 1200
            | image_tag:
              class: 'forma-brand-spotlight__image',
              widths: '320, 480, 700, 1000, 1200',
              sizes: '(max-width: 749px) 100vw, 52vw',
              loading: 'lazy',
              alt: brand_name
          }}
        </a>
      {% endif %}

      <div class="forma-brand-spotlight__content">
        <p class="forma-brand-spotlight__kicker">CURATED BY FORMA</p>
        <h2 class="forma-brand-spotlight__title">{{ brand_name | escape }}<span class="forma-brand-spotlight__title-period">.</span></h2>

        {% if story_text != blank %}
          <p class="forma-brand-spotlight__story">{{ story_text | escape }}</p>
        {% else %}
          <p class="forma-brand-spotlight__story">Discover the perspective and design behind the piece you‚Äôre looking at.</p>
        {% endif %}

        <a class="forma-brand-spotlight__link" href="{{ brand_link }}">
          <span>{{ button_label | escape }} {{ brand_name | escape }}</span>
          <span class="forma-brand-spotlight__arrow" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 8H13M9 4L13 8L9 12" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <style>
    #shopify-section-{{ section.id }} .forma-brand-spotlight {
      --fbs-ink: #1f1d19;
      --fbs-body: #3d3a33;
      --fbs-muted: #7a7468;
      --fbs-accent: #a18b65;
      --fbs-serif: Georgia, 'Times New Roman', serif;
      width: 100%;
      margin: 0;
      padding: clamp(40px, 6vw, 96px) 0;
      color: var(--fbs-ink);
      background: var(--fbs-bg, #f3ede3);
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight * { box-sizing: border-box; }

    #shopify-section-{{ section.id }} .forma-brand-spotlight__main {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: center;
      column-gap: clamp(32px, 6vw, 96px);
      width: 100%;
      max-width: 1600px;
      margin: 0 auto;
      padding: 0 clamp(28px, 4vw, 64px);
    }

    #shopify-section-{{ section.id }} .forma-brand-spotlight__image-link {
      display: block;
      width: 100%;
      height: clamp(380px, 40vw, 580px);
      overflow: hidden;
      background: #e4dccb;
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 38%;
      transform: scale(1.015);
      transition: transform 1200ms cubic-bezier(.2, .65, .3, 1);
    }
    @media (hover: hover) {
      #shopify-section-{{ section.id }} .forma-brand-spotlight__image-link:hover .forma-brand-spotlight__image { transform: scale(1.05); }
    }

    #shopify-section-{{ section.id }} .forma-brand-spotlight__content {
      min-width: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      max-width: 440px;
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__kicker {
      margin: 0 0 20px;
      color: var(--fbs-muted);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: .2em;
      line-height: 1.5;
      text-transform: uppercase;
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__title {
      margin: 0;
      color: var(--fbs-ink);
      font-family: var(--fbs-serif);
      font-size: clamp(44px, 5vw, 68px);
      font-weight: 400;
      letter-spacing: -.035em;
      line-height: 1;
      overflow-wrap: anywhere;
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__title-period { color: var(--fbs-accent); }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__story {
      margin: 24px 0 0;
      color: var(--fbs-body);
      font-size: 15px;
      line-height: 1.75;
    }

    #shopify-section-{{ section.id }} .forma-brand-spotlight__link {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-top: 32px;
      padding-bottom: 4px;
      border-bottom: 1px solid var(--fbs-ink);
      color: var(--fbs-ink);
      font-size: 12px;
      font-weight: 500;
      letter-spacing: .14em;
      line-height: 1.4;
      text-decoration: none;
      text-transform: uppercase;
      transition: gap 220ms ease, border-color 220ms ease;
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__link:hover,
    #shopify-section-{{ section.id }} .forma-brand-spotlight__link:focus-visible { gap: 16px; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__link:focus-visible { outline: 2px solid var(--fbs-ink); outline-offset: 6px; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__arrow { display: inline-flex; align-items: center; }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .forma-brand-spotlight { padding: 28px 0 40px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__main {
        grid-template-columns: 1fr;
        row-gap: 28px;
        padding: 0 18px;
      }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__image-link { height: auto; aspect-ratio: 4 / 5; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__content { padding: 0 2px; max-width: none; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__kicker { margin-bottom: 14px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__title { font-size: clamp(44px, 12vw, 58px); }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__story { margin-top: 16px; font-size: 14px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__link { margin-top: 24px; }
    }
    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .forma-brand-spotlight__image,
      #shopify-section-{{ section.id }} .forma-brand-spotlight__link { transition: none; }
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "Forma brand spotlight",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background color",
      "default": "#f3ede3"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label (followed by brand name)",
      "default": "Discover",
      "info": "Fx \"Discover\" eller \"Oplev\" giver \"Discover Les Deux\" / \"Oplev Les Deux\"."
    }
  ],
  "presets": [
    { "name": "Forma brand spotlight" }
  ]
}
{% endschema %}

