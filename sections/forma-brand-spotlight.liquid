{% liquid
  assign current_brand = blank
  assign product_brand_name = product.vendor | strip | downcase
  assign product_brand_handle = product.vendor | handleize

  for brand in shop.metaobjects.brand_profile.values
    assign saved_brand_name = brand.brand_name.value | strip | downcase
    if saved_brand_name == product_brand_name
      assign current_brand = brand
      break
    endif
  endfor

  if current_brand != blank
    assign brand_name = current_brand.brand_name.value | default: product.vendor
    assign brand_story = current_brand.brand_story.value | strip_html | strip
    assign brand_image = current_brand.brand_image.value
    assign brand_url = current_brand.brand_url.value
    assign brand_story_short = brand_story | truncate: 260
  endif
%}

{% if current_brand != blank %}
  <section
    id="forma-brand-spotlight-{{ section.id }}"
    class="forma-brand-spotlight"
    aria-label="Discover {{ brand_name | escape }}"
  >
    <div class="forma-brand-spotlight__header">
      <div class="forma-brand-spotlight__eyebrow-wrap">
        <span class="forma-brand-spotlight__eyebrow">A NOTE FROM FORMA</span>
        <span class="forma-brand-spotlight__rule" aria-hidden="true"></span>
      </div>
      <span class="forma-brand-spotlight__index">THE FORMA EDIT&nbsp;&nbsp;‚Äî&nbsp;&nbsp;BRAND NO. 01</span>
    </div>

    <div class="forma-brand-spotlight__main">
      {% if brand_image != blank %}
        <a
          class="forma-brand-spotlight__image-link"
          {% if brand_url != blank %}href="{{ brand_url | escape }}" target="_blank" rel="noopener noreferrer"{% else %}aria-disabled="true"{% endif %}
          aria-label="Discover {{ brand_name | escape }}"
        >
          {{
            brand_image
            | image_url: width: 1000
            | image_tag:
              class: 'forma-brand-spotlight__image',
              widths: '320, 480, 700, 1000',
              sizes: '(max-width: 749px) 42vw, 290px',
              loading: 'lazy',
              alt: brand_name
          }}
          <span class="forma-brand-spotlight__image-tag">SELECTED BY FORMA</span>
        </a>
      {% endif %}

      <div class="forma-brand-spotlight__content">
        <p class="forma-brand-spotlight__kicker">CURATED BY FORMA</p>
        <h2 class="forma-brand-spotlight__title">{{ brand_name | escape }}<span class="forma-brand-spotlight__title-period">.</span></h2>

        {% if brand_story != blank %}
          <p class="forma-brand-spotlight__story">{{ brand_story_short | escape }}</p>
          {% if brand_story.size > 260 %}
            <details class="forma-brand-spotlight__read-more">
              <summary><span class="forma-brand-spotlight__read-label">READ THE BRAND STORY</span><span class="forma-brand-spotlight__read-mark" aria-hidden="true">+</span></summary>
              <div class="forma-brand-spotlight__full-story">{{ current_brand.brand_story.value | metafield_tag }}</div>
            </details>
          {% endif %}
        {% else %}
          <p class="forma-brand-spotlight__story">Discover the perspective and design behind the piece you‚Äôre looking at.</p>
        {% endif %}

        <div class="forma-brand-spotlight__actions">
          {% if brand_url != blank %}
            <a class="forma-brand-spotlight__discover" href="{{ brand_url | escape }}" target="_blank" rel="noopener noreferrer">
              <span>EXPLORE {{ brand_name | upcase | escape }}</span>
              <span class="forma-brand-spotlight__arrow" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3.5 12.5L12 4M5 4H12V11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          {% endif %}

          <button
            class="forma-brand-spotlight__follow forma-follow-brand"
            type="button"
            data-forma-follow-brand
            data-brand-name="{{ brand_name | escape }}"
            data-brand-handle="{{ product_brand_handle }}"
            aria-pressed="false"
          >
            <span class="forma-brand-spotlight__follow-icon" aria-hidden="true">
              <svg class="forma-brand-spotlight__plus" viewBox="0 0 16 16" width="13" height="13" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 3V13M3 8H13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
              <svg class="forma-brand-spotlight__check" viewBox="0 0 16 16" width="13" height="13" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 8.2L6.2 11.2L13 4.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span data-forma-follow-label>FOLLOW {{ brand_name | upcase | escape }}</span>
          </button>
        </div>
        <p class="forma-brand-spotlight__note">A world worth knowing. Keep it in Your Forma.</p>
      </div>
    </div>
  </section>

  <style>
    #shopify-section-{{ section.id }} .forma-brand-spotlight {
      --fbs-ink: #242421;
      --fbs-muted: #77766f;
      --fbs-line: rgba(36, 36, 33, .18);
      width: 100%;
      margin: 0;
      padding: clamp(22px, 2.5vw, 34px) 0;
      color: var(--fbs-ink);
      background: transparent;
      border-top: 1px solid var(--fbs-line);
      border-bottom: 1px solid var(--fbs-line);
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight * { box-sizing: border-box; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__header {
      display: flex; justify-content: space-between; align-items: center; gap: 16px;
      margin: 0 0 22px;
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__eyebrow,
    #shopify-section-{{ section.id }} .forma-brand-spotlight__index {
      color: var(--fbs-muted); font-size: 9px; font-weight: 600; letter-spacing: .16em; line-height: 1.5; text-transform: uppercase;
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__eyebrow-wrap { display: flex; align-items: center; gap: 14px; min-width: 0; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__rule { display: block; width: 42px; height: 1px; background: #a18b65; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__index { text-align: right; font-size: 8px; white-space: nowrap; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__main {
      display: grid; grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr); align-items: stretch;
      gap: clamp(30px, 5vw, 76px);
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__image-link {
      position: relative; display: block; min-width: 0; min-height: 320px; aspect-ratio: 1.12 / 1; overflow: hidden;
      color: inherit; background: transparent; text-decoration: none;
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__image { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; transition: transform 600ms ease; }
    @media (hover: hover) {
      #shopify-section-{{ section.id }} .forma-brand-spotlight__image-link:hover .forma-brand-spotlight__image { transform: scale(1.02); }
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__image-tag {
      position: absolute; left: 14px; bottom: 14px; padding: 7px 9px; color: #fff;
      background: rgba(28, 28, 26, .62); font-size: 8px; font-weight: 600; letter-spacing: .14em;
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__content {
      min-width: 0; display: flex; flex-direction: column; justify-content: center; align-items: flex-start;
      padding: clamp(8px, 2vw, 24px) 0; max-width: 680px;
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__kicker { margin: 0 0 15px; color: var(--fbs-muted); font-size: 9px; font-weight: 600; letter-spacing: .18em; line-height: 1.5; text-transform: uppercase; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__title { margin: 0; color: var(--fbs-ink); font-family: inherit; font-size: clamp(42px, 5vw, 72px); font-weight: 400; letter-spacing: -.075em; line-height: .98; overflow-wrap: anywhere; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__title-period { color: #a18b65; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__story { max-width: 560px; margin: 20px 0 0; color: var(--fbs-muted); font-size: 13px; line-height: 1.85; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__actions { display: flex; flex-wrap: wrap; align-items: center; gap: clamp(18px, 2.5vw, 34px); margin-top: 28px; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__discover,
    #shopify-section-{{ section.id }} .forma-brand-spotlight__follow {
      display: inline-flex; align-items: center; gap: 13px; padding: 0 0 9px; border: 0; border-bottom: 1px solid var(--fbs-ink);
      border-radius: 0; background: transparent; color: var(--fbs-ink); font: inherit; font-size: 9px; font-weight: 600;
      letter-spacing: .14em; line-height: 1.5; text-decoration: none; cursor: pointer; transition: gap 180ms ease, opacity 180ms ease;
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__discover:hover,
    #shopify-section-{{ section.id }} .forma-brand-spotlight__follow:hover { gap: 19px; opacity: .68; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__arrow,
    #shopify-section-{{ section.id }} .forma-brand-spotlight__follow-icon { display: inline-flex; align-items: center; justify-content: center; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__follow-icon { width: 13px; height: 13px; flex: 0 0 13px; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__check { display: none; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__follow[aria-pressed="true"] .forma-brand-spotlight__plus { display: none; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__follow[aria-pressed="true"] .forma-brand-spotlight__check { display: block; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__note { margin: 13px 0 0; color: var(--fbs-muted); font-size: 10px; line-height: 1.6; }
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .forma-brand-spotlight { padding: 22px 0; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__header { align-items: flex-start; margin-bottom: 17px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__eyebrow { font-size: 8px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__index { max-width: 120px; font-size: 7px; white-space: normal; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__rule { width: 22px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__main { grid-template-columns: 1fr; gap: 22px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__image-link { min-height: 0; aspect-ratio: 5 / 4; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__image-tag { left: 9px; bottom: 9px; padding: 6px 7px; font-size: 7px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__content { padding: 0 2px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__kicker { margin-bottom: 10px; font-size: 8px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__title { font-size: clamp(42px, 11vw, 58px); }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__story { margin-top: 13px; font-size: 12px; line-height: 1.75; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__actions { gap: 20px; margin-top: 22px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__discover,
      #shopify-section-{{ section.id }} .forma-brand-spotlight__follow { font-size: 8px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__read-more {
        width: 100%;
        max-width: 560px;
        margin-top: 20px;
        border-bottom: 1px solid var(--fbs-line);
      }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__read-more summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 12px 0;
        cursor: pointer;
        list-style: none;
      }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__read-more summary::-webkit-details-marker { display: none; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__read-label { font-size: 9px; font-weight: 600; letter-spacing: .14em; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__read-mark { font-size: 19px; line-height: 1; transition: transform 180ms ease; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__read-more[open] .forma-brand-spotlight__read-mark { transform: rotate(45deg); }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__full-story { padding: 0 0 16px; color: var(--fbs-muted); font-size: 12px; line-height: 1.85; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__full-story p { margin: 0 0 10px; }

      #shopify-section-{{ section.id }} .forma-brand-spotlight__note { margin-top: 11px; font-size: 9px; }
    }
    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .forma-brand-spotlight__image,
      #shopify-section-{{ section.id }} .forma-brand-spotlight__discover,
      #shopify-section-{{ section.id }} .forma-brand-spotlight__follow { transition: none; }
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "Forma brand spotlight",
  "settings": [],
  "presets": [
    { "name": "Forma brand spotlight" }
  ]
}
{% endschema %}

