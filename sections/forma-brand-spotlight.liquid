{% liquid
  assign current_brand = blank
  assign product_brand_name = product.vendor | strip | downcase
  assign product_brand_handle = product.vendor | handleize

  for brand in shop.metaobjects.brand_profile.values
    assign saved_brand_name = brand.brand_name.value | strip | downcase
    if saved_brand_name == product_brand_name
      assign current_brand = brand
      break
    endif
  endfor

  if current_brand != blank
    assign brand_name = current_brand.brand_name.value | default: product.vendor
    assign brand_story = current_brand.brand_story.value
    assign brand_image = current_brand.brand_image.value
    assign brand_url = current_brand.brand_url.value
  endif
%}

{% if current_brand != blank %}
  <section
    id="forma-brand-spotlight-{{ section.id }}"
    class="forma-brand-spotlight"
    aria-label="Discover {{ brand_name | escape }}"
  >
    <div class="forma-brand-spotlight__main">
      {% if brand_image != blank %}
        <a
          class="forma-brand-spotlight__image-link"
          {% if brand_url != blank %}href="{{ brand_url | escape }}" target="_blank" rel="noopener noreferrer"{% else %}aria-disabled="true"{% endif %}
          aria-label="Discover {{ brand_name | escape }}"
        >
          {{
            brand_image
            | image_url: width: 1000
            | image_tag:
              class: 'forma-brand-spotlight__image',
              widths: '320, 480, 700, 1000',
              sizes: '(max-width: 749px) 42vw, 290px',
              loading: 'lazy',
              alt: brand_name
          }}
          <span class="forma-brand-spotlight__image-tag">SELECTED BY FORMA</span>
        </a>
      {% endif %}

      <div class="forma-brand-spotlight__content">
        <p class="forma-brand-spotlight__kicker">CURATED BY FORMA</p>
        <div class="forma-brand-spotlight__title-row">
          <h2 class="forma-brand-spotlight__title">{{ brand_name | escape }}<span class="forma-brand-spotlight__title-period">.</span></h2>
          <button
            class="forma-brand-spotlight__follow forma-follow-brand"
            type="button"
            data-forma-follow-brand
            data-brand-name="{{ brand_name | escape }}"
            data-brand-handle="{{ product_brand_handle }}"
            aria-pressed="false"
            aria-label="Follow {{ brand_name | escape }}"
            title="Follow brand"
          >
            <span class="forma-brand-spotlight__follow-icon" aria-hidden="true">
              <svg class="forma-brand-spotlight__plus" viewBox="0 0 16 16" width="13" height="13" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 3V13M3 8H13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
              <svg class="forma-brand-spotlight__check" viewBox="0 0 16 16" width="13" height="13" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 8.2L6.2 11.2L13 4.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span class="forma-brand-spotlight__follow-label" data-forma-follow-label>FOLLOW</span>
          </button>
        </div>

        {% if brand_story != blank %}
          <div class="forma-brand-spotlight__story rte">{{ current_brand.brand_story.value | metafield_tag }}</div>
        {% else %}
          <p class="forma-brand-spotlight__story">Discover the perspective and design behind the piece you‚Äôre looking at.</p>
        {% endif %}

        {% if brand_url != blank %}
          <div class="forma-brand-spotlight__actions">
            <a class="forma-brand-spotlight__discover" href="{{ brand_url | escape }}" target="_blank" rel="noopener noreferrer">
              <span>READ THE BRAND STORY</span>
              <span class="forma-brand-spotlight__arrow" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3.5 12.5L12 4M5 4H12V11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          </div>
        {% endif %}
        <p class="forma-brand-spotlight__note">Follow the brands you love. Find them again in Your Forma.</p>
      </div>
    </div>
  </section>

  <style>
    #shopify-section-{{ section.id }} .forma-brand-spotlight {
      --fbs-ink: #242421;
      --fbs-muted: #77766f;
      --fbs-line: rgba(36, 36, 33, .18);
      width: 100%;
      margin: 0;
      padding: clamp(18px, 2vw, 26px) 0;
      color: var(--fbs-ink);
      background: transparent;
      border-top: 0;
      border-bottom: 0;
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight * { box-sizing: border-box; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__main {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      align-items: center;
      gap: clamp(34px, 4.5vw, 76px);
      width: 100%;
      max-width: 1720px;
      margin: 0 auto;
      padding: 0 clamp(24px, 3.2vw, 52px);
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__image-link {
      position: relative;
      display: block;
      min-width: 0;
      min-height: 0;
      width: calc(100% + clamp(35px, 5vw, 90px));
      height: clamp(390px, 39vw, 560px);
      aspect-ratio: 0.98 / 1;
      overflow: hidden;
      color: inherit;
      background: #e9e6df;
      text-decoration: none;
      isolation: isolate;
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__image-link::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(180deg, rgba(20, 20, 18, 0) 55%, rgba(20, 20, 18, .22) 100%);
      pointer-events: none;
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__image { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 38%; transform: scale(1.015); transition: transform 800ms cubic-bezier(.2,.65,.3,1); }
    @media (hover: hover) {
      #shopify-section-{{ section.id }} .forma-brand-spotlight__image-link:hover .forma-brand-spotlight__image { transform: scale(1.055); }
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__image-tag {
      position: absolute; left: 18px; bottom: 18px; z-index: 2; padding: 9px 11px; color: #fff;
      background: rgba(28, 28, 26, .68); font-size: 8px; font-weight: 600; letter-spacing: .14em;
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__content {
      min-width: 0; display: flex; flex-direction: column; justify-content: center; align-items: flex-start;
      position: relative; z-index: 2; padding: clamp(18px, 2vw, 30px) 0; max-width: 720px;
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__kicker { margin: 0 0 15px; color: var(--fbs-muted); font-size: 9px; font-weight: 600; letter-spacing: .18em; line-height: 1.5; text-transform: uppercase; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__title { margin: 0; color: var(--fbs-ink); font-family: inherit; font-size: clamp(40px, 4.2vw, 62px); font-weight: 400; letter-spacing: -.075em; line-height: .98; overflow-wrap: anywhere; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__title-period { color: #a18b65; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__title-row { display: flex; align-items: center; justify-content: space-between; gap: 18px; width: 100%; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__story { max-width: 560px; margin: 20px 0 0; color: var(--fbs-muted); font-size: 13px; line-height: 1.85; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__story p { margin: 0 0 10px; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__story p:last-child { margin-bottom: 0; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 24px; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__discover,
    #shopify-section-{{ section.id }} .forma-brand-spotlight__follow {
      display: inline-flex; align-items: center; justify-content: center; gap: 10px;
      min-height: 42px; padding: 0 17px; border: 1px solid var(--fbs-ink);
      border-radius: 0; background: var(--fbs-ink); color: #fff; font: inherit;
      font-size: 9px; font-weight: 600; letter-spacing: .1em; line-height: 1.4;
      text-decoration: none; text-transform: uppercase; cursor: pointer;
      transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__follow {
      flex: 0 0 34px; width: 34px; min-width: 34px; height: 34px; min-height: 34px;
      padding: 0; border-radius: 50%; gap: 0; letter-spacing: 0;
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__follow-label { display: none; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__discover:hover,
    #shopify-section-{{ section.id }} .forma-brand-spotlight__follow:hover {
      background: transparent; color: var(--fbs-ink); opacity: 1;
    }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__arrow,
    #shopify-section-{{ section.id }} .forma-brand-spotlight__follow-icon { display: inline-flex; align-items: center; justify-content: center; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__follow-icon { width: 13px; height: 13px; flex: 0 0 13px; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__check { display: none; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__follow[aria-pressed="true"] { background: transparent; color: var(--fbs-ink); }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__follow[aria-pressed="true"] .forma-brand-spotlight__plus { display: none; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__follow[aria-pressed="true"] .forma-brand-spotlight__check { display: block; }
    #shopify-section-{{ section.id }} .forma-brand-spotlight__note { margin: 13px 0 0; color: var(--fbs-muted); font-size: 10px; line-height: 1.6; }
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .forma-brand-spotlight { padding: 18px 0; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__main {
        grid-template-columns: 1fr;
        gap: 22px;
        padding: 0 18px;
      }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__image-link { width: 100%; min-height: 0; height: auto; aspect-ratio: 4 / 5; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__image-tag { left: 10px; bottom: 10px; padding: 6px 7px; font-size: 7px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__content { padding: 0 2px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__kicker { margin-bottom: 10px; font-size: 8px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__title { font-size: clamp(42px, 11vw, 58px); }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__story { margin-top: 13px; font-size: 12px; line-height: 1.75; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__title-row { gap: 12px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__actions { gap: 12px; margin-top: 20px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__discover { min-height: 40px; padding: 0 13px; font-size: 8px; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__follow { width: 32px; min-width: 32px; height: 32px; min-height: 32px; padding: 0; }
      #shopify-section-{{ section.id }} .forma-brand-spotlight__note { margin-top: 11px; font-size: 9px; }
    }
    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .forma-brand-spotlight__image,
      #shopify-section-{{ section.id }} .forma-brand-spotlight__discover,
      #shopify-section-{{ section.id }} .forma-brand-spotlight__follow { transition: none; }
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "Forma brand spotlight",
  "settings": [],
  "presets": [
    { "name": "Forma brand spotlight" }
  ]
}
{% endschema %}

