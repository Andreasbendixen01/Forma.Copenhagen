
{% liquid
  assign brand_name = product.vendor | default: 'Selected brand'
  assign brand_story = product.metafields.custom.brand_story.value
  assign brand_image = product.metafields.custom.brand_image.value
  assign brand_url = product.metafields.custom.brand_url.value

  if brand_image == blank
    assign brand_image = product.featured_image
  endif

  if brand_url == blank
    assign brand_url = routes.collections_url | append: '/vendors?q=' | append: brand_name | url_encode
  endif

  if brand_story == blank
    assign brand_story = 'Discover the design philosophy, distinctive details and creative perspective behind ' | append: brand_name | append: '.'
  endif

  assign section_heading = 'Inside ' | append: brand_name
%}

<section
  id="forma-explore-brand-{{ section.id }}"
  class="forma-editorial-brand"
  aria-label="Explore {{ brand_name | escape }}"
>
  <div class="forma-editorial-brand__topline">
    <span class="forma-editorial-brand__eyebrow">THE FORMA BRAND FILE</span>
    <span class="forma-editorial-brand__index">01 — BRAND PROFILE</span>
  </div>

  <div class="forma-editorial-brand__layout">

    <div class="forma-editorial-brand__visual">
      {% if brand_image != blank %}
        {{
          brand_image
          | image_url: width: 1800
          | image_tag:
            class: 'forma-editorial-brand__image',
            widths: '600, 900, 1200, 1500, 1800',
            sizes: '(max-width: 749px) 100vw, 58vw',
            loading: 'lazy',
            alt: brand_name
        }}
      {% endif %}

      <span class="forma-editorial-brand__image-caption">
        DISCOVERED BY FORMA
      </span>
    </div>

    <div class="forma-editorial-brand__content">
      <div class="forma-editorial-brand__content-inner">

        <p class="forma-editorial-brand__kicker">
          A CLOSER LOOK AT THE BRAND
        </p>

        <h2 class="forma-editorial-brand__title">
          {{ section_heading | escape }}
          <span class="forma-editorial-brand__period">.</span>
        </h2>

        <div class="forma-editorial-brand__rule"></div>

        <p class="forma-editorial-brand__story">
          {{ brand_story | escape }}
        </p>

        <div class="forma-editorial-brand__footer">
          <span class="forma-editorial-brand__footer-label">
            THE PEOPLE. THE PERSPECTIVE. THE DESIGN.
          </span>

          <a
            class="forma-editorial-brand__link"
            href="{{ brand_url }}"
            aria-label="Explore the {{ brand_name | escape }} brand"
          >
            <span>EXPLORE THE BRAND</span>
            <span class="forma-editorial-brand__arrow" aria-hidden="true">
              &rarr;
            </span>
          </a>
        </div>

      </div>

      <span class="forma-editorial-brand__watermark" aria-hidden="true">
        F.
      </span>
    </div>

  </div>
</section>


#shopify-section-{{ section.id }} .forma-editorial-brand {
  --feb-ink: #20201d;
  --feb-paper: #efeee9;
  --feb-muted: #77766f;

  width: 100%;
  margin: 0;
  padding: 28px 0;
  color: var(--feb-ink);
  background: var(--feb-paper);
  overflow: hidden;
}

#shopify-section-{{ section.id }} .forma-editorial-brand * {
  box-sizing: border-box;
}

#shopify-section-{{ section.id }} .forma-editorial-brand__topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin: 0 32px 16px;
  padding-bottom: 10px;
  border-bottom: 1px solid rgba(32, 32, 29, .2);
}

#shopify-section-{{ section.id }} .forma-editorial-brand__eyebrow,
#shopify-section-{{ section.id }} .forma-editorial-brand__index {
  font-size: 9px;
  letter-spacing: .14em;
  line-height: 1.4;
  font-weight: 600;
  text-transform: uppercase;
}

#shopify-section-{{ section.id }} .forma-editorial-brand__index {
  color: var(--feb-muted);
  text-align: right;
}

#shopify-section-{{ section.id }} .forma-editorial-brand__layout {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  align-items: stretch;
  max-width: 1440px;
  margin: 0 auto;
}

#shopify-section-{{ section.id }} .forma-editorial-brand__visual {
  position: relative;
  min-width: 0;
  height: clamp(300px, 32vw, 440px);
  overflow: hidden;
  background: #dedbd3;
}

#shopify-section-{{ section.id }} .forma-editorial-brand__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform 700ms ease;
}

@media (hover: hover) {
  #shopify-section-{{ section.id }} .forma-editorial-brand__visual:hover
  .forma-editorial-brand__image {
    transform: scale(1.025);
  }
}

#shopify-section-{{ section.id }} .forma-editorial-brand__image-caption {
  position: absolute;
  left: 16px;
  bottom: 16px;
  padding: 8px 10px;
  color: #fff;
  background: rgba(25, 25, 23, .58);
  font-size: 8px;
  letter-spacing: .13em;
  backdrop-filter: blur(8px);
}

#shopify-section-{{ section.id }} .forma-editorial-brand__content {
  position: relative;
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 300px;
  padding: clamp(28px, 4vw, 58px);
  overflow: hidden;
  background: var(--feb-paper);
}

#shopify-section-{{ section.id }} .forma-editorial-brand__content-inner {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 480px;
}

#shopify-section-{{ section.id }} .forma-editorial-brand__kicker {
  margin: 0 0 18px;
  color: var(--feb-muted);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: .17em;
  line-height: 1.5;
  text-transform: uppercase;
}

#shopify-section-{{ section.id }} .forma-editorial-brand__title {
  max-width: 520px;
  margin: 0;
  color: var(--feb-ink);
  font-family: inherit;
  font-size: clamp(34px, 3.5vw, 56px);
  font-weight: 400;
  letter-spacing: -.065em;
  line-height: 1.02;
  overflow-wrap: anywhere;
}

#shopify-section-{{ section.id }} .forma-editorial-brand__period {
  color: #a18b65;
}

#shopify-section-{{ section.id }} .forma-editorial-brand__rule {
  width: 42px;
  height: 1px;
  margin: 22px 0 17px;
  background: var(--feb-ink);
}

#shopify-section-{{ section.id }} .forma-editorial-brand__story {
  max-width: 350px;
  margin: 0;
  color: #5c5b55;
  font-size: 13px;
  line-height: 1.8;
}

#shopify-section-{{ section.id }} .forma-editorial-brand__footer {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 17px;
  margin-top: 30px;
}

#shopify-section-{{ section.id }} .forma-editorial-brand__footer-label {
  color: var(--feb-muted);
  font-size: 8px;
  line-height: 1.5;
  letter-spacing: .11em;
}

#shopify-section-{{ section.id }} .forma-editorial-brand__link {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
  min-width: 200px;
  padding: 0 0 10px;
  border-bottom: 1px solid var(--feb-ink);
  color: var(--feb-ink);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: .12em;
  line-height: 1.5;
  text-decoration: none;
  transition: gap 200ms ease, opacity 200ms ease;
}

#shopify-section-{{ section.id }} .forma-editorial-brand__link:hover {
  gap: 36px;
  opacity: .7;
}

#shopify-section-{{ section.id }} .forma-editorial-brand__arrow {
  font-size: 18px;
  font-weight: 400;
  line-height: .8;
}

#shopify-section-{{ section.id }} .forma-editorial-brand__watermark {
  position: absolute;
  right: -4px;
  bottom: -55px;
  color: rgba(32, 32, 29, .035);
  font-family: Georgia, serif;
  font-size: 220px;
  line-height: 1;
  pointer-events: none;
  user-select: none;
}

@media screen and (max-width: 749px) {
  #shopify-section-{{ section.id }} .forma-editorial-brand {
    padding: 24px 0 0;
  }

  #shopify-section-{{ section.id }} .forma-editorial-brand__topline {
    margin: 0 18px 14px;
  }

  #shopify-section-{{ section.id }} .forma-editorial-brand__index {
    font-size: 7px;
  }

  #shopify-section-{{ section.id }} .forma-editorial-brand__layout {
    grid-template-columns: 1fr;
  }

  #shopify-section-{{ section.id }} .forma-editorial-brand__visual {
    height: auto;
    aspect-ratio: 5 / 4;
  }

  #shopify-section-{{ section.id }} .forma-editorial-brand__content {
    min-height: 0;
    padding: 30px 22px 36px;
  }

  #shopify-section-{{ section.id }} .forma-editorial-brand__kicker {
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .forma-editorial-brand__title {
    font-size: clamp(36px, 10vw, 48px);
  }

  #shopify-section-{{ section.id }} .forma-editorial-brand__rule {
    margin: 19px 0 15px;
  }

  #shopify-section-{{ section.id }} .forma-editorial-brand__footer {
    gap: 15px;
    margin-top: 24px;
  }

  #shopify-section-{{ section.id }} .forma-editorial-brand__watermark {
    bottom: -45px;
    font-size: 170px;
  }
}

@media (prefers-reduced-motion: reduce) {
  #shopify-section-{{ section.id }} .forma-editorial-brand__image,
  #shopify-section-{{ section.id }} .forma-editorial-brand__link {
    transition: none;
  }
}


{% schema %}
{
  "name": "Explore the brand",
  "settings": [],
  "presets": [
    {
      "name": "Explore the brand"
    }
  ]
}
{% endschema %}
