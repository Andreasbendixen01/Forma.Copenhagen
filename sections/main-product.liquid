{%- liquid
  assign has_content_below_gallery = false
  assign allow_transparent_header = section.settings.allow_transparent_header
  assign desktop_media_layout = section.settings.desktop_media_layout
  assign product_info_size = section.settings.product_info_size

  for block in section.blocks
    if block.type == 'complementary_products'
      assign has_content_below_gallery = true
      break
    endif

    unless block.settings.show_below_gallery
      continue
    endunless

    if block.type == 'accordion' and block.settings.title != blank and block.settings.content != blank or block.settings.liquid != blank or block.settings.page.content != blank
      assign has_content_below_gallery = true
      break
    elsif block.type == 'description' and product.description != blank
      assign has_content_below_gallery = true
      break
    endif
  endfor

  if allow_transparent_header
    assign desktop_media_layout = 'grid_2x_highlighted'
    assign product_info_size = 50
  endif
-%}

<style>
  {%- if section.settings.allow_transparent_header and section.settings.transparent_header_use_primary_colors -%}
    {%- comment -%}
    When this setting is enabled, we use the transparent header, but we force the header to use the primary colors and primary logo.
    {%- endcomment -%}

    .header {
      --header-show-transparent-logo: 0 !important;
      --header-transparent-header-text-color: initial;
    }
  {%- endif -%}

  #shopify-section-{{ section.id }} {
    --product-grid: "product-gallery" "product-info" {% if has_content_below_gallery %}"product-content"{% endif %} / minmax(0, 1fr);

    {%- if allow_transparent_header -%}
      --product-gallery-zoom-button-inset-block-start: calc(var(--sticky-area-height, 0px) + 1.25rem); /* 1.25rem is the default block padding, we want the zoom button to be at least 1.25rem away from the sticky header */
    {%- endif -%}
  }

  
/* ============================================================
   FORMA ‚Äö√Ñ√Æ PRODUCT PAGE LAYOUT
   Keep the existing product-gallery snippet and slider untouched.
