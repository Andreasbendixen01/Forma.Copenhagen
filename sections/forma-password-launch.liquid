{% comment %}
  FORMA COPENHAGEN — PRE-LAUNCH
  Image-free editorial design.
  Klaviyo integration will be completed separately.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    --forma-bg: #f5f4ef;
    --forma-text: #191919;
    --forma-muted: #77766f;
    --forma-line: #d9d7d0;
    --forma-dark: #191919;
    --forma-light: #ffffff;
    background: var(--forma-bg);
    color: var(--forma-text);
  }

  #shopify-section-{{ section.id }} *,
  #shopify-section-{{ section.id }} *::before,
  #shopify-section-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .forma-page {
    min-height: 100vh;
    background: var(--forma-bg);
    color: var(--forma-text);
    font-family: inherit;
  }

  #shopify-section-{{ section.id }} .forma-page a {
    color: inherit;
  }

  #shopify-section-{{ section.id }} .forma-container {
    width: min(100% - 96px, 1440px);
    margin: 0 auto;
  }

  /* HEADER */

  #shopify-section-{{ section.id }} .forma-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 86px;
    border-bottom: 1px solid var(--forma-line);
  }

  #shopify-section-{{ section.id }} .forma-wordmark {
    margin: 0;
    font-size: 30px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.09em;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .forma-header-note {
    margin: 0;
    color: var(--forma-muted);
    font-size: 9px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-align: right;
    text-transform: uppercase;
  }

  /* INTRODUCTION */

  #shopify-section-{{ section.id }} .forma-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(330px, 0.65fr);
    align-items: end;
    gap: 80px;
    padding: clamp(75px, 11vw, 155px) 0 58px;
  }

  #shopify-section-{{ section.id }} .forma-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 28px;
    color: var(--forma-muted);
    font-size: 10px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .forma-kicker::before {
    content: "";
    width: 25px;
    height: 1px;
    background: currentColor;
  }

  #shopify-section-{{ section.id }} .forma-heading {
    max-width: 850px;
    margin: 0;
    font-size: clamp(58px, 9.3vw, 132px);
    line-height: 0.88;
    font-weight: 400;
    letter-spacing: -0.095em;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .forma-heading em {
    display: block;
    margin-top: 10px;
    color: var(--forma-muted);
    font-weight: 400;
    font-style: normal;
  }

  #shopify-section-{{ section.id }} .forma-intro-aside {
    max-width: 380px;
    padding-bottom: 5px;
  }

  #shopify-section-{{ section.id }} .forma-intro-description {
    margin: 0;
    font-size: 15px;
    line-height: 1.85;
    color: var(--forma-muted);
  }

  #shopify-section-{{ section.id }} .forma-opening {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 23px 0 0;
    font-size: 10px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .forma-opening-dot {
    width: 6px;
    height: 6px;
    flex: 0 0 6px;
    border-radius: 50%;
    background: var(--forma-text);
  }

  /* SIGNUP */

  #shopify-section-{{ section.id }} .forma-signup-section {
    display: grid;
    grid-template-columns: minmax(220px, 0.65fr) minmax(0, 1fr);
    gap: 70px;
    padding: 36px 0 70px;
    border-top: 1px solid var(--forma-line);
    border-bottom: 1px solid var(--forma-line);
  }

  #shopify-section-{{ section.id }} .forma-signup-aside {
    padding-top: 8px;
  }

  #shopify-section-{{ section.id }} .forma-section-label {
    margin: 0 0 20px;
    color: var(--forma-muted);
    font-size: 10px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .forma-signup-title {
    max-width: 280px;
    margin: 0;
    font-size: clamp(29px, 3.2vw, 43px);
    line-height: 1.04;
    font-weight: 400;
    letter-spacing: -0.065em;
  }

  #shopify-section-{{ section.id }} .forma-signup-aside-copy {
    max-width: 285px;
    margin: 17px 0 0;
    color: var(--forma-muted);
    font-size: 12px;
    line-height: 1.8;
  }

  #shopify-section-{{ section.id }} .forma-form-wrap {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .forma-form {
    display: grid;
    gap: 21px;
  }

  #shopify-section-{{ section.id }} .forma-form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  #shopify-section-{{ section.id }} .forma-field {
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .forma-label {
    font-size: 10px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  #shopify-section-{{ section.id }} .forma-input {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 49px;
    margin: 0;
    padding: 13px 0;
    border: 0;
    border-bottom: 1px solid var(--forma-line);
    border-radius: 0;
    outline: none;
    background: transparent;
    color: var(--forma-text);
    font-family: inherit;
    font-size: 14px;
    line-height: 1.5;
    box-shadow: none;
    appearance: none;
    -webkit-appearance: none;
    transition: border-color 180ms ease;
  }

  #shopify-section-{{ section.id }} .forma-input::placeholder {
    color: #a09e96;
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .forma-input:focus {
    border-bottom-color: var(--forma-text);
  }

  #shopify-section-{{ section.id }} .forma-input:focus-visible {
    outline: 2px solid var(--forma-text);
    outline-offset: 4px;
  }

  #shopify-section-{{ section.id }} .forma-input::-webkit-calendar-picker-indicator {
    cursor: pointer;
    opacity: 0.65;
  }

  #shopify-section-{{ section.id }} .forma-consent {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    margin-top: 2px;
    color: var(--forma-muted);
    font-size: 10px;
    line-height: 1.8;
  }

  #shopify-section-{{ section.id }} .forma-consent input {
    width: 15px;
    height: 15px;
    flex: 0 0 15px;
    margin: 3px 0 0;
    accent-color: var(--forma-text);
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .forma-consent a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .forma-submit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    min-height: 58px;
    margin-top: 2px;
    padding: 17px 20px;
    border: 1px solid var(--forma-dark);
    border-radius: 0;
    background: var(--forma-dark);
    color: var(--forma-light);
    font-family: inherit;
    font-size: 10px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-align: left;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 180ms ease, color 180ms ease;
  }

  #shopify-section-{{ section.id }} .forma-submit:hover {
    background: transparent;
    color: var(--forma-text);
  }

  #shopify-section-{{ section.id }} .forma-submit:focus-visible {
    outline: 2px solid var(--forma-text);
    outline-offset: 4px;
  }

  #shopify-section-{{ section.id }} .forma-submit svg {
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
    stroke: currentColor;
    stroke-width: 1.4;
    fill: none;
  }

  #shopify-section-{{ section.id }} .forma-form-note {
    margin: -8px 0 0;
    color: var(--forma-muted);
    font-size: 9px;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .forma-message {
    margin: 0 0 18px;
    padding: 14px 16px;
    border: 1px solid var(--forma-line);
    font-size: 12px;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .forma-message--error {
    border-color: #a63e32;
  }

  /* WHAT IS FORMA? */

  #shopify-section-{{ section.id }} .forma-about {
    padding: 105px 0 100px;
  }

  #shopify-section-{{ section.id }} .forma-about-header {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
    gap: 80px;
    align-items: start;
    padding-bottom: 57px;
  }

  #shopify-section-{{ section.id }} .forma-about-heading {
    max-width: 650px;
    margin: 0;
    font-size: clamp(38px, 5.5vw, 73px);
    line-height: 0.98;
    font-weight: 400;
    letter-spacing: -0.08em;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .forma-about-copy {
    max-width: 480px;
    margin: 0;
    color: var(--forma-muted);
    font-size: 13px;
    line-height: 1.95;
  }

  #shopify-section-{{ section.id }} .forma-values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--forma-line);
    border-bottom: 1px solid var(--forma-line);
  }

  #shopify-section-{{ section.id }} .forma-value {
    padding: 28px 30px 30px 0;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .forma-value + .forma-value {
    padding-left: 30px;
    border-left: 1px solid var(--forma-line);
  }

  #shopify-section-{{ section.id }} .forma-value-number {
    display: block;
    margin-bottom: 35px;
    color: var(--forma-muted);
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.14em;
  }

  #shopify-section-{{ section.id }} .forma-value-title {
    margin: 0;
    font-size: 20px;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: -0.04em;
  }

  #shopify-section-{{ section.id }} .forma-value-copy {
    max-width: 300px;
    margin: 12px 0 0;
    color: var(--forma-muted);
    font-size: 12px;
    line-height: 1.85;
  }

  /* CATEGORIES */

  #shopify-section-{{ section.id }} .forma-categories {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
    padding-top: 30px;
  }

  #shopify-section-{{ section.id }} .forma-categories-label {
    margin-right: 12px;
    color: var(--forma-muted);
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .forma-category {
    padding: 9px 12px;
    border: 1px solid var(--forma-line);
    font-size: 10px;
    line-height: 1.4;
  }

  /* COUNTDOWN */

  #shopify-section-{{ section.id }} .forma-countdown {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: 35px 0;
    border-top: 1px solid var(--forma-line);
  }

  #shopify-section-{{ section.id }} .forma-countdown-title {
    margin: 0;
    font-size: 19px;
    line-height: 1.3;
    font-weight: 400;
    letter-spacing: -0.04em;
  }

  #shopify-section-{{ section.id }} .forma-countdown-subtitle {
    margin: 8px 0 0;
    color: var(--forma-muted);
    font-size: 10px;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .forma-timer {
    display: flex;
    align-items: flex-start;
    gap: clamp(20px, 4vw, 55px);
  }

  #shopify-section-{{ section.id }} .forma-timer-unit {
    min-width: 40px;
  }

  #shopify-section-{{ section.id }} .forma-timer-number {
    display: block;
    font-size: clamp(27px, 3.2vw, 39px);
    line-height: 1;
    font-weight: 400;
    letter-spacing: -0.065em;
    font-variant-numeric: tabular-nums;
  }

  #shopify-section-{{ section.id }} .forma-timer-label {
    display: block;
    margin-top: 10px;
    color: var(--forma-muted);
    font-size: 8px;
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* FOOTER */

  #shopify-section-{{ section.id }} .forma-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    padding: 25px 0 30px;
    border-top: 1px solid var(--forma-line);
  }

  #shopify-section-{{ section.id }} .forma-footer-wordmark {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  #shopify-section-{{ section.id }} .forma-footer-meta {
    margin: 0;
    color: var(--forma-muted);
    font-size: 10px;
    line-height: 1.7;
    text-align: right;
  }

  #shopify-section-{{ section.id }} .forma-footer-meta a {
    text-underline-offset: 3px;
  }

  /* RESPONSIVE */

  @media screen and (max-width: 900px) {
    #shopify-section-{{ section.id }} .forma-container {
      width: calc(100% - 56px);
    }

    #shopify-section-{{ section.id }} .forma-intro {
      grid-template-columns: 1fr;
      gap: 30px;
      padding-top: 90px;
    }

    #shopify-section-{{ section.id }} .forma-heading {
      font-size: clamp(66px, 11vw, 100px);
    }

    #shopify-section-{{ section.id }} .forma-intro-aside {
      max-width: 520px;
    }

    #shopify-section-{{ section.id }} .forma-signup-section {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
      gap: 35px;
    }

    #shopify-section-{{ section.id }} .forma-about-header {
      gap: 40px;
    }

    #shopify-section-{{ section.id }} .forma-value {
      padding-right: 18px;
    }

    #shopify-section-{{ section.id }} .forma-value + .forma-value {
      padding-left: 18px;
    }
  }

  @media screen and (max-width: 600px) {
    #shopify-section-{{ section.id }} .forma-container {
      width: calc(100% - 36px);
    }

    #shopify-section-{{ section.id }} .forma-header {
      min-height: 69px;
    }

    #shopify-section-{{ section.id }} .forma-wordmark {
      font-size: 27px;
    }

    #shopify-section-{{ section.id }} .forma-header-note {
      max-width: 135px;
      font-size: 8px;
      letter-spacing: 0.1em;
    }

    #shopify-section-{{ section.id }} .forma-intro {
      gap: 24px;
      padding: 62px 0 39px;
    }

    #shopify-section-{{ section.id }} .forma-kicker {
      margin-bottom: 24px;
      font-size: 9px;
    }

    #shopify-section-{{ section.id }} .forma-heading {
      font-size: clamp(56px, 13.5vw, 82px);
      line-height: 0.91;
    }

    #shopify-section-{{ section.id }} .forma-heading em {
      margin-top: 7px;
    }

    #shopify-section-{{ section.id }} .forma-intro-description {
      font-size: 13px;
      line-height: 1.85;
    }

    #shopify-section-{{ section.id }} .forma-opening {
      margin-top: 17px;
      font-size: 9px;
    }

    #shopify-section-{{ section.id }} .forma-signup-section {
      grid-template-columns: 1fr;
      gap: 31px;
      padding: 28px 0 45px;
    }

    #shopify-section-{{ section.id }} .forma-signup-aside {
      padding-top: 0;
    }

    #shopify-section-{{ section.id }} .forma-section-label {
      margin-bottom: 14px;
    }

    #shopify-section-{{ section.id }} .forma-signup-title {
      max-width: 360px;
      font-size: 35px;
    }

    #shopify-section-{{ section.id }} .forma-signup-aside-copy {
      max-width: 390px;
      margin-top: 12px;
    }

    #shopify-section-{{ section.id }} .forma-form {
      gap: 19px;
    }

    #shopify-section-{{ section.id }} .forma-form-row {
      gap: 14px;
    }

    #shopify-section-{{ section.id }} .forma-input {
      min-height: 47px;
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .forma-submit {
      min-height: 55px;
    }

    #shopify-section-{{ section.id }} .forma-about {
      padding: 68px 0 62px;
    }

    #shopify-section-{{ section.id }} .forma-about-header {
      grid-template-columns: 1fr;
      gap: 25px;
      padding-bottom: 35px;
    }

    #shopify-section-{{ section.id }} .forma-about-heading {
      font-size: clamp(40px, 10vw, 57px);
    }

    #shopify-section-{{ section.id }} .forma-about-copy {
      font-size: 12px;
      line-height: 1.9;
    }

    #shopify-section-{{ section.id }} .forma-values {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .forma-value,
    #shopify-section-{{ section.id }} .forma-value + .forma-value {
      padding: 23px 0 25px;
      border-left: 0;
    }

    #shopify-section-{{ section.id }} .forma-value + .forma-value {
      border-top: 1px solid var(--forma-line);
    }

    #shopify-section-{{ section.id }} .forma-value-number {
      margin-bottom: 20px;
    }

    #shopify-section-{{ section.id }} .forma-value-title {
      font-size: 19px;
    }

    #shopify-section-{{ section.id }} .forma-value-copy {
      margin-top: 8px;
    }

    #shopify-section-{{ section.id }} .forma-categories {
      gap: 8px;
      padding-top: 23px;
    }

    #shopify-section-{{ section.id }} .forma-categories-label {
      flex-basis: 100%;
      margin: 0 0 4px;
    }

    #shopify-section-{{ section.id }} .forma-category {
      padding: 8px 10px;
      font-size: 9px;
    }

    #shopify-section-{{ section.id }} .forma-countdown {
      flex-direction: column;
      align-items: flex-start;
      gap: 26px;
      padding: 27px 0;
    }

    #shopify-section-{{ section.id }} .forma-timer {
      width: 100%;
      justify-content: space-between;
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .forma-timer-unit {
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .forma-timer-number {
      font-size: 29px;
    }

    #shopify-section-{{ section.id }} .forma-timer-label {
      font-size: 8px;
    }

    #shopify-section-{{ section.id }} .forma-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
      padding: 21px 0 25px;
    }

    #shopify-section-{{ section.id }} .forma-footer-meta {
      text-align: left;
    }
  }

  @media screen and (max-width: 360px) {
    #shopify-section-{{ section.id }} .forma-container {
      width: calc(100% - 28px);
    }

    #shopify-section-{{ section.id }} .forma-form-row {
      grid-template-columns: 1fr;
      gap: 19px;
    }

    #shopify-section-{{ section.id }} .forma-heading {
      font-size: 54px;
    }

    #shopify-section-{{ section.id }} .forma-timer-number {
      font-size: 25px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} *,
    #shopify-section-{{ section.id }} *::before,
    #shopify-section-{{ section.id }} *::after {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<div class="forma-page">
  <div class="forma-container">

    <header class="forma-header">
      <a class="forma-wordmark" href="/" aria-label="FORMA Copenhagen">
        FORMA
      </a>

      <p class="forma-header-note">
        A new perspective<br>
        on discovery
      </p>
    </header>

    <main>
      <section class="forma-intro" aria-labelledby="FormaHeading">

        <div>
          <p class="forma-kicker">Introducing FORMA Copenhagen</p>

          <h1 class="forma-heading" id="FormaHeading">
            Discover a world
            <em>beyond the obvious.</em>
          </h1>
        </div>

        <div class="forma-intro-aside">
          <p class="forma-intro-description">
            FORMA er et kurateret univers af brands, produkter, steder og
            historier. Vi samler inspiration inden for mode, livsstil og
            design – så du kan opdage nye favoritter og finde det, der
            passer til din egen måde at leve på.
          </p>

          <p class="forma-opening">
            <span class="forma-opening-dot"></span>
            Opening 1 December 2026
          </p>
        </div>

      </section>

      <section class="forma-signup-section" id="FormaSignup" aria-labelledby="FormaSignupTitle">

        <div class="forma-signup-aside">
          <p class="forma-section-label">Be part of what's next</p>

          <h2 class="forma-signup-title" id="FormaSignupTitle">
            Be first.<br>
            Know first.
          </h2>

          <p class="forma-signup-aside-copy">
            Få besked, når FORMA åbner, og modtag udvalgt inspiration
            fra vores univers af brands, design og oplevelser.
          </p>
        </div>

        <div class="forma-form-wrap">
          {% form 'customer', id: 'FormaPrelaunchForm', class: 'forma-form' %}

            {% if form.posted_successfully? %}
              <div class="forma-message" role="status">
                Tak for din interesse i FORMA. Hold øje med din indbakke.
              </div>
            {% endif %}

            {% if form.errors %}
              <div class="forma-message forma-message--error" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <input
              type="hidden"
              name="contact[tags]"
              value="newsletter, forma-prelaunch"
            >

            <div class="forma-form-row">
              <div class="forma-field">
                <label class="forma-label" for="FormaFirstName">
                  Fornavn
                </label>
                <input
                  class="forma-input"
                  id="FormaFirstName"
                  type="text"
                  name="contact[first_name]"
                  autocomplete="given-name"
                  placeholder="Fornavn"
                  required
                >
              </div>

              <div class="forma-field">
                <label class="forma-label" for="FormaLastName">
                  Efternavn
                </label>
                <input
                  class="forma-input"
                  id="FormaLastName"
                  type="text"
                  name="contact[last_name]"
                  autocomplete="family-name"
                  placeholder="Efternavn"
                  required
                >
              </div>
            </div>

            <div class="forma-field">
              <label class="forma-label" for="FormaEmail">
                E-mailadresse
              </label>
              <input
                class="forma-input"
                id="FormaEmail"
                type="email"
                name="contact[email]"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                placeholder="Din e-mailadresse"
                required
              >
            </div>

            <div class="forma-field">
              <label class="forma-label" for="FormaBirthday">
                Fødselsdato
              </label>
              <input
                class="forma-input"
                id="FormaBirthday"
                type="date"
                name="contact[birthday]"
                autocomplete="bday"
                required
              >
            </div>

            <label class="forma-consent" for="FormaMarketingConsent">
              <input
                id="FormaMarketingConsent"
                type="checkbox"
                name="contact[accepts_marketing]"
                value="true"
                required
              >
              <span>
                Jeg giver samtykke til at modtage e-mails fra FORMA med
                nyheder, inspiration og information om lanceringen.
                Jeg kan til enhver tid trække mit samtykke tilbage.
                <a href="/policies/privacy-policy">Privatlivspolitik</a>.
              </span>
            </label>

            <button class="forma-submit" type="submit">
              <span>Join the Forma list</span>
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M3 10h13M10 4l6 6-6 6"/>
              </svg>
            </button>

            <p class="forma-form-note">
              Ingen spam. Kun udvalgt inspiration fra FORMA.
            </p>

          {% endform %}
        </div>

      </section>

      <section class="forma-about" aria-labelledby="FormaAboutHeading">

        <div class="forma-about-header">
          <div>
            <p class="forma-section-label">The idea behind Forma</p>
          </div>

          <div>
            <h2 class="forma-about-heading" id="FormaAboutHeading">
              A considered world of brands, places and ideas.
            </h2>

            <p class="forma-about-copy">
              FORMA er skabt til dig, der er nysgerrig på de brands,
              produkter og steder, der gør hverdagen lidt mere interessant.
              Vi samler det bedste fra forskellige universer og gør det
              lettere at opdage noget nyt.

              <br><br>

              Vi sælger ikke produkterne selv. I stedet guider vi dig
              videre til de brands og virksomheder, hvor du kan udforske
              produkterne og handle direkte.
            </p>
          </div>
        </div>

        <div class="forma-values">

          <article class="forma-value">
            <span class="forma-value-number">01 / DISCOVER</span>
            <h3 class="forma-value-title">Find new favourites.</h3>
            <p class="forma-value-copy">
              Udforsk nøje udvalgte brands og produkter inden for mode,
              design og livsstil – samlet ét sted.
            </p>
          </article>

          <article class="forma-value">
            <span class="forma-value-number">02 / EXPLORE</span>
            <h3 class="forma-value-title">Go beyond products.</h3>
            <p class="forma-value-copy">
              Oplev historier, inspiration, caféer, hoteller og steder,
              der er værd at kende til.
            </p>
          </article>

          <article class="forma-value">
            <span class="forma-value-number">03 / YOUR FORMA</span>
            <h3 class="forma-value-title">Make it your own.</h3>
            <p class="forma-value-copy">
              Gem favoritter, følg brands og saml den inspiration,
              du gerne vil vende tilbage til.
            </p>
          </article>

        </div>

        <div class="forma-categories">
          <span class="forma-categories-label">Explore our universe</span>
          <span class="forma-category">Wardrobe</span>
          <span class="forma-category">Lifestyle</span>
          <span class="forma-category">Home</span>
          <span class="forma-category">The Form</span>
          <span class="forma-category">Places</span>
          <span class="forma-category">Brands</span>
        </div>

      </section>

      {% if section.settings.show_countdown %}
        <section class="forma-countdown" aria-label="Countdown to launch">

          <div>
            <h2 class="forma-countdown-title">
              The countdown begins.
            </h2>
            <p class="forma-countdown-subtitle">
              FORMA Copenhagen · 1 December 2026
            </p>
          </div>

          <div
            class="forma-timer"
            id="FormaCountdown"
            data-launch-date="{{ section.settings.launch_date | escape }}"
          >
            <div class="forma-timer-unit">
              <span class="forma-timer-number" data-days>00</span>
              <span class="forma-timer-label">Dage</span>
            </div>

            <div class="forma-timer-unit">
              <span class="forma-timer-number" data-hours>00</span>
              <span class="forma-timer-label">Timer</span>
            </div>

            <div class="forma-timer-unit">
              <span class="forma-timer-number" data-minutes>00</span>
              <span class="forma-timer-label">Minutter</span>
            </div>

            <div class="forma-timer-unit">
              <span class="forma-timer-number" data-seconds>00</span>
              <span class="forma-timer-label">Sekunder</span>
            </div>
          </div>

        </section>
      {% endif %}

    </main>

    <footer class="forma-footer">
      <p class="forma-footer-wordmark">FORMA Copenhagen</p>

      <p class="forma-footer-meta">
        A curated world of discovery.
        <br>
        <a href="mailto:Customercare@formacopenhagen.com">
          Customercare@formacopenhagen.com
        </a>
      </p>
    </footer>

  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    var timer = section.querySelector('#FormaCountdown');
    if (!timer || timer.dataset.initialized === 'true') return;

    timer.dataset.initialized = 'true';

    var launchDate = new Date(timer.getAttribute('data-launch-date'));

    var days = timer.querySelector('[data-days]');
    var hours = timer.querySelector('[data-hours]');
    var minutes = timer.querySelector('[data-minutes]');
    var seconds = timer.querySelector('[data-seconds]');

    function pad(value) {
      return String(value).padStart(2, '0');
    }

    function updateCountdown() {
      var remaining = launchDate.getTime() - Date.now();

      if (isNaN(launchDate.getTime()) || remaining <= 0) {
        days.textContent = '00';
        hours.textContent = '00';
        minutes.textContent = '00';
        seconds.textContent = '00';
        return;
      }

      var total = Math.floor(remaining / 1000);

      days.textContent = pad(Math.floor(total / 86400));
      hours.textContent = pad(Math.floor((total % 86400) / 3600));
      minutes.textContent = pad(Math.floor((total % 3600) / 60));
      seconds.textContent = pad(total % 60);
    }

    updateCountdown();
    window.setInterval(updateCountdown, 1000);
  })();
</script>

{% schema %}
{
  "name": "FORMA Pre-launch",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Vis nedtælling",
      "default": true
    },
    {
      "type": "text",
      "id": "launch_date",
      "label": "Lanceringstidspunkt",
      "default": "2026-12-01T00:00:00+01:00",
      "info": "Format: YYYY-MM-DDTHH:MM:SS+01:00"
    }
  ],
  "presets": [
    {
      "name": "FORMA Pre-launch"
    }
  ]
}
{% endschema %}