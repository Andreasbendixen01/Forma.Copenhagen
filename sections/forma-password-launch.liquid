
{%- comment -%}
  FORMA COPENHAGEN — LAUNCH PAGE
  Launch date: 1 December 2026
  Complete standalone Shopify section
{%- endcomment -%}

<section
  id="FormaLaunch-{{ section.id }}"
  class="forma-launch"
  data-forma-launch
>
  <div class="forma-launch__shell">

    <!-- HEADER -->
    <header class="forma-launch__header">
      <a class="forma-launch__wordmark" href="{{ routes.root_url }}" aria-label="FORMA Copenhagen">
        FORMA
      </a>

      <span class="forma-launch__header-note">
        COPENHAGEN · EST. 2026
      </span>
    </header>

    <!-- HERO -->
    <main class="forma-launch__hero">

      <div class="forma-launch__eyebrow">
        <span class="forma-launch__eyebrow-line"></span>
        {{ section.settings.eyebrow | escape }}
      </div>

      <div class="forma-launch__hero-grid">

        <div class="forma-launch__hero-copy">
          <h1 class="forma-launch__heading">
            {{ section.settings.heading | escape }}
          </h1>

          <p class="forma-launch__description">
            {{ section.settings.description | escape }}
          </p>
        </div>

        <div class="forma-launch__hero-aside">
          <span class="forma-launch__aside-index">01 / THE BEGINNING</span>

          <p>
            A considered world of brands, places, stories and ideas.
            Curated for the way we live.
          </p>
        </div>

      </div>

      {% if section.settings.hero_image != blank %}
        <div class="forma-launch__image-wrap">
          {{
            section.settings.hero_image
            | image_url: width: 2400
            | image_tag:
              class: 'forma-launch__image',
              widths: '750,1100,1500,2000,2400',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: section.settings.hero_image.alt
          }}

          <div class="forma-launch__image-caption">
            <span>THE WORLD OF FORMA</span>
            <span>01 — 12 — 2026</span>
          </div>
        </div>
      {% else %}
        <div class="forma-launch__image-placeholder">
          <div class="forma-launch__placeholder-mark">F.</div>
          <span> A NEW PERSPECTIVE ON LIFESTYLE </span>
          <span class="forma-launch__placeholder-bottom">
            FORM · CULTURE · DISCOVERY
          </span>
        </div>
      {% endif %}

      <!-- COUNTDOWN -->
      <div class="forma-launch__countdown-wrap">

        <div class="forma-launch__countdown-intro">
          <span class="forma-launch__micro-label">MARK YOUR CALENDAR</span>
          <h2>The countdown begins.</h2>
          <p>
            A new destination is taking shape. Join us on
            1 December 2026.
          </p>
        </div>

        <div
          class="forma-launch__countdown"
          data-forma-countdown
          data-launch-date="2026-12-01T00:00:00+01:00"
          role="timer"
          aria-label="Time remaining until the FORMA launch"
        >
          <div class="forma-launch__countdown-unit">
            <span data-count-days>--</span>
            <small>DAYS</small>
          </div>

          <span class="forma-launch__countdown-divider">:</span>

          <div class="forma-launch__countdown-unit">
            <span data-count-hours>--</span>
            <small>HOURS</small>
          </div>

          <span class="forma-launch__countdown-divider">:</span>

          <div class="forma-launch__countdown-unit">
            <span data-count-minutes>--</span>
            <small>MINUTES</small>
          </div>

          <span class="forma-launch__countdown-divider">:</span>

          <div class="forma-launch__countdown-unit">
            <span data-count-seconds>--</span>
            <small>SECONDS</small>
          </div>
        </div>

        <a
          class="forma-launch__calendar-link"
          href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=FORMA%20Copenhagen%20Launch&dates=20261201T000000/20261201T010000&details=Discover%20Forma%20Copenhagen%20and%20a%20curated%20world%20of%20brands%2C%20places%20and%20ideas.&ctz=Europe%2FCopenhagen"
          target="_blank"
          rel="noopener noreferrer"
        >
          ADD TO CALENDAR
          <span aria-hidden="true">↗</span>
        </a>

      </div>

    </main>

    <!-- DIVIDER -->
    <div class="forma-launch__divider"></div>

    <!-- EARLY ACCESS -->
    <section class="forma-launch__signup">

      <div class="forma-launch__signup-copy">
        <span class="forma-launch__micro-label">02 / FIRST ACCESS</span>

        <h2>{{ section.settings.signup_heading | escape }}</h2>

        <p>
          {{ section.settings.signup_description | escape }}
        </p>

        <div class="forma-launch__signup-note">
          <span class="forma-launch__status-dot"></span>
          A LITTLE SOMETHING WORTH LOOKING FORWARD TO.
        </div>
      </div>

      <div class="forma-launch__signup-form">

        {% form 'customer', id: 'FormaLaunchSignup-' | append: section.id, class: 'forma-launch__form' %}

          <input type="hidden" name="contact[tags]" value="newsletter, forma-launch">

          {% if form.posted_successfully? %}
            <div class="forma-launch__form-message" role="status">
              <span class="forma-launch__message-mark">✓</span>
              <div>
                <strong>You're on the list.</strong>
                <p>We'll be in touch when there's something worth sharing.</p>
              </div>
            </div>
          {% else %}

            {% if form.errors %}
              <div class="forma-launch__error" role="alert">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </div>
            {% endif %}

            <label
              class="forma-launch__field-label"
              for="FormaLaunchEmail-{{ section.id }}"
            >
              YOUR E-MAIL ADDRESS
            </label>

            <div class="forma-launch__input-row">
              <input
                id="FormaLaunchEmail-{{ section.id }}"
                class="forma-launch__email"
                type="email"
                name="contact[email]"
                value="{{ form.email | escape }}"
                placeholder="Enter your e-mail address"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
                aria-required="true"
              >

              <button class="forma-launch__submit" type="submit">
                <span>{{ section.settings.signup_button | escape }}</span>
                <span class="forma-launch__submit-arrow" aria-hidden="true">↗</span>
              </button>
            </div>

            <p class="forma-launch__privacy">
              No noise. Only things worth knowing.
            </p>

          {% endif %}

        {% endform %}

      </div>

    </section>

    <!-- FOOTER -->
    <footer class="forma-launch__footer">

      <a class="forma-launch__footer-logo" href="{{ routes.root_url }}">
        FORMA
      </a>

      <p>
        A CURATED WORLD OF BRANDS,<br>
        PLACES, STORIES AND IDEAS.
      </p>

      <div class="forma-launch__footer-meta">
        <span>© {{ 'now' | date: '%Y' }} FORMA COPENHAGEN</span>

        <a href="mailto:{{ section.settings.contact_email | escape }}">
          CONTACT ↗
        </a>

        <button
          class="forma-launch__password-toggle"
          type="button"
          data-password-toggle
          aria-expanded="false"
        >
          ENTER PASSWORD <span aria-hidden="true">↗</span>
        </button>
      </div>

      <div class="forma-launch__password-panel" data-password-panel hidden>
        {% form 'storefront_password', class: 'forma-launch__password-form' %}

          {% if form.errors %}
            <p class="forma-launch__error" role="alert">
              {{ form.errors | default_errors }}
            </p>
          {% endif %}

          <label
            class="forma-launch__field-label"
            for="FormaStorefrontPassword-{{ section.id }}"
          >
            STORE PASSWORD
          </label>

          <div class="forma-launch__input-row">
            <input
              id="FormaStorefrontPassword-{{ section.id }}"
              class="forma-launch__email"
              type="password"
              name="password"
              placeholder="Enter password"
              autocomplete="current-password"
              required
            >

            <button class="forma-launch__submit" type="submit">
              <span>ENTER</span>
              <span class="forma-launch__submit-arrow" aria-hidden="true">↗</span>
            </button>
          </div>

        {% endform %}
      </div>

    </footer>

  </div>
</section>

<style>
  #FormaLaunch-{{ section.id }} {
    --forma-bg: #f3f1ec;
    --forma-text: #191918;
    --forma-muted: #85827b;
    --forma-line: #dcd9d1;
    --forma-accent: #b4b0a5;

    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--forma-bg);
    color: var(--forma-text);
    font-family: inherit;
    isolation: isolate;
  }

  #FormaLaunch-{{ section.id }} *,
  #FormaLaunch-{{ section.id }} *::before,
  #FormaLaunch-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__shell {
    width: 100%;
    max-width: 1920px;
    margin-inline: auto;
    padding-inline: clamp(24px, 5.2vw, 100px);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__header {
    min-height: 90px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--forma-line);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__wordmark,
  #FormaLaunch-{{ section.id }} .forma-launch__footer-logo {
    color: var(--forma-text);
    text-decoration: none;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 32px;
    letter-spacing: .015em;
    line-height: 1;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__header-note,
  #FormaLaunch-{{ section.id }} .forma-launch__micro-label,
  #FormaLaunch-{{ section.id }} .forma-launch__eyebrow,
  #FormaLaunch-{{ section.id }} .forma-launch__aside-index {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .15em;
    line-height: 1.6;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__header-note {
    color: var(--forma-muted);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__hero {
    padding-top: clamp(42px, 6vw, 96px);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--forma-muted);
    margin-bottom: clamp(28px, 4vw, 55px);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__eyebrow-line {
    display: block;
    width: 28px;
    height: 1px;
    background: var(--forma-accent);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(220px, .55fr);
    gap: clamp(32px, 6vw, 100px);
    align-items: end;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__heading {
    max-width: 1000px;
    margin: 0;
    color: var(--forma-text);
    font-size: clamp(48px, 7.4vw, 118px);
    font-weight: 400;
    letter-spacing: -.075em;
    line-height: .96;
    overflow-wrap: normal;
    text-wrap: balance;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__description {
    max-width: 560px;
    margin: 27px 0 0;
    color: var(--forma-muted);
    font-size: clamp(14px, 1.15vw, 17px);
    line-height: 1.8;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__hero-aside {
    padding-bottom: 5px;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__aside-index {
    color: var(--forma-muted);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__hero-aside p {
    max-width: 300px;
    margin: 17px 0 0;
    color: var(--forma-muted);
    font-size: 13px;
    line-height: 1.9;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__image-wrap {
    position: relative;
    height: clamp(260px, 39vw, 570px);
    margin-top: clamp(42px, 6vw, 82px);
    overflow: hidden;
    background: #dedbd3;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 1.2s cubic-bezier(.2,.65,.25,1);
  }

  @media (hover: hover) {
    #FormaLaunch-{{ section.id }} .forma-launch__image-wrap:hover .forma-launch__image {
      transform: scale(1.025);
    }
  }

  #FormaLaunch-{{ section.id }} .forma-launch__image-caption {
    position: absolute;
    right: 20px;
    bottom: 20px;
    left: 20px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: #fff;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .15em;
    text-shadow: 0 1px 8px rgba(0,0,0,.25);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__image-wrap::after {
    position: absolute;
    inset: 45% 0 0;
    background: linear-gradient(transparent, rgba(0,0,0,.23));
    content: "";
    pointer-events: none;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__image-caption {
    z-index: 1;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__image-placeholder {
    position: relative;
    min-height: clamp(260px, 39vw, 570px);
    margin-top: clamp(42px, 6vw, 82px);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 15px;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 20% 30%, rgba(255,255,255,.68), transparent 40%),
      radial-gradient(ellipse at 80% 70%, rgba(182,174,157,.23), transparent 45%),
      #e5e1d8;
    color: var(--forma-text);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__placeholder-mark {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(90px, 16vw, 220px);
    letter-spacing: -.09em;
    line-height: .85;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__image-placeholder > span {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .18em;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__placeholder-bottom {
    position: absolute;
    right: 22px;
    bottom: 22px;
    color: var(--forma-muted);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__countdown-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 30px;
    align-items: center;
    padding-block: clamp(40px, 6vw, 78px);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__micro-label {
    display: block;
    color: var(--forma-muted);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__countdown-intro h2,
  #FormaLaunch-{{ section.id }} .forma-launch__signup-copy h2 {
    margin: 17px 0 12px;
    font-size: clamp(26px, 3vw, 42px);
    font-weight: 400;
    letter-spacing: -.055em;
    line-height: 1.08;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__countdown-intro p,
  #FormaLaunch-{{ section.id }} .forma-launch__signup-copy > p {
    max-width: 430px;
    margin: 0;
    color: var(--forma-muted);
    font-size: 13px;
    line-height: 1.85;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__countdown {
    display: flex;
    align-items: flex-start;
    gap: clamp(9px, 1.5vw, 22px);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__countdown-unit {
    display: flex;
    min-width: clamp(42px, 4.2vw, 62px);
    flex-direction: column;
    gap: 10px;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__countdown-unit > span {
    font-size: clamp(28px, 3.5vw, 49px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -.065em;
    font-variant-numeric: tabular-nums;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__countdown-unit small {
    color: var(--forma-muted);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: .13em;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__countdown-divider {
    color: var(--forma-accent);
    font-size: 24px;
    font-weight: 300;
    line-height: 1;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__calendar-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    width: fit-content;
    margin-top: 25px;
    padding-bottom: 7px;
    border-bottom: 1px solid var(--forma-text);
    color: var(--forma-text);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .13em;
    text-decoration: none;
    transition: opacity .2s ease;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__calendar-link:hover {
    opacity: .55;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__calendar-link span {
    font-size: 15px;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__divider {
    height: 1px;
    background: var(--forma-line);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__signup {
    display: grid;
    grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
    gap: clamp(40px, 9vw, 150px);
    padding-block: clamp(48px, 7vw, 100px);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__signup-copy h2 {
    max-width: 460px;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__signup-copy > p {
    max-width: 400px;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__signup-note {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 28px;
    color: var(--forma-muted);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: .1em;
    line-height: 1.7;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__status-dot {
    flex: 0 0 6px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #8e9780;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__signup-form {
    padding-top: 4px;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__field-label {
    display: block;
    margin-bottom: 15px;
    color: var(--forma-muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .14em;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__input-row {
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid var(--forma-text);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__email {
    width: 100%;
    min-width: 0;
    min-height: 58px;
    padding: 14px 10px 14px 0;
    border: 0;
    border-radius: 0;
    outline: none;
    background: transparent;
    box-shadow: none;
    color: var(--forma-text);
    font: inherit;
    font-size: 14px;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__email::placeholder {
    color: #a19e97;
    opacity: 1;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__email:focus-visible {
    outline: none;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__input-row:focus-within {
    border-bottom-width: 2px;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__submit {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 18px;
    min-height: 52px;
    margin: 3px 0;
    padding: 0 20px;
    border: 1px solid var(--forma-text);
    border-radius: 0;
    background: var(--forma-text);
    color: #fff;
    font: inherit;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .12em;
    cursor: pointer;
    transition: background .25s ease, color .25s ease;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__submit:hover {
    background: transparent;
    color: var(--forma-text);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__submit-arrow {
    font-size: 17px;
    font-weight: 300;
    transition: transform .25s ease;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__submit:hover .forma-launch__submit-arrow {
    transform: translate(3px, -3px);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__privacy {
    margin: 17px 0 0;
    color: var(--forma-muted);
    font-size: 11px;
    line-height: 1.7;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__form-message {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 22px;
    border: 1px solid var(--forma-line);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__message-mark {
    font-size: 20px;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__form-message strong {
    font-size: 15px;
    font-weight: 500;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__form-message p {
    margin: 7px 0 0;
    color: var(--forma-muted);
    font-size: 12px;
    line-height: 1.7;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__error {
    margin: 0 0 18px;
    color: #9b3028;
    font-size: 12px;
    line-height: 1.7;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__footer {
    padding-top: 25px;
    border-top: 1px solid var(--forma-line);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__footer-logo {
    display: inline-block;
    font-size: clamp(76px, 15.5vw, 230px);
    letter-spacing: -.075em;
    line-height: .9;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__footer > p {
    margin: 24px 0 28px;
    color: var(--forma-muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .13em;
    line-height: 1.8;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__footer-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-block: 19px;
    border-top: 1px solid var(--forma-line);
    color: var(--forma-muted);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: .1em;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__footer-meta a,
  #FormaLaunch-{{ section.id }} .forma-launch__password-toggle {
    color: var(--forma-text);
    text-decoration: none;
    font: inherit;
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__password-toggle {
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

