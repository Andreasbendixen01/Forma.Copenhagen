```liquid
{% comment %}
  FORMA COPENHAGEN — LAUNCH EXPERIENCE
  Launch date: 1 December 2026
  Newsletter signups are handled by Shopify.
{% endcomment %}

<div id="forma-launch-{{ section.id }}" class="forma-launch">

  <header class="forma-launch__header">
    <a class="forma-launch__wordmark" href="{{ routes.root_url }}" aria-label="FORMA Copenhagen">
      FORMA<span class="forma-launch__period">.</span>
    </a>

    <div class="forma-launch__header-right">
      <span class="forma-launch__location">COPENHAGEN, DENMARK</span>
      <span class="forma-launch__status">
        <span class="forma-launch__status-dot"></span>
        SOMETHING IS TAKING SHAPE
      </span>
    </div>
  </header>

  <main class="forma-launch__main">

    <section class="forma-launch__hero">
      <div class="forma-launch__eyebrow">
        <span class="forma-launch__eyebrow-line"></span>
        A NEW CHAPTER BEGINS
      </div>

      <div class="forma-launch__hero-grid">
        <div class="forma-launch__hero-copy">
          <h1>
            A new perspective<br>
            on the things <span>we love.</span>
          </h1>

          <p class="forma-launch__intro">
            A curated world of brands, places, stories and ideas.
            Thoughtfully brought together. Made to be discovered.
          </p>
        </div>

        <div class="forma-launch__hero-aside">
          <span class="forma-launch__aside-number">001 — 026</span>

          <p>
            Not just another destination.
            A different way to discover the world around you.
          </p>

          <a href="#forma-waitlist-{{ section.id }}" class="forma-launch__text-link">
            BE PART OF WHAT'S NEXT
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="forma-launch__hero-bottom">
        <span>INDEPENDENT DISCOVERY</span>
        <span class="forma-launch__bottom-divider"></span>
        <span>SCANDINAVIA AND BEYOND</span>
        <span class="forma-launch__bottom-right">EST. COPENHAGEN</span>
      </div>
    </section>

    <section class="forma-launch__countdown-section" aria-label="Launch countdown">
      <div class="forma-launch__section-heading">
        <div>
          <span class="forma-launch__eyebrow-small">THE COUNTDOWN BEGINS</span>
          <h2>Mark the date.</h2>
        </div>

        <p class="forma-launch__launch-date">
          TUESDAY <span>01.12.2026</span>
        </p>
      </div>

      <div class="forma-launch__countdown" data-countdown>
        <div class="forma-launch__countdown-cell">
          <span class="forma-launch__countdown-number" data-days>00</span>
          <span class="forma-launch__countdown-label">DAYS</span>
        </div>

        <div class="forma-launch__countdown-cell">
          <span class="forma-launch__countdown-number" data-hours>00</span>
          <span class="forma-launch__countdown-label">HOURS</span>
        </div>

        <div class="forma-launch__countdown-cell">
          <span class="forma-launch__countdown-number" data-minutes>00</span>
          <span class="forma-launch__countdown-label">MINUTES</span>
        </div>

        <div class="forma-launch__countdown-cell">
          <span class="forma-launch__countdown-number" data-seconds>00</span>
          <span class="forma-launch__countdown-label">SECONDS</span>
        </div>
      </div>

      <div class="forma-launch__countdown-footer">
        <span>01 / 12</span>
        <div class="forma-launch__countdown-rule"></div>
        <span>THE NEXT CHAPTER IS ALMOST HERE</span>
      </div>
    </section>

    <section
      id="forma-waitlist-{{ section.id }}"
      class="forma-launch__waitlist"
    >
      <div class="forma-launch__waitlist-copy">
        <span class="forma-launch__eyebrow-small">YOUR INVITATION</span>

        <h2>
          Be first.<br>
          <span>Know first.</span>
        </h2>

        <p>
          Get on the list for launch news, new discoveries and a first
          look at what's coming to FORMA.
        </p>

        <div class="forma-launch__privacy">
          <span aria-hidden="true">↗</span>
          THOUGHTFUL UPDATES. NO UNNECESSARY NOISE.
        </div>
      </div>

      <div class="forma-launch__waitlist-form">
        <div class="forma-launch__form-heading">
          <span>THE FORMA LIST</span>
          <span>01 — JOIN</span>
        </div>

        {% form 'customer',
          id: 'FormaLaunchNewsletter',
          class: 'forma-launch__form'
        %}

          <input type="hidden" name="contact[tags]" value="newsletter, forma-launch">

          {% if form.posted_successfully? %}
            <div class="forma-launch__success" role="status">
              <span class="forma-launch__success-mark">✓</span>
              <div>
                <strong>You're on the list.</strong>
                <p>Thank you for being part of what's next. Keep an eye on your inbox.</p>
              </div>
            </div>
          {% else %}

            {% if form.errors %}
              <div class="forma-launch__error" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <label class="forma-launch__label" for="FormaLaunchEmail-{{ section.id }}">
              YOUR E-MAIL ADDRESS
            </label>

            <div class="forma-launch__input-row">
              <input
                id="FormaLaunchEmail-{{ section.id }}"
                class="forma-launch__email"
                type="email"
                name="contact[email]"
                value="{{ form.email | escape }}"
                placeholder="Enter your e-mail address"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
                aria-required="true"
              >

              <button class="forma-launch__submit" type="submit" aria-label="Join the FORMA list">
                <span>JOIN THE LIST</span>
                <span class="forma-launch__submit-arrow" aria-hidden="true">↗</span>
              </button>
            </div>

            <label class="forma-launch__consent" for="FormaLaunchConsent-{{ section.id }}">
              <input
                id="FormaLaunchConsent-{{ section.id }}"
                type="checkbox"
                name="contact[accepts_marketing]"
                value="true"
                required
              >
              <span>
                I agree to receive e-mails from FORMA about the launch,
                new discoveries and updates. I can unsubscribe at any time.
              </span>
            </label>

            <p class="forma-launch__form-note">
              By joining, you agree to our
              <a href="{{ routes.root_url }}policies/privacy-policy">Privacy Policy</a>.
            </p>

          {% endif %}
        {% endform %}
      </div>
    </section>

    <section class="forma-launch__manifesto">
      <span class="forma-launch__eyebrow-small">THE IDEA IS SIMPLE</span>

      <p>
        Less noise. More meaning.<br>
        <span>A world worth discovering.</span>
      </p>

      <span class="forma-launch__manifesto-index">FORMA COPENHAGEN — 2026</span>
    </section>

  </main>

  <footer class="forma-launch__footer">
    <a class="forma-launch__footer-logo" href="{{ routes.root_url }}">FORMA.</a>

    <p>A CURATED WORLD OF BRANDS, PLACES, STORIES AND IDEAS.</p>

    <a class="forma-launch__footer-contact" href="mailto:Customercare@formacopenhagen.com">
      GET IN TOUCH ↗
    </a>

    <span class="forma-launch__copyright">
      © {{ 'now' | date: '%Y' }} FORMA COPENHAGEN
    </span>
  </footer>

  <details class="forma-launch__password">
    <summary>ENTER WITH PASSWORD</summary>

    {% form 'storefront_password', class: 'forma-launch__password-form' %}
      <label for="FormaStorefrontPassword-{{ section.id }}">STORE PASSWORD</label>
      <input
        id="FormaStorefrontPassword-{{ section.id }}"
        type="password"
        name="password"
        placeholder="Enter password"
        required
      >
      <button type="submit">ENTER ↗</button>

      {% if form.errors %}
        <p class="forma-launch__error">{{ form.errors | default_errors }}</p>
      {% endif %}
    {% endform %}
  </details>

</div>

<style>
  #forma-launch-{{ section.id }} {
    --forma-paper: #eeede7;
    --forma-ink: #191918;
    --forma-muted: #77766f;
    --forma-line: #d5d3cb;
    --forma-white: #f8f7f3;

    background: var(--forma-paper);
    color: var(--forma-ink);
    width: 100%;
    overflow: hidden;
    font-family: inherit;
    -webkit-font-smoothing: antialiased;
  }

  #forma-launch-{{ section.id }} *,
  #forma-launch-{{ section.id }} *::before,
  #forma-launch-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #forma-launch-{{ section.id }} a {
    color: inherit;
    text-decoration: none;
  }

  #forma-launch-{{ section.id }} .forma-launch__header {
    min-height: 88px;
    padding: 0 5.2%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid var(--forma-line);
  }

  #forma-launch-{{ section.id }} .forma-launch__wordmark {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(32px, 3vw, 44px);
    letter-spacing: -0.075em;
    line-height: 1;
  }

  #forma-launch-{{ section.id }} .forma-launch__period {
    color: var(--forma-muted);
  }

  #forma-launch-{{ section.id }} .forma-launch__header-right {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  #forma-launch-{{ section.id }} .forma-launch__location,
  #forma-launch-{{ section.id }} .forma-launch__status,
  #forma-launch-{{ section.id }} .forma-launch__eyebrow,
  #forma-launch-{{ section.id }} .forma-launch__eyebrow-small,
  #forma-launch-{{ section.id }} .forma-launch__hero-bottom,
  #forma-launch-{{ section.id }} .forma-launch__aside-number,
  #forma-launch-{{ section.id }} .forma-launch__text-link,
  #forma-launch-{{ section.id }} .forma-launch__countdown-label,
  #forma-launch-{{ section.id }} .forma-launch__countdown-footer,
  #forma-launch-{{ section.id }} .forma-launch__form-heading,
  #forma-launch-{{ section.id }} .forma-launch__label,
  #forma-launch-{{ section.id }} .forma-launch__privacy,
  #forma-launch-{{ section.id }} .forma-launch__manifesto-index,
  #forma-launch-{{ section.id }} .forma-launch__copyright {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.6;
  }

  #forma-launch-{{ section.id }} .forma-launch__location {
    color: var(--forma-muted);
  }

  #forma-launch-{{ section.id }} .forma-launch__status {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  #forma-launch-{{ section.id }} .forma-launch__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #777c63;
    box-shadow: 0 0 0 4px rgba(119, 124, 99, 0.12);
  }

  #forma-launch-{{ section.id }} .forma-launch__main {
    padding: 0 5.2%;
  }

  #forma-launch-{{ section.id }} .forma-launch__hero {
    padding: clamp(62px, 9vw, 128px) 0 25px;
  }

  #forma-launch-{{ section.id }} .forma-launch__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--forma-muted);
    margin-bottom: clamp(36px, 5vw, 66px);
  }

  #forma-launch-{{ section.id }} .forma-launch__eyebrow-line {
    width: 25px;
