<script>
(function () {
  const root = document.getElementById('FormaLaunch-{{ section.id }}');
  if (!root || root.dataset.formaInitialized === 'true') return;

  root.dataset.formaInitialized = 'true';

  /* COUNTDOWN */
  const countdown = root.querySelector('[data-forma-countdown]');

  if (countdown) {
    const launchDate = new Date(countdown.dataset.launchDate).getTime();

    const days = countdown.querySelector('[data-count-days]');
    const hours = countdown.querySelector('[data-count-hours]');
    const minutes = countdown.querySelector('[data-count-minutes]');
    const seconds = countdown.querySelector('[data-count-seconds]');

    function updateCountdown() {
      const remaining = launchDate - Date.now();

      if (remaining <= 0) {
        countdown.innerHTML =
          '<span class="forma-launch__countdown-live">FORMA IS NOW OPEN</span>';
        return;
      }

      const totalSeconds = Math.floor(remaining / 1000);
      const totalMinutes = Math.floor(totalSeconds / 60);

      if (days) days.textContent = String(Math.floor(totalMinutes / 1440)).padStart(2, '0');
      if (hours) hours.textContent = String(Math.floor((totalMinutes % 1440) / 60)).padStart(2, '0');
      if (minutes) minutes.textContent = String(totalMinutes % 60).padStart(2, '0');
      if (seconds) seconds.textContent = String(totalSeconds % 60).padStart(2, '0');
    }

    updateCountdown();
    window.setInterval(updateCountdown, 1000);
  }

  /* PASSWORD PANEL */
  const toggle = root.querySelector('[data-password-toggle]');
  const panel = root.querySelector('[data-password-panel]');

  if (toggle && panel) {
    toggle.addEventListener('click', function () {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

      toggle.setAttribute('aria-expanded', String(!isExpanded));
      panel.hidden = isExpanded;

      if (!isExpanded) {
        const passwordInput = panel.querySelector('input[name="password"]');
        if (passwordInput) passwordInput.focus();
      }
    });
  }
})();
</script>

