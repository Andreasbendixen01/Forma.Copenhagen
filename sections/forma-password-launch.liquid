<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    var timer = section.querySelector('#FormaCountdown');
    if (!timer || timer.dataset.initialized === 'true') return;

    timer.dataset.initialized = 'true';

    var launchDate = new Date(timer.getAttribute('data-launch-date'));

    var days = timer.querySelector('[data-days]');
    var hours = timer.querySelector('[data-hours]');
    var minutes = timer.querySelector('[data-minutes]');
    var seconds = timer.querySelector('[data-seconds]');

    function pad(value) {
      return String(value).padStart(2, '0');
    }

    function updateCountdown() {
      var remaining = launchDate.getTime() - Date.now();

      if (isNaN(launchDate.getTime()) || remaining <= 0) {
        days.textContent = '00';
        hours.textContent = '00';
        minutes.textContent = '00';
        seconds.textContent = '00';
        return;
      }

      var total = Math.floor(remaining / 1000);

      days.textContent = pad(Math.floor(total / 86400));
      hours.textContent = pad(Math.floor((total % 86400) / 3600));
      minutes.textContent = pad(Math.floor((total % 3600) / 60));
      seconds.textContent = pad(total % 60);
    }

    updateCountdown();
    window.setInterval(updateCountdown, 1000);
  })();
</script>

