<script>
  (() => {
    const root = document.getElementById('forma-password-{{ section.id }}');
    if (!root || root.dataset.formaInitialised === 'true') return;
    root.dataset.formaInitialised = 'true';

    const countdown = root.querySelector('[data-launch-countdown]');
    if (!countdown) return;

    const launchDate = new Date({{ section.settings.launch_date | default: '2026-12-01T00:00:00+01:00' | json }});

    const updateCountdown = () => {
      const distance = launchDate.getTime() - Date.now();
      const days = Math.max(0, Math.floor(distance / 86400000));
      const hours = Math.max(0, Math.floor((distance % 86400000) / 3600000));
      const minutes = Math.max(0, Math.floor((distance % 3600000) / 60000));
      const seconds = Math.max(0, Math.floor((distance % 60000) / 1000));

      const setValue = (selector, value) => {
        const element = countdown.querySelector(selector);
        if (element) element.textContent = String(value).padStart(2, '0');
      };

      setValue('[data-days]', days);
      setValue('[data-hours]', hours);
      setValue('[data-minutes]', minutes);
      setValue('[data-seconds]', seconds);
    };

    updateCountdown();
    window.setInterval(updateCountdown, 1000);
  })();
</script>

