{% comment %}
  FORMA COPENHAGEN — PRE-LAUNCH PAGE
  Conversion-focused editorial landing page.
  Klaviyo integration will be added in the next step.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    --forma-bg: {{ section.settings.background_color }};
    --forma-text: {{ section.settings.text_color }};
    --forma-muted: {{ section.settings.muted_color }};
    --forma-border: {{ section.settings.border_color }};
    --forma-button: {{ section.settings.button_color }};
    --forma-button-text: {{ section.settings.button_text_color }};
    --forma-max-width: 1320px;
    background: var(--forma-bg);
    color: var(--forma-text);
  }

  #shopify-section-{{ section.id }} *,
  #shopify-section-{{ section.id }} *::before,
  #shopify-section-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .forma-launch {
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    background: var(--forma-bg);
    color: var(--forma-text);
    font-family: inherit;
  }

  #shopify-section-{{ section.id }} .forma-launch a {
    color: inherit;
  }

  #shopify-section-{{ section.id }} .forma-launch__inner {
    width: min(100% - 80px, var(--forma-max-width));
    margin-inline: auto;
  }

  /* HEADER */

  #shopify-section-{{ section.id }} .forma-launch__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 92px;
    border-bottom: 1px solid var(--forma-border);
  }

  #shopify-section-{{ section.id }} .forma-launch__logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .forma-launch__logo img {
    display: block;
    width: auto;
    max-width: 210px;
    max-height: 42px;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .forma-launch__wordmark {
    margin: 0;
    font-size: 28px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.075em;
  }

  #shopify-section-{{ section.id }} .forma-launch__header-note {
    margin: 0;
    color: var(--forma-muted);
    font-size: 10px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    text-align: right;
  }

  /* HERO */

  #shopify-section-{{ section.id }} .forma-launch__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.03fr) minmax(390px, 0.77fr);
    align-items: center;
    gap: clamp(52px, 8vw, 120px);
    padding-top: clamp(64px, 8vw, 116px);
    padding-bottom: clamp(72px, 8vw, 116px);
  }

  #shopify-section-{{ section.id }} .forma-launch__copy {
    max-width: 670px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .forma-launch__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 27px;
    color: var(--forma-muted);
    font-size: 10px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .forma-launch__eyebrow::before {
    content: "";
    width: 24px;
    height: 1px;
    flex: 0 0 24px;
    background: currentColor;
  }

  #shopify-section-{{ section.id }} .forma-launch__title {
    max-width: 760px;
    margin: 0;
    font-size: clamp(48px, 6.3vw, 88px);
    line-height: 0.99;
    font-weight: 400;
    letter-spacing: -0.075em;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .forma-launch__title em {
    font-weight: 400;
    font-style: normal;
    color: var(--forma-muted);
  }

  #shopify-section-{{ section.id }} .forma-launch__description {
    max-width: 475px;
    margin: 28px 0 0;
    font-size: 16px;
    line-height: 1.75;
    font-weight: 400;
    color: var(--forma-muted);
  }

  #shopify-section-{{ section.id }} .forma-launch__launch-note {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 29px;
    color: var(--forma-text);
    font-size: 11px;
    line-height: 1.6;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .forma-launch__launch-note::before {
    content: "";
    width: 6px;
    height: 6px;
    flex: 0 0 6px;
    border-radius: 50%;
    background: currentColor;
  }

  /* OPTIONAL EDITORIAL IMAGE */

  #shopify-section-{{ section.id }} .forma-launch__visual {
    position: relative;
    width: 100%;
    margin: 0;
    overflow: hidden;
    background: #e9e7e1;
  }

  #shopify-section-{{ section.id }} .forma-launch__visual img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .forma-launch__visual-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 380px;
    aspect-ratio: 4 / 5;
    padding: 24px;
    background:
      linear-gradient(145deg, #e7e5df 0%, #d4d0c8 48%, #bab8b0 100%);
  }

  #shopify-section-{{ section.id }} .forma-launch__visual-placeholder span {
    font-size: clamp(44px, 6vw, 80px);
    line-height: 1;
    font-weight: 400;
    letter-spacing: -0.075em;
    color: rgba(23, 23, 23, 0.75);
  }

  #shopify-section-{{ section.id }} .forma-launch__visual-caption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 12px;
    color: var(--forma-muted);
    font-size: 9px;
    line-height: 1.6;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* SIGNUP PANEL */

  #shopify-section-{{ section.id }} .forma-launch__signup {
    margin-top: 40px;
    padding: 29px;
    border: 1px solid var(--forma-border);
    background: rgba(255, 255, 255, 0.24);
  }

  #shopify-section-{{ section.id }} .forma-launch__signup-heading {
    margin: 0;
    font-size: 23px;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: -0.045em;
  }

  #shopify-section-{{ section.id }} .forma-launch__signup-intro {
    margin: 10px 0 23px;
    color: var(--forma-muted);
    font-size: 12px;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .forma-launch__form {
    display: grid;
    gap: 13px;
  }

  #shopify-section-{{ section.id }} .forma-launch__field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .forma-launch__field {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .forma-launch__label {
    color: var(--forma-text);
    font-size: 10px;
    line-height: 1.4;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  #shopify-section-{{ section.id }} .forma-launch__input {
    width: 100%;
    min-width: 0;
    min-height: 49px;
    margin: 0;
    padding: 13px 13px;
    border: 1px solid var(--forma-border);
    border-radius: 0;
    outline: none;
    background: transparent;
    color: var(--forma-text);
    font-family: inherit;
    font-size: 13px;
    line-height: 1.4;
    box-shadow: none;
    appearance: none;
    -webkit-appearance: none;
    transition: border-color 180ms ease, background 180ms ease;
  }

  #shopify-section-{{ section.id }} .forma-launch__input::placeholder {
    color: var(--forma-muted);
    opacity: 0.8;
  }

  #shopify-section-{{ section.id }} .forma-launch__input:focus {
    border-color: var(--forma-text);
    background: rgba(255, 255, 255, 0.3);
  }

  #shopify-section-{{ section.id }} .forma-launch__input:focus-visible {
    outline: 2px solid var(--forma-text);
    outline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .forma-launch__input::-webkit-calendar-picker-indicator {
    cursor: pointer;
    opacity: 0.65;
  }

  #shopify-section-{{ section.id }} .forma-launch__consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: 3px;
    color: var(--forma-muted);
    font-size: 10px;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .forma-launch__consent input {
    width: 15px;
    height: 15px;
    min-width: 15px;
    margin: 2px 0 0;
    accent-color: var(--forma-text);
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .forma-launch__consent a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .forma-launch__submit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    width: 100%;
    min-height: 54px;
    margin-top: 4px;
    padding: 15px 17px;
    border: 1px solid var(--forma-button);
    border-radius: 0;
    background: var(--forma-button);
    color: var(--forma-button-text);
    font-family: inherit;
    font-size: 11px;
    line-height: 1.4;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-align: left;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 180ms ease, background 180ms ease;
  }

  #shopify-section-{{ section.id }} .forma-launch__submit:hover {
    opacity: 0.82;
  }

  #shopify-section-{{ section.id }} .forma-launch__submit:focus-visible {
    outline: 2px solid var(--forma-text);
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .forma-launch__submit svg {
    width: 17px;
    height: 17px;
    flex: 0 0 17px;
    stroke: currentColor;
    stroke-width: 1.4;
    fill: none;
  }

  #shopify-section-{{ section.id }} .forma-launch__privacy-note {
    margin: 1px 0 0;
    color: var(--forma-muted);
    font-size: 9px;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .forma-launch__message {
    margin: 0 0 14px;
    padding: 12px 14px;
    border: 1px solid var(--forma-border);
    font-size: 12px;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .forma-launch__message--success {
    background: rgba(255, 255, 255, 0.35);
  }

  #shopify-section-{{ section.id }} .forma-launch__message--error {
    border-color: #a63e32;
  }

  /* VALUE PROPOSITION */

  #shopify-section-{{ section.id }} .forma-launch__about {
    padding-top: 38px;
    padding-bottom: 100px;
    border-top: 1px solid var(--forma-border);
  }

  #shopify-section-{{ section.id }} .forma-launch__about-top {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: 80px;
    align-items: start;
    padding: 38px 0 62px;
  }

  #shopify-section-{{ section.id }} .forma-launch__section-label {
    margin: 0;
    color: var(--forma-muted);
    font-size: 10px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .forma-launch__about-title {
    max-width: 560px;
    margin: 0;
    font-size: clamp(31px, 4vw, 52px);
    line-height: 1.06;
    font-weight: 400;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .forma-launch__about-copy {
    max-width: 510px;
    margin: 20px 0 0;
    color: var(--forma-muted);
    font-size: 13px;
    line-height: 1.9;
  }

  #shopify-section-{{ section.id }} .forma-launch__values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--forma-border);
    border-bottom: 1px solid var(--forma-border);
  }

  #shopify-section-{{ section.id }} .forma-launch__value {
    min-width: 0;
    padding: 28px 25px 31px 0;
  }

  #shopify-section-{{ section.id }} .forma-launch__value + .forma-launch__value {
    padding-left: 25px;
    border-left: 1px solid var(--forma-border);
  }

  #shopify-section-{{ section.id }} .forma-launch__value-number {
    display: block;
    margin-bottom: 29px;
    color: var(--forma-muted);
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  #shopify-section-{{ section.id }} .forma-launch__value-title {
    margin: 0;
    font-size: 18px;
    line-height: 1.25;
    font-weight: 400;
    letter-spacing: -0.035em;
  }

  #shopify-section-{{ section.id }} .forma-launch__value-copy {
    max-width: 290px;
    margin: 10px 0 0;
    color: var(--forma-muted);
    font-size: 12px;
    line-height: 1.8;
  }

  /* CATEGORIES */

  #shopify-section-{{ section.id }} .forma-launch__categories {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding-top: 29px;
  }

  #shopify-section-{{ section.id }} .forma-launch__categories-label {
    margin-right: 10px;
    color: var(--forma-muted);
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .forma-launch__category {
    padding: 9px 12px;
    border: 1px solid var(--forma-border);
    color: var(--forma-text);
    font-size: 10px;
    line-height: 1.3;
    letter-spacing: 0.03em;
  }

  /* COUNTDOWN */

  #shopify-section-{{ section.id }} .forma-launch__countdown {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
    padding: 29px 0 32px;
    border-top: 1px solid var(--forma-border);
  }

  #shopify-section-{{ section.id }} .forma-launch__countdown-heading {
    margin: 0;
    font-size: 16px;
    line-height: 1.4;
    font-weight: 400;
    letter-spacing: -0.025em;
  }

  #shopify-section-{{ section.id }} .forma-launch__countdown-subtitle {
    margin: 7px 0 0;
    color: var(--forma-muted);
    font-size: 10px;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .forma-launch__timer {
    display: flex;
    align-items: flex-start;
    gap: clamp(16px, 3vw, 42px);
  }

  #shopify-section-{{ section.id }} .forma-launch__timer-unit {
    min-width: 42px;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .forma-launch__timer-number {
    display: block;
    font-size: clamp(24px, 3vw, 35px);
    line-height: 1;
    font-weight: 400;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
  }

  #shopify-section-{{ section.id }} .forma-launch__timer-label {
    display: block;
    margin-top: 9px;
    color: var(--forma-muted);
    font-size: 9px;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* FOOTER */

  #shopify-section-{{ section.id }} .forma-launch__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 23px 0 27px;
    border-top: 1px solid var(--forma-border);
  }

  #shopify-section-{{ section.id }} .forma-launch__footer-brand {
    margin: 0;
    font-size: 10px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .forma-launch__footer-copy {
    margin: 0;
    color: var(--forma-muted);
    font-size: 10px;
    line-height: 1.6;
    text-align: right;
  }

  #shopify-section-{{ section.id }} .forma-launch__footer-copy a {
    text-underline-offset: 3px;
  }

  /* RESPONSIVE */

  @media screen and (min-width: 1500px) {
    #shopify-section-{{ section.id }} .forma-launch__hero {
      gap: 125px;
    }
  }

  @media screen and (max-width: 1000px) {
    #shopify-section-{{ section.id }} .forma-launch__inner {
      width: min(100% - 48px, var(--forma-max-width));
    }

    #shopify-section-{{ section.id }} .forma-launch__hero {
      grid-template-columns: minmax(0, 1fr) minmax(320px, 0.85fr);
      gap: 38px;
    }

    #shopify-section-{{ section.id }} .forma-launch__signup {
      padding: 22px;
    }

    #shopify-section-{{ section.id }} .forma-launch__about-top {
      gap: 42px;
    }

    #shopify-section-{{ section.id }} .forma-launch__value {
      padding-right: 17px;
    }

    #shopify-section-{{ section.id }} .forma-launch__value + .forma-launch__value {
      padding-left: 17px;
    }
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .forma-launch__inner {
      width: calc(100% - 36px);
    }

    #shopify-section-{{ section.id }} .forma-launch__header {
      min-height: 69px;
    }

    #shopify-section-{{ section.id }} .forma-launch__logo img {
      max-width: 160px;
      max-height: 32px;
    }

    #shopify-section-{{ section.id }} .forma-launch__wordmark {
      font-size: 25px;
    }

    #shopify-section-{{ section.id }} .forma-launch__header-note {
      max-width: 120px;
      font-size: 8px;
      letter-spacing: 0.09em;
    }

    #shopify-section-{{ section.id }} .forma-launch__hero {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 31px;
      padding-top: 52px;
      padding-bottom: 58px;
    }

    #shopify-section-{{ section.id }} .forma-launch__copy {
      display: contents;
    }

    #shopify-section-{{ section.id }} .forma-launch__eyebrow {
      order: 1;
      margin: 0 0 -12px;
      font-size: 9px;
    }

    #shopify-section-{{ section.id }} .forma-launch__title {
      order: 2;
      max-width: 520px;
      font-size: clamp(43px, 12vw, 65px);
      line-height: 0.99;
    }

    #shopify-section-{{ section.id }} .forma-launch__description {
      order: 3;
      margin: -12px 0 0;
      font-size: 14px;
      line-height: 1.75;
    }

    #shopify-section-{{ section.id }} .forma-launch__launch-note {
      order: 4;
      margin-top: -10px;
      font-size: 9px;
    }

    #shopify-section-{{ section.id }} .forma-launch__signup {
      order: 5;
      margin-top: -3px;
      padding: 21px 17px;
    }

    #shopify-section-{{ section.id }} .forma-launch__visual {
      order: 6;
    }

    #shopify-section-{{ section.id }} .forma-launch__visual img {
      aspect-ratio: 5 / 4;
    }

    #shopify-section-{{ section.id }} .forma-launch__visual-placeholder {
      min-height: 230px;
      aspect-ratio: 5 / 4;
    }

    #shopify-section-{{ section.id }} .forma-launch__visual-caption {
      font-size: 8px;
    }

    #shopify-section-{{ section.id }} .forma-launch__signup-heading {
      font-size: 22px;
    }

    #shopify-section-{{ section.id }} .forma-launch__signup-intro {
      margin-bottom: 20px;
    }

    #shopify-section-{{ section.id }} .forma-launch__field-row {
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .forma-launch__input {
      min-height: 48px;
      padding: 12px 10px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .forma-launch__label {
      font-size: 9px;
    }

    #shopify-section-{{ section.id }} .forma-launch__about {
      padding-top: 27px;
      padding-bottom: 55px;
    }

    #shopify-section-{{ section.id }} .forma-launch__about-top {
      grid-template-columns: 1fr;
      gap: 22px;
      padding: 25px 0 35px;
    }

    #shopify-section-{{ section.id }} .forma-launch__about-title {
      font-size: clamp(33px, 8.5vw, 45px);
    }

    #shopify-section-{{ section.id }} .forma-launch__about-copy {
      margin-top: 15px;
      font-size: 12px;
      line-height: 1.85;
    }

    #shopify-section-{{ section.id }} .forma-launch__values {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .forma-launch__value,
    #shopify-section-{{ section.id }} .forma-launch__value + .forma-launch__value {
      padding: 22px 0 24px;
      border-left: 0;
    }

    #shopify-section-{{ section.id }} .forma-launch__value + .forma-launch__value {
      border-top: 1px solid var(--forma-border);
    }

    #shopify-section-{{ section.id }} .forma-launch__value-number {
      margin-bottom: 17px;
    }

    #shopify-section-{{ section.id }} .forma-launch__value-title {
      font-size: 17px;
    }

    #shopify-section-{{ section.id }} .forma-launch__value-copy {
      max-width: 380px;
      margin-top: 7px;
    }

    #shopify-section-{{ section.id }} .forma-launch__categories {
      gap: 8px;
      padding-top: 23px;
    }

    #shopify-section-{{ section.id }} .forma-launch__categories-label {
      flex-basis: 100%;
      margin: 0 0 4px;
    }

    #shopify-section-{{ section.id }} .forma-launch__category {
      padding: 8px 10px;
      font-size: 9px;
    }

    #shopify-section-{{ section.id }} .forma-launch__countdown {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      padding: 24px 0 27px;
    }

    #shopify-section-{{ section.id }} .forma-launch__timer {
      width: 100%;
      justify-content: space-between;
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .forma-launch__timer-unit {
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .forma-launch__timer-number {
      font-size: 29px;
    }

    #shopify-section-{{ section.id }} .forma-launch__timer-label {
      font-size: 8px;
    }

    #shopify-section-{{ section.id }} .forma-launch__footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
      padding: 19px 0 23px;
    }

    #shopify-section-{{ section.id }} .forma-launch__footer-copy {
      text-align: left;
    }
  }

  @media screen and (max-width: 360px) {
    #shopify-section-{{ section.id }} .forma-launch__inner {
      width: calc(100% - 28px);
    }

    #shopify-section-{{ section.id }} .forma-launch__field-row {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .forma-launch__signup {
      padding: 18px 14px;
    }

    #shopify-section-{{ section.id }} .forma-launch__timer-number {
      font-size: 25px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} *,
    #shopify-section-{{ section.id }} *::before,
    #shopify-section-{{ section.id }} *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>

<section class="forma-launch" aria-label="FORMA Copenhagen pre-launch">
  <div class="forma-launch__inner">

    <header class="forma-launch__header">
      <a class="forma-launch__logo" href="/" aria-label="FORMA Copenhagen">
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 600
            | image_tag:
              widths: '160, 240, 360, 480, 600',
              loading: 'eager',
              alt: 'FORMA Copenhagen'
          }}
        {% else %}
          <span class="forma-launch__wordmark">FORMA</span>
        {% endif %}
      </a>

      <p class="forma-launch__header-note">
        {{ section.settings.header_note | escape }}
      </p>
    </header>

    <main>
      <section class="forma-launch__hero" aria-labelledby="FormaLaunchTitle">

        <div class="forma-launch__copy">
          <p class="forma-launch__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>

          <h1 class="forma-launch__title" id="FormaLaunchTitle">
            {{ section.settings.heading_line_1 | escape }}
            <em>{{ section.settings.heading_line_2 | escape }}</em>
          </h1>

          <p class="forma-launch__description">
            {{ section.settings.hero_description | escape }}
          </p>

          <p class="forma-launch__launch-note">
            {{ section.settings.launch_note | escape }}
          </p>

          <div class="forma-launch__signup" id="FormaSignup">
            <h2 class="forma-launch__signup-heading">
              {{ section.settings.signup_heading | escape }}
            </h2>

            <p class="forma-launch__signup-intro">
              {{ section.settings.signup_description | escape }}
            </p>

            {% form 'customer', id: 'FormaPrelaunchForm', class: 'forma-launch__form' %}
              {% if form.posted_successfully? %}
                <p class="forma-launch__message forma-launch__message--success" role="status">
                  Tak for din interesse i FORMA. Hold øje med din indbakke.
                </p>
              {% endif %}

              {% if form.errors %}
                <div class="forma-launch__message forma-launch__message--error" role="alert">
                  {{ form.errors | default_errors }}
                </div>
              {% endif %}

              <input type="hidden" name="contact[tags]" value="newsletter, forma-prelaunch">

              <div class="forma-launch__field-row">
                <div class="forma-launch__field">
                  <label class="forma-launch__label" for="FormaFirstName">Fornavn</label>
                  <input
                    class="forma-launch__input"
                    id="FormaFirstName"
                    type="text"
                    name="contact[first_name]"
                    autocomplete="given-name"
                    placeholder="Dit fornavn"
                    required
                  >
                </div>

                <div class="forma-launch__field">
                  <label class="forma-launch__label" for="FormaLastName">Efternavn</label>
                  <input
                    class="forma-launch__input"
                    id="FormaLastName"
                    type="text"
                    name="contact[last_name]"
                    autocomplete="family-name"
                    placeholder="Dit efternavn"
                    required
                  >
                </div>
              </div>

              <div class="forma-launch__field">
                <label class="forma-launch__label" for="FormaEmail">E-mail</label>
                <input
                  class="forma-launch__input"
                  id="FormaEmail"
                  type="email"
                  name="contact[email]"
                  autocomplete="email"
                  autocapitalize="off"
                  spellcheck="false"
                  placeholder="navn@eksempel.dk"
                  required
                >
              </div>

              <div class="forma-launch__field">
                <label class="forma-launch__label" for="FormaBirthday">Fødselsdato</label>
                <input
                  class="forma-launch__input"
                  id="FormaBirthday"
                  type="date"
                  name="contact[birthday]"
                  autocomplete="bday"
                  aria-describedby="FormaBirthdayNote"
                  required
                >
                <p class="forma-launch__privacy-note" id="FormaBirthdayNote">
                  Vi bruger din fødselsdato til at kunne give dig relevant fødselsdagsinspiration.
                </p>
              </div>

              <label class="forma-launch__consent" for="FormaMarketingConsent">
                <input
                  id="FormaMarketingConsent"
                  type="checkbox"
                  name="contact[accepts_marketing]"
                  value="true"
                  required
                >
                <span>
                  Jeg vil gerne modtage e-mails fra FORMA med nyheder, inspiration og information om lanceringen. Jeg kan til enhver tid afmelde mig.
                  <a href="{{ section.settings.privacy_url | default: '/policies/privacy-policy' }}">Læs vores privatlivspolitik</a>.
                </span>
              </label>

              <button class="forma-launch__submit" type="submit">
                <span>{{ section.settings.button_label | escape }}</span>
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M3.5 10h12M10 4.5l5.5 5.5-5.5 5.5"/>
                </svg>
              </button>

              <p class="forma-launch__privacy-note">
                Ingen spam. Kun nøje udvalgt inspiration fra FORMA.
              </p>
            {% endform %}
          </div>
        </div>

        <figure class="forma-launch__visual">
          {% if section.settings.hero_image != blank %}
            {{
              section.settings.hero_image
              | image_url: width: 1800
              | image_tag:
                widths: '480, 720, 960, 1200, 1500, 1800',
                sizes: '(max-width: 699px) calc(100vw - 36px), (max-width: 1000px) 42vw, 520px',
                loading: 'eager',
                fetchpriority: 'high',
                alt: section.settings.hero_image_alt
            }}
          {% else %}
            <div class="forma-launch__visual-placeholder" aria-label="FORMA editorial image placeholder">
              <span>FORMA</span>
            </div>
          {% endif %}

          {% if section.settings.image_caption != blank %}
            <figcaption class="forma-launch__visual-caption">
              <span>{{ section.settings.image_caption | escape }}</span>
              <span>FORMA Copenhagen</span>
            </figcaption>
          {% endif %}
        </figure>

      </section>

      <section class="forma-launch__about" aria-labelledby="FormaAboutTitle">
        <div class="forma-launch__about-top">
          <div>
            <p class="forma-launch__section-label">
              {{ section.settings.about_label | escape }}
            </p>
          </div>

          <div>
            <h2 class="forma-launch__about-title" id="FormaAboutTitle">
              {{ section.settings.about_heading | escape }}
            </h2>

            <p class="forma-launch__about-copy">
              {{ section.settings.about_description | escape }}
            </p>
          </div>
        </div>

        <div class="forma-launch__values">
          <article class="forma-launch__value">
            <span class="forma-launch__value-number">01 / DISCOVER</span>
            <h3 class="forma-launch__value-title">Opdag med omtanke</h3>
            <p class="forma-launch__value-copy">
              Udforsk en kurateret verden af brands og produkter, hvor kvalitet, æstetik og personlig stil er i centrum.
            </p>
          </article>

          <article class="forma-launch__value">
            <span class="forma-launch__value-number">02 / EXPLORE</span>
            <h3 class="forma-launch__value-title">Mere end produkter</h3>
            <p class="forma-launch__value-copy">
              Gå på opdagelse i historier, inspiration og udvalgte steder, der giver nye perspektiver på hverdagen.
            </p>
          </article>

          <article class="forma-launch__value">
            <span class="forma-launch__value-number">03 / YOUR FORMA</span>
            <h3 class="forma-launch__value-title">Find din egen retning</h3>
            <p class="forma-launch__value-copy">
              Forma skal gøre det lettere at gemme favoritter, følge brands og vende tilbage til det, der inspirerer dig.
            </p>
          </article>
        </div>

        <div class="forma-launch__categories" aria-label="FORMAs universer">
          <span class="forma-launch__categories-label">Explore the Forma universe</span>
          <span class="forma-launch__category">Wardrobe</span>
          <span class="forma-launch__category">Lifestyle</span>
          <span class="forma-launch__category">Home</span>
          <span class="forma-launch__category">The Form</span>
          <span class="forma-launch__category">Places</span>
        </div>
      </section>

      {% if section.settings.show_countdown %}
        <section class="forma-launch__countdown" aria-label="Nedtælling til lancering">
          <div>
            <h2 class="forma-launch__countdown-heading">
              {{ section.settings.countdown_heading | escape }}
            </h2>
            <p class="forma-launch__countdown-subtitle">
              {{ section.settings.countdown_subtitle | escape }}
            </p>
          </div>

          <div class="forma-launch__timer" id="FormaCountdown" data-launch-date="{{ section.settings.launch_date }}">
            <div class="forma-launch__timer-unit">
              <span class="forma-launch__timer-number" data-days>00</span>
              <span class="forma-launch__timer-label">Dage</span>
            </div>
            <div class="forma-launch__timer-unit">
              <span class="forma-launch__timer-number" data-hours>00</span>
              <span class="forma-launch__timer-label">Timer</span>
            </div>
            <div class="forma-launch__timer-unit">
              <span class="forma-launch__timer-number" data-minutes>00</span>
              <span class="forma-launch__timer-label">Minutter</span>
            </div>
            <div class="forma-launch__timer-unit">
              <span class="forma-launch__timer-number" data-seconds>00</span>
              <span class="forma-launch__timer-label">Sekunder</span>
            </div>
          </div>
        </section>
      {% endif %}
    </main>

    <footer class="forma-launch__footer">
      <p class="forma-launch__footer-brand">FORMA Copenhagen</p>
      <p class="forma-launch__footer-copy">
        {{ section.settings.footer_text | escape }}
        {% if section.settings.contact_email != blank %}
          &nbsp;·&nbsp;
          <a href="mailto:{{ section.settings.contact_email | escape }}">
            {{ section.settings.contact_email | escape }}
          </a>
        {% endif %}
      </p>
    </footer>

  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    var timer = section.querySelector('#FormaCountdown');
    if (!timer || timer.dataset.initialized === 'true') return;

    timer.dataset.initialized = 'true';

    var launchDate = new Date(timer.getAttribute('data-launch-date'));

    var daysEl = timer.querySelector('[data-days]');
    var hoursEl = timer.querySelector('[data-hours]');
    var minutesEl = timer.querySelector('[data-minutes]');
    var secondsEl = timer.querySelector('[data-seconds]');

    function pad(value) {
      return String(value).padStart(2, '0');
    }

    function updateCountdown() {
      var remaining = launchDate.getTime() - Date.now();

      if (isNaN(launchDate.getTime()) || remaining <= 0) {
        daysEl.textContent = '00';
        hoursEl.textContent = '00';
        minutesEl.textContent = '00';
        secondsEl.textContent = '00';
        return;
      }

      var totalSeconds = Math.floor(remaining / 1000);
      daysEl.textContent = pad(Math.floor(totalSeconds / 86400));
      hoursEl.textContent = pad(Math.floor((totalSeconds % 86400) / 3600));
      minutesEl.textContent = pad(Math.floor((totalSeconds % 3600) / 60));
      secondsEl.textContent = pad(totalSeconds % 60);
    }

    updateCountdown();
    window.setInterval(updateCountdown, 1000);
  })();
</script>

