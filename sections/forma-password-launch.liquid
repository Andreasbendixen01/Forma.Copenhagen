```liquid
{% comment %}
  FORMA COPENHAGEN — PASSWORD PAGE
  Editorial design, mobile-first signup and launch countdown.
  Launch date: 1 December 2026.
{% endcomment %}

{% assign forma_logo = section.settings.logo %}
{% assign forma_image = section.settings.hero_image %}

<div id="forma-launch-{{ section.id }}" class="fl-page">

  <!-- HEADER -->
  <header class="fl-header">
    <a href="{{ routes.root_url }}" class="fl-logo" aria-label="FORMA Copenhagen">
      {% if forma_logo != blank %}
        {{
          forma_logo
          | image_url: width: 600
          | image_tag:
            widths: '160, 300, 450, 600',
            class: 'fl-logo__image',
            alt: 'FORMA Copenhagen'
        }}
      {% else %}
        <span class="fl-logo__fallback">FORMA</span>
      {% endif %}
    </a>

    <span class="fl-header__note">
      COPENHAGEN<br>
      SCANDINAVIA · EVERYWHERE
    </span>
  </header>

  <main class="fl-main">

    <!-- HERO -->
    <section class="fl-hero">

      <div class="fl-eyebrow">
        <span class="fl-eyebrow__line"></span>
        SOMETHING WORTH DISCOVERING
      </div>

      <div class="fl-hero__grid {% if forma_image == blank %}fl-hero__grid--text-only{% endif %}">

        <div class="fl-hero__copy">
          <h1>
            A new perspective<br class="fl-desktop-only">
            on the things <span>we love.</span>
          </h1>

          <p>
            A curated world of brands, places, stories and ideas.
            Thoughtfully brought together. Made to be discovered.
          </p>

          <a class="fl-text-link" href="#fl-signup-{{ section.id }}">
            BE FIRST TO DISCOVER
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        {% if forma_image != blank %}
          <div class="fl-hero__visual">
            {{
              forma_image
              | image_url: width: 1600
              | image_tag:
                widths: '400, 700, 1000, 1300, 1600',
                sizes: '(max-width: 749px) 100vw, 45vw',
                loading: 'eager',
                class: 'fl-hero__image',
                alt: section.settings.image_alt
            }}
            {% if section.settings.image_caption != blank %}
              <span class="fl-hero__caption">
                {{ section.settings.image_caption | escape }}
              </span>
            {% endif %}
          </div>
        {% endif %}

      </div>

      <div class="fl-hero__footer">
        <span>INDEPENDENT DISCOVERY</span>
        <span class="fl-hero__divider"></span>
        <span>SCANDINAVIA AND BEYOND</span>
      </div>

    </section>

    <!-- SIGNUP: THE MAIN FOCUS -->
    <section id="fl-signup-{{ section.id }}" class="fl-signup">

      <div class="fl-signup__intro">
        <div class="fl-eyebrow">
          <span class="fl-eyebrow__line"></span>
          THE FORMA LETTER
        </div>

        <h2>
          Be first.<br>
          <span>Know first.</span>
        </h2>

        <p>
          Something worth looking forward to is coming.
          Join the list for first access to FORMA, new discoveries
          and the stories shaping our world.
        </p>

        <div class="fl-signup__launch-note">
          <span class="fl-launch-dot"></span>
          LAUNCHING 01 DECEMBER 2026
        </div>
      </div>

      <div class="fl-signup__panel">

        <div class="fl-signup__panel-heading">
          <span>YOUR INVITATION</span>
          <span>01 / 04</span>
        </div>

        {% form 'customer',
          id: 'FormaLaunchSignup',
          class: 'fl-form'
        %}

          <input
            type="hidden"
            name="contact[tags]"
            value="newsletter, forma-launch"
          >

          {% if form.posted_successfully? %}

            <div class="fl-success" role="status">
              <span class="fl-success__icon">✓</span>
              <div>
                <h3>You're on the list.</h3>
                <p>
                  Thank you for joining FORMA.
                  Keep an eye on your inbox.
                </p>
              </div>
            </div>

          {% else %}

            {% if form.errors %}
              <div class="fl-error" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="fl-form__grid">

              <div class="fl-field">
                <label for="FLFirstName-{{ section.id }}">
                  FIRST NAME <span>*</span>
                </label>
                <input
                  id="FLFirstName-{{ section.id }}"
                  type="text"
                  name="customer[first_name]"
                  placeholder="Your first name"
                  autocomplete="given-name"
                  required
                >
              </div>

              <div class="fl-field">
                <label for="FLLastName-{{ section.id }}">
                  LAST NAME <span>*</span>
                </label>
                <input
                  id="FLLastName-{{ section.id }}"
                  type="text"
                  name="customer[last_name]"
                  placeholder="Your last name"
                  autocomplete="family-name"
                  required
                >
              </div>

              <div class="fl-field">
                <label for="FLBirthday-{{ section.id }}">
                  DATE OF BIRTH <span>*</span>
                </label>
                <input
                  id="FLBirthday-{{ section.id }}"
                  type="date"
                  name="customer[note]"
                  autocomplete="bday"
                  required
                  aria-describedby="FLBirthdayHelp-{{ section.id }}"
                >
                <span
                  class="fl-field__help"
                  id="FLBirthdayHelp-{{ section.id }}"
                >
                  Used for birthday surprises.
                </span>
              </div>

              <div class="fl-field">
                <label for="FLEmail-{{ section.id }}">
                  EMAIL ADDRESS <span>*</span>
                </label>
                <input
                  id="FLEmail-{{ section.id }}"
                  type="email"
                  name="customer[email]"
                  value="{{ form.email | escape }}"
                  placeholder="you@example.com"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  required
                >
              </div>

            </div>

            <div class="fl-form__consent">
              <label for="FLConsent-{{ section.id }}">
                <input
                  id="FLConsent-{{ section.id }}"
                  type="checkbox"
                  name="customer[accepts_marketing]"
                  value="true"
                  required
                >
                <span>
                  I agree to receive marketing emails from FORMA about
                  the launch, new discoveries and updates. I can
                  unsubscribe at any time.
                </span>
              </label>
            </div>

            <button class="fl-submit" type="submit">
              <span>JOIN THE FORMA LETTER</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </button>

            <p class="fl-form__privacy">
              By signing up, you agree to our
              <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">
                Privacy Policy
              </a>.
            </p>

          {% endif %}

        {% endform %}

      </div>

    </section>

    <!-- COUNTDOWN -->
    <section class="fl-countdown" aria-label="Countdown to launch">

      <div class="fl-countdown__heading">
        <div>
          <span class="fl-eyebrow-small">SAVE THE DATE</span>
          <h2>The countdown begins.</h2>
        </div>
        <span class="fl-countdown__date">01.12.2026</span>
      </div>

      <div class="fl-countdown__grid" data-fl-countdown>
        <div class="fl-countdown__item">
          <span data-fl-days>00</span>
          <small>DAYS</small>
        </div>
        <div class="fl-countdown__item">
          <span data-fl-hours>00</span>
          <small>HOURS</small>
        </div>
        <div class="fl-countdown__item">
          <span data-fl-minutes>00</span>
          <small>MINUTES</small>
        </div>
        <div class="fl-countdown__item">
          <span data-fl-seconds>00</span>
          <small>SECONDS</small>
        </div>
      </div>

      <p class="fl-countdown__note">
        A new world of discovery. Coming soon.
      </p>

    </section>

  </main>

  <!-- FOOTER -->
  <footer class="fl-footer">
    <div class="fl-footer__top">
      <a href="{{ routes.root_url }}" class="fl-footer__brand">
        {% if forma_logo != blank %}
          {{
            forma_logo
            | image_url: width: 400
            | image_tag:
              widths: '150, 250, 400',
              class: 'fl-footer__logo',
              alt: 'FORMA Copenhagen'
          }}
        {% else %}
          <span>FORMA</span>
        {% endif %}
      </a>

      <a class="fl-footer__contact" href="mailto:Customercare@formacopenhagen.com">
        CONTACT
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 17 17 7M7 7h10v10"/>
        </svg>
      </a>
    </div>

    <div class="fl-footer__bottom">
      <span>A CURATED WORLD OF BRANDS, PLACES, STORIES AND IDEAS.</span>
      <span>© {{ 'now' | date: '%Y' }} FORMA COPENHAGEN</span>
    </div>
  </footer>

  <!-- PASSWORD ACCESS FOR THE STORE OWNER -->
  <details class="fl-password">
    <summary>ENTER WITH PASSWORD</summary>

    {% form 'storefront_password', class: 'fl-password__form' %}
      <label for="FLStorePassword-{{ section.id }}">STORE PASSWORD</label>
      <input
        id="FLStorePassword-{{ section.id }}"
        type="password"
        name="password"
        placeholder="Enter password"
        required
      >
      <button type="submit">ENTER</button>

      {% if form.errors %}
        <div class="fl-error">{{ form.errors | default_errors }}</div>
      {% endif %}
    {% endform %}
  </details>

</div>

<style>
  #forma-launch-{{ section.id }} {
    --fl-bg: #f4f3ef;
    --fl-text: #191918;
    --fl-muted: #77766f;
    --fl-line: #deddd6;

    background: var(--fl-bg);
    color: var(--fl-text);
    width: 100%;
    overflow: hidden;
    font-family: inherit;
    -webkit-font-smoothing: antialiased;
  }

  #forma-launch-{{ section.id }} *,
  #forma-launch-{{ section.id }} *::before,
  #forma-launch-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #forma-launch-{{ section.id }} a {
    color: inherit;
    text-decoration: none;
  }

  #forma-launch-{{ section.id }} .fl-header {
    min-height: 84px;
    padding: 0 5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid var(--fl-line);
  }

  #forma-launch-{{ section.id }} .fl-logo {
    display: inline-flex;
    align-items: center;
  }

  #forma-launch-{{ section.id }} .fl-logo__image {
    display: block;
    width: {{ section.settings.logo_width }}px;
    max-width: 45vw;
    height: auto;
    object-fit: contain;
    object-position: left center;
  }

  #forma-launch-{{ section.id }} .fl-logo__fallback,
  #forma-launch-{{ section.id }} .fl-footer__brand > span {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 42px;
    font-weight: 400;
    letter-spacing: -0.045em;
  }

  #forma-launch-{{ section.id }} .fl-header__note,
  #forma-launch-{{ section.id }} .fl-eyebrow,
  #forma-launch-{{ section.id }} .fl-eyebrow-small,
  #forma-launch-{{ section.id }} .fl-hero__footer,
  #forma-launch-{{ section.id }} .fl-signup__panel-heading,
  #forma-launch-{{ section.id }} .fl-field label,
  #forma-launch-{{ section.id }} .fl-submit,
  #forma-launch-{{ section.id }} .fl-footer__contact,
  #forma-launch-{{ section.id }} .fl-footer__bottom,
  #forma-launch-{{ section.id }} .fl-password summary {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.13em;
    line-height: 1.8;
  }

  #forma-launch-{{ section.id }} .fl-header__note {
    color: var(--fl-muted);
    text-align: right;
  }

  #forma-launch-{{ section.id }} .fl-main {
    width: 100%;
    max-width: 1700px;
    padding: 0 5%;
    margin: 0 auto;
  }

  #forma-launch-{{ section.id }} .fl-hero {
    padding-top: clamp(42px, 5vw, 68px);
  }

  #forma-launch-{{ section.id }} .fl-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--fl-muted);
    margin-bottom: 27px;
  }

  #forma-launch-{{ section.id }} .fl-eyebrow__line {
    display: inline-block;
    width: 24px;
    height: 1px;
    flex: 0 0 24px;
    background: var(--fl-muted);
  }

  #forma-launch-{{ section.id }} .fl-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(30px, 6vw, 85px);
  }

  #forma-launch-{{ section.id }} .fl-hero__grid--text-only {
    grid-template-columns: minmax(0, 1fr);
  }

  #forma-launch-{{ section.id }} .fl-hero__copy h1 {
    margin: 0;
    font-size: clamp(44px, 6.1vw, 88px);
    font-weight: 400;
    line-height: 0.99;
    letter-spacing: -0.078em;
  }

  #forma-launch-{{ section.id }} .fl-hero__copy h1 span,
  #forma-launch-{{ section.id }} .fl-signup__intro h2 span {
    color: var(--fl-muted);
  }

  #forma-launch-{{ section.id }} .fl-hero__copy > p {
    max-width: 470px;
    margin: 22px 0 0;
    color: var(--fl-muted);
    font-size: 13px;
    line-height: 1.8;
  }

  #forma-launch-{{ section.id }} .fl-text-link {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    margin-top: 26px;
    padding-bottom: 9px;
    border-bottom: 1px solid var(--fl-text);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  #forma-launch-{{ section.id }} .fl-text-link svg,
  #forma-launch-{{ section.id }} .fl-submit svg,
  #forma-launch-{{ section.id }} .fl-footer__contact svg {
    width: 19px;
    height: 19px;
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }

  #forma-launch-{{ section.id }} .fl-hero__visual {
    min-width: 0;
  }

  #forma-launch-{{ section.id }} .fl-hero__image {
    display: block;
    width: 100%;
    height: clamp(250px, 31vw, 430px);
    object-fit: cover;
  }

  #forma-launch-{{ section.id }} .fl-hero__caption {
    display: block;
    margin-top: 9px;
    color: var(--fl-muted);
    font-size: 9px;
    letter-spacing: 0.1em;
  }

  #forma-launch-{{ section.id }} .fl-hero__footer {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-top: 38px;
    padding: 15px 0;
    border-top: 1px solid var(--fl-line);
    color: var(--fl-muted);
  }

  #forma-launch-{{ section.id }} .fl-hero__divider {
    display: block;
    width: 24px;
    height: 1px;
    background: var(--fl-line);
  }

  /* SIGNUP */

  #forma-launch-{{ section.id }} .fl-signup {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(35px, 7vw, 100px);
    align-items: start;
    padding: clamp(48px, 6.5vw, 86px) 0;
    border-bottom: 1px solid var(--fl-line);
  }

  #forma-launch-{{ section.id }} .fl-signup__intro .fl-eyebrow {
    margin-bottom: 22px;
  }

  #forma-launch-{{ section.id }} .fl-signup__intro h2 {
    margin: 0;
    font-size: clamp(47px, 5.5vw, 75px);
    font-weight: 400;
    line-height: 0.99;
    letter-spacing: -0.08em;
  }

  #forma-launch-{{ section.id }} .fl-signup__intro > p {
    max-width: 390px;
    margin: 20px 0 0;
    color: var(--fl-muted);
    font-size: 13px;
    line-height: 1.85;
  }

  #forma-launch-{{ section.id }} .fl-signup__launch-note {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 26px;
    color: var(--fl-muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  #forma-launch-{{ section.id }} .fl-launch-dot {
    width: 6px;
    height: 6px;
    background: var(--fl-text);
    border-radius: 50%;
    flex-shrink: 0;
  }

  #forma-launch-{{ section.id }} .fl-signup__panel {
    min-width: 0;
  }

  #forma-launch-{{ section.id }} .fl-signup__panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 15px;
    margin-bottom: 23px;
    border-bottom: 1px solid var(--fl-line);
    color: var(--fl-muted);
  }

  #forma-launch-{{ section.id }} .fl-form__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 22px;
  }

  #forma-launch-{{ section.id }} .fl-field {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  #forma-launch-{{ section.id }} .fl-field label {
    color: var(--fl-text);
  }

  #forma-launch-{{ section.id }} .fl-field label span {
    color: var(--fl-muted);
  }

  #forma-launch-{{ section.id }} .fl-field input {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 10px 0;
    border: 0;
    border-bottom: 1px solid #c9c7bf;
    border-radius: 0;
    outline: none;
    background: transparent;
    color: var(--fl-text);
    box-shadow: none;
    font: inherit;
    font-size: 13px;
    appearance: none;
    -webkit-appearance: none;
    transition: border-color 0.2s ease;
  }

  #forma-launch-{{ section.id }} .fl-field input:focus {
    border-bottom-color: var(--fl-text);
  }

  #forma-launch-{{ section.id }} .fl-field input::placeholder {
    color: #929087;
    opacity: 1;
  }

  #forma-launch-{{ section.id }} .fl-field input[type="date"] {
    color-scheme: light;
  }

  #forma-launch-{{ section.id }} .fl-field__help {
    color: var(--fl-muted);
    font-size: 10px;
    line-height: 1.5;
  }

  #forma-launch-{{ section.id }} .fl-form__consent {
    margin-top: 24px;
  }

  #forma-launch-{{ section.id }} .fl-form__consent label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--fl-muted);
    font-size: 11px;
    line-height: 1.75;
    cursor: pointer;
  }

  #forma-launch-{{ section.id }} .fl-form__consent input {
    flex: 0 0 15px;
    width: 15px;
    height: 15px;
    margin: 3px 0 0;
    accent-color: var(--fl-text);
  }

  #forma-launch-{{ section.id }} .fl-submit {
    width: 100%;
    min-height: 54px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-top: 25px;
    padding: 0 19px;
    border: 1px solid var(--fl-text);
    border-radius: 0;
    background: var(--fl-text);
    color: #fff;
    cursor: pointer;
    text-align: left;
    transition: background 0.2s ease, color 0.2s ease;
  }

  #forma-launch-{{ section.id }} .fl-submit:hover {
    background: transparent;
    color: var(--fl-text);
  }

  #forma-launch-{{ section.id }} .fl-form__privacy {
    margin: 13px 0 0;
    color: var(--fl-muted);
    font-size: 10px;
    line-height: 1.7;
  }

  #forma-launch-{{ section.id }} .fl-form__privacy a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #forma-launch-{{ section.id }} .fl-success {
    display: flex;
    gap: 15px;
    align-items: flex-start;
    padding: 25px 0;
  }

  #forma-launch-{{ section.id }} .fl-success__icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--fl-line);
    border-radius: 50%;
    flex-shrink: 0;
  }

  #forma-launch-{{ section.id }} .fl-success h3 {
    margin: 0;
    font-size: 23px;
    font-weight: 400;
    letter-spacing: -0.04em;
  }

  #forma-launch-{{ section.id }} .fl-success p {
    margin: 8px 0 0;
    color: var(--fl-muted);
    font-size: 12px;
    line-height: 1.8;
  }

  #forma-launch-{{ section.id }} .fl-error {
    margin: 0 0 18px;
    color: #873c30;
    font-size: 12px;
    line-height: 1.7;
  }

  /* COUNTDOWN */

  #forma-launch-{{ section.id }} .fl-countdown {
    padding: clamp(45px, 6vw, 75px) 0;
    border-bottom: 1px solid var(--fl-line);
  }

  #forma-launch-{{ section.id }} .fl-countdown__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 23px;
  }

  #forma-launch-{{ section.id }} .fl-eyebrow-small {
    display: block;
    color: var(--fl-muted);
  }

  #forma-launch-{{ section.id }} .fl-countdown__heading h2 {
    margin: 10px 0 0;
    font-size: clamp(30px, 3.8vw, 47px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.065em;
  }

  #forma-launch-{{ section.id }} .fl-countdown__date {
    padding-bottom: 5px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  #forma-launch-{{ section.id }} .fl-countdown__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--fl-line);
  }

  #forma-launch-{{ section.id }} .fl-countdown__item {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 13px;
    padding: clamp(18px, 3vw, 30px);
  }

  #forma-launch-{{ section.id }} .fl-countdown__item + .fl-countdown__item {
    border-left: 1px solid var(--fl-line);
  }

  #forma-launch-{{ section.id }} .fl-countdown__item > span {
    font-size: clamp(34px, 5vw, 65px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.075em;
    font-variant-numeric: tabular-nums;
  }

  #forma-launch-{{ section.id }} .fl-countdown__item small {
    color: var(--fl-muted);
    font-size: 9px;
    font-weight: 600;
