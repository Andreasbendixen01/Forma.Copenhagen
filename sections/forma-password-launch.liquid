```liquid
{% comment %}
  FORMA COPENHAGEN — THE NEXT CHAPTER
  New image-free launch design.
  Shopify form is temporary until Klaviyo integration.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    --fc-bg: #171914;
    --fc-panel: #f0f0e8;
    --fc-text: #f0f0e8;
    --fc-dark: #171914;
    --fc-muted: #a7a99e;
    --fc-line: rgba(240, 240, 232, .18);
    --fc-accent: #d6ff45;
    background: var(--fc-bg);
    color: var(--fc-text);
  }

  #shopify-section-{{ section.id }} *,
  #shopify-section-{{ section.id }} *::before,
  #shopify-section-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .fc-page {
    min-height: 100vh;
    overflow: hidden;
    background: var(--fc-bg);
    color: var(--fc-text);
    font-family: inherit;
  }

  #shopify-section-{{ section.id }} .fc-page a {
    color: inherit;
  }

  #shopify-section-{{ section.id }} .fc-shell {
    width: min(100% - 88px, 1540px);
    margin-inline: auto;
  }

  /* TOP BAR */

  #shopify-section-{{ section.id }} .fc-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 25px;
    min-height: 76px;
    border-bottom: 1px solid var(--fc-line);
  }

  #shopify-section-{{ section.id }} .fc-logo {
    margin: 0;
    color: var(--fc-text);
    font-size: 31px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -.105em;
  }

  #shopify-section-{{ section.id }} .fc-topbar-right {
    display: flex;
    align-items: center;
    gap: 23px;
  }

  #shopify-section-{{ section.id }} .fc-status {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--fc-muted);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .fc-status-dot {
    width: 7px;
    height: 7px;
    flex: 0 0 7px;
    border-radius: 50%;
    background: var(--fc-accent);
    box-shadow: 0 0 12px rgba(214, 255, 69, .3);
  }

  #shopify-section-{{ section.id }} .fc-topbar-date {
    color: var(--fc-muted);
    font-size: 9px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  /* HERO */

  #shopify-section-{{ section.id }} .fc-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(390px, .7fr);
    gap: clamp(40px, 6.5vw, 105px);
    align-items: center;
    padding: clamp(70px, 8vw, 118px) 0 90px;
  }

  #shopify-section-{{ section.id }} .fc-hero-copy {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .fc-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 35px;
    color: var(--fc-accent);
    font-size: 10px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .fc-eyebrow-index {
    color: var(--fc-muted);
  }

  #shopify-section-{{ section.id }} .fc-hero-title {
    margin: 0;
    max-width: 900px;
    font-size: clamp(70px, 10.2vw, 151px);
    font-weight: 500;
    line-height: .79;
    letter-spacing: -.105em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .fc-hero-title span {
    display: block;
  }

  #shopify-section-{{ section.id }} .fc-hero-title .fc-title-outline {
    color: transparent;
    -webkit-text-stroke: 1.2px var(--fc-text);
  }

  #shopify-section-{{ section.id }} .fc-hero-title .fc-title-accent {
    color: var(--fc-accent);
  }

  #shopify-section-{{ section.id }} .fc-hero-bottom {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 30px;
    margin-top: 48px;
    padding-top: 22px;
    border-top: 1px solid var(--fc-line);
  }

  #shopify-section-{{ section.id }} .fc-hero-description {
    max-width: 400px;
    margin: 0;
    color: var(--fc-muted);
    font-size: 14px;
    line-height: 1.85;
  }

  #shopify-section-{{ section.id }} .fc-hero-index {
    color: var(--fc-muted);
    font-size: 10px;
    line-height: 1.7;
    letter-spacing: .1em;
    text-align: right;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .fc-hero-index strong {
    display: block;
    color: var(--fc-text);
    font-size: 18px;
    font-weight: 400;
    letter-spacing: -.04em;
  }

  /* SIGNUP PANEL */

  #shopify-section-{{ section.id }} .fc-signup {
    position: relative;
    min-width: 0;
    padding: clamp(27px, 3.2vw, 46px);
    background: var(--fc-panel);
    color: var(--fc-dark);
  }

  #shopify-section-{{ section.id }} .fc-signup-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(23, 25, 20, .2);
  }

  #shopify-section-{{ section.id }} .fc-signup-label {
    margin: 0;
    font-size: 9px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .fc-signup-number {
    color: #77796f;
    font-size: 10px;
    letter-spacing: .1em;
  }

  #shopify-section-{{ section.id }} .fc-signup-title {
    max-width: 410px;
    margin: 29px 0 0;
    font-size: clamp(36px, 4vw, 53px);
    font-weight: 500;
    line-height: .98;
    letter-spacing: -.075em;
  }

  #shopify-section-{{ section.id }} .fc-signup-title em {
    color: #74766d;
    font-style: normal;
  }

  #shopify-section-{{ section.id }} .fc-signup-description {
    max-width: 360px;
    margin: 16px 0 30px;
    color: #686a61;
    font-size: 12px;
    line-height: 1.8;
  }

  #shopify-section-{{ section.id }} .fc-form {
    display: grid;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .fc-field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 17px;
  }

  #shopify-section-{{ section.id }} .fc-field {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .fc-label {
    font-size: 10px;
    font-weight: 600;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .fc-input {
    width: 100%;
    min-width: 0;
    min-height: 45px;
    margin: 0;
    padding: 11px 0;
    border: 0;
    border-bottom: 1px solid rgba(23, 25, 20, .3);
    border-radius: 0;
    outline: none;
    background: transparent;
    color: var(--fc-dark);
    font-family: inherit;
    font-size: 13px;
    line-height: 1.5;
    box-shadow: none;
    appearance: none;
    -webkit-appearance: none;
    transition: border-color .18s ease;
  }

  #shopify-section-{{ section.id }} .fc-input::placeholder {
    color: #92938a;
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .fc-input:focus {
    border-bottom-color: var(--fc-dark);
  }

  #shopify-section-{{ section.id }} .fc-input:focus-visible {
    outline: 2px solid var(--fc-dark);
    outline-offset: 4px;
  }

  #shopify-section-{{ section.id }} .fc-input::-webkit-calendar-picker-indicator {
    cursor: pointer;
    opacity: .65;
  }

  #shopify-section-{{ section.id }} .fc-consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: #686a61;
    font-size: 10px;
    line-height: 1.75;
  }

  #shopify-section-{{ section.id }} .fc-consent input {
    width: 15px;
    height: 15px;
    flex: 0 0 15px;
    margin: 3px 0 0;
    accent-color: var(--fc-dark);
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .fc-consent a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .fc-submit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    min-height: 58px;
    margin-top: 2px;
    padding: 16px 18px;
    border: 1px solid var(--fc-dark);
    border-radius: 0;
    background: var(--fc-dark);
    color: var(--fc-panel);
    font-family: inherit;
    font-size: 10px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: .12em;
    text-align: left;
    text-transform: uppercase;
    cursor: pointer;
    transition: background .2s ease, color .2s ease;
  }

  #shopify-section-{{ section.id }} .fc-submit:hover {
    background: var(--fc-accent);
    color: var(--fc-dark);
    border-color: var(--fc-accent);
  }

  #shopify-section-{{ section.id }} .fc-submit:focus-visible {
    outline: 2px solid var(--fc-dark);
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .fc-submit svg {
    width: 19px;
    height: 19px;
    flex: 0 0 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  #shopify-section-{{ section.id }} .fc-form-note {
    margin: -9px 0 0;
    color: #77796f;
    font-size: 9px;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .fc-message {
    padding: 13px 14px;
    border: 1px solid rgba(23, 25, 20, .25);
    font-size: 12px;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .fc-message--error {
    border-color: #a63e32;
  }

  /* TYPOGRAPHIC STRIP */

  #shopify-section-{{ section.id }} .fc-strip {
    overflow: hidden;
    border-top: 1px solid var(--fc-line);
    border-bottom: 1px solid var(--fc-line);
  }

  #shopify-section-{{ section.id }} .fc-strip-track {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    width: 100%;
    min-height: 91px;
    padding: 18px 0;
  }

  #shopify-section-{{ section.id }} .fc-strip-item {
    display: flex;
    align-items: center;
    gap: 15px;
    flex: 0 0 auto;
    color: var(--fc-text);
    font-size: clamp(16px, 2vw, 24px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -.055em;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .fc-strip-star {
    color: var(--fc-accent);
    font-size: 20px;
    line-height: 1;
  }

  /* BRAND STATEMENT */

  #shopify-section-{{ section.id }} .fc-about {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1fr);
    gap: clamp(50px, 10vw, 150px);
    padding: clamp(90px, 12vw, 165px) 0;
  }

  #shopify-section-{{ section.id }} .fc-about-label {
    margin: 0 0 27px;
    color: var(--fc-accent);
    font-size: 10px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .fc-about-heading {
    max-width: 650px;
    margin: 0;
    font-size: clamp(44px, 6vw, 82px);
    font-weight: 400;
    line-height: .93;
    letter-spacing: -.085em;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .fc-about-heading span {
    color: var(--fc-muted);
  }

  #shopify-section-{{ section.id }} .fc-about-copy {
    max-width: 480px;
    margin: 6px 0 0;
    color: var(--fc-muted);
    font-size: 13px;
    line-height: 2;
  }

  #shopify-section-{{ section.id }} .fc-about-copy strong {
    color: var(--fc-text);
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .fc-values {
    margin-top: 36px;
    border-top: 1px solid var(--fc-line);
  }

  #shopify-section-{{ section.id }} .fc-value {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--fc-line);
  }

  #shopify-section-{{ section.id }} .fc-value-index {
    padding-top: 3px;
    color: var(--fc-accent);
    font-size: 10px;
    letter-spacing: .1em;
  }

  #shopify-section-{{ section.id }} .fc-value-title {
    margin: 0;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -.035em;
  }

  #shopify-section-{{ section.id }} .fc-value-copy {
    margin: 7px 0 0;
    color: var(--fc-muted);
    font-size: 11px;
    line-height: 1.8;
  }

  /* CATEGORIES */

  #shopify-section-{{ section.id }} .fc-universe {
    padding: 28px 0 34px;
    border-top: 1px solid var(--fc-line);
  }

  #shopify-section-{{ section.id }} .fc-universe-label {
    margin: 0 0 20px;
    color: var(--fc-muted);
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .fc-category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  #shopify-section-{{ section.id }} .fc-category {
    padding: 10px 14px;
    border: 1px solid var(--fc-line);
    color: var(--fc-text);
    font-size: 10px;
    line-height: 1.4;
    transition: color .2s ease, background .2s ease, border-color .2s ease;
  }

  #shopify-section-{{ section.id }} .fc-category:hover {
    border-color: var(--fc-accent);
    background: var(--fc-accent);
    color: var(--fc-dark);
  }

  /* COUNTDOWN */

  #shopify-section-{{ section.id }} .fc-countdown {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    padding: 34px 0;
    border-top: 1px solid var(--fc-line);
  }

  #shopify-section-{{ section.id }} .fc-countdown-heading {
    margin: 0;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -.04em;
  }

  #shopify-section-{{ section.id }} .fc-countdown-note {
    margin: 7px 0 0;
    color: var(--fc-muted);
    font-size: 10px;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .fc-timer {
    display: flex;
    gap: clamp(20px, 4vw, 50px);
  }

  #shopify-section-{{ section.id }} .fc-time-unit {
    min-width: 40px;
  }

  #shopify-section-{{ section.id }} .fc-time-number {
    display: block;
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -.07em;
    font-variant-numeric: tabular-nums;
  }

  #shopify-section-{{ section.id }} .fc-time-label {
    display: block;
    margin-top: 9px;
    color: var(--fc-muted);
    font-size: 8px;
    line-height: 1.5;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  /* FOOTER */

  #shopify-section-{{ section.id }} .fc-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    padding: 27px 0 32px;
    border-top: 1px solid var(--fc-line);
  }

  #shopify-section-{{ section.id }} .fc-footer-mark {
    margin: 0;
    color: var(--fc-text);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: -.04em;
  }

  #shopify-section-{{ section.id }} .fc-footer-copy {
    margin: 0;
    color: var(--fc-muted);
    font-size: 9px;
    line-height: 1.8;
    text-align: right;
  }

  #shopify-section-{{ section.id }} .fc-footer-copy a {
    text-underline-offset: 3px;
  }

  /* RESPONSIVE */

  @media screen and (max-width: 1000px) {
    #shopify-section-{{ section.id }} .fc-shell {
      width: calc(100% - 56px);
    }

    #shopify-section-{{ section.id }} .fc-hero {
      grid-template-columns: minmax(0, 1fr) minmax(310px, .72fr);
      gap: 35px;
    }

    #shopify-section-{{ section.id }} .fc-hero-title {
      font-size: clamp(66px, 9.5vw, 100px);
    }

    #shopify-section-{{ section.id }} .fc-signup {
      padding: 25px;
    }

    #shopify-section-{{ section.id }} .fc-about {
      gap: 55px;
    }

    #shopify-section-{{ section.id }} .fc-strip-track {
      justify-content: flex-start;
      overflow: hidden;
    }
  }

  @media screen and (max-width: 700px) {
    #shopify-section-{{ section.id }} .fc-shell {
      width: calc(100% - 36px);
    }

    #shopify-section-{{ section.id }} .fc-topbar {
      min-height: 67px;
    }

    #shopify-section-{{ section.id }} .fc-logo {
      font-size: 27px;
    }

    #shopify-section-{{ section.id }} .fc-topbar-right {
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .fc-status {
      font-size: 8px;
      letter-spacing: .08em;
    }

    #shopify-section-{{ section.id }} .fc-topbar-date {
      display: none;
    }

    #shopify-section-{{ section.id }} .fc-hero {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 43px;
      padding: 67px 0 52px;
    }

    #shopify-section-{{ section.id }} .fc-eyebrow {
      margin-bottom: 29px;
      font-size: 9px;
    }

    #shopify-section-{{ section.id }} .fc-hero-title {
      font-size: clamp(61px, 13.8vw, 96px);
      line-height: .82;
    }

    #shopify-section-{{ section.id }} .fc-hero-bottom {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 15px;
      margin-top: 31px;
      padding-top: 17px;
    }

    #shopify-section-{{ section.id }} .fc-hero-description {
      font-size: 12px;
      line-height: 1.85;
    }

    #shopify-section-{{ section.id }} .fc-hero-index {
      font-size: 8px;
    }

    #shopify-section-{{ section.id }} .fc-hero-index strong {
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .fc-signup {
      padding: 25px 21px;
    }

    #shopify-section-{{ section.id }} .fc-signup-title {
      font-size: clamp(39px, 10vw, 53px);
    }

    #shopify-section-{{ section.id }} .fc-signup-description {
      margin-bottom: 25px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .fc-form {
      gap: 19px;
    }

    #shopify-section-{{ section.id }} .fc-field-row {
      gap: 13px;
    }

    #shopify-section-{{ section.id }} .fc-input {
      min-height: 45px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .fc-strip-track {
      min-height: 71px;
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .fc-strip-item {
      font-size: 17px;
    }

    #shopify-section-{{ section.id }} .fc-about {
      grid-template-columns: 1fr;
      gap: 35px;
      padding: 75px 0;
    }

    #shopify-section-{{ section.id }} .fc-about-heading {
      font-size: clamp(47px, 11vw, 67px);
    }

    #shopify-section-{{ section.id }} .fc-about-copy {
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .fc-values {
      margin-top: 25px;
    }

    #shopify-section-{{ section.id }} .fc-value {
      padding: 20px 0;
    }

    #shopify-section-{{ section.id }} .fc-universe {
      padding: 25px 0;
    }

    #shopify-section-{{ section.id }} .fc-category-list {
      gap: 8px;
    }

    #shopify-section-{{ section.id }} .fc-category {
      padding: 9px 11px;
      font-size: 9px;
    }

    #shopify-section-{{ section.id }} .fc-countdown {
      flex-direction: column;
      align-items: flex-start;
      gap: 25px;
      padding: 28px 0;
    }

    #shopify-section-{{ section.id }} .fc-timer {
      width: 100%;
      justify-content: space-between;
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .fc-time-unit {
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .fc-time-number {
      font-size: 30px;
    }

    #shopify-section-{{ section.id }} .fc-time-label {
      font-size: 7px;
    }

    #shopify-section-{{ section.id }} .fc-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
      padding: 22px 0 26px;
    }

    #shopify-section-{{ section.id }} .fc-footer-copy {
      text-align: left;
    }
  }

  @media screen and (max-width: 380px) {
    #shopify-section-{{ section.id }} .fc-shell {
      width: calc(100% - 28px);
    }

    #shopify-section-{{ section.id }} .fc-hero-title {
      font-size: 58px;
    }

    #shopify-section-{{ section.id }} .fc-signup {
      padding: 22px 16px;
    }

    #shopify-section-{{ section.id }} .fc-field-row {
      grid-template-columns: 1fr;
      gap: 19px;
    }

    #shopify-section-{{ section.id }} .fc-time-number {
      font-size: 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} *,
    #shopify-section-{{ section.id }} *::before,
    #shopify-section-{{ section.id }} *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

