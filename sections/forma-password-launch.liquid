    justify-content: space-between;
    gap: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--forma-line);
    color: var(--forma-muted);
    margin-bottom: 35px;
  }

  #forma-launch-{{ section.id }} .forma-launch__label {
    display: block;
    margin-bottom: 13px;
  }

  #forma-launch-{{ section.id }} .forma-launch__input-row {
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid var(--forma-ink);
  }

  #forma-launch-{{ section.id }} .forma-launch__email {
    min-width: 0;
    flex: 1;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    outline-offset: 4px;
    padding: 20px 10px 20px 0;
    color: var(--forma-ink);
    font: inherit;
    font-size: 14px;
    appearance: none;
  }

  #forma-launch-{{ section.id }} .forma-launch__email::placeholder {
    color: #98968e;
    opacity: 1;
  }

  #forma-launch-{{ section.id }} .forma-launch__submit {
    flex-shrink: 0;
    border: 0;
    background: var(--forma-ink);
    color: white;
    min-width: 165px;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    cursor: pointer;
    font: inherit;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    transition: background 0.25s ease;
  }

  #forma-launch-{{ section.id }} .forma-launch__submit:hover {
    background: #484741;
  }

  #forma-launch-{{ section.id }} .forma-launch__submit-arrow {
    font-size: 22px;
    font-weight: 400;
    transition: transform 0.25s ease;
  }

  #forma-launch-{{ section.id }} .forma-launch__submit:hover .forma-launch__submit-arrow {
    transform: translate(3px, -3px);
  }

  #forma-launch-{{ section.id }} .forma-launch__consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: 24px;
    color: var(--forma-muted);
    font-size: 12px;
    line-height: 1.7;
    cursor: pointer;
  }

  #forma-launch-{{ section.id }} .forma-launch__consent input {
    margin: 3px 0 0;
    accent-color: var(--forma-ink);
    flex-shrink: 0;
  }

  #forma-launch-{{ section.id }} .forma-launch__form-note {
    color: var(--forma-muted);
    font-size: 11px;
    line-height: 1.7;
    margin-top: 17px;
  }

  #forma-launch-{{ section.id }} .forma-launch__form-note a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #forma-launch-{{ section.id }} .forma-launch__success {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    padding: 30px;
    border: 1px solid var(--forma-line);
  }

  #forma-launch-{{ section.id }} .forma-launch__success-mark {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border: 1px solid var(--forma-line);
    border-radius: 50%;
    flex-shrink: 0;
  }

  #forma-launch-{{ section.id }} .forma-launch__success strong {
    font-size: 20px;
    font-weight: 400;
  }

  #forma-launch-{{ section.id }} .forma-launch__success p {
    color: var(--forma-muted);
    font-size: 13px;
    line-height: 1.8;
    margin: 10px 0 0;
  }

  #forma-launch-{{ section.id }} .forma-launch__error {
    padding: 15px;
    margin-bottom: 20px;
    border: 1px solid #b36a5c;
    color: #873c30;
    font-size: 13px;
  }

  #forma-launch-{{ section.id }} .forma-launch__manifesto {
    padding: clamp(60px, 8vw, 100px) 0;
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    gap: 30px;
    align-items: start;
  }

  #forma-launch-{{ section.id }} .forma-launch__manifesto > p {
    font-size: clamp(27px, 4vw, 48px);
    line-height: 1.2;
    letter-spacing: -0.06em;
    margin: 0;
  }

  #forma-launch-{{ section.id }} .forma-launch__manifesto > p span {
    color: var(--forma-muted);
  }

  #forma-launch-{{ section.id }} .forma-launch__manifesto-index {
    color: var(--forma-muted);
    text-align: right;
  }

  #forma-launch-{{ section.id }} .forma-launch__footer {
    border-top: 1px solid var(--forma-line);
    padding: 30px 5.2%;
    display: grid;
    grid-template-columns: 1fr 1.5fr 1fr auto;
    align-items: center;
    gap: 25px;
  }

  #forma-launch-{{ section.id }} .forma-launch__footer-logo {
