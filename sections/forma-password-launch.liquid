      "id": "launch_date",
      "label": "Launch date and time",
      "default": "2026-12-01T00:00:00+01:00",
      "info": "Format: YYYY-MM-DDTHH:MM:SS+01:00"
    }
  ],
  "presets": [
    {
      "name": "FORMA Launch"
    }
  ]
}
{% endschema %}
