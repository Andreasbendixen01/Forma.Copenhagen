{% comment %}
  FORMA COPENHAGEN — PASSWORD / PRE-LAUNCH EXPERIENCE
  Replace the contents of sections/main-password.liquid with this file.
{% endcomment %}

<section id="forma-password-{{ section.id }}" class="forma-launch">

  <div class="forma-launch__grain"></div>

  <!-- ANNOUNCEMENT -->
  <div class="forma-launch__announcement">
    <span>AN INDEPENDENT WORLD OF DISCOVERY</span>
    <span class="forma-launch__announcement-right">
      COPENHAGEN · EUROPE
    </span>
  </div>

  <!-- HEADER -->
  <header class="forma-launch__header">
    <a href="/" class="forma-launch__wordmark" aria-label="Forma Copenhagen">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 500
          | image_tag:
            class: 'forma-launch__logo-image',
            widths: '180, 260, 360, 500',
            loading: 'eager',
            alt: 'FORMA Copenhagen'
        }}
      {% else %}
        <span>FORMA</span>
      {% endif %}
    </a>

    <span class="forma-launch__header-note">
      A NEW PERSPECTIVE ON LIFESTYLE
    </span>

    <a href="#forma-signup-{{ section.id }}" class="forma-launch__header-link">
      GET EARLY ACCESS <span>↗</span>
    </a>
  </header>

  <!-- HERO -->
  <main>
    <section class="forma-launch__hero">

      <div class="forma-launch__hero-copy">
        <div class="forma-launch__eyebrow">
          <span class="forma-launch__eyebrow-dot"></span>
          SOMETHING NEW IS TAKING SHAPE
        </div>

        <h1>
          A more<br>
          considered<br>
          <span>way to discover.</span>
        </h1>

        <p class="forma-launch__hero-description">
          Fashion, places, people and ideas worth knowing.
          One considered world of brands and experiences,
          brought together by FORMA.
        </p>

        <div class="forma-launch__hero-actions">
          <a href="#forma-signup-{{ section.id }}" class="forma-launch__button">
            DISCOVER FORMA
            <span>↗</span>
          </a>
          <span class="forma-launch__microcopy">
            Be part of it from the beginning.
          </span>
        </div>

        <div class="forma-launch__hero-footnote">
          <span>01 / A DIFFERENT WAY TO DISCOVER</span>
          <span>SCROLL TO EXPLORE ↓</span>
        </div>
      </div>

      <div class="forma-launch__hero-visual">
        {% if section.settings.hero_image != blank %}
          {{
            section.settings.hero_image
            | image_url: width: 1800
            | image_tag:
              class: 'forma-launch__hero-image',
              widths: '600, 900, 1200, 1600, 1800',
              sizes: '(min-width: 900px) 52vw, 100vw',
              loading: 'eager',
              alt: section.settings.hero_image.alt
          }}
        {% else %}
          <div class="forma-launch__hero-placeholder">
            <span class="forma-launch__placeholder-top">THE ART OF FINDING</span>
            <span class="forma-launch__placeholder-word">YOUR<br>FORM.</span>
            <span class="forma-launch__placeholder-bottom">OBJECTS · PLACES · PEOPLE</span>
          </div>
        {% endif %}

        <div class="forma-launch__image-caption">
          <span>THE WORLD, MORE THOUGHTFULLY CURATED.</span>
          <span>CPH / 001</span>
        </div>

        <div class="forma-launch__floating-note">
          <span class="forma-launch__floating-index">F.</span>
          <span>
            <strong>Find your point of view.</strong>
            <small>Explore what moves you.</small>
          </span>
        </div>
      </div>

    </section>

    <!-- EDITORIAL INTRO -->
    <section class="forma-launch__manifesto">
      <div class="forma-launch__manifesto-label">
        <span>INTRODUCING FORMA</span>
        <span>EST. COPENHAGEN</span>
      </div>

      <div class="forma-launch__manifesto-content">
        <h2>
          Not more things.<br>
          <span>More things that mean something.</span>
        </h2>

        <p>
          The best discoveries rarely happen when you are looking for
          everything. They happen when someone brings the right things
          together. FORMA is being built around that idea — connecting
          independent brands, considered products, inspiring places
          and the people behind them.
        </p>
      </div>
    </section>

    <!-- DISCOVERY GRID -->
    <section class="forma-launch__discovery">

      <div class="forma-launch__section-heading">
        <div>
          <span class="forma-launch__eyebrow">A WORLD TO EXPLORE</span>
          <h2>Find your kind of <em>forma.</em></h2>
        </div>
        <span class="forma-launch__section-number">02 — THE DISCOVERY</span>
      </div>

      <div class="forma-launch__discovery-grid">

        <a href="#forma-signup-{{ section.id }}" class="forma-launch__discovery-card forma-launch__discovery-card--large">
          <div class="forma-launch__discovery-image">
            {% if section.settings.discovery_image != blank %}
              {{
                section.settings.discovery_image
                | image_url: width: 1200
                | image_tag:
                  widths: '400, 700, 1000, 1200',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: section.settings.discovery_image.alt
              }}
            {% else %}
              <div class="forma-launch__visual-fallback forma-launch__visual-fallback--fashion">
                <span>THE EVERYDAY<br>EXTRAORDINARY</span>
                <strong>WARDROBE</strong>
              </div>
            {% endif %}
            <span class="forma-launch__card-index">01</span>
          </div>
          <div class="forma-launch__card-caption">
            <div>
              <h3>Wardrobe</h3>
              <p>Fashion, accessories and personal style.</p>
            </div>
            <span class="forma-launch__round-arrow">↗</span>
          </div>
        </a>

        <a href="#forma-signup-{{ section.id }}" class="forma-launch__discovery-card">
          <div class="forma-launch__discovery-image">
            {% if section.settings.home_image != blank %}
              {{
                section.settings.home_image
                | image_url: width: 1000
                | image_tag:
                  widths: '350, 600, 800, 1000',
                  sizes: '(min-width: 750px) 33vw, 100vw',
                  loading: 'lazy',
                  alt: section.settings.home_image.alt
              }}
            {% else %}
              <div class="forma-launch__visual-fallback forma-launch__visual-fallback--home">
                <span>SPACE TO<br>LIVE WELL</span>
                <strong>THE HOME</strong>
              </div>
            {% endif %}
            <span class="forma-launch__card-index">02</span>
          </div>
          <div class="forma-launch__card-caption">
            <div>
              <h3>The Home</h3>
              <p>Objects, interiors and considered living.</p>
            </div>
            <span class="forma-launch__round-arrow">↗</span>
          </div>
        </a>

        <a href="#forma-signup-{{ section.id }}" class="forma-launch__discovery-card">
          <div class="forma-launch__discovery-image">
            {% if section.settings.lifestyle_image != blank %}
              {{
                section.settings.lifestyle_image
                | image_url: width: 1000
                | image_tag:
                  widths: '350, 600, 800, 1000',
                  sizes: '(min-width: 750px) 33vw, 100vw',
                  loading: 'lazy',
                  alt: section.settings.lifestyle_image.alt
              }}
            {% else %}
              <div class="forma-launch__visual-fallback forma-launch__visual-fallback--lifestyle">
                <span>THE WAY<br>WE LIVE</span>
                <strong>LIFESTYLE</strong>
              </div>
            {% endif %}
            <span class="forma-launch__card-index">03</span>
          </div>
          <div class="forma-launch__card-caption">
            <div>
              <h3>The Lifestyle</h3>
              <p>Grooming, culture and everyday rituals.</p>
            </div>
            <span class="forma-launch__round-arrow">↗</span>
          </div>
        </a>

      </div>

      <div class="forma-launch__category-strip">
        <span>ALSO ON OUR RADAR</span>
        <span>The Form</span>
        <span>Brands</span>
        <span>Hotels & Stays</span>
        <span>Cafés & Restaurants</span>
        <span>Cities & Experiences</span>
      </div>
    </section>

    <!-- YOUR FORMA -->
    <section class="forma-launch__personal">

      <div class="forma-launch__personal-visual">
        {% if section.settings.your_forma_image != blank %}
          {{
            section.settings.your_forma_image
            | image_url: width: 1400
            | image_tag:
              widths: '500, 800, 1100, 1400',
              sizes: '(min-width: 900px) 50vw, 100vw',
              loading: 'lazy',
              alt: section.settings.your_forma_image.alt
          }}
        {% else %}
          <div class="forma-launch__personal-placeholder">
            <div class="forma-launch__profile-window">
              <div class="forma-launch__profile-top">
                <span>YOUR FORMA</span>
                <span>PERSONAL SPACE / 001</span>
              </div>
              <div class="forma-launch__profile-title">A world<br>of your own.</div>
              <div class="forma-launch__profile-line"></div>
              <div class="forma-launch__profile-items">
                <span>01&nbsp; SAVED PRODUCTS</span>
                <span>02&nbsp; FOLLOWED BRANDS</span>
                <span>03&nbsp; YOUR DISCOVERIES</span>
              </div>
            </div>
          </div>
        {% endif %}
      </div>

      <div class="forma-launch__personal-copy">
        <span class="forma-launch__eyebrow">YOUR SPACE. YOUR TASTE.</span>
        <h2>Make it<br><em>your forma.</em></h2>
        <p>
          A discovery platform should feel personal. Save the products
          you love, follow the brands that speak to you and keep the
          discoveries you want to come back to in one place.
        </p>

        <ul class="forma-launch__feature-list">
          <li><span>01</span><div><strong>Your saved finds</strong><small>Keep your favourite discoveries close.</small></div></li>
          <li><span>02</span><div><strong>Your brands</strong><small>Follow the names you want to know better.</small></div></li>
          <li><span>03</span><div><strong>Your point of view</strong><small>Build a world around what you love.</small></div></li>
        </ul>

        <a href="#forma-signup-{{ section.id }}" class="forma-launch__text-link">
          BE THERE FROM THE BEGINNING <span>↗</span>
        </a>
      </div>

    </section>

    <!-- PLACES -->
    <section class="forma-launch__places">

      <div class="forma-launch__places-copy">
        <span class="forma-launch__eyebrow">BEYOND THE PRODUCT</span>
        <h2>Good taste<br>has <em>no borders.</em></h2>
        <p>
          The next great find might be a label you have never heard of,
          a small hotel in a city you love, or a café worth crossing
          town for. FORMA connects products with the places, people
          and stories that give them meaning.
        </p>
        <a href="#forma-signup-{{ section.id }}" class="forma-launch__text-link">
          DISCOVER WHAT'S OUT THERE <span>↗</span>
        </a>
      </div>

      <div class="forma-launch__places-visual">
        {% if section.settings.city_image != blank %}
          {{
            section.settings.city_image
            | image_url: width: 1500
            | image_tag:
              widths: '500, 800, 1100, 1500',
              sizes: '(min-width: 900px) 55vw, 100vw',
              loading: 'lazy',
              alt: section.settings.city_image.alt
          }}
        {% else %}
          <div class="forma-launch__city-placeholder">
            <span class="forma-launch__city-label">A CITY IS NEVER JUST A CITY.</span>
            <span class="forma-launch__city-word">EXPLORE<br>FURTHER.</span>
            <span class="forma-launch__city-coordinates">55°40' N / 12°34' E</span>
          </div>
        {% endif %}
        <div class="forma-launch__city-caption">
          <span>PLACES TO GO. PEOPLE TO KNOW.</span>
          <span>THE CITY EDIT</span>
        </div>
      </div>

    </section>

    <!-- JOURNAL -->
    <section class="forma-launch__journal">
      <div class="forma-launch__section-heading">
        <div>
          <span class="forma-launch__eyebrow">THE STORIES BEHIND THE FINDS</span>
          <h2>More than a <em>product page.</em></h2>
        </div>
        <span class="forma-launch__section-number">03 — THE JOURNAL</span>
      </div>

      <div class="forma-launch__journal-grid">

        <div class="forma-launch__journal-image">
          {% if section.settings.journal_image != blank %}
            {{
              section.settings.journal_image
              | image_url: width: 1400
              | image_tag:
                widths: '450, 750, 1000, 1400',
                sizes: '(min-width: 750px) 58vw, 100vw',
                loading: 'lazy',
                alt: section.settings.journal_image.alt
            }}
          {% else %}
            <div class="forma-launch__journal-placeholder">
              <span>FORMA JOURNAL</span>
              <strong>Stories<br>worth<br>sharing.</strong>
              <small>PEOPLE · PLACES · PERSPECTIVES</small>
            </div>
          {% endif %}
        </div>

        <div class="forma-launch__journal-copy">
          <span class="forma-launch__journal-number">F / JOURNAL</span>
          <h3>Discover the story.<br>Find your next favourite.</h3>
          <p>
            Meet the people behind the brands. Explore new places.
            Get closer to the ideas, details and perspectives that
            make everyday life more interesting.
          </p>
          <div class="forma-launch__journal-tags">
            <span>Brand stories</span>
            <span>City guides</span>
            <span>Interviews</span>
            <span>Curated edits</span>
          </div>
          <a href="#forma-signup-{{ section.id }}" class="forma-launch__text-link">
            GET THE FIRST EDITION <span>↗</span>
          </a>
        </div>

      </div>
    </section>

    <!-- SIGNUP -->
    <section id="forma-signup-{{ section.id }}" class="forma-launch__signup">

      <div class="forma-launch__signup-top">
        <span class="forma-launch__eyebrow">YOUR INVITATION STARTS HERE</span>
        <span class="forma-launch__section-number">04 — FIRST ACCESS</span>
      </div>

      <div class="forma-launch__signup-layout">

        <div class="forma-launch__signup-copy">
          <h2>Be first.<br><em>Find your forma.</em></h2>
          <p>
            Get a first look at the brands, places and stories shaping
            FORMA. Join our early-access list and be part of the
            journey from day one.
          </p>

          <div class="forma-launch__signup-benefits">
            <div><span>01</span><p>First to discover new brands and edits.</p></div>
            <div><span>02</span><p>Invitations to selected stories and experiences.</p></div>
            <div><span>03</span><p>A closer look at the world of FORMA.</p></div>
          </div>

          <div class="forma-launch__countdown-wrap">
            <span class="forma-launch__countdown-label">THE COUNTDOWN TO FORMA</span>
            <div class="forma-launch__countdown" data-launch-countdown>
              <div><strong data-days>--</strong><small>DAYS</small></div>
              <span>:</span>
              <div><strong data-hours>--</strong><small>HRS</small></div>
              <span>:</span>
              <div><strong data-minutes>--</strong><small>MIN</small></div>
              <span>:</span>
              <div><strong data-seconds>--</strong><small>SEC</small></div>
            </div>
          </div>
        </div>

        <div class="forma-launch__signup-card">
          <div class="forma-launch__signup-card-top">
            <span class="forma-launch__signup-mark">F.</span>
            <span>THE EARLY ACCESS LIST</span>
          </div>

          {% form 'customer', id: 'FormaPrelaunchForm', class: 'forma-launch__form' %}

            <input type="hidden" name="contact[tags]" value="newsletter, forma-prelaunch">

            {% if form.posted_successfully? %}
              <div class="forma-launch__success" role="status">
                <span class="forma-launch__success-mark">✓</span>
                <h3>You're on the list.</h3>
                <p>Thank you for joining us. Keep an eye on your inbox for what's next.</p>
              </div>
            {% else %}

              {% if form.errors %}
                <div class="forma-launch__errors" role="alert">
                  {{ form.errors | default_errors }}
                </div>
              {% endif %}

              <div class="forma-launch__form-intro">
                <h3>Come on in.</h3>
                <p>A considered inbox starts here.</p>
              </div>

              <div class="forma-launch__field">
                <label for="FormaFirstName-{{ section.id }}">FIRST NAME</label>
                <input
                  id="FormaFirstName-{{ section.id }}"
                  type="text"
                  name="contact[first_name]"
                  autocomplete="given-name"
                  placeholder="Your first name"
                >
              </div>

              <div class="forma-launch__field">
                <label for="FormaEmail-{{ section.id }}">EMAIL ADDRESS <span>*</span></label>
                <input
                  id="FormaEmail-{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  autocomplete="email"
                  placeholder="you@example.com"
                  autocorrect="off"
                  autocapitalize="off"
                  required
                >
              </div>

              <div class="forma-launch__field">
                <label for="FormaBirthday-{{ section.id }}">BIRTHDAY <span class="forma-launch__optional">(OPTIONAL)</span></label>
                <input
                  id="FormaBirthday-{{ section.id }}"
                  type="date"
                  name="contact[birthday]"
                  autocomplete="bday"
                >
              </div>

              <label class="forma-launch__consent" for="FormaConsent-{{ section.id }}">
                <input
                  id="FormaConsent-{{ section.id }}"
                  type="checkbox"
                  name="contact[accepts_marketing]"
                  value="true"
                  required
                >
                <span>
                  I agree to receive emails from FORMA about new discoveries,
                  stories and selected experiences. I can unsubscribe at any time.
                </span>
              </label>

              <button type="submit" class="forma-launch__submit">
                <span>GET EARLY ACCESS</span>
                <span class="forma-launch__submit-arrow">↗</span>
              </button>

              <p class="forma-launch__privacy">
                By signing up, you agree to our
                <a href="/policies/privacy-policy">Privacy Policy</a>.
              </p>

            {% endif %}

          {% endform %}

          <div class="forma-launch__signup-card-footer">
            <span>CONSIDERED DISCOVERY. NOTHING MORE.</span>
            <span>FORMA COPENHAGEN © 2026</span>
          </div>
        </div>

      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="forma-launch__footer">
    <a href="/" class="forma-launch__footer-wordmark">FORMA</a>
    <p>A considered world of brands, places and ideas.</p>
    <div class="forma-launch__footer-bottom">
      <span>COPENHAGEN, DENMARK</span>
      <span>BUILT AROUND DISCOVERY.</span>
      <a href="mailto:{{ section.settings.contact_email | escape }}">
        {{ section.settings.contact_email | escape }}
      </a>
    </div>
  </footer>

</section>

<style>
  #forma-password-{{ section.id }} {
    --forma-ink: #20201e;
    --forma-paper: #f7f6f2;
    --forma-muted: #77756e;
    --forma-line: rgba(32,32,30,.16);
    --forma-white: #fffefa;
    position: relative;
    overflow: hidden;
    background: var(--forma-paper);
    color: var(--forma-ink);
    font-family: inherit;
    isolation: isolate;
  }

  #forma-password-{{ section.id }} *,
  #forma-password-{{ section.id }} *::before,
  #forma-password-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #forma-password-{{ section.id }} a {
    color: inherit;
    text-decoration: none;
  }

  #forma-password-{{ section.id }} img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #forma-password-{{ section.id }} .forma-launch__grain {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: .13;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.12'/%3E%3C/svg%3E");
  }

  #forma-password-{{ section.id }} .forma-launch__announcement {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 5.2%;
    background: var(--forma-ink);
    color: #f7f6f2;
    font-size: 9px;
    letter-spacing: .15em;
    line-height: 1.5;
  }

  #forma-password-{{ section.id }} .forma-launch__header {
    min-height: 86px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    padding: 20px 5.2%;
    border-bottom: 1px solid var(--forma-line);
  }

  #forma-password-{{ section.id }} .forma-launch__wordmark,
  #forma-password-{{ section.id }} .forma-launch__footer-wordmark {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    font-size: 35px;
    line-height: .9;
    font-weight: 500;
    letter-spacing: -.085em;
  }

  #forma-password-{{ section.id }} .forma-launch__logo-image {
    width: auto;
    max-width: 190px;
    max-height: 42px;
    object-fit: contain;
  }

  #forma-password-{{ section.id }} .forma-launch__header-note {
    text-align: center;
    font-size: 9px;
    letter-spacing: .13em;
    color: var(--forma-muted);
  }

  #forma-password-{{ section.id }} .forma-launch__header-link {
    justify-self: end;
    display: inline-flex;
    gap: 16px;
    align-items: center;
    font-size: 9px;
    letter-spacing: .11em;
    border-bottom: 1px solid var(--forma-ink);
    padding: 0 0 7px;
  }

  #forma-password-{{ section.id }} .forma-launch__header-link span,
  #forma-password-{{ section.id }} .forma-launch__button span,
  #forma-password-{{ section.id }} .forma-launch__text-link span {
    font-size: 15px;
    transition: transform .25s ease;
  }

  #forma-password-{{ section.id }} .forma-launch__header-link:hover span,
  #forma-password-{{ section.id }} .forma-launch__button:hover span,
  #forma-password-{{ section.id }} .forma-launch__text-link:hover span {
    transform: translate(3px,-3px);
  }

  #forma-password-{{ section.id }} .forma-launch__hero {
    display: grid;
    grid-template-columns: minmax(0, .94fr) minmax(0, 1.06fr);
    min-height: min(740px, calc(100vh - 120px));
    padding: 36px 5.2% 44px;
    gap: 5%;
    align-items: stretch;
  }

  #forma-password-{{ section.id }} .forma-launch__hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(28px, 5vw, 84px) 0 0;
    min-width: 0;
  }

  #forma-password-{{ section.id }} .forma-launch__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  #forma-password-{{ section.id }} .forma-launch__eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex: 0 0 auto;
  }

  #forma-password-{{ section.id }} .forma-launch__hero h1 {
    max-width: 760px;
    margin: 30px 0 24px;
    font-size: clamp(54px, 7.3vw, 112px);
    line-height: .88;
    letter-spacing: -.085em;
    font-weight: 400;
