<script>
(() => {
  const root = document.getElementById('forma-prelaunch-{{ section.id }}');
  if (!root || root.dataset.initialized === 'true') return;
  root.dataset.initialized = 'true';

  const form = root.querySelector('[data-forma-signup]');
  const submitButton = root.querySelector('[data-submit-button]');
  const submitLabel = root.querySelector('[data-submit-label]');
  const message = root.querySelector('[data-form-message]');
  const modal = root.querySelector('[data-forma-modal]');
  const modalCopy = root.querySelector('[data-modal-copy]');
  const siteId = (root.dataset.klaviyoSiteId || '').trim();
  const listId = (root.dataset.klaviyoListId || '').trim();
  let previousFocus = null;
  let countdownInterval;

  function showMessage(text, error = false) {
    message.textContent = text;
    message.classList.add('is-visible');
    message.classList.toggle('is-error', error);
  }

  function openModal(text) {
    previousFocus = document.activeElement;
    modalCopy.textContent = text;
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';
    const close = modal.querySelector('.forma-modal-close');
    if (close) close.focus();
  }

  function closeModal() {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
    if (previousFocus && previousFocus.focus) previousFocus.focus();
  }

  root.querySelectorAll('[data-close-modal]').forEach((button) => {
    button.addEventListener('click', closeModal);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
  });

  function updateCountdown() {
    const parts = (root.dataset.launchDate || '').split('-').map(Number);
    if (parts.length !== 3 || parts.some((value) => !Number.isFinite(value))) return;

    const target = new Date(parts[0], parts[1] - 1, parts[2], 0, 0, 0);
    const seconds = Math.max(0, Math.floor((target.getTime() - Date.now()) / 1000));
    const values = {
      days: Math.floor(seconds / 86400),
      hours: Math.floor((seconds % 86400) / 3600),
      minutes: Math.floor((seconds % 3600) / 60),
      seconds: seconds % 60
    };

    Object.entries(values).forEach(([key, value]) => {
      const node = root.querySelector('[data-' + key + ']');
      if (node) node.textContent = String(value).padStart(2, '0');
    });
  }

  updateCountdown();
  countdownInterval = window.setInterval(updateCountdown, 1000);

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    message.classList.remove('is-visible', 'is-error');

    if (!form.reportValidity()) return;

    if (!siteId || !listId) {
      showMessage('The signup form is not connected yet. Please add your Klaviyo Site ID and List ID in the section settings.', true);
      return;
    }

    const data = new FormData(form);
    const email = String(data.get('email') || '').trim();
    const firstName = String(data.get('first_name') || '').trim();
    const lastName = String(data.get('last_name') || '').trim();
    const birthday = String(data.get('birthday') || '').trim();

    const birthDate = new Date(birthday + 'T12:00:00');
    if (!birthday || Number.isNaN(birthDate.getTime()) || birthDate > new Date()) {
      showMessage('Please enter a valid date of birth.', true);
      return;
    }

    if (!form.querySelector('[name="marketing_consent"]').checked) {
      showMessage('Please confirm that you agree to receive emails from FORMA.', true);
      return;
    }

    submitButton.disabled = true;
    submitLabel.textContent = 'PLEASE WAIT…';

    try {
      const response = await fetch(
        'https://a.klaviyo.com/client/subscriptions/?company_id=' + encodeURIComponent(siteId),
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/vnd.api+json',
            'revision': '2025-04-15'
          },
          body: JSON.stringify({
            data: {
              type: 'subscription',
              attributes: {
                custom_source: 'FORMA Copenhagen Pre-Launch',
                profile: {
                  data: {
                    type: 'profile',
                    attributes: {
                      email,
                      first_name: firstName,
                      last_name: lastName,
                      properties: { birthday },
                      subscriptions: {
                        email: {
                          marketing: { consent: 'SUBSCRIBED' }
                        }
                      }
                    }
                  }
                }
              },
              relationships: {
                list: {
                  data: { type: 'list', id: listId }
                }
              }
            }
          })
        }
      );

      if (!response.ok) {
        let detail = '';
        try {
          const result = await response.json();
          detail = (result.errors || [])
            .map((item) => item.detail || item.title)
            .filter(Boolean)
            .join(' ');
        } catch (error) {}

        showMessage(
          detail || 'We couldn’t complete your signup. Please check your details and try again.',
          true
        );
        return;
      }

      form.reset();
      openModal('Thank you for joining FORMA. If confirmation is required, please check your inbox to confirm your subscription. Your next discovery is just around the corner.');
    } catch (error) {
      showMessage('We couldn’t connect to the signup service. Please try again in a moment.', true);
    } finally {
      submitButton.disabled = false;
      submitLabel.textContent = {{ section.settings.button_label | json }};
    }
  });

  document.addEventListener('shopify:section:unload', (event) => {
    if (event.detail && event.detail.sectionId === '{{ section.id }}') {
      window.clearInterval(countdownInterval);
    }
  });
})();
</script>

