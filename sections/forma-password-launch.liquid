
{% comment %}
  FORMA COPENHAGEN — PASSWORD / LAUNCH PAGE
  Launch date: 1 December 2026
  Logo and image are editable in the Shopify Theme Editor.
{% endcomment %}

<div id="forma-launch-{{ section.id }}" class="forma-launch">

  {% assign launch_logo = section.settings.logo %}
  {% assign launch_image = section.settings.hero_image %}

  <!-- HEADER -->
  <header class="forma-launch__header">
    <a href="{{ routes.root_url }}" class="forma-launch__brand" aria-label="FORMA Copenhagen">
      {% if launch_logo != blank %}
        {{
          launch_logo
          | image_url: width: 600
          | image_tag:
            class: 'forma-launch__logo',
            widths: '150, 250, 400, 600',
            alt: 'FORMA Copenhagen'
        }}
      {% endif %}
    </a>

    <span class="forma-launch__header-note">
      COPENHAGEN · SCANDINAVIA · EVERYWHERE
    </span>
  </header>

  <main class="forma-launch__main">

    <!-- HERO -->
    <section class="forma-launch__hero">

      <div class="forma-launch__eyebrow">
        <span></span>
        SOMETHING WORTH DISCOVERING
      </div>

      <div class="forma-launch__hero-grid {% if launch_image == blank %}forma-launch__hero-grid--no-image{% endif %}">

        <div class="forma-launch__hero-copy">
          <h1>
            A new perspective<br class="forma-launch__desktop-break">
            on the things <span>we love.</span>
          </h1>

          <p class="forma-launch__intro">
            A curated world of brands, places, stories and ideas.
            Thoughtfully brought together. Made to be discovered.
          </p>

          <a href="#forma-signup-{{ section.id }}" class="forma-launch__cta">
            BE FIRST TO DISCOVER
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        {% if launch_image != blank %}
          <div class="forma-launch__visual">
            {{
              launch_image
              | image_url: width: 1800
              | image_tag:
                class: 'forma-launch__image',
                widths: '500, 800, 1200, 1600, 1800',
                sizes: '(max-width: 749px) 100vw, 44vw',
                loading: 'eager',
                alt: section.settings.image_alt
            }}
            {% if section.settings.image_caption != blank %}
              <span class="forma-launch__image-caption">
                {{ section.settings.image_caption | escape }}
              </span>
            {% endif %}
          </div>
        {% endif %}

      </div>

      <div class="forma-launch__hero-footer">
        <span>INDEPENDENT DISCOVERY</span>
        <span class="forma-launch__footer-line"></span>
        <span>SCANDINAVIA AND BEYOND</span>
      </div>

    </section>

    <!-- COUNTDOWN -->
    <section class="forma-launch__countdown-section" aria-label="Countdown to launch">

      <div class="forma-launch__countdown-heading">
        <div>
          <span class="forma-launch__eyebrow-small">SAVE THE DATE</span>
          <h2>The countdown begins.</h2>
        </div>

        <span class="forma-launch__launch-date">01.12.2026</span>
      </div>

      <div class="forma-launch__countdown" data-countdown>
        <div class="forma-launch__countdown-item">
          <span data-days>00</span>
          <small>DAYS</small>
        </div>

        <div class="forma-launch__countdown-item">
          <span data-hours>00</span>
          <small>HOURS</small>
        </div>

        <div class="forma-launch__countdown-item">
          <span data-minutes>00</span>
          <small>MINUTES</small>
        </div>

        <div class="forma-launch__countdown-item">
          <span data-seconds>00</span>
          <small>SECONDS</small>
        </div>
      </div>

    </section>

    <!-- NEWSLETTER -->
    <section id="forma-signup-{{ section.id }}" class="forma-launch__signup">

      <div class="forma-launch__signup-copy">
        <span class="forma-launch__eyebrow-small">THE FORMA LETTER</span>

        <h2>Be first.<br><span>Know first.</span></h2>

        <p>
          Get the first look at what's coming. Discover new brands,
          places and stories — and be part of FORMA from day one.
        </p>
      </div>

      <div class="forma-launch__signup-form">

        <div class="forma-launch__form-topline">
          <span>JOIN THE LIST</span>
          <span>01 — YOUR INVITATION</span>
        </div>

        {% form 'customer',
          id: 'FormaLaunchNewsletter',
          class: 'forma-launch__form'
        %}

          <input
            type="hidden"
            name="contact[tags]"
            value="newsletter, forma-launch"
          >

          {% if form.posted_successfully? %}

            <div class="forma-launch__success" role="status">
              <span class="forma-launch__success-check">✓</span>
              <div>
                <strong>You're on the list.</strong>
                <p>Thank you for joining us. Keep an eye on your inbox.</p>
              </div>
            </div>

          {% else %}

            {% if form.errors %}
              <div class="forma-launch__error" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <label
              class="forma-launch__visually-hidden"
              for="FormaLaunchEmail-{{ section.id }}"
            >
              E-mail address
            </label>

            <div class="forma-launch__input-row">
              <input
                id="FormaLaunchEmail-{{ section.id }}"
                class="forma-launch__email"
                type="email"
                name="contact[email]"
                value="{{ form.email | escape }}"
                placeholder="Your email address"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
              >

              <button
                class="forma-launch__submit"
                type="submit"
                aria-label="Join the FORMA Letter"
              >
                <span aria-hidden="true">→</span>
              </button>
            </div>

            <label class="forma-launch__consent" for="FormaLaunchConsent-{{ section.id }}">
              <input
                id="FormaLaunchConsent-{{ section.id }}"
                type="checkbox"
                name="contact[accepts_marketing]"
                value="true"
                required
              >
              <span>
                I agree to receive e-mails from FORMA about the launch,
                new discoveries and updates. I can unsubscribe at any time.
              </span>
            </label>

            <p class="forma-launch__privacy">
              Your information will only be used in accordance with our
              <a href="{{ routes.root_url }}policies/privacy-policy">Privacy Policy</a>.
            </p>

          {% endif %}

        {% endform %}

      </div>

    </section>

  </main>

  <!-- FOOTER -->
  <footer class="forma-launch__footer">
    <div class="forma-launch__footer-brand">
      {% if launch_logo != blank %}
        {{
          launch_logo
          | image_url: width: 400
          | image_tag:
            class: 'forma-launch__footer-logo',
            widths: '150, 250, 400',
            alt: 'FORMA Copenhagen'
        }}
      {% endif %}
    </div>

    <span class="forma-launch__footer-description">
      A CURATED WORLD OF BRANDS, PLACES, STORIES AND IDEAS.
    </span>

    <a href="mailto:Customercare@formacopenhagen.com" class="forma-launch__contact">
      CONTACT <span aria-hidden="true">↗</span>
    </a>

    <span class="forma-launch__copyright">
      © {{ 'now' | date: '%Y' }} FORMA COPENHAGEN
    </span>
  </footer>

  <!-- STORE OWNER PASSWORD ACCESS -->
  <details class="forma-launch__password">
    <summary>ENTER WITH PASSWORD</summary>

    {% form 'storefront_password', class: 'forma-launch__password-form' %}
      <label for="FormaStorefrontPassword-{{ section.id }}">STORE PASSWORD</label>

      <input
        id="FormaStorefrontPassword-{{ section.id }}"
        type="password"
        name="password"
        placeholder="Enter password"
        required
      >

      <button type="submit">ENTER ↗</button>

      {% if form.errors %}
        <div class="forma-launch__error">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}
    {% endform %}
  </details>

</div>

<style>
  #forma-launch-{{ section.id }} {
    --fl-bg: #f4f3ef;
    --fl-text: #191918;
    --fl-muted: #77766f;
    --fl-line: #deddd6;

    background: var(--fl-bg);
    color: var(--fl-text);
    width: 100%;
    overflow: hidden;
    font-family: inherit;
    -webkit-font-smoothing: antialiased;
  }

  #forma-launch-{{ section.id }} *,
  #forma-launch-{{ section.id }} *::before,
  #forma-launch-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #forma-launch-{{ section.id }} a {
    color: inherit;
    text-decoration: none;
  }

  #forma-launch-{{ section.id }} .forma-launch__header {
    min-height: 88px;
    padding: 0 5.2%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid var(--fl-line);
  }

  #forma-launch-{{ section.id }} .forma-launch__brand {
    display: inline-flex;
    align-items: center;
    min-width: 1px;
  }

  #forma-launch-{{ section.id }} .forma-launch__logo {
    display: block;
    width: {{ section.settings.logo_width }}px;
    max-width: min(45vw, {{ section.settings.logo_width }}px);
    height: auto;
    object-fit: contain;
    object-position: left center;
  }

  #forma-launch-{{ section.id }} .forma-launch__header-note,
  #forma-launch-{{ section.id }} .forma-launch__eyebrow,
  #forma-launch-{{ section.id }} .forma-launch__eyebrow-small,
  #forma-launch-{{ section.id }} .forma-launch__hero-footer,
  #forma-launch-{{ section.id }} .forma-launch__form-topline,
  #forma-launch-{{ section.id }} .forma-launch__contact,
  #forma-launch-{{ section.id }} .forma-launch__copyright {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.13em;
    line-height: 1.7;
  }

  #forma-launch-{{ section.id }} .forma-launch__header-note {
    color: var(--fl-muted);
    text-align: right;
  }

  #forma-launch-{{ section.id }} .forma-launch__main {
    padding: 0 5.2%;
    max-width: 1800px;
    margin: 0 auto;
  }

  #forma-launch-{{ section.id }} .forma-launch__hero {
    padding: clamp(55px, 7vw, 95px) 0 0;
  }

  #forma-launch-{{ section.id }} .forma-launch__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--fl-muted);
    margin-bottom: clamp(30px, 4vw, 55px);
  }

  #forma-launch-{{ section.id }} .forma-launch__eyebrow > span {
    width: 25px;
    height: 1px;
    background: var(--fl-muted);
  }

  #forma-launch-{{ section.id }} .forma-launch__hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(35px, 6vw, 95px);
    align-items: center;
  }

  #forma-launch-{{ section.id }} .forma-launch__hero-grid--no-image {
    grid-template-columns: minmax(0, 1fr);
  }

  #forma-launch-{{ section.id }} .forma-launch__hero-copy h1 {
    margin: 0;
    font-size: clamp(48px, 6.6vw, 100px);
    font-weight: 400;
    letter-spacing: -0.08em;
    line-height: 0.99;
  }

  #forma-launch-{{ section.id }} .forma-launch__hero-copy h1 span {
    color: var(--fl-muted);
  }

  #forma-launch-{{ section.id }} .forma-launch__intro {
    max-width: 430px;
    margin: 28px 0 0;
    color: var(--fl-muted);
    font-size: 14px;
    line-height: 1.85;
  }

  #forma-launch-{{ section.id }} .forma-launch__cta {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding: 0 0 10px;
    margin-top: 35px;
    border-bottom: 1px solid var(--fl-text);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.13em;
    transition: gap 0.25s ease;
  }

  #forma-launch-{{ section.id }} .forma-launch__cta:hover {
    gap: 32px;
  }

  #forma-launch-{{ section.id }} .forma-launch__cta span {
    font-size: 19px;
    font-weight: 400;
  }

  #forma-launch-{{ section.id }} .forma-launch__visual {
    min-width: 0;
  }

  #forma-launch-{{ section.id }} .forma-launch__image {
    display: block;
    width: 100%;
    height: clamp(280px, 36vw, 500px);
    object-fit: cover;
    object-position: center;
  }

  #forma-launch-{{ section.id }} .forma-launch__image-caption {
    display: block;
    margin-top: 12px;
    color: var(--fl-muted);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #forma-launch-{{ section.id }} .forma-launch__hero-footer {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: clamp(45px, 6vw, 75px);
    padding: 17px 0;
    border-top: 1px solid var(--fl-line);
    color: var(--fl-muted);
  }

  #forma-launch-{{ section.id }} .forma-launch__footer-line {
    width: 25px;
    height: 1px;
    background: var(--fl-line);
  }

  #forma-launch-{{ section.id }} .forma-launch__countdown-section {
    padding: clamp(45px, 6vw, 75px) 0;
    border-bottom: 1px solid var(--fl-line);
  }

  #forma-launch-{{ section.id }} .forma-launch__countdown-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 25px;
    margin-bottom: 28px;
  }

  #forma-launch-{{ section.id }} .forma-launch__eyebrow-small {
    display: block;
    color: var(--fl-muted);
  }

  #forma-launch-{{ section.id }} .forma-launch__countdown-heading h2 {
    margin: 12px 0 0;
    font-size: clamp(30px, 3.5vw, 46px);
    line-height: 1.05;
    letter-spacing: -0.065em;
    font-weight: 400;
  }

  #forma-launch-{{ section.id }} .forma-launch__launch-date {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  #forma-launch-{{ section.id }} .forma-launch__countdown {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--fl-line);
  }

  #forma-launch-{{ section.id }} .forma-launch__countdown-item {
    min-width: 0;
    padding: clamp(20px, 3vw, 35px);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  #forma-launch-{{ section.id }} .forma-launch__countdown-item + .forma-launch__countdown-item {
    border-left: 1px solid var(--fl-line);
  }

  #forma-launch-{{ section.id }} .forma-launch__countdown-item > span {
    font-size: clamp(35px, 5.4vw, 67px);
    line-height: 1;
    font-weight: 400;
    letter-spacing: -0.075em;
    font-variant-numeric: tabular-nums;
  }

  #forma-launch-{{ section.id }} .forma-launch__countdown-item small {
    color: var(--fl-muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  #forma-launch-{{ section.id }} .forma-launch__signup {
    padding: clamp(60px, 8vw, 110px) 0;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(45px, 9vw, 130px);
    align-items: start;
    border-bottom: 1px solid var(--fl-line);
  }

  #forma-launch-{{ section.id }} .forma-launch__signup-copy h2 {
    margin: 20px 0;
    font-size: clamp(50px, 6vw, 78px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.08em;
  }

  #forma-launch-{{ section.id }} .forma-launch__signup-copy h2 span {
    color: var(--fl-muted);
  }

  #forma-launch-{{ section.id }} .forma-launch__signup-copy > p {
    max-width: 380px;
    margin: 0;
    color: var(--fl-muted);
    font-size: 13px;
    line-height: 1.9;
  }

  #forma-launch-{{ section.id }} .forma-launch__form-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding-bottom: 17px;
    border-bottom: 1px solid var(--fl-line);
    color: var(--fl-muted);
    margin-bottom: 28px;
  }

  #forma-launch-{{ section.id }} .forma-launch__input-row {
    display: flex;
    align-items: center;
    gap: 20px;
    border-bottom: 1px solid #a9a79f;
    transition: border-color 0.2s ease;
  }

  #forma-launch-{{ section.id }} .forma-launch__input-row:focus-within {
    border-color: var(--fl-text);
  }

  #forma-launch-{{ section.id }} .forma-launch__email {
    width: 100%;
    min-width: 0;
    border: 0;
    border-radius: 0;
    outline: none;
    background: transparent;
    box-shadow: none;
    color: var(--fl-text);
    font: inherit;
    font-size: 14px;
    padding: 19px 0;
    appearance: none;
  }

  #forma-launch-{{ section.id }} .forma-launch__email::placeholder {
    color: #929087;
    opacity: 1;
  }

  #forma-launch-{{ section.id }} .forma-launch__submit {
    flex: 0 0 40px;
    width: 40px;
    height: 48px;
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--fl-text);
    cursor: pointer;
    font-size: 26px;
    font-weight: 400;
    transition: transform 0.2s ease;
  }

  #forma-launch-{{ section.id }} .forma-launch__submit:hover {
    transform: translateX(4px);
  }

  #forma-launch-{{ section.id }} .forma-launch__consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: 22px;
    color: var(--fl-muted);
    font-size: 11px;
    line-height: 1.75;
    cursor: pointer;
  }

  #forma-launch-{{ section.id }} .forma-launch__consent input {
    flex: 0 0 auto;
    margin: 3px 0 0;
    accent-color: var(--fl-text);
  }

  #forma-launch-{{ section.id }} .forma-launch__privacy {
    margin: 14px 0 0;
    color: var(--fl-muted);
    font-size: 10px;
    line-height: 1.7;
  }

  #forma-launch-{{ section.id }} .forma-launch__privacy a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #forma-launch-{{ section.id }} .forma-launch__success {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 24px 0;
    border-bottom: 1px solid var(--fl-line);
  }

  #forma-launch-{{ section.id }} .forma-launch__success-check {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border: 1px solid var(--fl-line);
    border-radius: 50%;
    flex-shrink: 0;
  }

  #forma-launch-{{ section.id }} .forma-launch__success strong {
    font-size: 19px;
    font-weight: 400;
  }

  #forma-launch-{{ section.id }} .forma-launch__success p {
    margin: 8px 0 0;
    color: var(--fl-muted);
    font-size: 12px;
    line-height: 1.8;
  }

  #forma-launch-{{ section.id }} .forma-launch__error {
    margin: 0 0 20px;
    color: #873c30;
    font-size: 12px;
    line-height: 1.7;
  }

  #forma-launch-{{ section.id }} .forma-launch__visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #forma-launch-{{ section.id }} .forma-launch__footer {
    padding: 24px 5.2%;
    display: grid;
    grid-template-columns: 1fr 1.5fr 1fr auto;
    align-items: center;
    gap: 25px;
    border-top: 1px solid var(--fl-line);
  }

  #forma-launch-{{ section.id }} .forma-launch__footer-brand {
    min-height: 20px;
  }

  #forma-launch-{{ section.id }} .forma-launch__footer-logo {
    display: block;
    width: min(100%, {{ section.settings.logo_width | times: 0.65 | round }}px);
    max-height: 42px;
    object-fit: contain;
    object-position: left center;
  }

  #forma-launch-{{ section.id }} .forma-launch__footer-description {
    color: var(--fl-muted);
    font-size: 9px;
    letter-spacing: 0.1em;
    line-height: 1.8;
  }

  #forma-launch-{{ section.id }} .forma-launch__contact {
    white-space: nowrap;
  }

  #forma-launch-{{ section.id }} .forma-launch__contact span {
    margin-left: 5px;
    font-size: 15px;
  }

  #forma-launch-{{ section.id }} .forma-launch__copyright {
    color: var(--fl-muted);
    white-space: nowrap;
    font-size: 8px;
  }

  #forma-launch-{{ section.id }} .forma-launch__password {
    padding: 13px 5.2%;
    border-top: 1px solid var(--fl-line);
    color: var(--fl-muted);
  }

  #forma-launch-{{ section.id }} .forma-launch__password summary {
    cursor: pointer;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  #forma-launch-{{ section.id }} .forma-launch__password-form {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding: 18px 0 5px;
    font-size: 11px;
  }

  #forma-launch-{{ section.id }} .forma-launch__password-form input {
    min-width: 0;
    padding: 10px;
    border: 1px solid var(--fl-line);
    border-radius: 0;
    background: transparent;
    font: inherit;
  }

  #forma-launch-{{ section.id }} .forma-launch__password-form button {
    padding: 11px 16px;
    border: 0;
    background: var(--fl-text);
    color: white;
    font: inherit;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    #forma-launch-{{ section.id }} .forma-launch__hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 35px;
    }

    #forma-launch-{{ section.id }} .forma-launch__image {
      height: clamp(260px, 55vw, 440px);
    }

    #forma-launch-{{ section.id }} .forma-launch__signup {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    #forma-launch-{{ section.id }} .forma-launch__footer {
      grid-template-columns: 1fr 1fr;
      gap: 22px;
    }

    #forma-launch-{{ section.id }} .forma-launch__footer-description {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  @media (max-width: 600px) {
    #forma-launch-{{ section.id }} .forma-launch__header {
      min-height: 70px;
      padding: 0 22px;
    }

