<script>
  (() => {
    const root = document.getElementById('forma-launch-{{ section.id }}');
    if (!root || root.dataset.flReady === 'true') return;

    root.dataset.flReady = 'true';

    const countdown = root.querySelector('[data-fl-countdown]');
    if (!countdown) return;

    // Launch: 1 December 2026, midnight Danish time.
    const launchDate = new Date('2026-12-01T00:00:00+01:00').getTime();

    const days = root.querySelector('[data-fl-days]');
    const hours = root.querySelector('[data-fl-hours]');
    const minutes = root.querySelector('[data-fl-minutes]');
    const seconds = root.querySelector('[data-fl-seconds]');

    const pad = (number) => String(number).padStart(2, '0');

    function updateCountdown() {
      const remaining = launchDate - Date.now();

      if (remaining <= 0) {
        days.textContent = '00';
        hours.textContent = '00';
        minutes.textContent = '00';
        seconds.textContent = '00';
        window.clearInterval(timer);
        return;
      }

      days.textContent = pad(Math.floor(remaining / 86400000));
      hours.textContent = pad(Math.floor((remaining % 86400000) / 3600000));
      minutes.textContent = pad(Math.floor((remaining % 3600000) / 60000));
      seconds.textContent = pad(Math.floor((remaining % 60000) / 1000));
    }

    const timer = window.setInterval(updateCountdown, 1000);
    updateCountdown();

    document.addEventListener('shopify:section:unload', (event) => {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        window.clearInterval(timer);
      }
    });
  })();
</script>

