{% comment %}
  FORMA COPENHAGEN — PRE-LAUNCH PAGE
  Complete password page with responsive layout,
  SVG arrows, signup form and success modal.
{% endcomment %}

<section
  id="forma-prelaunch-{{ section.id }}"
  class="forma-prelaunch"
  data-launch-date="{{ section.settings.launch_date | escape }}"
  data-klaviyo-site-id="{{ section.settings.klaviyo_site_id | escape }}"
  data-klaviyo-list-id="{{ section.settings.klaviyo_list_id | escape }}"
>
  <div class="forma-header">
    <a href="/" class="forma-logo" aria-label="FORMA Copenhagen">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 500 | image_tag: alt: 'FORMA Copenhagen', class: 'forma-logo-image' }}
      {% else %}
        <span class="forma-logo-main">FORMA</span>
        <span class="forma-logo-sub">COPENHAGEN</span>
      {% endif %}
    </a>
    <span class="forma-header-note">{{ section.settings.header_note | escape }}</span>
  </div>

  <main>
    <!-- HERO -->
    <section class="forma-hero">
      <div class="forma-eyebrow">
        <span class="forma-eyebrow-line"></span>
        <span>{{ section.settings.eyebrow | escape }}</span>
        <span class="forma-eyebrow-line"></span>
      </div>

      <h1 class="forma-hero-title">
        {{ section.settings.heading_line_1 | escape }}
        <em>{{ section.settings.heading_line_2 | escape }}</em>
      </h1>

      <p class="forma-hero-description">
        {{ section.settings.intro | escape }}
      </p>

      <div class="forma-launch">
        <span class="forma-small-label">THE JOURNEY BEGINS</span>
        <span class="forma-launch-date">{{ section.settings.launch_date_display | escape }}</span>
      </div>

      <div class="forma-countdown" aria-label="Countdown to launch">
        <div class="forma-count-unit">
          <span data-days>--</span><small>DAYS</small>
        </div>
        <span class="forma-count-colon">:</span>
        <div class="forma-count-unit">
          <span data-hours>--</span><small>HOURS</small>
        </div>
        <span class="forma-count-colon">:</span>
        <div class="forma-count-unit">
          <span data-minutes>--</span><small>MINUTES</small>
        </div>
        <span class="forma-count-colon">:</span>
        <div class="forma-count-unit">
          <span data-seconds>--</span><small>SECONDS</small>
        </div>
      </div>
    </section>

    <!-- SIGNUP -->
    <section class="forma-membership" id="forma-membership">
      <div class="forma-form-card">
        <div class="forma-section-index">
          <span>01</span><span class="forma-index-line"></span><span>YOUR INVITATION</span>
        </div>

        <div class="forma-form-heading">
          <span class="forma-small-label">A MORE CONSIDERED WORLD</span>
          <h2>{{ section.settings.form_heading | escape }}</h2>
          <p>{{ section.settings.form_intro | escape }}</p>
        </div>

        <form data-forma-signup novalidate>
          <div class="forma-field-row">
            <div class="forma-field">
              <label for="forma-first-{{ section.id }}">First name <span>*</span></label>
              <input id="forma-first-{{ section.id }}" type="text" name="first_name" autocomplete="given-name" placeholder="Your first name" required>
            </div>
            <div class="forma-field">
              <label for="forma-last-{{ section.id }}">Last name <span>*</span></label>
              <input id="forma-last-{{ section.id }}" type="text" name="last_name" autocomplete="family-name" placeholder="Your last name" required>
            </div>
          </div>

          <div class="forma-field">
            <label for="forma-email-{{ section.id }}">Email address <span>*</span></label>
            <input id="forma-email-{{ section.id }}" type="email" name="email" autocomplete="email" placeholder="you@example.com" required>
          </div>

          <div class="forma-field">
            <label for="forma-birthday-{{ section.id }}">Date of birth <span>*</span></label>
            <input id="forma-birthday-{{ section.id }}" type="date" name="birthday" autocomplete="bday" required>
            <p class="forma-field-note">
              A little something, just for you. We use your date of birth to send you a personal birthday gift. Your date of birth is handled in accordance with our
              <a href="{{ section.settings.privacy_url }}">privacy policy</a>.
            </p>
          </div>

          <label class="forma-consent">
            <input type="checkbox" name="marketing_consent" required>
            <span class="forma-checkbox" aria-hidden="true"></span>
            <span>
              I agree to receive emails from FORMA Copenhagen about curated brands, inspiration, launches and member experiences. I can unsubscribe at any time.
              <span class="forma-required">*</span>
            </span>
          </label>

          <button class="forma-submit" type="submit" data-submit-button>
            <span data-submit-label>{{ section.settings.button_label | escape }}</span>
            <svg class="forma-arrow" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 19 19 5M7 5h12v12" />
            </svg>
          </button>

          <p class="forma-form-message" data-form-message role="status" aria-live="polite"></p>

          <p class="forma-privacy-note">
            By joining, you agree to our <a href="{{ section.settings.privacy_url }}">Privacy Policy</a>.
            No noise. Only things worth discovering.
          </p>
        </form>

        <div class="forma-footnote">
          <span class="forma-footnote-symbol" aria-hidden="true">
            <svg viewBox="0 0 20 20">
              <circle cx="10" cy="10" r="7.5" />
              <path d="M10 5v10M5 10h10M6.5 6.5l7 7M13.5 6.5l-7 7" />
            </svg>
          </span>
          <span>Thoughtfully selected. Never just more.</span>
        </div>
      </div>
    </section>

    <!-- ABOUT FORMA -->
    <section class="forma-world">
      <div class="forma-world-top">
        <div class="forma-section-index">
          <span>02</span><span class="forma-index-line"></span><span>THE WORLD OF FORMA</span>
        </div>
        <p class="forma-world-kicker">Less searching.<br>More discovering.</p>
      </div>

      <div class="forma-world-intro">
        <h2>
          {{ section.settings.world_heading_line_1 | escape }}
          <em>{{ section.settings.world_heading_line_2 | escape }}</em>
        </h2>
        <p>{{ section.settings.world_description | escape }}</p>
      </div>

      <div class="forma-benefits">
        <article class="forma-benefit">
          <span class="forma-benefit-number">01</span>
          <div>
            <h3>Independent discovery</h3>
            <p>Find considered brands and products from across Scandinavia and Europe, brought together in one curated universe.</p>
          </div>
          <span class="forma-benefit-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 19 19 5M7 5h12v12" /></svg>
          </span>
        </article>

        <article class="forma-benefit">
          <span class="forma-benefit-number">02</span>
          <div>
            <h3>Ideas worth keeping</h3>
            <p>Explore stories, places, people and perspectives that make everyday life a little more inspiring.</p>
          </div>
          <span class="forma-benefit-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 19 19 5M7 5h12v12" /></svg>
          </span>
        </article>

        <article class="forma-benefit">
          <span class="forma-benefit-number">03</span>
          <div>
            <h3>Your own Forma</h3>
            <p>Save what you love, follow the brands that speak to you and build a personal collection of discoveries.</p>
          </div>
          <span class="forma-benefit-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 19 19 5M7 5h12v12" /></svg>
          </span>
        </article>
      </div>

      <div class="forma-categories">
        <span class="forma-small-label">THE UNIVERSE</span>
        <div class="forma-category-list">
          <span>Wardrobe</span>
          <span>The Lifestyle</span>
          <span>The Home</span>
          <span>The Form</span>
          <span>Hotels &amp; Stays</span>
          <span>Cafés &amp; Restaurants</span>
          <span>Cities &amp; Experiences</span>
          <span>Forma Journal</span>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="forma-final">
      <span class="forma-small-label">YOUR NEXT DISCOVERY STARTS HERE</span>
      <h2>Not everything deserves<br>your attention.</h2>
      <p>We curate what does.</p>
      <a href="#forma-membership" class="forma-final-link">
        <span>Become a member</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M7 5h12v12" /></svg>
      </a>
    </section>
  </main>

  <!-- SUCCESS POPUP -->
  <div class="forma-modal" data-forma-modal aria-hidden="true">
    <button type="button" class="forma-modal-backdrop" data-close-modal aria-label="Close confirmation"></button>
    <div class="forma-modal-card" role="dialog" aria-modal="true" aria-labelledby="forma-modal-title-{{ section.id }}">
      <button type="button" class="forma-modal-close" data-close-modal aria-label="Close">×</button>
      <span class="forma-modal-logo">F.</span>
      <span class="forma-small-label">WELCOME TO FORMA</span>
      <h2 id="forma-modal-title-{{ section.id }}">You're on the list.</h2>
      <p data-modal-copy>Thank you for joining us. A more considered world is just around the corner.</p>
      <span class="forma-modal-rule"></span>
      <span class="forma-modal-signoff">See you on the inside.</span>
      <button type="button" class="forma-modal-button" data-close-modal>CONTINUE EXPLORING</button>
    </div>
  </div>
</section>

<style>
  #forma-prelaunch-{{ section.id }} {
    --paper: #f5f4f0;
    --ink: #242420;
    --muted: #77766f;
    --line: #d8d6ce;
    --white: #fffefa;
    background: var(--paper);
    color: var(--ink);
    position: relative;
    overflow: clip;
    isolation: isolate;
    font-family: inherit;
  }

  #forma-prelaunch-{{ section.id }} *,
  #forma-prelaunch-{{ section.id }} *::before,
  #forma-prelaunch-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #forma-prelaunch-{{ section.id }} a { color: inherit; }

  #forma-prelaunch-{{ section.id }} .forma-header {
    min-height: 86px;
    padding: 24px 5.5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(36,36,32,.12);
  }

  #forma-prelaunch-{{ section.id }} .forma-logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    text-decoration: none;
  }

  #forma-prelaunch-{{ section.id }} .forma-logo-main {
    font-size: 27px;
    font-weight: 600;
    letter-spacing: .22em;
    line-height: 1;
  }

  #forma-prelaunch-{{ section.id }} .forma-logo-sub {
    font-size: 8px;
    letter-spacing: .34em;
  }

  #forma-prelaunch-{{ section.id }} .forma-logo-image {
    display: block;
    width: min(190px, 40vw);
    height: auto;
  }

  #forma-prelaunch-{{ section.id }} .forma-header-note {
    font-size: 10px;
    letter-spacing: .17em;
    text-transform: uppercase;
    color: var(--muted);
  }

  #forma-prelaunch-{{ section.id }} .forma-hero {
    text-align: center;
    padding: clamp(78px, 10vw, 140px) 22px 90px;
    max-width: 1000px;
    margin: 0 auto;
  }

  #forma-prelaunch-{{ section.id }} .forma-eyebrow,
  #forma-prelaunch-{{ section.id }} .forma-section-index {
    display: flex;
    align-items: center;
    gap: 13px;
    font-size: 9px;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  #forma-prelaunch-{{ section.id }} .forma-eyebrow { justify-content: center; }

  #forma-prelaunch-{{ section.id }} .forma-eyebrow-line {
    width: 25px;
    height: 1px;
    background: #a9a69c;
  }

  #forma-prelaunch-{{ section.id }} .forma-hero-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(54px, 8.5vw, 112px);
    font-weight: 400;
    letter-spacing: -.075em;
    line-height: .94;
    margin: 32px 0 26px;
  }

  #forma-prelaunch-{{ section.id }} .forma-hero-title em {
    display: block;
    font-weight: 400;
  }

  #forma-prelaunch-{{ section.id }} .forma-hero-description {
    max-width: 490px;
    margin: 0 auto;
    font-size: 14px;
    line-height: 1.9;
    color: #65645e;
  }

  #forma-prelaunch-{{ section.id }} .forma-launch {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 42px 0 24px;
  }

  #forma-prelaunch-{{ section.id }} .forma-small-label,
  #forma-prelaunch-{{ section.id }} .forma-count-unit small {
    font-size: 9px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  #forma-prelaunch-{{ section.id }} .forma-launch-date {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 21px;
  }

  #forma-prelaunch-{{ section.id }} .forma-countdown {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(12px, 2.8vw, 30px);
  }

  #forma-prelaunch-{{ section.id }} .forma-count-unit {
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-width: 43px;
  }

  #forma-prelaunch-{{ section.id }} .forma-count-unit > span {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 27px;
    font-variant-numeric: tabular-nums;
  }

  #forma-prelaunch-{{ section.id }} .forma-count-unit small {
    font-size: 8px;
    letter-spacing: .12em;
  }

  #forma-prelaunch-{{ section.id }} .forma-count-colon {
    padding-top: 3px;
    color: #a5a197;
  }

  #forma-prelaunch-{{ section.id }} .forma-membership {
    padding: 0 20px 120px;
    scroll-margin-top: 30px;
  }

  #forma-prelaunch-{{ section.id }} .forma-form-card {
    max-width: 590px;
    margin: 0 auto;
    padding: 46px clamp(23px, 5vw, 62px) 35px;
    background: rgba(255,254,250,.68);
    border: 1px solid rgba(36,36,32,.14);
  }

  #forma-prelaunch-{{ section.id }} .forma-section-index {
    justify-content: flex-start;
    gap: 12px;
    color: var(--muted);
  }

  #forma-prelaunch-{{ section.id }} .forma-index-line {
    width: 30px;
    height: 1px;
    background: #b8b5ab;
  }

  #forma-prelaunch-{{ section.id }} .forma-form-heading { margin: 38px 0 32px; }

  #forma-prelaunch-{{ section.id }} .forma-form-heading h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    font-size: clamp(37px, 5vw, 51px);
    letter-spacing: -.055em;
    line-height: 1.05;
    margin: 13px 0;
  }

  #forma-prelaunch-{{ section.id }} .forma-form-heading p {
    font-size: 13px;
    line-height: 1.8;
    color: #696861;
    margin: 0;
  }

  #forma-prelaunch-{{ section.id }} [data-forma-signup] {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  #forma-prelaunch-{{ section.id }} .forma-field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  #forma-prelaunch-{{ section.id }} .forma-field {
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-width: 0;
  }

  #forma-prelaunch-{{ section.id }} .forma-field label {
    font-size: 11px;
    letter-spacing: .035em;
  }

  #forma-prelaunch-{{ section.id }} .forma-field label > span,
  #forma-prelaunch-{{ section.id }} .forma-required { color: #8a5146; }

  #forma-prelaunch-{{ section.id }} .forma-field input {
    appearance: none;
    width: 100%;
    min-height: 50px;
    padding: 14px 13px;
    border: 1px solid #d4d1c8;
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 12px;
    transition: border-color .2s ease, background .2s ease;
  }

  #forma-prelaunch-{{ section.id }} .forma-field input::placeholder { color: #a5a298; }

  #forma-prelaunch-{{ section.id }} .forma-field input:focus {
    outline: none;
    border-color: #37372f;
    background: var(--white);
  }

  #forma-prelaunch-{{ section.id }} .forma-field input:focus-visible,
  #forma-prelaunch-{{ section.id }} .forma-submit:focus-visible,
  #forma-prelaunch-{{ section.id }} .forma-modal button:focus-visible {
    outline: 2px solid #77766f;
    outline-offset: 3px;
  }

  #forma-prelaunch-{{ section.id }} .forma-field-note {
    font-size: 10px;
    line-height: 1.8;
    color: #77766f;
    margin: 0;
  }

  #forma-prelaunch-{{ section.id }} .forma-field-note a,
  #forma-prelaunch-{{ section.id }} .forma-privacy-note a {
    text-underline-offset: 3px;
  }

  #forma-prelaunch-{{ section.id }} .forma-consent {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 11px;
    align-items: start;
    cursor: pointer;
    font-size: 10px;
    line-height: 1.8;
    color: #6f6d66;
  }

  #forma-prelaunch-{{ section.id }} .forma-consent input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  #forma-prelaunch-{{ section.id }} .forma-checkbox {
    width: 15px;
    height: 15px;
    margin-top: 2px;
    border: 1px solid #a8a59a;
    background: transparent;
    display: block;
    position: relative;
  }

  #forma-prelaunch-{{ section.id }} .forma-consent input:checked + .forma-checkbox {
    background: var(--ink);
    background: #242420;
    border-color: #242420;
  }

  #forma-prelaunch-{{ section.id }} .forma-consent input:checked + .forma-checkbox::after {
    content: '';
    position: absolute;
    width: 7px;
    height: 4px;
    left: 3px;
    top: 4px;
    border-left: 1px solid white;
    border-bottom: 1px solid white;
    transform: rotate(-45deg);
  }

  #forma-prelaunch-{{ section.id }} .forma-consent input:focus-visible + .forma-checkbox {
    outline: 2px solid #77766f;
    outline-offset: 3px;
  }

  #forma-prelaunch-{{ section.id }} .forma-submit {
    width: 100%;
    min-height: 58px;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: var(--ink);
    color: var(--white);
    cursor: pointer;
    font-family: inherit;
    font-size: 10px;
    letter-spacing: .17em;
    text-transform: uppercase;
    transition: color .25s ease, background .25s ease;
  }

  #forma-prelaunch-{{ section.id }} .forma-submit:hover {
    color: var(--ink);
    background: transparent;
  }

  #forma-prelaunch-{{ section.id }} .forma-submit:disabled {
    opacity: .65;
    cursor: wait;
  }

  /* All arrows are inline SVG — never rendered as emojis on iOS. */
  #forma-prelaunch-{{ section.id }} .forma-arrow,
  #forma-prelaunch-{{ section.id }} .forma-benefit-arrow svg,
  #forma-prelaunch-{{ section.id }} .forma-final-link svg {
    display: block;
    width: 21px;
    height: 21px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: square;
    stroke-linejoin: miter;
    color: inherit;
  }

  #forma-prelaunch-{{ section.id }} .forma-benefit-arrow svg {
    width: 22px;
    height: 22px;
    transition: transform .2s ease;
  }

  #forma-prelaunch-{{ section.id }} .forma-benefit:hover .forma-benefit-arrow svg {
    transform: translate(2px, -2px);
  }

  #forma-prelaunch-{{ section.id }} .forma-privacy-note {
    font-size: 9px;
    line-height: 1.8;
    text-align: center;
    color: #8a887f;
    margin: -5px 0 0;
  }

  #forma-prelaunch-{{ section.id }} .forma-form-message {
    display: none;
    margin: -10px 0 0;
    font-size: 12px;
    line-height: 1.7;
  }

  #forma-prelaunch-{{ section.id }} .forma-form-message.is-visible { display: block; }
  #forma-prelaunch-{{ section.id }} .forma-form-message.is-error { color: #8a5146; }

  #forma-prelaunch-{{ section.id }} .forma-footnote {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 34px;
    color: #77766f;
    font-size: 10px;
  }

  #forma-prelaunch-{{ section.id }} .forma-footnote-symbol,
  #forma-prelaunch-{{ section.id }} .forma-footnote-symbol svg {
    display: block;
    width: 15px;
    height: 15px;
  }

  #forma-prelaunch-{{ section.id }} .forma-footnote-symbol svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
  }

  #forma-prelaunch-{{ section.id }} .forma-world {
    border-top: 1px solid rgba(36,36,32,.15);
    padding: 70px 7% 90px;
    max-width: 1500px;
    margin: 0 auto;
  }

  #forma-prelaunch-{{ section.id }} .forma-world-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  #forma-prelaunch-{{ section.id }} .forma-world-kicker {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 17px;
    line-height: 1.3;
    font-style: italic;
    text-align: right;
    margin: 0;
  }

  #forma-prelaunch-{{ section.id }} .forma-world-intro {
    max-width: 730px;
    margin: 70px auto 60px;
    text-align: center;
  }

  #forma-prelaunch-{{ section.id }} .forma-world-intro h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(38px, 6vw, 68px);
    font-weight: 400;
