<script>
  (() => {
    const root = document.getElementById('forma-launch-{{ section.id }}');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const countdown = root.querySelector('[data-countdown]');
    if (!countdown) return;

    // Danish local time: 1 December 2026 at 00:00 CET.
    const launchDate = new Date('2026-12-01T00:00:00+01:00').getTime();

    const days = countdown.querySelector('[data-days]');
    const hours = countdown.querySelector('[data-hours]');
    const minutes = countdown.querySelector('[data-minutes]');
    const seconds = countdown.querySelector('[data-seconds]');

    const pad = (value) => String(value).padStart(2, '0');

    function updateCountdown() {
      const difference = launchDate - Date.now();

      if (difference <= 0) {
        days.textContent = '00';
        hours.textContent = '00';
        minutes.textContent = '00';
        seconds.textContent = '00';
        countdown.setAttribute('aria-label', 'Launch day has arrived');
        return;
      }

      days.textContent = pad(Math.floor(difference / 86400000));
      hours.textContent = pad(Math.floor((difference % 86400000) / 3600000));
      minutes.textContent = pad(Math.floor((difference % 3600000) / 60000));
      seconds.textContent = pad(Math.floor((difference % 60000) / 1000));
    }

    updateCountdown();
    const timer = window.setInterval(updateCountdown, 1000);

    document.addEventListener('shopify:section:unload', (event) => {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        window.clearInterval(timer);
      }
    });
  })();
</script>

