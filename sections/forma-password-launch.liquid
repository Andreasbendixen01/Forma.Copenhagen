{% comment %}
  FORMA COPENHAGEN — PASSWORD PAGE
  Replace the entire contents of sections/main-password.liquid.
{% endcomment %}

<section id="forma-password-{{ section.id }}" class="forma-password">

  <!-- HEADER -->
  <header class="forma-password__header">
    <a href="/" class="forma-password__logo" aria-label="FORMA Copenhagen">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 400
          | image_tag:
            class: 'forma-password__logo-image',
            widths: '140, 220, 300, 400',
            alt: 'FORMA Copenhagen'
        }}
      {% else %}
        FORMA
      {% endif %}
    </a>

    <span class="forma-password__header-note">
      COPENHAGEN · EUROPE
    </span>
  </header>

  <!-- MAIN -->
  <main class="forma-password__main">

    <div class="forma-password__eyebrow">
      <span class="forma-password__status-dot"></span>
      SOMETHING NEW IS TAKING SHAPE
    </div>

    <h1>
      A new way<br>
      to <em>discover.</em>
    </h1>

    <p class="forma-password__intro">
      A considered world of brands, products, places and ideas.
      Discover what moves you. Find what feels like you.
      Welcome to FORMA.
    </p>

    <!-- LAUNCH DATE -->
    <div class="forma-password__launch">
      <span class="forma-password__launch-label">WE OPEN OUR DOORS</span>
      <div class="forma-password__launch-date">
        {{ section.settings.launch_date_display | escape }}
      </div>

      <div class="forma-password__countdown" data-countdown>
        <div class="forma-password__time-unit">
          <span data-days>--</span>
          <small>DAYS</small>
        </div>
        <span class="forma-password__time-separator">:</span>
        <div class="forma-password__time-unit">
          <span data-hours>--</span>
          <small>HOURS</small>
        </div>
        <span class="forma-password__time-separator">:</span>
        <div class="forma-password__time-unit">
          <span data-minutes>--</span>
          <small>MINUTES</small>
        </div>
        <span class="forma-password__time-separator">:</span>
        <div class="forma-password__time-unit">
          <span data-seconds>--</span>
          <small>SECONDS</small>
        </div>
      </div>
    </div>

    <!-- SIGNUP -->
    <div id="forma-signup-{{ section.id }}" class="forma-password__signup">

      <div class="forma-password__signup-heading">
        <span class="forma-password__signup-index">YOUR INVITATION</span>
        <span class="forma-password__signup-mark">F.</span>
      </div>

      <h2>Be first.</h2>

      <p class="forma-password__signup-description">
        Get early access to FORMA and be among the first to discover
        the brands, stories and experiences we're bringing together.
      </p>

      {% form 'customer', id: 'FormaPrelaunchForm', class: 'forma-password__form' %}

        <input
          type="hidden"
          name="contact[tags]"
          value="newsletter, forma-prelaunch"
        >

        {% if form.posted_successfully? %}

          <div class="forma-password__success" role="status">
            <span class="forma-password__success-icon">✓</span>
            <h3>You're on the list.</h3>
            <p>Thanks for being here from the beginning. Keep an eye on your inbox.</p>
          </div>

        {% else %}

          {% if form.errors %}
            <div class="forma-password__errors" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <label class="forma-password__field-label" for="FormaEmail-{{ section.id }}">
            YOUR EMAIL ADDRESS
          </label>

          <div class="forma-password__input-row">
            <input
              id="FormaEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              placeholder="Enter your email"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
            >

            <button type="submit" class="forma-password__submit">
              <span>GET EARLY ACCESS</span>
              <span class="forma-password__submit-arrow">↗</span>
            </button>
          </div>

          <label class="forma-password__consent" for="FormaConsent-{{ section.id }}">
            <input
              id="FormaConsent-{{ section.id }}"
              type="checkbox"
              name="contact[accepts_marketing]"
              value="true"
              required
            >
            <span>
              I agree to receive emails from FORMA about new discoveries,
              brand stories and selected experiences. I can unsubscribe at any time.
            </span>
          </label>

          <p class="forma-password__privacy">
            By signing up, you agree to our
            <a href="/policies/privacy-policy">Privacy Policy</a>.
          </p>

        {% endif %}

      {% endform %}

      <div class="forma-password__signup-footer">
        <span>NO NOISE. JUST GOOD DISCOVERIES.</span>
        <span>FREE TO JOIN</span>
      </div>

    </div>

    <!-- WHAT IS FORMA -->
    <div class="forma-password__what">
      <span class="forma-password__what-label">A LITTLE OF WHAT'S TO COME</span>

      <div class="forma-password__categories">
        <span>Fashion</span>
        <span>Accessories</span>
        <span>The Home</span>
        <span>Lifestyle</span>
        <span>Hotels & Stays</span>
        <span>Cafés & Restaurants</span>
        <span>Cities & Experiences</span>
        <span>Forma Journal</span>
      </div>
    </div>

  </main>

  <!-- FOOTER -->
  <footer class="forma-password__footer">
    <span>FORMA COPENHAGEN</span>
    <span>MADE FOR THE CURIOUS.</span>
    <a href="mailto:{{ section.settings.contact_email | escape }}">
      {{ section.settings.contact_email | escape }}
    </a>
  </footer>

</section>

<style>
  #forma-password-{{ section.id }} {
    --fp-bg: #f7f6f2;
    --fp-ink: #20201e;
    --fp-muted: #77756e;
    --fp-line: rgba(32,32,30,.16);
    --fp-card: #fffefa;

    min-height: 100vh;
    background: var(--fp-bg);
    color: var(--fp-ink);
    font-family: inherit;
    display: flex;
    flex-direction: column;
  }

  #forma-password-{{ section.id }} *,
  #forma-password-{{ section.id }} *::before,
  #forma-password-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #forma-password-{{ section.id }} a {
    color: inherit;
    text-decoration: none;
  }

  /* HEADER */

  #forma-password-{{ section.id }} .forma-password__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
    padding: 18px 6%;
    border-bottom: 1px solid var(--fp-line);
  }

  #forma-password-{{ section.id }} .forma-password__logo {
    font-size: 35px;
    font-weight: 500;
    line-height: .9;
    letter-spacing: -.09em;
  }

  #forma-password-{{ section.id }} .forma-password__logo-image {
    display: block;
    width: auto;
    max-width: 190px;
    max-height: 42px;
    object-fit: contain;
  }

  #forma-password-{{ section.id }} .forma-password__header-note {
    font-size: 9px;
    letter-spacing: .15em;
    color: var(--fp-muted);
  }

  /* MAIN */

  #forma-password-{{ section.id }} .forma-password__main {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 68px 24px 55px;
    text-align: center;
  }

  #forma-password-{{ section.id }} .forma-password__eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    font-size: 9px;
    letter-spacing: .15em;
  }

  #forma-password-{{ section.id }} .forma-password__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fp-ink);
    animation: forma-pulse-{{ section.id }} 2s ease-in-out infinite;
  }

  @keyframes forma-pulse-{{ section.id }} {
    0%, 100% { opacity: 1; }
    50% { opacity: .35; }
  }

  #forma-password-{{ section.id }} .forma-password__main h1 {
    margin: 28px 0 20px;
    font-size: clamp(62px, 9.2vw, 112px);
    line-height: .88;
    font-weight: 400;
    letter-spacing: -.085em;
  }

  #forma-password-{{ section.id }} .forma-password__main h1 em {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    letter-spacing: -.075em;
  }

  #forma-password-{{ section.id }} .forma-password__intro {
    max-width: 460px;
    margin: 0 auto;
    color: #626059;
    font-size: 13px;
    line-height: 1.85;
  }

  /* LAUNCH DATE */

  #forma-password-{{ section.id }} .forma-password__launch {
    margin: 38px auto 32px;
  }

  #forma-password-{{ section.id }} .forma-password__launch-label {
    display: block;
    color: var(--fp-muted);
    font-size: 8px;
    letter-spacing: .16em;
  }

  #forma-password-{{ section.id }} .forma-password__launch-date {
    margin-top: 9px;
    font-size: clamp(23px, 4vw, 32px);
    line-height: 1.2;
    letter-spacing: -.05em;
    font-weight: 400;
  }

  #forma-password-{{ section.id }} .forma-password__countdown {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 22px;
    margin-top: 20px;
  }

  #forma-password-{{ section.id }} .forma-password__time-unit {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 48px;
  }

  #forma-password-{{ section.id }} .forma-password__time-unit > span {
    font-size: 27px;
    line-height: 1;
    font-weight: 400;
    letter-spacing: -.06em;
    font-variant-numeric: tabular-nums;
  }

  #forma-password-{{ section.id }} .forma-password__time-unit small {
    color: var(--fp-muted);
    font-size: 7px;
    letter-spacing: .13em;
  }

  #forma-password-{{ section.id }} .forma-password__time-separator {
    color: #a6a39a;
    font-size: 21px;
    line-height: 1;
  }

  /* SIGNUP CARD */

  #forma-password-{{ section.id }} .forma-password__signup {
    max-width: 540px;
    margin: 0 auto;
    padding: 28px 30px 22px;
    background: var(--fp-card);
    border: 1px solid rgba(32,32,30,.08);
    box-shadow: 0 20px 65px rgba(32,32,30,.055);
    text-align: left;
    scroll-margin-top: 30px;
  }

  #forma-password-{{ section.id }} .forma-password__signup-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--fp-line);
  }

  #forma-password-{{ section.id }} .forma-password__signup-index {
    font-size: 8px;
    letter-spacing: .14em;
    color: var(--fp-muted);
  }

  #forma-password-{{ section.id }} .forma-password__signup-mark {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 26px;
    letter-spacing: -.08em;
  }

  #forma-password-{{ section.id }} .forma-password__signup h2 {
    margin: 23px 0 8px;
    font-size: 39px;
    line-height: 1;
    font-weight: 400;
    letter-spacing: -.07em;
  }

  #forma-password-{{ section.id }} .forma-password__signup-description {
    max-width: 420px;
    margin: 0 0 23px;
    color: #69675f;
    font-size: 11px;
    line-height: 1.8;
  }

  #forma-password-{{ section.id }} .forma-password__form {
    margin: 0;
  }

  #forma-password-{{ section.id }} .forma-password__field-label {
    display: block;
    margin-bottom: 8px;
    font-size: 8px;
    letter-spacing: .12em;
  }

  #forma-password-{{ section.id }} .forma-password__input-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0;
  }

  #forma-password-{{ section.id }} .forma-password__input-row input {
    width: 100%;
    min-width: 0;
    min-height: 53px;
    padding: 0 14px;
    border: 1px solid #d8d6cf;
    border-right: 0;
    border-radius: 0;
    background: white;
    color: var(--fp-ink);
    font-family: inherit;
    font-size: 12px;
    box-shadow: none;
    outline: none;
  }

  #forma-password-{{ section.id }} .forma-password__input-row input:focus {
    border-color: var(--fp-ink);
  }

  #forma-password-{{ section.id }} .forma-password__input-row input::placeholder {
    color: #a09d95;
  }

  #forma-password-{{ section.id }} .forma-password__submit {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 17px;
    min-height: 53px;
    padding: 0 15px;
    border: 1px solid var(--fp-ink);
    border-radius: 0;
    background: var(--fp-ink);
    color: white;
    font-family: inherit;
    font-size: 8px;
    letter-spacing: .1em;
    white-space: nowrap;
    cursor: pointer;
    transition: background .2s ease, color .2s ease;
  }

  #forma-password-{{ section.id }} .forma-password__submit:hover {
    background: white;
    color: var(--fp-ink);
  }

  #forma-password-{{ section.id }} .forma-password__submit-arrow {
    font-size: 16px;
  }

  #forma-password-{{ section.id }} .forma-password__consent {
    display: grid;
    grid-template-columns: 14px 1fr;
    align-items: start;
    gap: 9px;
    margin-top: 16px;
    color: #747168;
    font-size: 9px;
    line-height: 1.7;
    cursor: pointer;
  }

  #forma-password-{{ section.id }} .forma-password__consent input {
    width: 14px;
    height: 14px;
    margin: 2px 0 0;
    accent-color: var(--fp-ink);
    cursor: pointer;
  }

  #forma-password-{{ section.id }} .forma-password__privacy {
    margin: 11px 0 0;
    color: #8b887f;
    font-size: 8px;
    line-height: 1.6;
  }

  #forma-password-{{ section.id }} .forma-password__privacy a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #forma-password-{{ section.id }} .forma-password__signup-footer {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 23px;
    padding-top: 15px;
    border-top: 1px solid var(--fp-line);
    color: #8b887f;
    font-size: 7px;
    letter-spacing: .1em;
  }

  #forma-password-{{ section.id }} .forma-password__success {
    padding: 28px 0 18px;
    text-align: center;
  }

  #forma-password-{{ section.id }} .forma-password__success-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin: 0 auto 16px;
    border: 1px solid var(--fp-line);
    border-radius: 50%;
    font-size: 17px;
  }

  #forma-password-{{ section.id }} .forma-password__success h3 {
    margin: 0;
    font-size: 29px;
    font-weight: 400;
    letter-spacing: -.05em;
  }

  #forma-password-{{ section.id }} .forma-password__success p {
    margin: 10px auto 0;
    color: var(--fp-muted);
    font-size: 11px;
    line-height: 1.8;
  }

  #forma-password-{{ section.id }} .forma-password__errors {
    margin-bottom: 16px;
    color: #8d493b;
    font-size: 11px;
    line-height: 1.6;
  }

  /* CATEGORIES */

  #forma-password-{{ section.id }} .forma-password__what {
    margin: 43px auto 0;
  }

  #forma-password-{{ section.id }} .forma-password__what-label {
    display: block;
    margin-bottom: 17px;
    color: var(--fp-muted);
    font-size: 8px;
    letter-spacing: .15em;
  }

  #forma-password-{{ section.id }} .forma-password__categories {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 9px;
  }

  #forma-password-{{ section.id }} .forma-password__categories span {
    padding: 9px 13px;
    border: 1px solid var(--fp-line);
    border-radius: 30px;
    font-size: 9px;
    line-height: 1.3;
  }

  /* FOOTER */

  #forma-password-{{ section.id }} .forma-password__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: auto;
    padding: 20px 6%;
    border-top: 1px solid var(--fp-line);
    color: var(--fp-muted);
    font-size: 8px;
    letter-spacing: .1em;
  }

  #forma-password-{{ section.id }} .forma-password__footer a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 600px) {
    #forma-password-{{ section.id }} .forma-password__header {
      min-height: 65px;
      padding: 16px 20px;
    }

    #forma-password-{{ section.id }} .forma-password__logo {
      font-size: 30px;
    }

    #forma-password-{{ section.id }} .forma-password__logo-image {
      max-width: 145px;
      max-height: 34px;
    }

    #forma-password-{{ section.id }} .forma-password__header-note {
      font-size: 7px;
      letter-spacing: .1em;
    }

    #forma-password-{{ section.id }} .forma-password__main {
      padding: 53px 18px 43px;
    }

    #forma-password-{{ section.id }} .forma-password__main h1 {
      margin-top: 24px;
      font-size: clamp(56px, 14vw, 82px);
    }

    #forma-password-{{ section.id }} .forma-password__intro {
      max-width: 350px;
      font-size: 12px;
    }

    #forma-password-{{ section.id }} .forma-password__launch {
      margin: 31px auto 28px;
    }

    #forma-password-{{ section.id }} .forma-password__countdown {
      gap: clamp(10px, 4vw, 18px);
    }

    #forma-password-{{ section.id }} .forma-password__time-unit {
      min-width: 39px;
    }

    #forma-password-{{ section.id }} .forma-password__time-unit > span {
      font-size: 24px;
    }

    #forma-password-{{ section.id }} .forma-password__signup {
      padding: 23px 17px 19px;
    }

    #forma-password-{{ section.id }} .forma-password__signup h2 {
      font-size: 35px;
    }

    #forma-password-{{ section.id }} .forma-password__input-row {
      grid-template-columns: 1fr;
      gap: 9px;
    }

    #forma-password-{{ section.id }} .forma-password__input-row input {
      min-height: 51px;
      border-right: 1px solid #d8d6cf;
    }

    #forma-password-{{ section.id }} .forma-password__submit {
      min-height: 51px;
    }

    #forma-password-{{ section.id }} .forma-password__signup-footer {
      font-size: 6px;
    }

    #forma-password-{{ section.id }} .forma-password__what {
      margin-top: 34px;
    }

    #forma-password-{{ section.id }} .forma-password__categories {
      gap: 7px;
    }

    #forma-password-{{ section.id }} .forma-password__categories span {
      padding: 8px 10px;
      font-size: 8px;
    }

    #forma-password-{{ section.id }} .forma-password__footer {
      padding: 18px 20px;
      gap: 10px 16px;
      font-size: 7px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #forma-password-{{ section.id }} .forma-password__status-dot {
      animation: none;
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('forma-password-{{ section.id }}');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const countdown = root.querySelector('[data-countdown]');
    if (!countdown) return;

    const launchDate = new Date(
      {{ section.settings.launch_date | default: '2026-12-01T00:00:00+01:00' | json }}
    );

    function updateCountdown() {
      const remaining = launchDate.getTime() - Date.now();

      const values = {
        '[data-days]': Math.max(0, Math.floor(remaining / 86400000)),
        '[data-hours]': Math.max(0, Math.floor((remaining % 86400000) / 3600000)),
        '[data-minutes]': Math.max(0, Math.floor((remaining % 3600000) / 60000)),
        '[data-seconds]': Math.max(0, Math.floor((remaining % 60000) / 1000))
      };

      Object.entries(values).forEach(([selector, value]) => {
        const element = countdown.querySelector(selector);
        if (element) element.textContent = String(value).padStart(2, '0');
      });
    }

    updateCountdown();
    window.setInterval(updateCountdown, 1000);
  })();
</script>

{% schema %}
{
  "name": "FORMA Password",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "FORMA logo (optional)"
    },
    {
      "type": "text",
      "id": "launch_date_display",
      "label": "Launch date shown on page",
      "default": "1 December 2026"
    },
    {
      "type": "text",
      "id": "launch_date",
      "label": "Launch date for countdown",
      "default": "2026-12-01T00:00:00+01:00",
      "info": "Use format YYYY-MM-DDTHH:MM:SS+01:00"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email",
      "default": "hello@formacopenhagen.dk"
    }
  ],
  "presets": [
    {
      "name": "FORMA Password"
    }
  ]
}
{% endschema %}