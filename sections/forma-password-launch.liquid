
{% comment %}
  FORMA COPENHAGEN — PRE-LAUNCH EXPERIENCE
  Custom Shopify password page section.
{% endcomment %}

<section
  id="FormaLaunch-{{ section.id }}"
  class="forma-launch"
  style="
    --forma-bg: {{ section.settings.background_color }};
    --forma-text: {{ section.settings.text_color }};
    --forma-muted: {{ section.settings.muted_color }};
    --forma-line: {{ section.settings.line_color }};
    --forma-button: {{ section.settings.button_color }};
    --forma-button-text: {{ section.settings.button_text_color }};
  "
>
  <div class="forma-launch__shell">

    <!-- HEADER -->
    <header class="forma-launch__header">
      <a
        class="forma-launch__wordmark"
        href="{{ routes.root_url }}"
        aria-label="Forma Copenhagen — home"
      >
        {{ section.settings.wordmark | escape }}
      </a>

      <div class="forma-launch__header-right">
        <span class="forma-launch__edition">
          {{ section.settings.edition | escape }}
        </span>

        <span class="forma-launch__status">
          <span class="forma-launch__status-dot"></span>
          {{ section.settings.status_text | escape }}
        </span>
      </div>
    </header>

    <!-- HERO -->
    <main class="forma-launch__main">

      <div class="forma-launch__image-wrap">
        {% if section.settings.hero_image != blank %}
          {{
            section.settings.hero_image
            | image_url: width: 2600
            | image_tag:
              class: 'forma-launch__image',
              widths: '750, 1100, 1500, 2000, 2600',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: section.settings.image_alt
          }}
        {% else %}
          <div class="forma-launch__image-placeholder">
            <span>FORMA</span>
          </div>
        {% endif %}

        <div class="forma-launch__image-overlay"></div>

        <div class="forma-launch__image-meta">
          <span>{{ section.settings.image_label | escape }}</span>
          <span>{{ section.settings.image_number | escape }}</span>
        </div>
      </div>

      <div class="forma-launch__content">

        <div class="forma-launch__intro">
          <p class="forma-launch__eyebrow">
            <span class="forma-launch__eyebrow-line"></span>
            {{ section.settings.eyebrow | escape }}
          </p>

          <h1 class="forma-launch__title">
            {{ section.settings.heading | escape }}
          </h1>

          <p class="forma-launch__description">
            {{ section.settings.description | escape }}
          </p>
        </div>

        <div class="forma-launch__signup">

          <div class="forma-launch__signup-heading">
            <span class="forma-launch__micro-label">
              {{ section.settings.signup_label | escape }}
            </span>

            <span class="forma-launch__signup-number">01 / 01</span>
          </div>

          <h2 class="forma-launch__signup-title">
            {{ section.settings.signup_heading | escape }}
          </h2>

          <p class="forma-launch__signup-copy">
            {{ section.settings.signup_description | escape }}
          </p>

          {% if section.settings.klaviyo_public_key != blank and section.settings.klaviyo_form_id != blank %}

            <div
              class="klaviyo-form-{{ section.settings.klaviyo_form_id | escape }} forma-launch__klaviyo"
              aria-label="Join the Forma mailing list"
            ></div>

          {% else %}

            {% form 'customer', id: 'FormaLaunchSignup', class: 'forma-launch__form' %}

              <input
                type="hidden"
                name="contact[tags]"
                value="newsletter,forma-prelaunch"
              >

              {% if form.posted_successfully? %}
                <div class="forma-launch__notice" role="status">
                  <span class="forma-launch__notice-mark">✓</span>
                  <span>{{ section.settings.success_message | escape }}</span>
                </div>
              {% else %}

                {% if form.errors %}
                  <div class="forma-launch__error" role="alert">
                    {{ form.errors | default_errors }}
                  </div>
                {% endif %}

                <label
                  class="forma-launch__visually-hidden"
                  for="FormaLaunchEmail-{{ section.id }}"
                >
                  E-mail address
                </label>

                <div class="forma-launch__input-row">
                  <input
                    id="FormaLaunchEmail-{{ section.id }}"
                    class="forma-launch__email"
                    type="email"
                    name="contact[email]"
                    value="{{ form.email | escape }}"
                    placeholder="{{ section.settings.email_placeholder | escape }}"
                    autocomplete="email"
                    autocapitalize="off"
                    spellcheck="false"
                    required
                  >

                  <button
                    class="forma-launch__submit"
                    type="submit"
                  >
                    <span>{{ section.settings.button_label | escape }}</span>
                    <span class="forma-launch__arrow" aria-hidden="true">↗</span>
                  </button>
                </div>

                <label class="forma-launch__consent">
                  <input
                    type="checkbox"
                    name="contact[accepts_marketing]"
                    value="true"
                    required
                  >
                  <span>{{ section.settings.consent_text | escape }}</span>
                </label>

              {% endif %}

            {% endform %}

          {% endif %}

          <p class="forma-launch__privacy">
            {{ section.settings.privacy_text | escape }}
          </p>

        </div>

      </div>

      <!-- CATEGORY STRIP -->
      <div class="forma-launch__categories">
        <span>WARDROBE</span>
        <span class="forma-launch__category-separator"></span>
        <span>THE LIFESTYLE</span>
        <span class="forma-launch__category-separator"></span>
        <span>THE HOME</span>
        <span class="forma-launch__category-separator"></span>
        <span>THE FORM</span>
        <span class="forma-launch__category-separator"></span>
        <span>PLACES &amp; STORIES</span>
      </div>

    </main>

    <!-- FOOTER -->
    <footer class="forma-launch__footer">

      <div class="forma-launch__footer-brand">
        <span class="forma-launch__footer-logo">
          {{ section.settings.wordmark | escape }}
        </span>
        <span class="forma-launch__footer-tagline">
          {{ section.settings.footer_tagline | escape }}
        </span>
      </div>

      <div class="forma-launch__footer-right">
        {% if section.settings.instagram_url != blank %}
          <a
            href="{{ section.settings.instagram_url }}"
            target="_blank"
            rel="noopener noreferrer"
            class="forma-launch__social"
          >
            INSTAGRAM <span aria-hidden="true">↗</span>
          </a>
        {% endif %}

        {% if section.settings.show_password_access %}
          <details class="forma-launch__access">
            <summary>
              <span class="forma-launch__access-dot"></span>
              ENTER WITH PASSWORD
            </summary>

            <div class="forma-launch__password-panel">
              {% form 'storefront_password', class: 'forma-launch__password-form' %}
                <label
                  class="forma-launch__visually-hidden"
                  for="FormaStorefrontPassword-{{ section.id }}"
                >
                  Store password
                </label>

                <input
                  id="FormaStorefrontPassword-{{ section.id }}"
                  type="password"
                  name="password"
                  placeholder="Store password"
                  autocomplete="current-password"
                  required
                >

                <button type="submit" aria-label="Enter store">↗</button>

                {% if form.errors %}
                  <p class="forma-launch__password-error">
                    Incorrect password. Please try again.
                  </p>
                {% endif %}
              {% endform %}
            </div>
          </details>
        {% endif %}
      </div>

    </footer>

  </div>
</section>

<style>
  #FormaLaunch-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: clip;
    background: var(--forma-bg);
    color: var(--forma-text);
    font-family: inherit;
    isolation: isolate;
  }

  #FormaLaunch-{{ section.id }} *,
  #FormaLaunch-{{ section.id }} *::before,
  #FormaLaunch-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__shell {
    width: 100%;
    max-width: 1920px;
    margin-inline: auto;
    padding: 0 clamp(22px, 5.2vw, 88px);
  }

  /* HEADER */

  #FormaLaunch-{{ section.id }} .forma-launch__header {
    min-height: 90px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid var(--forma-line);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__wordmark {
    color: var(--forma-text);
    text-decoration: none;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(29px, 3vw, 42px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.055em;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__header-right {
    display: flex;
    align-items: center;
    gap: clamp(18px, 3vw, 46px);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__edition,
  #FormaLaunch-{{ section.id }} .forma-launch__status,
  #FormaLaunch-{{ section.id }} .forma-launch__micro-label {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__edition {
    color: var(--forma-muted);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--forma-text);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__status-dot,
  #FormaLaunch-{{ section.id }} .forma-launch__access-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    flex: 0 0 6px;
    border-radius: 50%;
    background: #7B8B6F;
  }

  /* HERO IMAGE */

  #FormaLaunch-{{ section.id }} .forma-launch__main {
    padding-top: clamp(20px, 2.5vw, 36px);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__image-wrap {
    position: relative;
    width: 100%;
    height: clamp(300px, 49vw, 650px);
    min-height: 0;
    overflow: hidden;
    background: #D8D4CC;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
    transform: scale(1.001);
    animation: forma-launch-image-in-{{ section.id }} 1.3s cubic-bezier(.2,.65,.3,1) both;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__image-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #d8d4cc 0%, #b7b1a7 50%, #8d887e 100%);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__image-placeholder span {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(80px, 18vw, 250px);
    letter-spacing: -0.08em;
    color: rgba(255,255,255,.65);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__image-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(0,0,0,.08) 0%,
      transparent 32%,
      transparent 65%,
      rgba(0,0,0,.34) 100%
    );
  }

  #FormaLaunch-{{ section.id }} .forma-launch__image-meta {
    position: absolute;
    inset: auto 22px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: #fff;
    font-size: 9px;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  /* CONTENT */

  #FormaLaunch-{{ section.id }} .forma-launch__content {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(310px, .7fr);
    gap: clamp(48px, 9vw, 150px);
    align-items: center;
    padding: clamp(48px, 7vw, 100px) 0 clamp(48px, 6vw, 82px);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__intro {
    max-width: 880px;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 30px;
    color: var(--forma-muted);
    font-size: 9px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__eyebrow-line {
    width: 28px;
    height: 1px;
    background: var(--forma-muted);
    flex: 0 0 28px;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__title {
    max-width: 900px;
    margin: 0;
    color: var(--forma-text);
    font-size: clamp(46px, 6.3vw, 96px);
    font-weight: 400;
    line-height: .99;
    letter-spacing: -.075em;
    text-wrap: balance;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__description {
    max-width: 480px;
    margin: 27px 0 0;
    color: var(--forma-muted);
    font-size: 14px;
    line-height: 1.85;
    letter-spacing: -.01em;
  }

  /* SIGNUP */

  #FormaLaunch-{{ section.id }} .forma-launch__signup {
    width: 100%;
    max-width: 480px;
    justify-self: end;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__signup-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--forma-line);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__micro-label {
    color: var(--forma-text);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__signup-number {
    color: var(--forma-muted);
    font-size: 9px;
    letter-spacing: .12em;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__signup-title {
    margin: 25px 0 9px;
    color: var(--forma-text);
    font-size: clamp(25px, 2.4vw, 34px);
    line-height: 1.15;
    font-weight: 400;
    letter-spacing: -.045em;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__signup-copy {
    margin: 0 0 27px;
    color: var(--forma-muted);
    font-size: 12px;
    line-height: 1.8;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__form {
    margin: 0;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__input-row {
    display: flex;
    width: 100%;
    min-height: 57px;
    border-bottom: 1px solid var(--forma-text);
    transition: border-color .25s ease;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__input-row:focus-within {
    border-color: var(--forma-muted);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__email {
    flex: 1;
    min-width: 0;
    width: 100%;
    padding: 16px 12px 16px 0;
    border: 0 !important;
    border-radius: 0 !important;
    outline: 0;
    box-shadow: none !important;
    background: transparent !important;
    color: var(--forma-text);
    font: inherit;
    font-size: 13px;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__email::placeholder {
    color: var(--forma-muted);
    opacity: .8;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    flex: 0 0 auto;
    padding: 0 0 0 18px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--forma-text);
    font: inherit;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .13em;
    text-transform: uppercase;
    cursor: pointer;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__arrow {
    display: inline-block;
    font-size: 21px;
    font-weight: 300;
    transition: transform .3s cubic-bezier(.2,.65,.3,1);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__submit:hover .forma-launch__arrow {
    transform: translate(3px, -3px);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__consent {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-top: 17px;
    color: var(--forma-muted);
    font-size: 10px;
    line-height: 1.6;
    cursor: pointer;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__consent input {
    width: 13px;
    height: 13px;
    flex: 0 0 13px;
    margin: 1px 0 0;
    accent-color: var(--forma-text);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__privacy {
    margin: 20px 0 0;
    color: var(--forma-muted);
    font-size: 10px;
    line-height: 1.7;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__notice {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px;
    border: 1px solid var(--forma-line);
    color: var(--forma-text);
    font-size: 13px;
    line-height: 1.6;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__notice-mark {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1px solid var(--forma-line);
    border-radius: 50%;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__error {
    margin-bottom: 15px;
    color: #9A3029;
    font-size: 12px;
    line-height: 1.6;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  /* CATEGORY STRIP */

  #FormaLaunch-{{ section.id }} .forma-launch__categories {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 24px;
    padding: 20px 0;
    border-top: 1px solid var(--forma-line);
    border-bottom: 1px solid var(--forma-line);
    color: var(--forma-muted);
    font-size: 8px;
    font-weight: 500;
    letter-spacing: .14em;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__category-separator {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--forma-muted);
    opacity: .7;
  }

  /* FOOTER */

  #FormaLaunch-{{ section.id }} .forma-launch__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 25px;
    padding: 29px 0 32px;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__footer-brand {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__footer-logo {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 23px;
    letter-spacing: -.06em;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__footer-tagline {
    color: var(--forma-muted);
    font-size: 9px;
    letter-spacing: .04em;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__footer-right {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__social,
  #FormaLaunch-{{ section.id }} .forma-launch__access summary {
    color: var(--forma-text);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: .12em;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__social span {
    display: inline-block;
    margin-left: 5px;
    font-size: 15px;
    transition: transform .25s ease;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__social:hover span {
    transform: translate(2px, -2px);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__access {
    position: relative;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__access summary {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__access summary::-webkit-details-marker {
    display: none;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__access-dot {
    width: 5px;
    height: 5px;
    flex-basis: 5px;
    background: var(--forma-muted);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__password-panel {
    position: absolute;
    z-index: 10;
    right: 0;
    bottom: calc(100% + 18px);
    width: min(320px, calc(100vw - 44px));
    padding: 18px;
    border: 1px solid var(--forma-line);
    background: var(--forma-bg);
    box-shadow: 0 15px 45px rgba(0,0,0,.08);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__password-form {
    display: flex;
    border-bottom: 1px solid var(--forma-text);
  }

  #FormaLaunch-{{ section.id }} .forma-launch__password-form input {
    min-width: 0;
    flex: 1;
    padding: 12px 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--forma-text);
    font: inherit;
    font-size: 12px;
    outline: none;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__password-form button {
    padding: 0 5px 0 15px;
    border: 0;
    background: transparent;
    color: var(--forma-text);
    font-size: 21px;
    cursor: pointer;
  }

  #FormaLaunch-{{ section.id }} .forma-launch__password-error {
    grid-column: 1 / -1;
    margin: 12px 0 0;
    color: #9A3029;
    font-size: 11px;
  }

  @keyframes forma-launch-image-in-{{ section.id }} {
    from {
      opacity: .6;
      transform: scale(1.035);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (min-width: 1500px) {
    #FormaLaunch-{{ section.id }} .forma-launch__content {
      grid-template-columns: minmax(0, 1.4fr) minmax(360px, .6fr);
    }
  }

  @media (max-width: 900px) {
    #FormaLaunch-{{ section.id }} .forma-launch__content {
      grid-template-columns: minmax(0, 1fr);
      gap: 44px;
      padding: 54px 0;
    }

    #FormaLaunch-{{ section.id }} .forma-launch__signup {
      max-width: 600px;
      justify-self: stretch;
    }

    #FormaLaunch-{{ section.id }} .forma-launch__title {
      max-width: 750px;
      font-size: clamp(52px, 9vw, 82px);
    }

    #FormaLaunch-{{ section.id }} .forma-launch__categories {
      justify-content: flex-start;
    }
  }

  @media (max-width: 600px) {
    #FormaLaunch-{{ section.id }} .forma-launch__shell {
      padding-inline: 20px;
    }

    #FormaLaunch-{{ section.id }} .forma-launch__header {
      min-height: 72px;
    }

    #FormaLaunch-{{ section.id }} .forma-launch__wordmark {
      font-size: 30px;
    }

    #FormaLaunch-{{ section.id }} .forma-launch__header-right {
      gap: 0;
    }

    #FormaLaunch-{{ section.id }} .forma-launch__edition {
      display: none;
    }

    #FormaLaunch-{{ section.id }} .forma-launch__status {
      font-size: 8px;
      letter-spacing: .1em;
    }

    #FormaLaunch-{{ section.id }} .forma-launch__main {
      padding-top: 16px;
    }

    #FormaLaunch-{{ section.id }} .forma-launch__image-wrap {
      height: 64svh;
      min-height: 390px;
      max-height: 620px;
    }

    #FormaLaunch-{{ section.id }} .forma-launch__image-meta {
      inset: auto 14px 14px;
      font-size: 8px;
    }

    #FormaLaunch-{{ section.id }} .forma-launch__content {
      gap: 40px;
      padding: 43px 0 45px;
    }

    #FormaLaunch-{{ section.id }} .forma-launch__eyebrow {
      margin-bottom: 23px;
      font-size: 8px;
    }

    #FormaLaunch-{{ section.id }} .forma-launch__title {
      font-size: clamp(45px, 12.5vw, 70px);
      line-height: .99;
      letter-spacing: -.075em;
    }

    #FormaLaunch-{{ section.id }} .forma-launch__description {
      margin-top: 19px;
      font-size: 13px;
    }

    #FormaLaunch-{{ section.id }} .forma-launch__signup-title {
      font-size: 29px;
    }

    #FormaLaunch-{{ section.id }} .forma-launch__categories {
