    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  #forma-launch-{{ section.id }} .forma-launch__countdown-cell {
    min-height: clamp(125px, 15vw, 205px);
    border: 1px solid var(--forma-line);
    padding: 24px 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: background 0.3s ease, color 0.3s ease;
  }

  #forma-launch-{{ section.id }} .forma-launch__countdown-cell:hover {
    background: var(--forma-ink);
    color: var(--forma-white);
  }

  #forma-launch-{{ section.id }} .forma-launch__countdown-number {
    font-size: clamp(42px, 6vw, 76px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.075em;
    font-variant-numeric: tabular-nums;
  }

  #forma-launch-{{ section.id }} .forma-launch__countdown-label {
    color: var(--forma-muted);
  }

  #forma-launch-{{ section.id }} .forma-launch__countdown-cell:hover .forma-launch__countdown-label {
    color: #c8c6bd;
  }

  #forma-launch-{{ section.id }} .forma-launch__countdown-footer {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 20px;
    color: var(--forma-muted);
  }

  #forma-launch-{{ section.id }} .forma-launch__countdown-rule {
    flex: 1;
    height: 1px;
    background: var(--forma-line);
  }

  #forma-launch-{{ section.id }} .forma-launch__waitlist {
    padding: clamp(65px, 9vw, 125px) 0;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 10vw, 150px);
    align-items: start;
    border-bottom: 1px solid var(--forma-line);
  }

  #forma-launch-{{ section.id }} .forma-launch__waitlist-copy h2 {
    font-size: clamp(55px, 7vw, 88px);
    font-weight: 400;
    letter-spacing: -0.085em;
    line-height: 0.95;
    margin: 25px 0;
  }

  #forma-launch-{{ section.id }} .forma-launch__waitlist-copy h2 span {
    color: var(--forma-muted);
  }

