<script>
  (() => {
    const root = document.getElementById('forma-prelaunch-{{ section.id }}');
    if (!root || root.dataset.formaInitialized === 'true') return;
    root.dataset.formaInitialized = 'true';

    const form = root.querySelector('[data-forma-signup]');
    const submitButton = root.querySelector('[data-submit-button]');
    const submitLabel = root.querySelector('[data-submit-label]');
    const message = root.querySelector('[data-form-message]');
    const modal = root.querySelector('[data-forma-modal]');
    const modalCopy = root.querySelector('[data-modal-copy]');
    const closeButtons = root.querySelectorAll('[data-close-modal]');
    const siteId = (root.dataset.klaviyoSiteId || '').trim();
    const listId = (root.dataset.klaviyoListId || '').trim();
    const launchDate = root.dataset.launchDate;
    let previousFocus = null;

    function setMessage(text, isError) {
      message.textContent = text;
      message.classList.add('is-visible');
      message.classList.toggle('is-error', Boolean(isError));
    }

    function openModal(copy) {
      previousFocus = document.activeElement;
      modalCopy.textContent = copy;
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.documentElement.style.overflow = 'hidden';
      const closeButton = modal.querySelector('.forma-modal-close');
      if (closeButton) closeButton.focus();
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = '';
      if (previousFocus && typeof previousFocus.focus === 'function') {
        previousFocus.focus();
      }
    }

    closeButtons.forEach((button) => {
      button.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });

    // Countdown: interprets the configured date as Copenhagen local time.
    function updateCountdown() {
      const parts = (launchDate || '').split('-').map(Number);
      if (parts.length !== 3 || parts.some((part) => !Number.isFinite(part))) return;

      const target = new Date(parts[0], parts[1] - 1, parts[2], 0, 0, 0);
      const now = new Date();
      const distance = Math.max(0, target.getTime() - now.getTime());
      const totalSeconds = Math.floor(distance / 1000);

      const values = {
        days: Math.floor(totalSeconds / 86400),
        hours: Math.floor((totalSeconds % 86400) / 3600),
        minutes: Math.floor((totalSeconds % 3600) / 60),
        seconds: totalSeconds % 60
      };

      Object.keys(values).forEach((key) => {
        const node = root.querySelector('[data-' + key + ']');
        if (node) node.textContent = String(values[key]).padStart(2, '0');
      });
    }

    updateCountdown();
    const countdownInterval = window.setInterval(updateCountdown, 1000);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      message.classList.remove('is-visible', 'is-error');

      if (!form.reportValidity()) return;

      if (!siteId || !listId) {
        setMessage(
          'The signup form is not connected yet. Please add the Klaviyo Site ID and List ID in this section’s settings.',
          true
        );
        return;
      }

      const formData = new FormData(form);
      const email = String(formData.get('email') || '').trim();
      const firstName = String(formData.get('first_name') || '').trim();
      const lastName = String(formData.get('last_name') || '').trim();
      const birthday = String(formData.get('birthday') || '').trim();
      const consent = form.querySelector('[name="marketing_consent"]').checked;

      if (!consent) {
        setMessage('Please confirm that you agree to receive emails from FORMA.', true);
        return;
      }

      const birthdayDate = new Date(birthday + 'T12:00:00');
      if (
        !birthday ||
        Number.isNaN(birthdayDate.getTime()) ||
        birthdayDate > new Date()
      ) {
        setMessage('Please enter a valid date of birth.', true);
        return;
      }

      submitButton.disabled = true;
      submitLabel.textContent = 'PLEASE WAIT…';

      try {
        const response = await fetch(
          'https://a.klaviyo.com/client/subscriptions/?company_id=' +
            encodeURIComponent(siteId),
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/vnd.api+json',
              'revision': '2025-04-15'
            },
            body: JSON.stringify({
              data: {
                type: 'subscription',
                attributes: {
                  custom_source: 'FORMA Copenhagen Pre-Launch',
                  profile: {
                    data: {
                      type: 'profile',
                      attributes: {
                        email: email,
                        first_name: firstName,
                        last_name: lastName,
                        properties: {
                          birthday: birthday
                        },
                        subscriptions: {
                          email: {
                            marketing: {
                              consent: 'SUBSCRIBED'
                            }
                          }
                        }
                      }
                    }
                  }
                },
                relationships: {
                  list: {
                    data: {
                      type: 'list',
                      id: listId
                    }
                  }
                }
              }
            })
          }
        );

        if (response.ok) {
          form.reset();
          setMessage('', false);
          openModal(
            'Thank you for joining FORMA. If confirmation is required, please check your inbox to confirm your subscription. Your next discovery is just around the corner.'
          );
        } else {
          let errorText = '';
          try {
            const result = await response.json();
            errorText = (result.errors || [])
              .map((item) => item.detail || item.title)
              .filter(Boolean)
              .join(' ');
          } catch (error) {}

          setMessage(
            errorText ||
              'We couldn’t complete your signup just now. Please check your details and try again.',
            true
          );
        }
      } catch (error) {
        setMessage(
          'We couldn’t connect securely to the signup service. Please try again in a moment.',
          true
        );
      } finally {
        submitButton.disabled = false;
        submitLabel.textContent = {{ section.settings.button_label | json }};
      }
    });

    // Theme editor may re-render this section; clear the interval when removed.
    document.addEventListener('shopify:section:unload', (event) => {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        window.clearInterval(countdownInterval);
      }
    });
  })();
</script>

