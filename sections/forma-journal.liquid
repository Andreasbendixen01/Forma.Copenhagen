{%- assign journal_blog = section.settings.blog -%}
{%- if journal_blog != blank and journal_blog.articles_count > 0 -%}
<section id="forma-journal-{{ section.id }}" class="forma-journal">
  <div class="forma-journal__inner">
    <div class="forma-journal__header">
      <div>
        <p class="forma-journal__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2 class="forma-journal__title">{{ section.settings.heading | escape }}</h2>
      </div>
      <a class="forma-journal__all" href="{{ journal_blog.url }}">{{ section.settings.view_all_label | escape }} <span aria-hidden="true">‚Üí</span></a>
    </div>
    <div class="forma-journal__grid">
      {%- for article in journal_blog.articles limit: section.settings.articles_to_show -%}
        <article class="forma-journal__card">
          <a class="forma-journal__image-link" href="{{ article.url }}">
            {%- if article.image != blank -%}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 750px) 33vw, 90vw', alt: article.image.alt | default: article.title, class: 'forma-journal__image' }}
            {%- else -%}
              <div class="forma-journal__image forma-journal__image--empty"></div>
            {%- endif -%}
          </a>
          <div class="forma-journal__meta">
            {%- if article.tags.size > 0 -%}<span>{{ article.tags.first | escape }}</span>{%- endif -%}
            <span>{{ article.published_at | date: "%d.%m.%Y" }}</span>
          </div>
          <h3 class="forma-journal__article-title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
          {%- if section.settings.show_excerpt and article.excerpt != blank -%}
            <p class="forma-journal__excerpt">{{ article.excerpt | strip_html | truncate: 135 }}</p>
          {%- endif -%}
          <a class="forma-journal__read" href="{{ article.url }}">{{ section.settings.read_label | escape }} <span aria-hidden="true">‚Üí</span></a>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
  #forma-journal-{{ section.id }} { padding: clamp(40px, 6vw, 90px) 24px; background: {{ section.settings.background }}; color: {{ section.settings.text_color }}; }
  #forma-journal-{{ section.id }} .forma-journal__inner { max-width: 1440px; margin: 0 auto; }
  #forma-journal-{{ section.id }} .forma-journal__header { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 30px; }
  #forma-journal-{{ section.id }} .forma-journal__eyebrow { margin: 0 0 12px; font-size: 10px; letter-spacing: .18em; text-transform: uppercase; opacity: .65; }
  #forma-journal-{{ section.id }} .forma-journal__title { margin: 0; font-size: clamp(30px, 4vw, 52px); font-weight: 400; letter-spacing: -.04em; line-height: 1.1; }
  #forma-journal-{{ section.id }} .forma-journal__all, #forma-journal-{{ section.id }} .forma-journal__read { display: inline-flex; gap: 14px; align-items: center; color: inherit; text-decoration: none; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  #forma-journal-{{ section.id }} .forma-journal__grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 24px; }
  #forma-journal-{{ section.id }} .forma-journal__image-link { display: block; overflow: hidden; background: rgba(0,0,0,.04); }
  #forma-journal-{{ section.id }} .forma-journal__image { display: block; width: 100%; aspect-ratio: 4/5; object-fit: cover; transition: transform .45s ease; }
  #forma-journal-{{ section.id }} .forma-journal__image-link:hover .forma-journal__image { transform: scale(1.025); }
  #forma-journal-{{ section.id }} .forma-journal__image--empty { background: #e9e6df; }
  #forma-journal-{{ section.id }} .forma-journal__meta { display: flex; gap: 14px; margin-top: 16px; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; opacity: .65; }
  #forma-journal-{{ section.id }} .forma-journal__article-title { margin: 10px 0 8px; font-size: clamp(19px, 2vw, 25px); line-height: 1.2; font-weight: 400; letter-spacing: -.025em; }
  #forma-journal-{{ section.id }} .forma-journal__article-title a { color: inherit; text-decoration: none; }
  #forma-journal-{{ section.id }} .forma-journal__excerpt { font-size: 13px; line-height: 1.7; opacity: .75; }
  #forma-journal-{{ section.id }} .forma-journal__read { margin-top: 8px; padding-bottom: 6px; border-bottom: 1px solid currentColor; }
  @media(max-width: 749px) { #forma-journal-{{ section.id }} { padding: 34px 18px; } #forma-journal-{{ section.id }} .forma-journal__header { align-items: start; flex-direction: column; } #forma-journal-{{ section.id }} .forma-journal__grid { grid-template-columns: 1fr; gap: 30px; } #forma-journal-{{ section.id }} .forma-journal__image { aspect-ratio: 5/4; } }
</style>
{%- endif -%}
{% schema %}
{
  "name": "Forma Journal",
  "settings": [
    {"type":"blog","id":"blog","label":"Journal blog"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Ideas, places and people"},
    {"type":"text","id":"heading","label":"Heading","default":"From Forma Journal"},
    {"type":"range","id":"articles_to_show","label":"Articles to show","min":1,"max":3,"step":1,"default":3},
    {"type":"checkbox","id":"show_excerpt","label":"Show article excerpt","default":true},
    {"type":"text","id":"view_all_label","label":"View all label","default":"Explore the journal"},
    {"type":"text","id":"read_label","label":"Read link label","default":"Read story"},
    {"type":"color","id":"background","label":"Background","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text","default":"#1D1D1B"}
  ],
  "presets":[{"name":"Forma Journal"}]
}
{% endschema %}

