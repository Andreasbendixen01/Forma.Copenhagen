
{% liquid
  assign brands = shop.metaobjects.forma_brand.values
  assign total_brands = 0
  assign featured_count = 0

  for brand in brands
    if brand.brand_name.value != blank
      assign total_brands = total_brands | plus: 1
      if brand.featured.value == true
        assign featured_count = featured_count | plus: 1
      endif
    endif
  endfor
%}

<section id="forma-brand-index-{{ section.id }}" class="forma-brand-index">

  <div class="fbi-shell">

    <!-- DIRECTORY -->
    <div class="fbi-directory">

      <div class="fbi-directory-top">

        <div class="fbi-directory-title">
          <h2>Explore all brands</h2>
        </div>

        <div class="fbi-search-wrap">
          <input
            type="search"
            id="fbi-search-{{ section.id }}"
            placeholder="Find a brand"
            aria-label="Search brands"
            autocomplete="off"
          >
          <span class="fbi-search-icon">‚åï</span>
          <span class="fbi-search-shortcut">SEARCH</span>
        </div>

      </div>

      <!-- CATEGORY FILTERS -->
      <div class="fbi-filter-row">

        <div class="fbi-category-filters" id="fbi-categories-{{ section.id }}">
          <button class="fbi-category-button is-active" data-category="all" type="button">
            All brands
          </button>
        </div>

        <div class="fbi-result-count">
          <span id="fbi-result-count-{{ section.id }}">{{ total_brands }}</span>
          <span>RESULTS</span>
        </div>

      </div>

      <!-- ALPHABET -->
      <div class="fbi-alphabet-wrap">

        <span class="fbi-alphabet-label">INDEX</span>

        <div class="fbi-alphabet" id="fbi-alphabet-{{ section.id }}">
          {% assign alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ" | split: "" %}
          {% for letter in alphabet %}
            <button
              class="fbi-letter"
              type="button"
              data-letter="{{ letter }}"
              aria-label="Filter brands starting with {{ letter }}"
            >
              {{ letter }}
            </button>
          {% endfor %}
          <button class="fbi-letter fbi-letter-reset" type="button" data-letter="all" aria-label="Show all letters">
            ALL
          </button>
        </div>

      </div>

      <!-- BRAND GRID -->
      <div class="fbi-grid" id="fbi-grid-{{ section.id }}">

        {% for brand in brands %}
          {% if brand.brand_name.value != blank %}

            {% assign b_name = brand.brand_name.value %}
            {% assign b_logo = brand.logo.value %}
            {% assign b_category = brand.category.value %}
            {% assign b_description = brand.description.value %}
            {% assign b_website = brand.website.value.url %}
            {% assign b_forma_url = brand.forma_url.value.url %}
            {% assign b_featured = brand.featured.value %}
            {% assign b_sort = brand.sort_order.value %}

            <article
              class="fbi-card"
              data-name="{{ b_name | escape }}"
              data-category="{{ b_category | escape }}"
              data-sort="{{ b_sort | default: 9999 }}"
            >
              <div class="fbi-card-visual">
                {% if b_logo != blank %}
                  <img src="{{ b_logo | image_url: width: 600 }}" alt="{{ b_name | escape }}" loading="lazy">
                {% else %}
                  <span class="fbi-card-fallback">{{ b_name }}</span>
                {% endif %}
                {% if b_forma_url != blank or b_website != blank %}
                  <div class="fbi-card-actions">
                    {% if b_forma_url != blank %}<a href="{{ b_forma_url }}" class="fbi-action fbi-action--forma">Explore on Forma <span>‚Üó</span></a>{% endif %}
                    {% if b_website != blank %}<a href="{{ b_website }}" class="fbi-action" target="_blank" rel="noopener noreferrer">Visit website <span>‚Üó</span></a>{% endif %}
                  </div>
                {% endif %}
              </div>
              <div class="fbi-card-information">
                <div class="fbi-card-title-row"><h3>{{ b_name }}</h3>{% if b_category != blank %}<span class="fbi-card-category">{{ b_category }}</span>{% endif %}</div>
                {% if b_description != blank %}<p>{{ b_description | strip_html | truncate: 90 }}</p>{% endif %}
              </div>
            </article>

          {% endif %}
        {% endfor %}

      </div>

      <!-- EMPTY STATE -->
      <div class="fbi-empty" id="fbi-empty-{{ section.id }}" hidden>
        <span class="fbi-empty-title">Nothing found.</span>
        <p>Try another search or explore a different category.</p>
        <button type="button" id="fbi-reset-{{ section.id }}">RESET FILTERS</button>
      </div>

    </div>

  </div>

</section>

<style>
#forma-brand-index-{{ section.id }}{--fbi-bg:{{section.settings.background}};--fbi-text:{{section.settings.text}};--fbi-muted:{{section.settings.muted}};--fbi-line:{{section.settings.line}};--fbi-card-bg:{{section.settings.card_background}};background:var(--fbi-bg);color:var(--fbi-text);width:100%;overflow:hidden}
#forma-brand-index-{{section.id}} *{box-sizing:border-box}
#forma-brand-index-{{section.id}} .fbi-shell{max-width:{{section.settings.max_width}}px;margin:0 auto;padding:24px 45px 55px}
#forma-brand-index-{{section.id}} .fbi-directory{padding-top:0}
#forma-brand-index-{{section.id}} .fbi-directory-top{display:flex;justify-content:space-between;align-items:center;gap:25px;margin-bottom:24px}
#forma-brand-index-{{section.id}} .fbi-directory-title h2{font-size:clamp(22px,2.5vw,34px);line-height:1;letter-spacing:-.055em;font-weight:400;margin:0}
#forma-brand-index-{{section.id}} .fbi-search-wrap{position:relative;width:min(100%,340px);border-bottom:1px solid #bdbdbd}
#forma-brand-index-{{section.id}} .fbi-search-wrap input{width:100%;height:44px;border:0;background:transparent;color:var(--fbi-text);padding:0 65px 0 0;font-size:14px;outline:none}
#forma-brand-index-{{section.id}} .fbi-search-wrap input::placeholder{color:#888}
#forma-brand-index-{{section.id}} .fbi-search-icon{position:absolute;right:40px;top:50%;transform:translateY(-50%);font-size:20px;opacity:.6;pointer-events:none}
#forma-brand-index-{{section.id}} .fbi-search-shortcut{position:absolute;right:0;top:50%;transform:translateY(-50%);font-size:9px;letter-spacing:.1em;opacity:.45}
#forma-brand-index-{{section.id}} .fbi-filter-row{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:0 0 17px;border:0}
#forma-brand-index-{{section.id}} .fbi-category-filters{display:flex;gap:9px;flex-wrap:wrap}
#forma-brand-index-{{section.id}} .fbi-category-button{border:1px solid #dedede;border-radius:999px;background:transparent;color:var(--fbi-text);padding:11px 20px;font-size:12px;cursor:pointer;transition:all .22s ease}
#forma-brand-index-{{section.id}} .fbi-category-button:hover,#forma-brand-index-{{section.id}} .fbi-category-button.is-active{background:var(--fbi-text);color:var(--fbi-bg);border-color:var(--fbi-text)}
#forma-brand-index-{{section.id}} .fbi-result-count{display:flex;gap:7px;align-items:baseline;font-size:10px;letter-spacing:.1em;white-space:nowrap;color:var(--fbi-muted)}
#forma-brand-index-{{section.id}} .fbi-result-count span:first-child{font-size:15px;color:var(--fbi-text)}
#forma-brand-index-{{section.id}} .fbi-alphabet-wrap{display:flex;align-items:center;gap:14px;padding:12px 0 24px;border:0}
#forma-brand-index-{{section.id}} .fbi-alphabet-label{font-size:9px;letter-spacing:.1em;color:#999;flex-shrink:0}
#forma-brand-index-{{section.id}} .fbi-alphabet{display:flex;flex-wrap:wrap;align-items:center;gap:2px}
#forma-brand-index-{{section.id}} .fbi-letter{border:0;border-radius:999px;background:transparent;color:var(--fbi-text);cursor:pointer;padding:5px 7px;font-size:10px;opacity:.45;transition:.2s}
#forma-brand-index-{{section.id}} .fbi-letter:hover,#forma-brand-index-{{section.id}} .fbi-letter.is-active{opacity:1;background:var(--fbi-text);color:var(--fbi-bg)}
#forma-brand-index-{{section.id}} .fbi-letter:disabled{opacity:.12;cursor:default;background:transparent;color:var(--fbi-text)}
#forma-brand-index-{{section.id}} .fbi-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px 20px}
#forma-brand-index-{{section.id}} .fbi-card{min-width:0}
#forma-brand-index-{{section.id}} .fbi-card-visual{position:relative;background:var(--fbi-card-bg);aspect-ratio:1/1;padding:22%;display:flex;align-items:center;justify-content:center;overflow:hidden}
#forma-brand-index-{{section.id}} .fbi-card-visual img{width:100%;height:100%;object-fit:contain;transition:transform .45s ease}
#forma-brand-index-{{section.id}} .fbi-card:hover .fbi-card-visual img{transform:scale(1.035)}
#forma-brand-index-{{section.id}} .fbi-card-fallback{font-size:20px;text-align:center}
/* Refined hover: discreet bottom action dock, never obscures the logo */
#forma-brand-index-{{section.id}} .fbi-card-actions{position:absolute;left:50%;bottom:14px;transform:translate(-50%,12px);width:max-content;max-width:calc(100% - 24px);display:flex;flex-wrap:wrap;justify-content:center;gap:7px;padding:7px;background:rgba(255,255,255,.88);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.7);border-radius:999px;box-shadow:0 5px 20px rgba(0,0,0,.08);opacity:0;transition:opacity .25s ease,transform .25s ease}
#forma-brand-index-{{section.id}} .fbi-card:hover .fbi-card-actions,#forma-brand-index-{{section.id}} .fbi-card:focus-within .fbi-card-actions{opacity:1;transform:translate(-50%,0)}
#forma-brand-index-{{section.id}} .fbi-action{display:inline-flex;align-items:center;gap:12px;border-radius:999px;padding:11px 15px;background:#fff;color:#111;text-decoration:none;font-size:11px;white-space:nowrap;transition:background .2s,color .2s}
#forma-brand-index-{{section.id}} .fbi-action:hover{background:#111;color:#fff}
#forma-brand-index-{{section.id}} .fbi-action--forma{background:#111;color:#fff}
#forma-brand-index-{{section.id}} .fbi-action--forma:hover{background:#444}
#forma-brand-index-{{section.id}} .fbi-card-information{padding-top:13px}
#forma-brand-index-{{section.id}} .fbi-card-title-row{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
#forma-brand-index-{{section.id}} .fbi-card-title-row h3{margin:0;font-size:15px;line-height:1.3;font-weight:400;letter-spacing:-.02em}
#forma-brand-index-{{section.id}} .fbi-card-category{font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:var(--fbi-muted);text-align:right}
#forma-brand-index-{{section.id}} .fbi-card-information p{margin:6px 0 0;font-size:12px;line-height:1.5;color:var(--fbi-muted);max-width:360px}
#forma-brand-index-{{section.id}} .fbi-empty{text-align:center;padding:50px 20px}#forma-brand-index-{{section.id}} .fbi-empty-title{display:block;font-size:28px}#forma-brand-index-{{section.id}} .fbi-empty p{color:var(--fbi-muted);font-size:13px}
@media(max-width:1100px){#forma-brand-index-{{section.id}} .fbi-grid{grid-template-columns:repeat(2,minmax(0,1fr));}}
@media(max-width:749px){#forma-brand-index-{{section.id}} .fbi-shell{padding:20px 18px 40px}#forma-brand-index-{{section.id}} .fbi-directory-top{display:block}#forma-brand-index-{{section.id}} .fbi-search-wrap{margin-top:20px;width:100%}#forma-brand-index-{{section.id}} .fbi-filter-row{display:block}#forma-brand-index-{{section.id}} .fbi-result-count{margin-top:15px}#forma-brand-index-{{section.id}} .fbi-alphabet-wrap{display:block;padding:16px 0 20px}#forma-brand-index-{{section.id}} .fbi-alphabet-label{display:block;margin-bottom:8px}#forma-brand-index-{{section.id}} .fbi-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:26px 12px}#forma-brand-index-{{section.id}} .fbi-card-visual{padding:17%}#forma-brand-index-{{section.id}} .fbi-card-actions{opacity:1;transform:translate(-50%,0);bottom:8px;max-width:calc(100% - 12px);padding:4px;gap:4px}#forma-brand-index-{{section.id}} .fbi-action{font-size:9px;padding:8px 10px;gap:5px}#forma-brand-index-{{section.id}} .fbi-card-title-row{display:block}#forma-brand-index-{{section.id}} .fbi-card-category{display:block;text-align:left;margin-top:4px}}
</style>

<script>
(function() {
  const root = document.getElementById('forma-brand-index-{{ section.id }}');
  if (!root || root.dataset.initialized === 'true') return;
  root.dataset.initialized = 'true';

  const grid = root.querySelector('#fbi-grid-{{ section.id }}');
  const search = root.querySelector('#fbi-search-{{ section.id }}');
  const categoriesEl = root.querySelector('#fbi-categories-{{ section.id }}');
  const alphabetEl = root.querySelector('#fbi-alphabet-{{ section.id }}');
  const emptyEl = root.querySelector('#fbi-empty-{{ section.id }}');
  const resetButton = root.querySelector('#fbi-reset-{{ section.id }}');
  const resultCountEl = root.querySelector('#fbi-result-count-{{ section.id }}');
  const totalEl = root.querySelector('#fbi-total-{{ section.id }}');

  if (!grid || !search || !categoriesEl || !alphabetEl) return;

  const cards = Array.from(grid.querySelectorAll('.fbi-card'));

  const normalize = value => (value || '')
    .toLowerCase()
    .trim()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '');

  cards.sort((a, b) => {
    const aSort = Number(a.dataset.sort || 9999);
    const bSort = Number(b.dataset.sort || 9999);

    if (aSort !== bSort && aSort !== 9999 && bSort !== 9999) {
      return aSort - bSort;
    }

    return a.dataset.name.localeCompare(b.dataset.name, undefined, {
      sensitivity: 'base'
    });
  });

  cards.forEach(card => grid.appendChild(card));

  const categoryNames = [...new Set(
    cards.map(card => card.dataset.category.trim()).filter(Boolean)
  )].sort((a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }));

  categoryNames.forEach(category => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'fbi-category-button';
    button.dataset.category = category;
    button.textContent = category;
    categoriesEl.appendChild(button);
  });

  const letterButtons = Array.from(
    alphabetEl.querySelectorAll('.fbi-letter')
  );

  let selectedCategory = 'all';
  let selectedLetter = 'all';
  let searchTerm = '';

  function update() {
    let visibleCount = 0;
    const visibleLetters = new Set();

    cards.forEach(card => {
      const name = card.dataset.name || '';
      const category = card.dataset.category || '';
      const firstLetter = name.trim().charAt(0).toUpperCase();

      const matchesCategory =
        selectedCategory === 'all' ||
        normalize(category) === normalize(selectedCategory);

      const matchesSearch =
        normalize(name).includes(normalize(searchTerm));

      const matchesLetter =
        selectedLetter === 'all' ||
        firstLetter === selectedLetter;

      const visible = matchesCategory && matchesSearch && matchesLetter;

      card.style.display = visible ? '' : 'none';

      if (visible) {
        visibleCount++;
        visibleLetters.add(firstLetter);
      }
    });

    categoriesEl.querySelectorAll('.fbi-category-button').forEach(button => {
      button.classList.toggle(
        'is-active',
        normalize(button.dataset.category) === normalize(selectedCategory)
      );
    });

    letterButtons.forEach(button => {
      const letter = button.dataset.letter;
      const isReset = letter === 'all';

      button.disabled = !isReset && !visibleLetters.has(letter);

      button.classList.toggle(
        'is-active',
        isReset ? selectedLetter === 'all' : selectedLetter === letter
      );
    });

    if (resultCountEl) resultCountEl.textContent = visibleCount;
    if (totalEl) totalEl.textContent = cards.length;

    if (emptyEl) emptyEl.hidden = visibleCount > 0;
  }

  categoriesEl.addEventListener('click', function(event) {
    const button = event.target.closest('.fbi-category-button');
    if (!button) return;

    selectedCategory = button.dataset.category;
    selectedLetter = 'all';
    update();
  });

  alphabetEl.addEventListener('click', function(event) {
    const button = event.target.closest('.fbi-letter');
    if (!button || button.disabled) return;

    selectedLetter = button.dataset.letter;
    update();
  });

  search.addEventListener('input', function() {
    searchTerm = search.value;
    selectedLetter = 'all';
    update();
  });

  if (resetButton) {
    resetButton.addEventListener('click', function() {
      search.value = '';
      searchTerm = '';
      selectedCategory = 'all';
      selectedLetter = 'all';
      update();
    });
  }

  update();
})();
</script>

{% schema %}
{
  "name": "Forma Brand Index",
  "settings": [
        
    
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 1000,
      "max": 2000,
      "step": 100,
      "default": 1600
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted",
      "label": "Muted text",
      "default": "#777777"
    },
    {
      "type": "color",
      "id": "line",
      "label": "Border",
      "default": "#DCDCDC"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Brand image background",
      "default": "#F4F3F0"
    }
  ],
  "presets": [
    {
      "name": "Forma Brand Index"
    }
  ]
}
{% endschema %}

