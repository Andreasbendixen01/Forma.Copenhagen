
{% liquid
  assign brands = shop.metaobjects.forma_brand.values
  assign total_brands = 0

  for brand in brands
    if brand.brand_name.value != blank
      assign total_brands = total_brands | plus: 1
    endif
  endfor
%}

<section id="forma-brand-index-{{ section.id }}" class="forma-brand-index">

  <div class="fbi-shell">

    <!-- HEADER -->
    <div class="fbi-intro">

      <div class="fbi-intro-copy">
        <span class="fbi-kicker">{{ section.settings.kicker }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.intro }}</p>
      </div>

      <div class="fbi-search-wrap">
        <input
          type="search"
          id="fbi-search-{{ section.id }}"
          placeholder="Find a brand"
          aria-label="Search brands"
          autocomplete="off"
        >
        <span class="fbi-search-shortcut">SEARCH</span>
      </div>

    </div>

    <!-- FILTERS -->
    <div class="fbi-toolbar">

      <div class="fbi-category-filters" id="fbi-categories-{{ section.id }}">
        <button
          class="fbi-category-button is-active"
          data-category="all"
          type="button"
        >
          All brands
        </button>
      </div>

      <div class="fbi-result-count">
        <span id="fbi-result-count-{{ section.id }}">{{ total_brands }}</span>
        <span>BRANDS</span>
      </div>

    </div>

    <!-- ALPHABET -->
    <div class="fbi-alphabet-wrap">

      <span class="fbi-alphabet-label">INDEX</span>

      <div class="fbi-alphabet" id="fbi-alphabet-{{ section.id }}">

        {% assign alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ" | split: "" %}

        {% for letter in alphabet %}
          <button
            class="fbi-letter"
            type="button"
            data-letter="{{ letter }}"
            aria-label="Filter brands starting with {{ letter }}"
          >
            {{ letter }}
          </button>
        {% endfor %}

        <button
          class="fbi-letter fbi-letter-reset"
          type="button"
          data-letter="all"
          aria-label="Show all letters"
        >
          ALL
        </button>

      </div>

    </div>

    <!-- BRAND GRID -->
    <div class="fbi-grid" id="fbi-grid-{{ section.id }}">

      {% for brand in brands %}

        {% if brand.brand_name.value != blank %}

          {% assign b_name = brand.brand_name.value %}
          {% assign b_logo = brand.logo.value %}
          {% assign b_category = brand.category.value %}
          {% assign b_description = brand.description.value %}
          {% assign b_website = brand.website.value.url %}
          {% assign b_forma_url = brand.forma_url.value.url %}
          {% assign b_sort = brand.sort_order.value %}

          <article
            class="fbi-card"
            data-name="{{ b_name | escape }}"
            data-category="{{ b_category | escape }}"
            data-sort="{{ b_sort | default: 9999 }}"
          >

            <a
              {% if b_forma_url != blank %}
                href="{{ b_forma_url }}"
              {% elsif b_website != blank %}
                href="{{ b_website }}"
                target="_blank"
                rel="noopener noreferrer"
              {% else %}
                href="#"
              {% endif %}
              class="fbi-card-main"
              {% if b_forma_url == blank and b_website == blank %}
                aria-disabled="true"
              {% endif %}
            >

              <!-- BRAND VISUAL -->
              <div class="fbi-card-visual">

                {% if b_logo != blank %}

                  <img
                    src="{{ b_logo | image_url: width: 1000 }}"
                    alt="{{ b_name | escape }}"
                    loading="lazy"
                  >

                {% else %}

                  <span class="fbi-card-fallback">
                    {{ b_name }}
                  </span>

                {% endif %}

                <div class="fbi-card-overlay">

                  <span class="fbi-overlay-link">
                    Discover brand
                    <span class="fbi-arrow">↗</span>
                  </span>

                </div>

              </div>

              <!-- BRAND INFORMATION -->
              <div class="fbi-card-information">

                <div class="fbi-card-title-row">

                  <h3>{{ b_name }}</h3>

                  {% if b_category != blank %}
                    <span class="fbi-card-category">
                      {{ b_category }}
                    </span>
                  {% endif %}

                </div>

                {% if b_description != blank %}
                  <p>
                    {{ b_description | strip_html | truncate: 120 }}
                  </p>
                {% endif %}

              </div>

            </a>

            <!-- SECONDARY LINKS -->
            {% if b_forma_url != blank or b_website != blank %}

              <div class="fbi-secondary-links">

                {% if b_forma_url != blank %}
                  <a
                    href="{{ b_forma_url }}"
                    class="fbi-secondary-link"
                  >
                    Explore on Forma
                    <span>↗</span>
                  </a>
                {% endif %}

                {% if b_website != blank %}
                  <a
                    href="{{ b_website }}"
                    class="fbi-secondary-link"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Official website
                    <span>↗</span>
                  </a>
                {% endif %}

              </div>

            {% endif %}

          </article>

        {% endif %}

      {% endfor %}

    </div>

    <!-- EMPTY STATE -->
    <div class="fbi-empty" id="fbi-empty-{{ section.id }}" hidden>

      <span class="fbi-empty-title">No brands found.</span>

      <p>
        Try another search or explore a different category.
      </p>

      <button
        type="button"
        id="fbi-reset-{{ section.id }}"
      >
        RESET FILTERS
      </button>

    </div>

  </div>

</section>

<style>

#forma-brand-index-{{ section.id }} {
  background: #FFFFFF;
  color: #111111;
  width: 100%;
  overflow: hidden;

  --fbi-text: #111111;
  --fbi-muted: #888888;
  --fbi-line: #E8E8E8;
  --fbi-white: #FFFFFF;
}

#forma-brand-index-{{ section.id }} * {
  box-sizing: border-box;
}

/* SHELL */

#forma-brand-index-{{ section.id }} .fbi-shell {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  padding: 65px 45px 85px;
}

/* INTRO */

#forma-brand-index-{{ section.id }} .fbi-intro {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 50px;
  margin-bottom: 55px;
}

#forma-brand-index-{{ section.id }} .fbi-intro-copy {
  max-width: 720px;
}

#forma-brand-index-{{ section.id }} .fbi-kicker {
  display: block;
  font-size: 10px;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: #888888;
  margin-bottom: 22px;
}

#forma-brand-index-{{ section.id }} .fbi-intro h2 {
  font-size: clamp(36px, 5vw, 66px);
  line-height: .98;
  letter-spacing: -.065em;
  font-weight: 400;
  margin: 0;
}

#forma-brand-index-{{ section.id }} .fbi-intro-copy p {
  font-size: 14px;
  line-height: 1.7;
  font-weight: 400;
  color: #777777;
  max-width: 480px;
  margin: 22px 0 0;
}

/* SEARCH */

#forma-brand-index-{{ section.id }} .fbi-search-wrap {
  position: relative;
  width: min(100%, 340px);
  flex-shrink: 0;
  border-bottom: 1px solid #D8D8D8;
}

#forma-brand-index-{{ section.id }} .fbi-search-wrap input {
  width: 100%;
  height: 48px;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #111111;
  padding: 0 70px 0 0;
  font-size: 13px;
  outline: none;
  box-shadow: none;
}

#forma-brand-index-{{ section.id }} .fbi-search-wrap input::placeholder {
  color: #999999;
  opacity: 1;
}

#forma-brand-index-{{ section.id }} .fbi-search-shortcut {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  font-size: 9px;
  letter-spacing: .12em;
  color: #888888;
}

/* TOOLBAR */

#forma-brand-index-{{ section.id }} .fbi-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 25px;
  padding-bottom: 22px;
}

#forma-brand-index-{{ section.id }} .fbi-category-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

#forma-brand-index-{{ section.id }} .fbi-category-button {
  border: 1px solid #E5E5E5;
  border-radius: 999px;
  background: #FFFFFF;
  color: #111111;
  padding: 12px 22px;
  font-size: 11px;
  letter-spacing: .01em;
  cursor: pointer;
  transition:
    background .25s ease,
    color .25s ease,
    border-color .25s ease;
}

#forma-brand-index-{{ section.id }} .fbi-category-button:hover,
#forma-brand-index-{{ section.id }} .fbi-category-button.is-active {
  background: #111111;
  color: #FFFFFF;
  border-color: #111111;
}

#forma-brand-index-{{ section.id }} .fbi-result-count {
  display: flex;
  align-items: baseline;
  gap: 7px;
  font-size: 9px;
  letter-spacing: .14em;
  color: #888888;
  white-space: nowrap;
}

#forma-brand-index-{{ section.id }} .fbi-result-count span:first-child {
  font-size: 15px;
  letter-spacing: 0;
  color: #111111;
}

/* ALPHABET */

#forma-brand-index-{{ section.id }} .fbi-alphabet-wrap {
  display: flex;
  align-items: center;
  gap: 22px;
  padding: 22px 0 38px;
}

#forma-brand-index-{{ section.id }} .fbi-alphabet-label {
  font-size: 9px;
  letter-spacing: .15em;
  color: #888888;
  flex-shrink: 0;
}

#forma-brand-index-{{ section.id }} .fbi-alphabet {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px;
}

#forma-brand-index-{{ section.id }} .fbi-letter {
  border: 0;
  background: transparent;
  color: #111111;
  cursor: pointer;
  padding: 6px 7px;
  font-size: 10px;
  font-weight: 400;
  opacity: .45;
  transition: opacity .2s ease;
}

#forma-brand-index-{{ section.id }} .fbi-letter:hover,
#forma-brand-index-{{ section.id }} .fbi-letter.is-active {
  opacity: 1;
}

#forma-brand-index-{{ section.id }} .fbi-letter.is-active {
  text-decoration: underline;
  text-underline-offset: 4px;
}

#forma-brand-index-{{ section.id }} .fbi-letter:disabled {
  opacity: .12;
  cursor: default;
}

#forma-brand-index-{{ section.id }} .fbi-letter:disabled:hover {
  text-decoration: none;
}

/* GRID */

#forma-brand-index-{{ section.id }} .fbi-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  column-gap: 28px;
  row-gap: 55px;
}

#forma-brand-index-{{ section.id }} .fbi-card {
  min-width: 0;
  position: relative;
}

#forma-brand-index-{{ section.id }} .fbi-card-main {
  display: block;
  color: inherit;
  text-decoration: none;
}

#forma-brand-index-{{ section.id }} .fbi-card-visual {
  position: relative;
  background: #FFFFFF;
  border: 1px solid #F0F0F0;
  aspect-ratio: 4 / 5;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 19%;
}

#forma-brand-index-{{ section.id }} .fbi-card-visual img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: transform .65s cubic-bezier(.2,.7,.2,1);
}

#forma-brand-index-{{ section.id }} .fbi-card:hover .fbi-card-visual img {
  transform: scale(1.045);
}

#forma-brand-index-{{ section.id }} .fbi-card-fallback {
  font-size: 24px;
  text-align: center;
  letter-spacing: -.04em;
}

/* OVERLAY */

#forma-brand-index-{{ section.id }} .fbi-card-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 22px;
  background: linear-gradient(
    to top,
    rgba(0,0,0,.035),
    rgba(0,0,0,0) 45%
  );
  opacity: 0;
  transition: opacity .3s ease;
}

#forma-brand-index-{{ section.id }} .fbi-card:hover .fbi-card-overlay {
  opacity: 1;
}

#forma-brand-index-{{ section.id }} .fbi-overlay-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  letter-spacing: .02em;
  color: #111111;
  background: rgba(255,255,255,.95);
  padding: 13px 20px;
  border-radius: 999px;
  transform: translateY(8px);
  transition: transform .3s ease;
}

#forma-brand-index-{{ section.id }} .fbi-card:hover .fbi-overlay-link {
  transform: translateY(0);
}

#forma-brand-index-{{ section.id }} .fbi-arrow {
  font-size: 13px;
}

/* INFORMATION */

#forma-brand-index-{{ section.id }} .fbi-card-information {
  padding-top: 16px;
}

#forma-brand-index-{{ section.id }} .fbi-card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 10px;
}

#forma-brand-index-{{ section.id }} .fbi-card-title-row h3 {
  margin: 0;
  font-size: 15px;
  line-height: 1.3;
  font-weight: 400;
  letter-spacing: -.025em;
}

#forma-brand-index-{{ section.id }} .fbi-card-category {
  font-size: 9px;
  letter-spacing: .13em;
  text-transform: uppercase;
  color: #888888;
  text-align: right;
  flex-shrink: 0;
}

#forma-brand-index-{{ section.id }} .fbi-card-information p {
  margin: 9px 0 0;
  font-size: 12px;
  line-height: 1.7;
  color: #777777;
  max-width: 400px;
}

/* SECONDARY LINKS */

#forma-brand-index-{{ section.id }} .fbi-secondary-links {
  display: flex;
  flex-wrap: wrap;
  gap: 15px;
  margin-top: 10px;
}

#forma-brand-index-{{ section.id }} .fbi-secondary-link {
  font-size: 10px;
  color: #777777;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: color .2s ease;
}

#forma-brand-index-{{ section.id }} .fbi-secondary-link:hover {
  color: #111111;
}

#forma-brand-index-{{ section.id }} .fbi-secondary-link span {
  font-size: 11px;
}

/* EMPTY */

#forma-brand-index-{{ section.id }} .fbi-empty {
  text-align: center;
  padding: 100px 20px;
}

#forma-brand-index-{{ section.id }} .fbi-empty-title {
  display: block;
  font-size: 32px;
  font-weight: 400;
  letter-spacing: -.05em;
}

#forma-brand-index-{{ section.id }} .fbi-empty p {
  color: #777777;
  font-size: 13px;
  margin: 15px 0 25px;
}

#forma-brand-index-{{ section.id }} .fbi-empty button {
  background: transparent;
  border: 0;
  border-bottom: 1px solid #111111;
  padding: 8px 0;
  font-size: 10px;
  letter-spacing: .12em;
  cursor: pointer;
}

/* TABLET */

@media(max-width: 1100px) {

  #forma-brand-index-{{ section.id }} .fbi-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 20px;
  }

  #forma-brand-index-{{ section.id }} .fbi-intro {
    align-items: flex-start;
  }

}

/* MOBILE */

@media(max-width: 749px) {

  #forma-brand-index-{{ section.id }} .fbi-shell {
    padding: 40px 18px 60px;
  }

  #forma-brand-index-{{ section.id }} .fbi-intro {
    display: block;
    margin-bottom: 35px;
  }

  #forma-brand-index-{{ section.id }} .fbi-kicker {
    margin-bottom: 16px;
  }

  #forma-brand-index-{{ section.id }} .fbi-intro h2 {
    font-size: clamp(38px, 11vw, 55px);
  }

  #forma-brand-index-{{ section.id }} .fbi-intro-copy p {
    margin-top: 16px;
    font-size: 13px;
  }

  #forma-brand-index-{{ section.id }} .fbi-search-wrap {
    margin-top: 28px;
    width: 100%;
  }

  #forma-brand-index-{{ section.id }} .fbi-toolbar {
    display: block;
  }

  #forma-brand-index-{{ section.id }} .fbi-category-filters {
    gap: 7px;
  }

  #forma-brand-index-{{ section.id }} .fbi-category-button {
    padding: 11px 16px;
    font-size: 11px;
  }

  #forma-brand-index-{{ section.id }} .fbi-result-count {
    margin-top: 18px;
  }

  #forma-brand-index-{{ section.id }} .fbi-alphabet-wrap {
    display: block;
    padding: 20px 0 30px;
  }

  #forma-brand-index-{{ section.id }} .fbi-alphabet-label {
    display: block;
    margin-bottom: 12px;
  }

  #forma-brand-index-{{ section.id }} .fbi-alphabet {
    gap: 2px;
  }

  #forma-brand-index-{{ section.id }} .fbi-letter {
    padding: 7px 7px;
    font-size: 10px;
  }

  #forma-brand-index-{{ section.id }} .fbi-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 12px;
  }

  #forma-brand-index-{{ section.id }} .fbi-card-visual {
    aspect-ratio: 4 / 5;
    padding: 15%;
  }

  #forma-brand-index-{{ section.id }} .fbi-card-overlay {
    opacity: 1;
    padding: 10px;
    background: transparent;
  }

  #forma-brand-index-{{ section.id }} .fbi-overlay-link {
    transform: none;
    padding: 9px 12px;
    font-size: 9px;
    gap: 6px;
    background: rgba(255,255,255,.92);
  }

  #forma-brand-index-{{ section.id }} .fbi-card-title-row {
    display: block;
  }

  #forma-brand-index-{{ section.id }} .fbi-card-title-row h3 {
    font-size: 14px;
  }

  #forma-brand-index-{{ section.id }} .fbi-card-category {
    display: block;
    text-align: left;
    margin-top: 6px;
    font-size: 9px;
  }

  #forma-brand-index-{{ section.id }} .fbi-card-information p {
    font-size: 11px;
    line-height: 1.6;
  }

  #forma-brand-index-{{ section.id }} .fbi-secondary-links {
    gap: 10px;
  }

  #forma-brand-index-{{ section.id }} .fbi-secondary-link {
    font-size: 9px;
  }

}

</style>

<script>
(function() {

  const root = document.getElementById('forma-brand-index-{{ section.id }}');

  if (!root || root.dataset.initialized === 'true') return;

  root.dataset.initialized = 'true';

  const grid = root.querySelector('#fbi-grid-{{ section.id }}');
  const search = root.querySelector('#fbi-search-{{ section.id }}');
  const categoriesEl = root.querySelector('#fbi-categories-{{ section.id }}');
  const alphabetEl = root.querySelector('#fbi-alphabet-{{ section.id }}');
  const emptyEl = root.querySelector('#fbi-empty-{{ section.id }}');
  const resetButton = root.querySelector('#fbi-reset-{{ section.id }}');
  const resultCountEl = root.querySelector('#fbi-result-count-{{ section.id }}');

  if (!grid || !search || !categoriesEl || !alphabetEl) return;

  const cards = Array.from(grid.querySelectorAll('.fbi-card'));

  const normalize = value => (value || '')
    .toLowerCase()
    .trim()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '');

  /* SORT */

  cards.sort((a, b) => {

    const aSort = Number(a.dataset.sort || 9999);
    const bSort = Number(b.dataset.sort || 9999);

    if (aSort !== bSort && aSort !== 9999 && bSort !== 9999) {
      return aSort - bSort;
    }

    return a.dataset.name.localeCompare(
      b.dataset.name,
      undefined,
      { sensitivity: 'base' }
    );

  });

  cards.forEach(card => grid.appendChild(card));

  /* CATEGORIES */

  const categoryNames = [...new Set(
    cards
      .map(card => (card.dataset.category || '').trim())
      .filter(Boolean)
  )].sort((a, b) => a.localeCompare(
    b,
    undefined,
    { sensitivity: 'base' }
  ));

  categoryNames.forEach(category => {

    const button = document.createElement('button');

    button.type = 'button';
    button.className = 'fbi-category-button';
    button.dataset.category = category;
    button.textContent = category;

    categoriesEl.appendChild(button);

  });

  /* LETTERS */

  const letterButtons = Array.from(
    alphabetEl.querySelectorAll('.fbi-letter')
  );

  let selectedCategory = 'all';
  let selectedLetter = 'all';
  let searchTerm = '';

  /* UPDATE */

  function update() {

    let visibleCount = 0;
    const visibleLetters = new Set();

    cards.forEach(card => {

      const name = card.dataset.name || '';
      const category = card.dataset.category || '';
      const firstLetter = name.trim().charAt(0).toUpperCase();

      const matchesCategory =
        selectedCategory === 'all' ||
        normalize(category) === normalize(selectedCategory);

      const matchesSearch =
        normalize(name).includes(normalize(searchTerm));

      const matchesLetter =
        selectedLetter === 'all' ||
        firstLetter === selectedLetter;

      const visible =
        matchesCategory &&
        matchesSearch &&
        matchesLetter;

      card.style.display = visible ? '' : 'none';

      if (visible) {

        visibleCount++;
        visibleLetters.add(firstLetter);

      }

    });

    /* CATEGORY STATE */

    categoriesEl.querySelectorAll('.fbi-category-button').forEach(button => {

      button.classList.toggle(
        'is-active',
        normalize(button.dataset.category) === normalize(selectedCategory)
      );

    });

    /* LETTER STATE */

    letterButtons.forEach(button => {

      const letter = button.dataset.letter;
      const isReset = letter === 'all';

      button.disabled = !isReset && !visibleLetters.has(letter);

      button.classList.toggle(
        'is-active',
        isReset
          ? selectedLetter === 'all'
          : selectedLetter === letter
      );

    });

    /* COUNT */

    if (resultCountEl) {
      resultCountEl.textContent = visibleCount;
    }

    /* EMPTY */

    if (emptyEl) {
      emptyEl.hidden = visibleCount > 0;
    }

  }

  /* CATEGORY CLICK */

  categoriesEl.addEventListener('click', function(event) {

    const button = event.target.closest('.fbi-category-button');

    if (!button) return;

    selectedCategory = button.dataset.category;
    selectedLetter = 'all';

    update();

  });

  /* LETTER CLICK */

  alphabetEl.addEventListener('click', function(event) {

    const button = event.target.closest('.fbi-letter');

    if (!button || button.disabled) return;

    selectedLetter = button.dataset.letter;

    update();

  });

  /* SEARCH */

  search.addEventListener('input', function() {

    searchTerm = search.value;
    selectedLetter = 'all';

    update();

  });

  /* RESET */

  if (resetButton) {

    resetButton.addEventListener('click', function() {

      search.value = '';
      searchTerm = '';
      selectedCategory = 'all';
      selectedLetter = 'all';

      update();

    });

  }

  update();

})();
</script>

