
{% liquid
  assign brands = shop.metaobjects.forma_brand.values
  assign total_brands = 0
  assign featured_count = 0

  for brand in brands
    if brand.brand_name.value != blank
      assign total_brands = total_brands | plus: 1
      if brand.featured.value == true
        assign featured_count = featured_count | plus: 1
      endif
    endif
  endfor
%}

<section id="forma-brand-index-{{ section.id }}" class="forma-brand-index">

  <div class="fbi-shell">

    <!-- EDITORIAL HEADER -->
    <header class="fbi-intro">

      <div class="fbi-kicker">
        <span>FORMA</span>
        <span>BRAND INDEX</span>
      </div>

      <div class="fbi-heading-wrap">
        <h1 class="fbi-heading">
          <span>{{ section.settings.heading_line_1 }}</span>
          <span class="fbi-heading-second">{{ section.settings.heading_line_2 }}</span>
        </h1>

        {% if section.settings.intro != blank %}
          <div class="fbi-intro-copy">
            {{ section.settings.intro }}
          </div>
        {% endif %}
      </div>

      <div class="fbi-intro-bottom">
        <div class="fbi-intro-note">
          <span class="fbi-note-line"></span>
          <span>{{ section.settings.bottom_note }}</span>
        </div>

        <div class="fbi-total">
          <span class="fbi-total-number" id="fbi-total-{{ section.id }}">{{ total_brands }}</span>
          <span class="fbi-total-label">BRANDS</span>
        </div>
      </div>

    </header>

    <!-- FEATURED BRANDS -->
    {% if section.settings.show_featured %}
      <div class="fbi-featured-section">

        <div class="fbi-section-heading">
          <span class="fbi-section-label">SELECTED BY FORMA</span>
          <span class="fbi-section-caption">A closer look</span>
        </div>

        <div class="fbi-featured-grid">

          {% for brand in brands %}
            {% if brand.featured.value == true and brand.brand_name.value != blank %}

              {% assign f_name = brand.brand_name.value %}
              {% assign f_logo = brand.logo.value %}
              {% assign f_description = brand.description.value %}
              {% assign f_website = brand.website.value %}
              {% assign f_forma_url = brand.forma_url.value %}
              {% assign f_category = brand.category.value %}

              {% assign f_target = f_forma_url %}
              {% if f_target == blank %}
                {% assign f_target = f_website %}
              {% endif %}

              <article class="fbi-featured-card">

                {% if f_target != blank %}
                  <a href="{{ f_target }}" class="fbi-featured-link"
                    {% if f_forma_url == blank %}target="_blank" rel="noopener noreferrer"{% endif %}>
                {% else %}
                  <div class="fbi-featured-link fbi-featured-link--static">
                {% endif %}

                  <div class="fbi-featured-image">

                    {% if f_logo != blank %}
                      <img
                        src="{{ f_logo | image_url: width: 1000 }}"
                        alt="{{ f_name | escape }}"
                        loading="lazy"
                      >
                    {% else %}
                      <span class="fbi-featured-fallback">{{ f_name }}</span>
                    {% endif %}

                    <div class="fbi-featured-overlay">
                      <span class="fbi-featured-overlay-label">DISCOVER BRAND</span>
                      <span class="fbi-featured-arrow">↗</span>
                    </div>

                  </div>

                  <div class="fbi-featured-meta">
                    <div>
                      <h2>{{ f_name }}</h2>
                      {% if f_category != blank %}
                        <span class="fbi-featured-category">{{ f_category }}</span>
                      {% endif %}
                    </div>

                    {% if f_description != blank %}
                      <p>{{ f_description | strip_html | truncate: 120 }}</p>
                    {% endif %}
                  </div>

                {% if f_target != blank %}
                  </a>
                {% else %}
                  </div>
                {% endif %}

              </article>

            {% endif %}
          {% endfor %}

        </div>
      </div>
    {% endif %}

    <!-- DIRECTORY -->
    <div class="fbi-directory">

      <div class="fbi-directory-top">

        <div class="fbi-directory-title">
          <span class="fbi-section-label">THE DIRECTORY</span>
          <h2>Explore all brands</h2>
        </div>

        <div class="fbi-search-wrap">
          <input
            type="search"
            id="fbi-search-{{ section.id }}"
            placeholder="Find a brand"
            aria-label="Search brands"
            autocomplete="off"
          >
          <span class="fbi-search-icon">⌕</span>
          <span class="fbi-search-shortcut">SEARCH</span>
        </div>

      </div>

      <!-- CATEGORY FILTERS -->
      <div class="fbi-filter-row">

        <div class="fbi-category-filters" id="fbi-categories-{{ section.id }}">
          <button class="fbi-category-button is-active" data-category="all" type="button">
            All brands
          </button>
        </div>

        <div class="fbi-result-count">
          <span id="fbi-result-count-{{ section.id }}">{{ total_brands }}</span>
          <span>RESULTS</span>
        </div>

      </div>

      <!-- ALPHABET -->
      <div class="fbi-alphabet-wrap">

        <span class="fbi-alphabet-label">INDEX</span>

        <div class="fbi-alphabet" id="fbi-alphabet-{{ section.id }}">
          {% assign alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ" | split: "" %}
          {% for letter in alphabet %}
            <button
              class="fbi-letter"
              type="button"
              data-letter="{{ letter }}"
              aria-label="Filter brands starting with {{ letter }}"
            >
              {{ letter }}
            </button>
          {% endfor %}
          <button class="fbi-letter fbi-letter-reset" type="button" data-letter="all" aria-label="Show all letters">
            ALL
          </button>
        </div>

      </div>

      <!-- BRAND GRID -->
      <div class="fbi-grid" id="fbi-grid-{{ section.id }}">

        {% for brand in brands %}
          {% if brand.brand_name.value != blank %}

            {% assign b_name = brand.brand_name.value %}
            {% assign b_logo = brand.logo.value %}
            {% assign b_category = brand.category.value %}
            {% assign b_description = brand.description.value %}
            {% assign b_website = brand.website.value %}
            {% assign b_forma_url = brand.forma_url.value %}
            {% assign b_featured = brand.featured.value %}
            {% assign b_sort = brand.sort_order.value %}

            {% assign b_target = b_forma_url %}
            {% if b_target == blank %}
              {% assign b_target = b_website %}
            {% endif %}

            <article
              class="fbi-card"
              data-name="{{ b_name | escape }}"
              data-category="{{ b_category | escape }}"
              data-sort="{{ b_sort | default: 9999 }}"
              data-featured="{{ b_featured }}"
            >

              {% if b_target != blank %}
                <a
                  class="fbi-card-link"
                  href="{{ b_target }}"
                  {% if b_forma_url == blank %}target="_blank" rel="noopener noreferrer"{% endif %}
                >
              {% else %}
                <div class="fbi-card-link fbi-card-link--static">
              {% endif %}

                  <div class="fbi-card-visual">

                    {% if b_logo != blank %}
                      <img
                        src="{{ b_logo | image_url: width: 800 }}"
                        alt="{{ b_name | escape }}"
                        loading="lazy"
                      >
                    {% else %}
                      <span class="fbi-card-fallback">{{ b_name }}</span>
                    {% endif %}

                    {% if b_featured == true %}
                      <span class="fbi-card-featured-tag">FORMA SELECT</span>
                    {% endif %}

                    <span class="fbi-card-arrow">↗</span>

                  </div>

                  <div class="fbi-card-information">
                    <div class="fbi-card-title-row">
                      <h3>{{ b_name }}</h3>
                      {% if b_category != blank %}
                        <span class="fbi-card-category">{{ b_category }}</span>
                      {% endif %}
                    </div>

                    {% if b_description != blank %}
                      <p>{{ b_description | strip_html | truncate: 90 }}</p>
                    {% endif %}
                  </div>

              {% if b_target != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}

            </article>

          {% endif %}
        {% endfor %}

      </div>

      <!-- EMPTY STATE -->
      <div class="fbi-empty" id="fbi-empty-{{ section.id }}" hidden>
        <span class="fbi-empty-title">Nothing found.</span>
        <p>Try another search or explore a different category.</p>
        <button type="button" id="fbi-reset-{{ section.id }}">RESET FILTERS</button>
      </div>

    </div>

    <!-- BOTTOM -->
    {% if section.settings.show_bottom %}
      <div class="fbi-bottom">

        <div class="fbi-bottom-copy">
          <span class="fbi-section-label">THE FORMA PERSPECTIVE</span>
          <p>{{ section.settings.bottom_text }}</p>
        </div>

        {% if section.settings.bottom_link != blank %}
          <a class="fbi-bottom-link" href="{{ section.settings.bottom_link }}">
            <span>{{ section.settings.bottom_link_label }}</span>
            <span>↗</span>
          </a>
        {% endif %}

      </div>
    {% endif %}

  </div>

</section>

<style>
#forma-brand-index-{{ section.id }} {
  --fbi-bg: {{ section.settings.background }};
  --fbi-text: {{ section.settings.text }};
  --fbi-muted: {{ section.settings.muted }};
  --fbi-line: {{ section.settings.line }};
  --fbi-card-bg: {{ section.settings.card_background }};
  --fbi-shell: {{ section.settings.max_width }}px;

  background: var(--fbi-bg);
  color: var(--fbi-text);
  width: 100%;
  overflow: hidden;
}

#forma-brand-index-{{ section.id }} *,
#forma-brand-index-{{ section.id }} *::before,
#forma-brand-index-{{ section.id }} *::after {
  box-sizing: border-box;
}

#forma-brand-index-{{ section.id }} .fbi-shell {
  width: 100%;
  max-width: var(--fbi-shell);
  margin: 0 auto;
  padding: {{ section.settings.padding_top }}px 45px {{ section.settings.padding_bottom }}px;
}

/* INTRO */

#forma-brand-index-{{ section.id }} .fbi-intro {
  padding-bottom: 45px;
  border-bottom: 1px solid var(--fbi-line);
}

#forma-brand-index-{{ section.id }} .fbi-kicker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 10px;
  letter-spacing: .14em;
  text-transform: uppercase;
  opacity: .65;
  margin-bottom: 60px;
}

#forma-brand-index-{{ section.id }} .fbi-heading-wrap {
  display: grid;
  grid-template-columns: minmax(0, 1.6fr) minmax(200px, .6fr);
  align-items: end;
  gap: 40px;
}

#forma-brand-index-{{ section.id }} .fbi-heading {
  font-size: clamp(60px, 8vw, {{ section.settings.heading_size }}px);
  line-height: .88;
  letter-spacing: -.075em;
  font-weight: 400;
  margin: 0;
}

#forma-brand-index-{{ section.id }} .fbi-heading span {
  display: block;
}

#forma-brand-index-{{ section.id }} .fbi-heading-second {
  font-style: italic;
  font-family: Georgia, "Times New Roman", serif;
  font-weight: 400;
  letter-spacing: -.065em;
}

#forma-brand-index-{{ section.id }} .fbi-intro-copy {
  max-width: 350px;
  font-size: 15px;
  line-height: 1.75;
  color: var(--fbi-muted);
  padding-bottom: 8px;
}

#forma-brand-index-{{ section.id }} .fbi-intro-copy p {
  margin: 0;
}

#forma-brand-index-{{ section.id }} .fbi-intro-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 65px;
}

#forma-brand-index-{{ section.id }} .fbi-intro-note {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .12em;
  color: var(--fbi-muted);
}

#forma-brand-index-{{ section.id }} .fbi-note-line {
  width: 35px;
  height: 1px;
  background: var(--fbi-text);
}

#forma-brand-index-{{ section.id }} .fbi-total {
  display: flex;
  align-items: baseline;
  gap: 8px;
}

#forma-brand-index-{{ section.id }} .fbi-total-number {
  font-size: 25px;
  letter-spacing: -.05em;
}

#forma-brand-index-{{ section.id }} .fbi-total-label {
  font-size: 10px;
  letter-spacing: .12em;
  opacity: .65;
}

/* FEATURED */

#forma-brand-index-{{ section.id }} .fbi-featured-section {
  padding: 75px 0 90px;
  border-bottom: 1px solid var(--fbi-line);
}

#forma-brand-index-{{ section.id }} .fbi-section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 28px;
}

#forma-brand-index-{{ section.id }} .fbi-section-label {
  font-size: 10px;
  letter-spacing: .14em;
  text-transform: uppercase;
}

#forma-brand-index-{{ section.id }} .fbi-section-caption {
  font-size: 12px;
  color: var(--fbi-muted);
}

#forma-brand-index-{{ section.id }} .fbi-featured-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 25px;
}

#forma-brand-index-{{ section.id }} .fbi-featured-card {
  min-width: 0;
}

#forma-brand-index-{{ section.id }} .fbi-featured-link {
  text-decoration: none;
  color: inherit;
  display: block;
}

#forma-brand-index-{{ section.id }} .fbi-featured-image {
  position: relative;
  background: var(--fbi-card-bg);
  aspect-ratio: 4 / 3;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12%;
}

#forma-brand-index-{{ section.id }} .fbi-featured-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: transform .65s cubic-bezier(.2,.7,.2,1);
}

#forma-brand-index-{{ section.id }} .fbi-featured-card:hover img {
  transform: scale(1.045);
}

#forma-brand-index-{{ section.id }} .fbi-featured-fallback {
  font-size: 32px;
  text-align: center;
  letter-spacing: -.04em;
}

#forma-brand-index-{{ section.id }} .fbi-featured-overlay {
  position: absolute;
  left: 18px;
  right: 18px;
  bottom: 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(255,255,255,.9);
  color: #111;
  padding: 12px 14px;
  opacity: 0;
  transform: translateY(8px);
  transition: opacity .25s, transform .25s;
}

#forma-brand-index-{{ section.id }} .fbi-featured-card:hover .fbi-featured-overlay {
  opacity: 1;
  transform: translateY(0);
}

#forma-brand-index-{{ section.id }} .fbi-featured-overlay-label {
  font-size: 10px;
  letter-spacing: .12em;
}

#forma-brand-index-{{ section.id }} .fbi-featured-arrow {
  font-size: 18px;
}

#forma-brand-index-{{ section.id }} .fbi-featured-meta {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 25px;
  padding-top: 20px;
}

#forma-brand-index-{{ section.id }} .fbi-featured-meta h2 {
  margin: 0;
  font-size: 19px;
  font-weight: 400;
  letter-spacing: -.03em;
}

#forma-brand-index-{{ section.id }} .fbi-featured-category {
  display: block;
  margin-top: 7px;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .12em;
  color: var(--fbi-muted);
}

#forma-brand-index-{{ section.id }} .fbi-featured-meta p {
  max-width: 280px;
  font-size: 12px;
  line-height: 1.7;
  color: var(--fbi-muted);
  margin: 0;
}

/* DIRECTORY */

#forma-brand-index-{{ section.id }} .fbi-directory {
  padding-top: 85px;
}

#forma-brand-index-{{ section.id }} .fbi-directory-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 40px;
  margin-bottom: 45px;
}

#forma-brand-index-{{ section.id }} .fbi-directory-title h2 {
  font-size: 34px;
  line-height: 1;
  letter-spacing: -.055em;
  font-weight: 400;
  margin: 15px 0 0;
}

#forma-brand-index-{{ section.id }} .fbi-search-wrap {
  position: relative;
  width: min(100%, 360px);
  border-bottom: 1px solid var(--fbi-line);
}

#forma-brand-index-{{ section.id }} .fbi-search-wrap input {
  width: 100%;
  height: 48px;
  border: 0;
  background: transparent;
  color: var(--fbi-text);
  padding: 0 80px 0 0;
  font-size: 14px;
  outline: none;
  border-radius: 0;
}

#forma-brand-index-{{ section.id }} .fbi-search-wrap input::placeholder {
  color: var(--fbi-muted);
  opacity: 1;
}

#forma-brand-index-{{ section.id }} .fbi-search-icon {
  position: absolute;
  right: 55px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 25px;
  opacity: .7;
  pointer-events: none;
}

#forma-brand-index-{{ section.id }} .fbi-search-shortcut {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  font-size: 9px;
  letter-spacing: .1em;
  opacity: .5;
}

#forma-brand-index-{{ section.id }} .fbi-filter-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 25px;
  padding-bottom: 25px;
  border-bottom: 1px solid var(--fbi-line);
}

#forma-brand-index-{{ section.id }} .fbi-category-filters {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

#forma-brand-index-{{ section.id }} .fbi-category-button {
  border: 1px solid var(--fbi-line);
  background: transparent;
  color: var(--fbi-text);
  padding: 10px 15px;
  font-size: 11px;
  letter-spacing: .02em;
  cursor: pointer;
  transition: background .2s, color .2s, border-color .2s;
}

#forma-brand-index-{{ section.id }} .fbi-category-button:hover,
#forma-brand-index-{{ section.id }} .fbi-category-button.is-active {
  background: var(--fbi-text);
  color: var(--fbi-bg);
  border-color: var(--fbi-text);
}

#forma-brand-index-{{ section.id }} .fbi-result-count {
  display: flex;
  gap: 7px;
  align-items: baseline;
  font-size: 10px;
  letter-spacing: .1em;
  white-space: nowrap;
  color: var(--fbi-muted);
}

#forma-brand-index-{{ section.id }} .fbi-result-count span:first-child {
  font-size: 16px;
  color: var(--fbi-text);
  letter-spacing: -.04em;
}

/* ALPHABET */

#forma-brand-index-{{ section.id }} .fbi-alphabet-wrap {
  display: flex;
  align-items: center;
  gap: 25px;
  padding: 23px 0 35px;
}

#forma-brand-index-{{ section.id }} .fbi-alphabet-label {
  font-size: 10px;
  letter-spacing: .12em;
  color: var(--fbi-muted);
  flex-shrink: 0;
}

#forma-brand-index-{{ section.id }} .fbi-alphabet {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 5px;
}

#forma-brand-index-{{ section.id }} .fbi-letter {
  border: 0;
  background: transparent;
  color: var(--fbi-text);
  cursor: pointer;
  padding: 5px 7px;
  font-size: 11px;
  opacity: .55;
  transition: opacity .2s, background .2s;
}

#forma-brand-index-{{ section.id }} .fbi-letter:hover,
#forma-brand-index-{{ section.id }} .fbi-letter.is-active {
  opacity: 1;
  background: var(--fbi-text);
  color: var(--fbi-bg);
}

#forma-brand-index-{{ section.id }} .fbi-letter:disabled {
  opacity: .15;
  cursor: default;
  background: transparent;
  color: var(--fbi-text);
}

#forma-brand-index-{{ section.id }} .fbi-letter-reset {
  letter-spacing: .08em;
}

/* GRID */

#forma-brand-index-{{ section.id }} .fbi-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 45px 20px;
}

#forma-brand-index-{{ section.id }} .fbi-card {
  min-width: 0;
}

#forma-brand-index-{{ section.id }} .fbi-card-link {
  display: block;
  color: inherit;
  text-decoration: none;
}

#forma-brand-index-{{ section.id }} .fbi-card-visual {
  position: relative;
  background: var(--fbi-card-bg);
  aspect-ratio: 1 / 1;
  padding: 27%;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  transition: background .25s;
}

#forma-brand-index-{{ section.id }} .fbi-card:hover .fbi-card-visual {
  background: color-mix(in srgb, var(--fbi-card-bg) 85%, var(--fbi-text) 15%);
}

#forma-brand-index-{{ section.id }} .fbi-card-visual img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: transform .5s cubic-bezier(.2,.7,.2,1);
}

#forma-brand-index-{{ section.id }} .fbi-card:hover .fbi-card-visual img {
  transform: scale(1.07);
}

#forma-brand-index-{{ section.id }} .fbi-card-fallback {
  text-align: center;
  font-size: 19px;
  letter-spacing: -.03em;
}

#forma-brand-index-{{ section.id }} .fbi-card-arrow {
  position: absolute;
  right: 15px;
  top: 15px;
  font-size: 16px;
  opacity: 0;
  transform: translate(-4px, 4px);
  transition: opacity .25s, transform .25s;
}

#forma-brand-index-{{ section.id }} .fbi-card:hover .fbi-card-arrow {
  opacity: 1;
  transform: translate(0, 0);
}

#forma-brand-index-{{ section.id }} .fbi-card-featured-tag {
  position: absolute;
  bottom: 12px;
  left: 12px;
  font-size: 8px;
  letter-spacing: .1em;
  padding: 7px 9px;
  background: var(--fbi-bg);
  color: var(--fbi-text);
}

#forma-brand-index-{{ section.id }} .fbi-card-information {
  padding-top: 16px;
}

#forma-brand-index-{{ section.id }} .fbi-card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 10px;
}

#forma-brand-index-{{ section.id }} .fbi-card-title-row h3 {
  margin: 0;
  font-size: 14px;
  line-height: 1.3;
  font-weight: 400;
  letter-spacing: -.02em;
}

#forma-brand-index-{{ section.id }} .fbi-card-category {
  font-size: 9px;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--fbi-muted);
  text-align: right;
}

#forma-brand-index-{{ section.id }} .fbi-card-information p {
  margin: 9px 0 0;
  font-size: 11px;
  line-height: 1.6;
  color: var(--fbi-muted);
}

