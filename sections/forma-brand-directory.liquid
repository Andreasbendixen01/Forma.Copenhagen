#forma-brand-index-{{section.id}} .fbi-card-category{font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:var(--fbi-muted);text-align:right}
#forma-brand-index-{{section.id}} .fbi-card-information p{margin:7px 0 0;font-size:11px;line-height:1.5;color:var(--fbi-muted)}
#forma-brand-index-{{section.id}} .fbi-empty{text-align:center;padding:60px 20px}#forma-brand-index-{{section.id}} .fbi-empty-title{display:block;font-size:30px}#forma-brand-index-{{section.id}} .fbi-empty p{color:var(--fbi-muted);font-size:13px}
@media(max-width:1100px){#forma-brand-index-{{section.id}} .fbi-grid{grid-template-columns:repeat(3,minmax(0,1fr));}
@media(max-width:749px){#forma-brand-index-{{section.id}} .fbi-shell{padding:{{section.settings.mobile_padding_top}}px 18px {{section.settings.mobile_padding_bottom}}px}#forma-brand-index-{{section.id}} .fbi-kicker{margin-bottom:30px}#forma-brand-index-{{section.id}} .fbi-heading-wrap{display:block}#forma-brand-index-{{section.id}} .fbi-heading{font-size:{{section.settings.mobile_heading_size}}px}#forma-brand-index-{{section.id}} .fbi-intro-copy{margin-top:25px;font-size:13px}#forma-brand-index-{{section.id}} .fbi-intro-bottom{margin-top:35px}#forma-brand-index-{{section.id}} .fbi-intro-note{font-size:8px}#forma-brand-index-{{section.id}} .fbi-directory{padding-top:30px}#forma-brand-index-{{section.id}} .fbi-directory-top{display:block}#forma-brand-index-{{section.id}} .fbi-search-wrap{margin-top:22px;width:100%}#forma-brand-index-{{section.id}} .fbi-filter-row{display:block}#forma-brand-index-{{section.id}} .fbi-result-count{margin-top:15px}#forma-brand-index-{{section.id}} .fbi-alphabet-wrap{display:block;padding:18px 0 22px}#forma-brand-index-{{section.id}} .fbi-alphabet-label{display:block;margin-bottom:10px}#forma-brand-index-{{section.id}} .fbi-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:25px 12px}#forma-brand-index-{{section.id}} .fbi-card-visual{padding:18%}#forma-brand-index-{{section.id}} .fbi-card-overlay{opacity:1;background:transparent;inset:auto 0 0;padding:8px;gap:5px}#forma-brand-index-{{section.id}} .fbi-overlay-link{font-size:9px;padding:8px 9px;max-width:none}#forma-brand-index-{{section.id}} .fbi-overlay-link--secondary{background:rgba(255,255,255,.9);color:#111;border:0}#forma-brand-index-{{section.id}} .fbi-card-title-row{display:block}#forma-brand-index-{{section.id}} .fbi-card-category{display:block;text-align:left;margin-top:4px}}
