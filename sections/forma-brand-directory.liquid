#forma-brand-index-{{section.id}} *{box-sizing:border-box}
#forma-brand-index-{{section.id}} .fbi-shell{max-width:{{section.settings.max_width}}px;margin:0 auto;padding:{{section.settings.padding_top}}px 45px {{section.settings.padding_bottom}}px}
#forma-brand-index-{{section.id}} .fbi-intro{padding-bottom:42px;border-bottom:1px solid var(--fbi-line)}
