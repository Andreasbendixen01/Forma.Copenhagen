<section class="forma-standalone-page">

  <div class="forma-dashboard__container">

    <header class="forma-member-page-header">

      <p class="forma-dashboard-section__eyebrow">
        Activity
      </p>

      <h1 class="forma-member-page-header__title">
        Your journey across Forma.
      </h1>

      <p class="forma-member-page-header__description">
        Everything you've explored, saved and followed.
      </p>

    </header>


    <section
      id="FormaActivity"
      class="forma-dashboard-section forma-activity"
    >

      <div class="forma-dashboard-section__header">

        <div class="forma-dashboard-section__heading">

          <p class="forma-dashboard-section__eyebrow">
            Your activity
          </p>

          <h2 class="forma-dashboard-section__title">
            Recent Activity
          </h2>

          <p class="forma-dashboard-section__description">
            Everything you've explored, saved and followed
            across Forma.
          </p>

        </div>

      </div>


      <div
        class="forma-activity-feed"
        data-forma-activity-feed
      ></div>


      <div
        class="forma-activity-empty"
        data-forma-activity-empty
        hidden
      >

        <p class="forma-activity-empty__index">
          Activity
        </p>

        <h3 class="forma-activity-empty__title">
          Your journey starts here.
        </h3>

        <p class="forma-activity-empty__text">
          Save products, follow brands and explore stories
          to build your personal timeline.
        </p>

      </div>

    </section>

  </div>

</section>


{% schema %}
{
  "name": "Forma — Activity",
  "settings": []
}
{% endschema %}