{%- liquid
  assign brands = shop.metaobjects.forma_brand.values
  assign brand_count = 0
  for brand in brands
    if brand.brand_name.value != blank
      assign brand_count = brand_count | plus: 1
    endif
  endfor

  assign magazine_url = '/pages/magazine'
  if section.settings.magazine_page != blank
    assign magazine_url = section.settings.magazine_page.url
  endif

  assign source_articles = '' | split: ''
  if section.settings.blog_1 != blank
    assign source_articles = source_articles | concat: section.settings.blog_1.articles
  endif
  if section.settings.blog_2 != blank
    assign source_articles = source_articles | concat: section.settings.blog_2.articles
  endif

  assign repeats = 1
  if brand_count > 0
    assign row_width = brand_count | times: section.settings.tile_width
    assign repeats = 2400 | divided_by: row_width | plus: 1
  endif
  assign tiles_per_half = brand_count | times: repeats
  assign duration = tiles_per_half | times: section.settings.seconds_per_tile
-%}
{%- if brand_count > 0 -%}
<section
  id="fbm-{{ section.id }}"
  class="fbm"
  style="--fbm-bg: {{ section.settings.background }}; --fbm-card: {{ section.settings.card_background }}; --fbm-text: {{ section.settings.text }}; --fbm-w: {{ section.settings.tile_width }}px; --fbm-h: {{ section.settings.tile_height }}px; --fbm-gap: {{ section.settings.gap }}px; --fbm-duration: {{ duration }}s; --fbm-overlay: {{ section.settings.overlay | divided_by: 100.0 }};"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="fbm__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="fbm__viewport">
    <div class="fbm__track">
      {%- for half in (1..2) -%}
        <ul class="fbm__list" role="list" {% if half == 2 %}aria-hidden="true"{% endif %}>
          {%- for round in (1..repeats) -%}
            {%- for brand in brands -%}
              {%- assign brand_name = brand.brand_name.value -%}
              {%- if brand_name != blank -%}
                {%- liquid
                  assign brand_handle = brand_name | handleize
                  assign brand_url = magazine_url | append: '?brand=' | append: brand_handle
                  if section.settings.link_to == 'collection' and brand.forma_url.value != blank
                    assign brand_url = brand.forma_url.value.url
                  endif

                  assign brand_image = brand.image.value
                  for article in source_articles
                    if brand_image == blank and article.image != blank
                      for tag in article.tags
                        assign tag_handle = tag | handleize
                        if tag_handle == brand_handle
                          assign brand_image = article.image
                        endif
                      endfor
                    endif
                  endfor

                  assign is_copy = false
                  if half == 2 or round > 1
                    assign is_copy = true
                  endif
                -%}
                <li class="fbm__item">
                  <a
                    class="fbm__tile{% if brand_image != blank %} fbm__tile--photo{% else %} fbm__tile--logo{% endif %}"
                    href="{{ brand_url }}"
                    aria-label="{{ section.settings.button_label | append: ' ' | append: brand_name | escape }}"
                    {% if is_copy %}tabindex="-1"{% endif %}
                  >
                    {%- if brand_image != blank -%}
                      <span class="fbm__media">
                        {{ brand_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(min-width: 750px) 40vw, 80vw', alt: '' }}
                      </span>
                    {%- elsif brand.logo.value != blank -%}
                      <span class="fbm__logo">
                        {{ brand.logo.value | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '240px', alt: '' }}
                      </span>
                    {%- endif -%}
                    <span class="fbm__content">
                      {%- if section.settings.show_name -%}<span class="fbm__name">{{ brand_name | escape }}</span>{%- endif -%}
                      {%- if section.settings.button_label != blank -%}
                        <span class="fbm__button">{{ section.settings.button_label | escape }}</span>
                      {%- endif -%}
                    </span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #fbm-{{ section.id }} { background: var(--fbm-bg); color: var(--fbm-text); overflow: hidden; }
  #fbm-{{ section.id }} .fbm__heading { margin: 0; padding: clamp(32px, 4vw, 56px) var(--container-gutter, 20px) 24px; font-size: clamp(22px, 2vw, 28px); font-weight: 400; letter-spacing: -.01em; }
  #fbm-{{ section.id }} .fbm__track { display: flex; width: max-content; gap: var(--fbm-gap); animation: fbm-scroll-{{ section.id }} var(--fbm-duration) linear infinite; }
  #fbm-{{ section.id }} .fbm__viewport:hover .fbm__track, #fbm-{{ section.id }} .fbm__viewport:focus-within .fbm__track { animation-play-state: paused; }
  #fbm-{{ section.id }} .fbm__list { display: flex; gap: var(--fbm-gap); margin: 0; padding: 0; list-style: none; }
  #fbm-{{ section.id }} .fbm__item { flex: none; width: min(var(--fbm-w), 82vw); }
  #fbm-{{ section.id }} .fbm__tile { position: relative; display: grid; place-items: center; height: min(var(--fbm-h), 110vw); overflow: hidden; color: inherit; text-decoration: none; text-align: center; background: var(--fbm-card); }
  #fbm-{{ section.id }} .fbm__media, #fbm-{{ section.id }} .fbm__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  #fbm-{{ section.id }} .fbm__media img { transition: transform .8s cubic-bezier(.22, 1, .36, 1); }
  #fbm-{{ section.id }} .fbm__tile:hover .fbm__media img { transform: scale(1.03); }
  #fbm-{{ section.id }} .fbm__tile--photo { color: #fff; }
  #fbm-{{ section.id }} .fbm__tile--photo::after { content: ""; position: absolute; inset: 0; background: rgba(0, 0, 0, var(--fbm-overlay)); }
  #fbm-{{ section.id }} .fbm__logo { position: absolute; inset: 0 0 auto; display: grid; place-items: center; height: 62%; padding: 0 18%; }
  #fbm-{{ section.id }} .fbm__logo img { max-width: 100%; max-height: 90px; width: auto; height: auto; object-fit: contain; mix-blend-mode: multiply; }
  #fbm-{{ section.id }} .fbm__content { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 24px; }
  #fbm-{{ section.id }} .fbm__tile--logo .fbm__content { align-self: end; padding-bottom: 40px; }
  #fbm-{{ section.id }} .fbm__name { font-size: clamp(22px, 2.2vw, 32px); line-height: 1.1; letter-spacing: -.01em; }
  #fbm-{{ section.id }} .fbm__button { display: inline-block; padding: 11px 24px; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #111; background: #fff; transition: background-color .2s ease, color .2s ease; }
  #fbm-{{ section.id }} .fbm__tile--logo .fbm__button { color: #fff; background: #111; }
  #fbm-{{ section.id }} .fbm__tile:hover .fbm__button { color: #fff; background: #111; }
  #fbm-{{ section.id }} .fbm__tile--logo:hover .fbm__button { color: #111; background: #fff; }
  #fbm-{{ section.id }} .fbm__tile:focus-visible { outline: 2px solid currentColor; outline-offset: -4px; }
  @keyframes fbm-scroll-{{ section.id }} { from { transform: translateX(0); } to { transform: translateX(calc(-50% - var(--fbm-gap) / 2)); } }
  @media (prefers-reduced-motion: reduce) {
    #fbm-{{ section.id }} .fbm__track { animation: none; }
    #fbm-{{ section.id }} .fbm__viewport { overflow-x: auto; }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Forma Brand Slider",
  "tag": "div",
  "class": "shopify-section--forma-brand-marquee",
  "settings": [
    { "type": "paragraph", "content": "Shows every brand from the Forma Brand entries and slides from right to left. Each brand uses its Brand image. Without one it uses its newest article tagged with the brand name, otherwise its logo." },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore" },
    { "type": "checkbox", "id": "show_name", "label": "Show brand name", "default": false },
    {
      "type": "select",
      "id": "link_to",
      "label": "Tiles link to",
      "options": [
        { "value": "magazine", "label": "Brand's articles in the magazine" },
        { "value": "collection", "label": "Brand's collection (Forma URL)" }
      ],
      "default": "magazine"
    },
    { "type": "page", "id": "magazine_page", "label": "Magazine page" },
    { "type": "blog", "id": "blog_1", "label": "Images from blog 1" },
    { "type": "blog", "id": "blog_2", "label": "Images from blog 2" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "tile_width", "label": "Tile width", "min": 240, "max": 900, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "tile_height", "label": "Tile height", "min": 240, "max": 900, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "gap", "label": "Space between tiles", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 2 },
    { "type": "range", "id": "seconds_per_tile", "label": "Speed (seconds per tile)", "min": 2, "max": 15, "step": 1, "unit": "s", "default": 6 },
    { "type": "range", "id": "overlay", "label": "Image overlay", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 20 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "card_background", "label": "Logo tile background", "default": "#f4f3f0" },
    { "type": "color", "id": "text", "label": "Text", "default": "#111111" }
  ],
  "presets": [{ "name": "Forma Brand Slider" }]
}
{% endschema %}
