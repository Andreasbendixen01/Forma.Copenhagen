{%- comment -%}
  FORMA ARTICLE
  Article layout that matches Forma Magazine: article title as the masthead,
  a sticky "In this article" menu on the left and the article text on the right.
  The featured image is not shown here; it is only used as the thumbnail in the magazine.
  The table of contents, reading progress and image layout come from assets/forma-journal.js.
{%- endcomment -%}

<script src="{{ 'forma-journal.js' | asset_url }}" defer></script>

<style>
  #shopify-section-{{ section.id }} .fa5 {
    --fa5-title-font: "Cormorant Garamond", "Times New Roman", Georgia, serif;
    --fa5-text: {{ section.settings.text }};
    --fa5-muted: {{ section.settings.muted }};
    --fa5-line: {{ section.settings.line }};
    background: {{ section.settings.background }};
    color: var(--fa5-text);
  }
  #shopify-section-{{ section.id }} .fa5-wrap { padding: 0 var(--container-gutter, 20px) clamp(64px, 7vw, 120px); }

  /* Masthead: article title, like "Forma Magazine" on the magazine page */
  #shopify-section-{{ section.id }} .fa5-mast { padding: clamp(40px, 5vw, 72px) 0 clamp(24px, 3vw, 36px); border-bottom: 1px solid var(--fa5-text); }
  #shopify-section-{{ section.id }} .fa5-mast__title { max-width: 18ch; margin: 0; font-family: var(--fa5-title-font); font-weight: 400; font-size: clamp(44px, 6.4vw, 96px); line-height: .95; letter-spacing: -.02em; color: inherit; text-wrap: balance; }

  /* Two columns: menu + text */
  #shopify-section-{{ section.id }} .fa5-body { display: grid; grid-template-columns: minmax(170px, 220px) minmax(0, 1fr); gap: clamp(32px, 4.5vw, 80px); padding-top: clamp(32px, 4vw, 48px); }

  /* "In this article" menu, styled like the magazine category menu */
  #shopify-section-{{ section.id }} .fa5-side__inner { position: sticky; top: calc(var(--sticky-area-height, 0px) + 32px); }
  #shopify-section-{{ section.id }} .fa5 .forma-article__toc { position: static; width: auto; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__toc[hidden] { display: none; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__toc-label { margin: 0 0 8px; font-size: 11px; font-weight: 400; line-height: 1.4; letter-spacing: .16em; text-transform: uppercase; color: var(--fa5-muted); opacity: 1; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__toc-nav { position: static; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__toc-list { display: block; margin: 0; padding: 0; list-style: none; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__toc-item { margin: 0; padding: 0; border-bottom: 1px solid var(--fa5-line); }
  #shopify-section-{{ section.id }} .fa5 .forma-article__toc-link { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 4px; font-size: 15px; line-height: 1.35; letter-spacing: 0; color: var(--fa5-text); text-decoration: none; opacity: 1; transform: none; transition: color .2s ease; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__toc-link:hover { color: var(--fa5-muted); transform: none; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__toc-link.is-active { font-weight: 600; color: var(--fa5-text); transform: none; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__toc-link.is-active::after { content: ""; flex: none; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

  /* Article text: same setup as before, with the magazine fonts on headings */
  #shopify-section-{{ section.id }} .fa5-main { min-width: 0; }
  #shopify-section-{{ section.id }} .fa5-intro { max-width: 860px; margin: 0 0 clamp(32px, 4vw, 48px); font-size: clamp(18px, 1.5vw, 22px); line-height: 1.55; color: var(--fa5-muted); }
  #shopify-section-{{ section.id }} .fa5-intro > * { margin: 0; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__body { width: auto; max-width: 760px; margin: 0; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose h2,
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose h3,
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose blockquote,
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose > p:first-child::first-letter { font-family: var(--fa5-title-font); }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose h2 { letter-spacing: -.02em; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose > :first-child { margin-top: 0; }


  /* Breaker images: span the whole text column and are always visible */
  #shopify-section-{{ section.id }} .fa5 .forma-article__body { max-width: none; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose > :not(.forma-media):not(.forma-media-pair):not(:has(.forma-media)) { max-width: 860px; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .forma-media,
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .forma-media.forma-reveal,
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .forma-media.forma-reveal.is-visible { width: 100%; max-width: none; margin: clamp(48px, 6vw, 96px) 0; transform: none; opacity: 1; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .forma-media-pair,
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .forma-media-pair.forma-reveal,
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .forma-media-pair.forma-reveal.is-visible { left: auto; width: 100%; max-width: none; margin: clamp(48px, 6vw, 96px) 0; transform: none; opacity: 1; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .forma-media-pair .forma-media { margin: 0; }

  /* Breaker images in 16:9 across the whole text column */
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .forma-media img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: center; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .forma-media:not(.forma-media-pair .forma-media) { width: 100% !important; max-width: 860px !important; }

  /* Even spacing between text, headings and images (margins collapse, so the largest value wins) */
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose > p { margin: 0 0 1.4em; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose h2 { margin: 72px 0 20px; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose h3 { margin: 48px 0 16px; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose > :first-child { margin-top: 0; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .wp-block-gallery { display: block; margin: 48px 0; padding: 0; max-width: 860px; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .wp-block-gallery:not(:has(img)) { display: none; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .wp-block-gallery .blocks-gallery-grid { display: grid; gap: 16px; margin: 0; padding: 0; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .wp-block-gallery figure { margin: 0 !important; padding: 0; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .wp-block-gallery figure:not(:has(img)) { display: none; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .wp-block-gallery .forma-media { margin: 0 !important; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .slider-button-next,
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .slider-button-prev { display: none; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .wp-block-buttons { margin: 0 0 1.4em; }

  /* Photo credit (e.g. @name) right under the image */
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .wp-block-gallery:has(+ p > a[href*="instagram.com"]) { margin-bottom: 12px; }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .wp-block-gallery + p:has(> a[href*="instagram.com"]) { margin: 0 0 48px; font-size: 12px; line-height: 1.4; letter-spacing: .04em; color: var(--fa5-muted); }
  #shopify-section-{{ section.id }} .fa5 .forma-article__prose .wp-block-gallery + p:has(> a[href*="instagram.com"]) a { color: inherit; }

  /* Product cards in a rail to the right of the text */
  #shopify-section-{{ section.id }} .fa5-rail { display: none; }
  @media screen and (min-width: 1280px) {
    #shopify-section-{{ section.id }} .fa5-main { display: grid; grid-template-columns: minmax(0, 860px) 280px; justify-content: space-between; gap: clamp(40px, 4vw, 72px); }
    #shopify-section-{{ section.id }} .fa5-rail { display: block; position: relative; }
  }
  #shopify-section-{{ section.id }} .fa5-card { position: absolute; left: 0; right: 0; display: grid; grid-template-columns: 84px minmax(0, 1fr); gap: 16px; align-items: center; padding: 12px; border: 1px solid var(--fa5-line); background: #fff; color: var(--fa5-text); text-decoration: none; opacity: 0; transform: translateY(16px); transition: opacity .6s ease, transform .6s ease, border-color .2s ease; pointer-events: none; }
  #shopify-section-{{ section.id }} .fa5-card.is-visible { opacity: 1; transform: none; pointer-events: auto; }
  #shopify-section-{{ section.id }} .fa5-card:hover { border-color: var(--fa5-text); }
  #shopify-section-{{ section.id }} .fa5-card__img { display: block; width: 84px; aspect-ratio: 4 / 5; overflow: hidden; background: #f4f3f0; }
  #shopify-section-{{ section.id }} .fa5-card__img img { display: block; width: 100%; height: 100%; margin: 0; object-fit: cover; }
  #shopify-section-{{ section.id }} .fa5-card__body { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; min-width: 0; }
  #shopify-section-{{ section.id }} .fa5-card__title { font-family: var(--fa5-title-font); font-size: 18px; line-height: 1.15; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  #shopify-section-{{ section.id }} .fa5-card__price { font-size: 12px; letter-spacing: .06em; color: var(--fa5-muted); }
  #shopify-section-{{ section.id }} .fa5-card__btn { margin-top: 4px; padding: 9px 16px; border-radius: 999px; background: {{ section.settings.card_button_color }}; color: #fff; font-size: 10px; line-height: 1; letter-spacing: .18em; text-transform: uppercase; white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .fa5-card { transition: none; transform: none; }
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .fa5-body { grid-template-columns: minmax(0, 1fr); gap: 0; }
    #shopify-section-{{ section.id }} .fa5-side { display: none; }
  }
</style>

<div class="fa5">
  {%- if section.settings.show_progress -%}
    <div class="forma-reading-progress" aria-hidden="true"><span class="forma-reading-progress__bar"></span></div>
  {%- endif -%}

  <div class="fa5-wrap">
    <header class="fa5-mast">
      <h1 class="fa5-mast__title">{{ article.title | escape }}</h1>
    </header>

    <div class="fa5-body">
      <aside class="fa5-side">
        <div class="fa5-side__inner">
          <div class="forma-article__toc" data-forma-toc hidden>
            <p class="forma-article__toc-label">{{ section.settings.toc_label | escape }}</p>
            <nav class="forma-article__toc-nav" aria-label="{{ section.settings.toc_label | escape }}">
              <ol class="forma-article__toc-list"></ol>
            </nav>
          </div>
        </div>
      </aside>

      <div class="fa5-main">
        <div class="fa5-content">
        {%- if section.settings.show_excerpt and article.excerpt != blank -%}
          <div class="fa5-intro">{{ article.excerpt }}</div>
        {%- endif -%}

        <div class="forma-article__body">
          <div class="prose forma-article__prose" data-forma-article-content>
            {{- article.content -}}
          </div>
        </div>
        </div>
        <aside class="fa5-rail" data-fa5-rail aria-label="Products in this article"></aside>
      </div>
    </div>
  </div>
</div>


{%- if section.settings.show_product_cards -%}
<script>
  /* FORMA ARTICLE: product cards next to product links in the text.
     A link to one of the store's products shows that product.
     Any other text link is matched to a store product through Shopify search (by the link text);
     links with no matching product get no card. Image links are ignored. */
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }} .fa5');
    if (!root) return;
    var rail = root.querySelector('[data-fa5-rail]');
    var prose = root.querySelector('[data-forma-article-content]');
    if (!rail || !prose) return;

    var buttonLabel = {{ section.settings.card_button_label | json }};
    var searchRoot = {{ routes.predictive_search_url | json }};
    var currency = (window.Shopify && Shopify.currency && Shopify.currency.active) || {{ cart.currency.iso_code | json }};
    var cards = [];
    var usedHandles = {};

    function money(cents) {
      try {
        return new Intl.NumberFormat(document.documentElement.lang || 'da-DK', { style: 'currency', currency: currency }).format(cents / 100);
      } catch (e) {
        return (cents / 100).toFixed(2) + ' ' + currency;
      }
    }
    function sized(src) {
      if (!src) return '';
      if (src.indexOf('//') === 0) src = 'https:' + src;
      return src + (src.indexOf('?') > -1 ? '&' : '?') + 'width=240';
    }

    function addCard(anchor, product) {
      if (!product || usedHandles[product.handle]) return;
      usedHandles[product.handle] = true;
      var card = document.createElement('a');
      card.className = 'fa5-card';
      card.href = product.url;
      card.innerHTML = '<span class="fa5-card__img"></span><span class="fa5-card__body"><span class="fa5-card__title"></span><span class="fa5-card__price"></span><span class="fa5-card__btn"></span></span>';
      card.querySelector('.fa5-card__title').textContent = product.title;
      card.querySelector('.fa5-card__price').textContent = product.price;
      card.querySelector('.fa5-card__btn').textContent = buttonLabel;
      if (product.image) {
        var img = document.createElement('img');
        img.src = sized(product.image);
        img.alt = '';
        img.loading = 'lazy';
        img.addEventListener('load', layout);
        card.querySelector('.fa5-card__img').appendChild(img);
      }
      cards.push({ el: card, anchor: anchor });
      cards.sort(function (a, b) {
        return a.anchor.compareDocumentPosition(b.anchor) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1;
      });
      rail.appendChild(card);
      layout();
      if (io) io.observe(anchor); else card.classList.add('is-visible');
    }

    function fromProductJs(p) {
      return {
        handle: p.handle,
        title: p.title,
        url: '/products/' + p.handle,
        price: money(p.price),
        image: p.featured_image || ''
      };
    }
    function fromSearch(p) {
      var price = p.price || '';
      if (/^\d+(\.\d+)?$/.test(String(price))) price = money(Math.round(parseFloat(price) * 100));
      return {
        handle: p.handle,
        title: p.title,
        url: p.url,
        price: price,
        image: p.featured_image && p.featured_image.url ? p.featured_image.url : (p.image || '')
      };
    }

    function collect() {
      var seenText = {};
      Array.prototype.forEach.call(prose.querySelectorAll('a[href]'), function (a) {
        if (a.querySelector('img') || a.closest('.wp-block-buttons, .wp-block-gallery, .forma-media')) return;
        var text = (a.textContent || '').trim();
        if (!text || text.charAt(0) === '@') return;
        var url;
        try { url = new URL(a.href, window.location.href); } catch (e) { return; }

        var match = url.host === window.location.host && url.pathname.match(/\/products\/([^/?#]+)/);
        if (match) {
          fetch('/products/' + match[1] + '.js').then(function (r) { return r.ok ? r.json() : null; }).then(function (p) {
            if (p) addCard(a, fromProductJs(p));
          }).catch(function () {});
          return;
        }

        var key = text.toLowerCase();
        if (seenText[key]) return;
        seenText[key] = true;
        var q = searchRoot + '.json?q=' + encodeURIComponent(text) + '&resources[type]=product&resources[limit]=1&resources[options][unavailable_products]=last';
        fetch(q).then(function (r) { return r.ok ? r.json() : null; }).then(function (data) {
          var list = data && data.resources && data.resources.results && data.resources.results.products;
          if (list && list.length) addCard(a, fromSearch(list[0]));
        }).catch(function () {});
      });
    }

    function layout() {
      if (!cards.length || rail.offsetParent === null) return;
      var railTop = rail.getBoundingClientRect().top;
      var next = 0;
      cards.forEach(function (c) {
        var top = Math.max(c.anchor.getBoundingClientRect().top - railTop - 8, next);
        c.el.style.top = top + 'px';
        next = top + c.el.offsetHeight + 16;
      });
    }

    var io = 'IntersectionObserver' in window ? new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        cards.forEach(function (c) { if (c.anchor === entry.target) c.el.classList.add('is-visible'); });
        io.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -25% 0px' }) : null;

    function start() {
      collect();
      window.addEventListener('resize', layout);
      window.addEventListener('load', layout);
      Array.prototype.forEach.call(prose.querySelectorAll('img'), function (img) {
        if (!img.complete) img.addEventListener('load', layout);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { setTimeout(start, 50); });
    } else {
      setTimeout(start, 50);
    }
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Forma Article",
  "class": "shopify-section--forma-article",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "toc_label", "label": "Menu label", "default": "In this article" },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt above the text", "default": true },
    { "type": "checkbox", "id": "show_progress", "label": "Show reading progress line", "default": true },
    { "type": "header", "content": "Product cards" },
    { "type": "checkbox", "id": "show_product_cards", "label": "Show product cards next to product links", "default": true },
    { "type": "text", "id": "card_button_label", "label": "Card button label", "default": "Se produkt" },
    { "type": "color", "id": "card_button_color", "label": "Card button color", "default": "#1e3a34" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "muted", "label": "Muted text", "default": "#5e5e5e" },
    { "type": "color", "id": "line", "label": "Lines", "default": "#e3e0db" }
  ]
}
{% endschema %}
