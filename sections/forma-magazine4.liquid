{%- comment -%}
  FORMA MAGAZINE
  One section, four categories (Wardrobe, The Lifestyle, The Home, The Form).
  Each category is a block that reads articles from a Shopify blog (optionally filtered by tag).
  Layout: category heading + large feature article on the left, a two-column grid of articles on the right.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --fm-ink: #111111;
    --fm-muted: #6b6b6b;
    --fm-line: #e2e2e2;
    --fm-serif: "Cormorant Garamond", "Times New Roman", Georgia, serif;
    --fm-gap: clamp(28px, 4vw, 56px);
    --fm-pad: clamp(16px, 2.2vw, 32px);
    --fm-sticky-top: var(--sticky-area-height, 0px);
  }

  #shopify-section-{{ section.id }} .fm {
    background: #fff;
    color: var(--fm-ink);
  }

  /* ---------- Category navigation ---------- */
  #shopify-section-{{ section.id }} .fm-nav {
    position: sticky;
    top: var(--fm-sticky-top);
    z-index: 5;
    background: #fff;
    border-bottom: 1px solid var(--fm-line);
  }
  #shopify-section-{{ section.id }} .fm-nav__list {
    display: flex;
    gap: clamp(24px, 4vw, 56px);
    margin: 0;
    padding: 0 var(--fm-pad);
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  #shopify-section-{{ section.id }} .fm-nav__list::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .fm-nav__link {
    position: relative;
    display: block;
    padding: 18px 0;
    color: var(--fm-muted);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease-in;
  }
  #shopify-section-{{ section.id }} .fm-nav__link::after {
    content: "";
    position: absolute;
    inset: auto 0 -1px 0;
    height: 1px;
    background: var(--fm-ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease-in;
  }
  #shopify-section-{{ section.id }} .fm-nav__link:hover,
  #shopify-section-{{ section.id }} .fm-nav__link.is-active {
    color: var(--fm-ink);
  }
  #shopify-section-{{ section.id }} .fm-nav__link.is-active::after {
    transform: scaleX(1);
  }
  #shopify-section-{{ section.id }} .fm-nav__link:focus-visible {
    outline: 2px solid var(--fm-ink);
    outline-offset: 4px;
  }

  /* ---------- Category ---------- */
  #shopify-section-{{ section.id }} .fm-cat {
    padding: clamp(40px, 6vw, 88px) var(--fm-pad) 0;
    scroll-margin-top: calc(var(--fm-sticky-top) + 56px);
  }
  #shopify-section-{{ section.id }} .fm-cat + .fm-cat {
    margin-top: clamp(48px, 7vw, 104px);
    border-top: 1px solid var(--fm-line);
  }
  #shopify-section-{{ section.id }} .fm-cat:last-child {
    padding-bottom: clamp(56px, 8vw, 112px);
  }

  #shopify-section-{{ section.id }} .fm-cat__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--fm-gap);
    align-items: start;
  }
  @media screen and (min-width: 900px) {
    #shopify-section-{{ section.id }} .fm-cat__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .fm-cat__title {
    margin: 0;
    font-family: var(--fm-serif);
    font-weight: 400;
    font-size: clamp(48px, 7.2vw, 112px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-transform: none;
  }
  #shopify-section-{{ section.id }} .fm-cat__tagline {
    max-width: 52ch;
    margin: 18px 0 0;
    color: var(--fm-ink);
    font-size: clamp(14px, 1.15vw, 17px);
    line-height: 1.6;
    letter-spacing: 0.06em;
  }
  #shopify-section-{{ section.id }} .fm-cat__head {
    margin-bottom: clamp(28px, 3.6vw, 52px);
  }

  /* ---------- Article card ---------- */
  #shopify-section-{{ section.id }} .fm-card {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .fm-card__media {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #f2f2f2;
  }
  #shopify-section-{{ section.id }} .fm-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  #shopify-section-{{ section.id }} .fm-card:hover .fm-card__media img {
    transform: scale(1.025);
  }
  #shopify-section-{{ section.id }} .fm-card__title {
    margin: 22px 0 0;
    font-family: var(--fm-serif);
    font-weight: 400;
    font-size: clamp(22px, 2vw, 32px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  #shopify-section-{{ section.id }} .fm-card__meta {
    margin: 14px 0 0;
    color: var(--fm-ink);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .fm-card:focus-visible {
    outline: 2px solid var(--fm-ink);
    outline-offset: 6px;
  }
  #shopify-section-{{ section.id }} .fm-card--feature .fm-card__title {
    font-size: clamp(26px, 2.6vw, 42px);
  }

  #shopify-section-{{ section.id }} .fm-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 4vw, 56px) clamp(16px, 3vw, 56px);
  }
  @media screen and (max-width: 520px) {
    #shopify-section-{{ section.id }} .fm-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .fm-cat__all {
    margin-top: clamp(32px, 4vw, 56px);
  }
  #shopify-section-{{ section.id }} .fm-cat__all a {
    display: inline-block;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--fm-ink);
    color: var(--fm-ink);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .fm-cat__all a:hover {
    border-bottom-color: transparent;
  }

  #shopify-section-{{ section.id }} .fm-empty {
    padding: 32px;
    border: 1px dashed var(--fm-line);
    color: var(--fm-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .fm-card__media img,
    #shopify-section-{{ section.id }} .fm-nav__link,
    #shopify-section-{{ section.id }} .fm-nav__link::after {
      transition: none;
    }
  }
</style>

<div class="fm" data-fm="{{ section.id }}">

  {%- if section.settings.show_nav and section.blocks.size > 1 -%}
    <nav class="fm-nav" aria-label="Magazine categories">
      <ul class="fm-nav__list">
        {%- for block in section.blocks -%}
          {%- assign nav_label = block.settings.nav_label | default: block.settings.title -%}
          <li>
            <a class="fm-nav__link{% if forloop.first %} is-active{% endif %}" href="#fm-{{ block.id }}" data-fm-link="fm-{{ block.id }}" {% if forloop.first %}aria-current="true"{% endif %}>
              {{- nav_label -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- liquid
      assign cat_blog = block.settings.blog
      assign cat_tag = block.settings.tag | strip
      assign cat_limit = block.settings.articles_count
      assign cat_label = block.settings.nav_label | default: block.settings.title
      assign picked = 0
      assign picked_handles = '|'
      assign first_handle = ''
    -%}

    <section class="fm-cat" id="fm-{{ block.id }}" aria-labelledby="fm-title-{{ block.id }}" {{ block.shopify_attributes }}>

      {%- comment -%} First pass: collect the handles of the articles to show (tag filter + limit) {%- endcomment -%}
      {%- if cat_blog != blank -%}
        {%- for article in cat_blog.articles -%}
          {%- if picked >= cat_limit -%}
            {%- break -%}
          {%- endif -%}
          {%- if cat_tag != blank and article.tags contains cat_tag -%}
            {%- assign picked = picked | plus: 1 -%}
            {%- if picked == 1 -%}{%- assign first_handle = article.handle -%}{%- endif -%}
            {%- assign picked_handles = picked_handles | append: article.handle | append: '|' -%}
          {%- elsif cat_tag == blank -%}
            {%- assign picked = picked | plus: 1 -%}
            {%- if picked == 1 -%}{%- assign first_handle = article.handle -%}{%- endif -%}
            {%- assign picked_handles = picked_handles | append: article.handle | append: '|' -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      
      <div class="fm-cat__layout">

        {%- comment -%} LEFT: heading + feature article {%- endcomment -%}
        <div class="fm-cat__main">
          <header class="fm-cat__head">
            <h2 class="fm-cat__title" id="fm-title-{{ block.id }}">{{ block.settings.title }}</h2>
            {%- if block.settings.tagline != blank -%}
              <p class="fm-cat__tagline">{{ block.settings.tagline }}</p>
            {%- endif -%}
          </header>

          {%- if cat_blog == blank -%}
            <div class="fm-empty">Select a blog for this category in the theme editor.</div>
          {%- elsif picked == 0 -%}
            <div class="fm-empty">No articles found yet{% if cat_tag != blank %} with the tag ‚Äú{{ cat_tag }}‚Äù{% endif %}.</div>
          {%- else -%}
            {%- for article in cat_blog.articles -%}
              {%- assign handle_key = '|' | append: article.handle | append: '|' -%}
              {%- if picked_handles contains handle_key and first_handle == article.handle -%}
                {%- liquid
                  assign words = article.content | strip_html | split: ' ' | size
                  assign minutes = words | divided_by: 200.0 | ceil | at_least: 1
                  assign label = article.tags.first | default: cat_label
                -%}
                <a class="fm-card fm-card--feature" href="{{ article.url }}">
                  <span class="fm-card__media">
                    {%- if article.image -%}
                      {{- article.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1200,1400', sizes: '(min-width: 900px) 50vw, 100vw', alt: article.image.alt | default: article.title -}}
                    {%- endif -%}
                  </span>
                  <h3 class="fm-card__title">{{ article.title }}</h3>
                  <p class="fm-card__meta">{{ label }} ¬∑ {{ minutes }} min read</p>
                </a>
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>

        {%- comment -%} RIGHT: grid with the remaining articles {%- endcomment -%}
        {%- if picked > 1 -%}
          <div class="fm-grid">
            {%- for article in cat_blog.articles -%}
              {%- assign handle_key = '|' | append: article.handle | append: '|' -%}
              {%- if picked_handles contains handle_key and first_handle != article.handle -%}
                {%- liquid
                  assign words = article.content | strip_html | split: ' ' | size
                  assign minutes = words | divided_by: 200.0 | ceil | at_least: 1
                  assign label = article.tags.first | default: cat_label
                -%}
                <a class="fm-card" href="{{ article.url }}">
                  <span class="fm-card__media">
                    {%- if article.image -%}
                      {{- article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,900', sizes: '(min-width: 900px) 25vw, 50vw', alt: article.image.alt | default: article.title -}}
                    {%- endif -%}
                  </span>
                  <h3 class="fm-card__title">{{ article.title }}</h3>
                  <p class="fm-card__meta">{{ label }} ¬∑ {{ minutes }} min read</p>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if cat_blog != blank and picked > 0 and block.settings.show_view_all -%}
        <div class="fm-cat__all">
          <a href="{{ cat_blog.url }}{% if cat_tag != blank %}/tagged/{{ cat_tag | handleize }}{% endif %}">View all in {{ cat_label }}</a>
        </div>
      {%- endif -%}
    </section>
  {%- endfor -%}
</div>

<script>
(function () {
  var root = document.querySelector('[data-fm="{{ section.id }}"]');
  if (!root) return;

  var links = Array.prototype.slice.call(root.querySelectorAll('[data-fm-link]'));
  if (!links.length) return;

  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function setActive(id) {
    links.forEach(function (link) {
      var on = link.getAttribute('data-fm-link') === id;
      link.classList.toggle('is-active', on);
      if (on) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  }

  // Smooth scroll to the chosen category
  links.forEach(function (link) {
    link.addEventListener('click', function (event) {
      var target = document.getElementById(link.getAttribute('data-fm-link'));
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      setActive(link.getAttribute('data-fm-link'));
      if (history.replaceState) history.replaceState(null, '', '#' + target.id);
    });
  });

  // Highlight the category that is currently in view
  if ('IntersectionObserver' in window) {
    var sections = links
      .map(function (link) { return document.getElementById(link.getAttribute('data-fm-link')); })
      .filter(Boolean);

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    }, { rootMargin: '-35% 0px -55% 0px', threshold: 0 });

    sections.forEach(function (section) { observer.observe(section); });
  }
})();
</script>

{% schema %}
{
  "name": "Forma Magazine",
  "tag": "section",
  "class": "shopify-section--forma-magazine",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_nav",
      "label": "Show category navigation",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "The Lifestyle"
        },
        {
          "type": "text",
          "id": "nav_label",
          "label": "Navigation label",
          "info": "Leave empty to use the heading."
        },
        {
          "type": "textarea",
          "id": "tagline",
          "label": "Tagline"
        },
        {
          "type": "blog",
          "id": "blog",
          "label": "Blog",
          "info": "The blog that holds this category's articles."
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Only show articles with this tag",
          "info": "Optional. Useful if all four categories live in one blog."
        },
        {
          "type": "range",
          "id": "articles_count",
          "label": "Number of articles",
          "info": "1 large article + the rest in the grid. An odd number gives an even grid.",
          "min": 3,
          "max": 13,
          "step": 2,
          "default": 7
        },
        {
          "type": "checkbox",
          "id": "show_view_all",
          "label": "Show ‚ÄúView all‚Äù link",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Forma Magazine",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Wardrobe",
            "tagline": "Style, fits and the pieces worth building an outfit around."
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "The Lifestyle",
            "tagline": "Travel, culture, movement and the small things that make a day better."
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "The Home",
            "tagline": "Interiors, design and objects that make a space feel like yours."
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "The Form",
            "tagline": "Our take on form, function and the people behind the brands."
          }
        }
      ]
    }
  ]
}
{% endschema %}

