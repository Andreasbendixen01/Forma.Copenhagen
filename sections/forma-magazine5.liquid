{{ 'forma-magazine.css' | asset_url | stylesheet_tag }}
<style>
  /* FORMA MAGAZINE 5: editorial layout, categories on the left */
  .fm5 { --fm5-title-font: var(--heading-font-family); }
  .fm5-wrap { max-width: var(--fm-max, 1600px); margin: 0 auto; padding: 0 var(--container-gutter, 20px) clamp(64px, 7vw, 120px); }

  .fm5-mast { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px 48px; padding: clamp(40px, 5vw, 72px) 0 clamp(24px, 3vw, 36px); border-bottom: 1px solid var(--fm-text, #111); }
  .fm5-mast__title { margin: 0; font-family: var(--fm5-title-font); font-weight: 400; font-size: clamp(44px, 6.4vw, 96px); line-height: .95; letter-spacing: -.02em; color: inherit; }
  .fm5-mast__text { margin: 0; max-width: 380px; font-size: 15px; line-height: 1.55; color: var(--fm-muted, #5e5e5e); }

  .fm5-body { display: grid; grid-template-columns: minmax(170px, 220px) minmax(0, 1fr); gap: clamp(32px, 4.5vw, 80px); padding-top: clamp(32px, 4vw, 48px); }

  .fm5-side__label { margin: 0 0 8px; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--fm-muted, #5e5e5e); }
  .fm5 .fm-nav__list { gap: 0; }
  .fm5 .fm-nav__list > li { border-bottom: 1px solid var(--fm-line, #e3e0db); }
  .fm5 .fm-nav__list > li > .fm-nav__link { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 13px 0; border-bottom: 0; font-size: 15px; }
  .fm5 .fm-nav__list > li > .fm-nav__link:hover { color: var(--fm-muted, #5e5e5e); }
  .fm5 .fm-nav__list > li > .fm-nav__link.is-active { font-weight: 600; color: var(--fm-text, #111); }
  .fm5 .fm-nav__list > li > .fm-nav__link.is-active::after { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .fm5 .fm-nav__brands { margin: 0 0 14px; padding-left: 12px; gap: 9px; }
  .fm5 .fm-nav__brands .fm-nav__link { font-size: 13px; }

  .fm5-head { display: flex; align-items: center; gap: 20px; margin-bottom: clamp(24px, 3vw, 36px); scroll-margin-top: calc(var(--sticky-area-height, 0px) + 24px); }
  .fm5-head .fm-head__title { font-family: var(--fm5-title-font); font-size: clamp(28px, 2.6vw, 38px); }
  .fm5-head .fm-head__text { font-size: 15px; color: var(--fm-muted, #5e5e5e); }

  .fm5-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 48px 24px; align-items: start; }
  .fm5-card { grid-column: span 3; order: 1; }
  .fm5-card[hidden], .fm5-divider[hidden], .fm5-more[hidden] { display: none; }
  .fm5-card.is-lead { grid-column: 1 / span 7; grid-row: 1 / span 2; order: -1; }
  .fm5-card.is-side { grid-column: 8 / span 5; order: -1; align-self: start; }
  .fm5-card.is-side-2 { align-self: end; }
  .fm5-divider { grid-column: 1 / -1; order: 0; display: flex; align-items: baseline; gap: 16px; margin: 8px 0 -16px; padding-top: 40px; border-top: 1px solid var(--fm-line, #e3e0db); }
  .fm5-divider__title { margin: 0; font-family: var(--fm5-title-font); font-weight: 400; font-size: clamp(24px, 2.2vw, 32px); }

  .fm5-card__link { display: flex; flex-direction: column; gap: 12px; text-decoration: none; color: inherit; }
  .fm5-card__media { display: block; overflow: hidden; aspect-ratio: 4 / 5; background: var(--fm-card, #f4f3f0); }
  .fm5-card.is-side .fm5-card__media { aspect-ratio: 11 / 10; }
  .fm5-card__media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.22, 1, .36, 1); }
  .fm5-card__link:hover .fm5-card__media img { transform: scale(1.025); }
  .fm5-card__kicker { margin-top: 6px; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--fm-muted, #5e5e5e); }
  .fm5-card__title { font-family: var(--fm5-title-font); font-size: 21px; line-height: 1.22; letter-spacing: -.005em; }
  .fm5-card__link:hover .fm5-card__title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .fm5-card.is-side .fm5-card__title { font-size: clamp(22px, 1.9vw, 28px); line-height: 1.15; }
  .fm5-card.is-lead .fm5-card__title { font-size: clamp(32px, 3.4vw, 54px); line-height: 1.04; letter-spacing: -.015em; }
  .fm5-card__excerpt, .fm5-card__more { display: none; }
  .fm5-card.is-lead .fm5-card__excerpt { display: block; max-width: 560px; font-size: 16px; line-height: 1.55; color: var(--fm-muted, #5e5e5e); }
  .fm5-card.is-lead .fm5-card__more { display: inline-block; margin-top: 2px; font-size: 14px; font-weight: 500; }

  .fm5-more { display: flex; justify-content: center; padding-top: clamp(40px, 5vw, 64px); }
  .fm5-more__button { min-height: 52px; padding: 0 40px; border: 1px solid var(--fm-text, #111); background: transparent; color: var(--fm-text, #111); font-size: 13px; letter-spacing: .1em; text-transform: uppercase; cursor: pointer; transition: background-color .2s ease, color .2s ease; }
  .fm5-more__button:hover { background: var(--fm-text, #111); color: var(--fm-bg, #fff); }
  .fm5 button:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  @media (max-width: 1199px) {
    .fm5-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .fm5-card { grid-column: span 2; }
    .fm5-card.is-lead { grid-column: 1 / -1; grid-row: auto; }
    .fm5-card.is-side { grid-column: span 3; }
  }
  @media (max-width: 749px) {
    .fm5-body { grid-template-columns: minmax(0, 1fr); gap: 24px; padding-top: 0; }
    .fm5-side { margin: 0 calc(-1 * var(--container-gutter, 20px)); padding: 14px var(--container-gutter, 20px); border-bottom: 1px solid var(--fm-line, #e3e0db); }
    .fm5-side__label { display: none; }
    .fm5 .fm-nav { position: static; }
    .fm5 .fm-nav__list { flex-direction: row; flex-wrap: nowrap; gap: 8px; overflow-x: auto; scrollbar-width: none; }
    .fm5 .fm-nav__list::-webkit-scrollbar { display: none; }
    .fm5 .fm-nav__list > li { flex: none; border: 0; }
    .fm5 .fm-nav__list > .fm-nav__item--brands { display: contents; }
    .fm5 .fm-nav__list > li > .fm-nav__link, .fm5 .fm-nav__item--brands > .fm-nav__link { display: inline-flex; width: auto; min-height: 40px; padding: 0 16px; border: 1px solid var(--fm-line, #e3e0db); border-radius: 20px; font-size: 14px; white-space: nowrap; }
    .fm5 .fm-nav__item--brands > .fm-nav__link.is-active, .fm5 .fm-nav__list > li > .fm-nav__link.is-active { background: var(--fm-text, #111); border-color: var(--fm-text, #111); color: var(--fm-bg, #fff); font-weight: 500; }
    .fm5 .fm-nav__list > li > .fm-nav__link.is-active::after { display: none; }
    .fm5 .fm-nav__brands { flex: none; flex-direction: row; gap: 8px 16px; align-items: center; margin: 0; padding: 0 0 0 8px; border-left: 1px solid var(--fm-line, #e3e0db); }
    .fm5 .fm-nav__brands .fm-nav__link { white-space: nowrap; }
    .fm5-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 12px; }
    .fm5-card { grid-column: span 1; }
    .fm5-card.is-lead, .fm5-card.is-side { grid-column: 1 / -1; }
    .fm5-card__title { font-size: 17px; }
    .fm5-divider { margin-bottom: -8px; padding-top: 28px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fm5-card__media img { transition: none; }
  }
</style>
{%- liquid
  assign all_articles = '' | split: ''
  if section.settings.blog_1 != blank
    assign all_articles = all_articles | concat: section.settings.blog_1.articles
  endif
  if section.settings.blog_2 != blank
    assign all_articles = all_articles | concat: section.settings.blog_2.articles
  endif
  if section.settings.blog_3 != blank
    assign all_articles = all_articles | concat: section.settings.blog_3.articles
  endif
  assign all_articles = all_articles | sort: 'published_at' | reverse
  assign brand_entries = shop.metaobjects.forma_brand.values
-%}
<div
  id="fm-{{ section.id }}"
  class="fm fm5"
  data-fm5
  data-per-page="{{ section.settings.per_page }}"
  style="--fm-bg: {{ section.settings.background }}; --fm-text: {{ section.settings.text }}; --fm-muted: {{ section.settings.muted }}; --fm-line: {{ section.settings.line }}; --fm-card: {{ section.settings.card_background }}; --fm-max: {{ section.settings.max_width }}px;"
>
  <div class="fm5-wrap">
    <header class="fm5-mast">
      {%- if section.settings.heading != blank -%}
        <h1 class="fm5-mast__title">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="fm5-mast__text">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </header>

    <div class="fm5-body">
      <aside class="fm5-side">
        {%- if section.settings.sections_label != blank -%}
          <p class="fm5-side__label">{{ section.settings.sections_label | escape }}</p>
        {%- endif -%}
        {%- render 'forma-magazine-nav',
          blocks: section.blocks,
          all_label: section.settings.all_label,
          all_description: section.settings.all_description,
          magazine_url: request.path,
          active_topic: 'all',
          active_brand: ''
        -%}
      </aside>

      <div class="fm5-main">
        <div class="fm5-head" data-fm5-head>
          <div class="fm-head__logo" data-mag-logo hidden></div>
          <div>
            <h2 class="fm-head__title" data-mag-heading>{{ section.settings.all_label | escape }}</h2>
            <p class="fm-head__text" data-mag-description {% if section.settings.all_description == blank %}hidden{% endif %}>{{ section.settings.all_description | escape }}</p>
          </div>
        </div>

        <div class="fm5-grid">
          <div class="fm5-divider" data-fm5-divider {% if all_articles.size <= 3 %}hidden{% endif %}>
            <h3 class="fm5-divider__title">{{ section.settings.more_heading | escape }}</h3>
          </div>
          {%- for article in all_articles -%}
            {%- liquid
              assign tag_handles = ' '
              for tag in article.tags
                assign tag_handle = tag | handleize
                assign tag_handles = tag_handles | append: tag_handle | append: ' '
              endfor

              assign badge = ''
              for brand in brand_entries
                if badge == '' and brand.brand_name.value != blank
                  assign brand_handle = brand.brand_name.value | handleize
                  assign needle = ' ' | append: brand_handle | append: ' '
                  if tag_handles contains needle
                    assign badge = brand.brand_name.value
                  endif
                endif
              endfor
              if badge == ''
                for block in section.blocks
                  if block.type == 'topic' and badge == ''
                    assign topic_handle = block.settings.tag | default: block.settings.label | handleize
                    assign needle = ' ' | append: topic_handle | append: ' '
                    if tag_handles contains needle
                      assign badge = block.settings.label
                    endif
                  endif
                endfor
              endif
              if badge == '' and article.tags.size > 0
                assign badge = article.tags.first
              endif

              assign excerpt = article.excerpt | strip_html | strip
              if excerpt == blank
                assign excerpt = article.content | strip_html | strip | truncatewords: 30
              endif
            -%}
            <article class="fm5-card" data-fm5-card data-tags="{{ tag_handles }}">
              <a class="fm5-card__link" href="{{ article.url }}">
                <span class="fm5-card__media">
                  {%- if article.image != blank -%}
                    {{ article.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1100, 1400, 1600', sizes: '(min-width: 750px) 50vw, 100vw', alt: article.image.alt | default: '' }}
                  {%- endif -%}
                </span>
                {%- if badge != blank -%}
                  <span class="fm5-card__kicker">{{ badge | escape }}</span>
                {%- endif -%}
                <span class="fm5-card__title">{{ article.title | escape }}</span>
                {%- if excerpt != blank -%}
                  <span class="fm5-card__excerpt">{{ excerpt | escape }}</span>
                {%- endif -%}
                <span class="fm5-card__more" aria-hidden="true">{{ section.settings.read_label | escape }} →</span>
              </a>
            </article>
          {%- endfor -%}
        </div>

        <p class="fm-empty" data-mag-empty {% if all_articles.size > 0 %}hidden{% endif %}>{{ section.settings.empty_text | escape }}</p>

        <div class="fm5-more" data-fm5-more hidden>
          <button type="button" class="fm5-more__button">{{ section.settings.load_more_label | escape }}</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  /* FORMA MAGAZINE 5: category filter, lead story and "load more" */
  (function () {
    if (window.FormaMagazine5) {
      window.FormaMagazine5.initAll();
      return;
    }

    function init(root) {
      if (!root || root.hasAttribute('data-fm5-ready')) return;
      root.setAttribute('data-fm5-ready', '');

      var cards = Array.prototype.slice.call(root.querySelectorAll('[data-fm5-card]'));
      var links = root.querySelectorAll('[data-mag-topic], [data-mag-brand]');
      var heading = root.querySelector('[data-mag-heading]');
      var description = root.querySelector('[data-mag-description]');
      var logo = root.querySelector('[data-mag-logo]');
      var empty = root.querySelector('[data-mag-empty]');
      var brandList = root.querySelector('[data-mag-brands]');
      var head = root.querySelector('[data-fm5-head]');
      var divider = root.querySelector('[data-fm5-divider]');
      var more = root.querySelector('[data-fm5-more]');
      var moreButton = more ? more.querySelector('button') : null;
      var perPage = parseInt(root.getAttribute('data-per-page'), 10) || 15;
      var brandHandles = Array.prototype.map.call(root.querySelectorAll('[data-mag-brand]'), function (link) {
        return link.getAttribute('data-mag-brand');
      });
      var visible = cards.slice();
      var shown = perPage;

      function draw() {
        cards.forEach(function (card) {
          card.hidden = true;
          card.classList.remove('is-lead', 'is-side', 'is-side-2');
        });
        visible.forEach(function (card, i) {
          if (i >= shown) return;
          card.hidden = false;
          if (i === 0) card.classList.add('is-lead');
          else if (i < 3) card.classList.add('is-side');
          if (i === 2) card.classList.add('is-side-2');
        });
        if (divider) divider.hidden = Math.min(shown, visible.length) <= 3;
        if (more) more.hidden = visible.length <= shown;
        if (empty) empty.hidden = visible.length > 0;
      }

      function find(attr, value) {
        if (!value) return null;
        var safe = window.CSS && CSS.escape ? CSS.escape(value) : value.replace(/[^a-z0-9_-]/gi, '');
        return root.querySelector('[' + attr + '="' + safe + '"]');
      }

      function apply(kind, value, push) {
        var link = kind === 'brand' ? find('data-mag-brand', value) : find('data-mag-topic', value);
        if (!link) {
          kind = 'topic';
          value = 'all';
          link = find('data-mag-topic', 'all');
        }
        Array.prototype.forEach.call(links, function (item) {
          item.classList.remove('is-active');
          item.removeAttribute('aria-current');
        });
        if (link) {
          link.classList.add('is-active');
          link.setAttribute('aria-current', 'page');
        }
        if (brandList) brandList.hidden = !(kind === 'brand' || value === 'brands');

        visible = cards.filter(function (card) {
          var tags = card.getAttribute('data-tags') || ' ';
          if (value === 'all') return true;
          if (kind === 'topic' && value === 'brands') {
            return brandHandles.some(function (handle) { return tags.indexOf(' ' + handle + ' ') > -1; });
          }
          return tags.indexOf(' ' + value + ' ') > -1;
        });
        shown = perPage;

        if (link && heading) heading.textContent = link.getAttribute('data-title') || link.textContent;
        if (link && description) {
          var text = link.getAttribute('data-description') || '';
          description.textContent = text;
          description.hidden = text === '';
        }
        if (logo) {
          var logoUrl = kind === 'brand' && link ? link.getAttribute('data-logo') : null;
          logo.innerHTML = '';
          if (logoUrl) {
            var img = document.createElement('img');
            img.src = logoUrl;
            img.alt = '';
            logo.appendChild(img);
          }
          logo.hidden = !logoUrl;
        }

        draw();

        if (push) {
          var url = new URL(window.location.href);
          url.searchParams.delete('topic');
          url.searchParams.delete('brand');
          if (value !== 'all') url.searchParams.set(kind === 'brand' ? 'brand' : 'topic', value);
          window.history.pushState({}, '', url);
          if (head && head.getBoundingClientRect().top < 0) {
            var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            head.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
          }
        }
      }

      Array.prototype.forEach.call(links, function (link) {
        link.addEventListener('click', function (event) {
          event.preventDefault();
          var brand = link.getAttribute('data-mag-brand');
          if (brand) {
            apply('brand', brand, true);
          } else {
            apply('topic', link.getAttribute('data-mag-topic'), true);
          }
        });
      });

      if (moreButton) {
        moreButton.addEventListener('click', function () {
          var first = visible[shown];
          shown += perPage;
          draw();
          if (first) {
            var target = first.querySelector('a');
            if (target) target.focus({ preventScroll: true });
          }
        });
      }

      function fromUrl() {
        var params = new URLSearchParams(window.location.search);
        if (params.get('brand')) {
          apply('brand', params.get('brand'), false);
        } else {
          apply('topic', params.get('topic') || 'all', false);
        }
      }

      window.addEventListener('popstate', fromUrl);
      fromUrl();
    }

    function initAll(scope) {
      Array.prototype.forEach.call((scope || document).querySelectorAll('[data-fm5]'), init);
    }

    window.FormaMagazine5 = { init: init, initAll: initAll };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { initAll(); });
    } else {
      initAll();
    }
    document.addEventListener('shopify:section:load', function (event) { initAll(event.target); });
  })();
</script>

{% schema %}
{
  "name": "Forma Magazine 5",
  "tag": "section",
  "class": "shopify-section--forma-magazine",
  "max_blocks": 16,
  "settings": [
    { "type": "header", "content": "Top" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Forma Magazine" },
    { "type": "text", "id": "intro", "label": "Text", "default": "Stories on wardrobe, lifestyle, home and the brands we love." },
    { "type": "header", "content": "Articles" },
    { "type": "blog", "id": "blog_1", "label": "Blog 1" },
    { "type": "blog", "id": "blog_2", "label": "Blog 2" },
    { "type": "blog", "id": "blog_3", "label": "Blog 3" },
    { "type": "paragraph", "content": "The newest article is shown large, the next two beside it. Articles appear under a category when they have its tag. Brand articles need the brand's name as a tag, e.g. Les Deux." },
    { "type": "text", "id": "sections_label", "label": "Category menu label", "default": "Sections" },
    { "type": "text", "id": "all_label", "label": "All articles label", "default": "All articles" },
    { "type": "textarea", "id": "all_description", "label": "All articles intro", "default": "Everything from Forma, from wardrobe staples and the way we live to the homes and brands behind it, in one place." },
    { "type": "text", "id": "more_heading", "label": "Heading above the other articles", "default": "More stories" },
    { "type": "text", "id": "read_label", "label": "Read link label", "default": "Read the article" },
    { "type": "range", "id": "per_page", "label": "Articles before \"Load more\"", "min": 7, "max": 31, "step": 4, "default": 15 },
    { "type": "text", "id": "load_more_label", "label": "Load more label", "default": "Load more articles" },
    { "type": "text", "id": "empty_text", "label": "No articles text", "default": "No articles here yet. Check back soon." },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 1200, "max": 2400, "step": 40, "unit": "px", "default": 1600 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "muted", "label": "Muted text", "default": "#5e5e5e" },
    { "type": "color", "id": "line", "label": "Lines", "default": "#e3e0db" },
    { "type": "color", "id": "card_background", "label": "Image background", "default": "#f4f3f0" }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Wardrobe" },
        { "type": "text", "id": "tag", "label": "Article tag", "info": "Articles with this tag show up here. Uses the label if empty." },
        { "type": "textarea", "id": "description", "label": "Intro" }
      ]
    },
    {
      "type": "brands",
      "name": "Brands",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Lists every brand from the Forma Brand entries. Tag an article with a brand's name to show it under that brand." },
        { "type": "text", "id": "label", "label": "Label", "default": "Brands" },
        { "type": "textarea", "id": "description", "label": "Intro" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Forma Magazine 5",
      "blocks": [
        { "type": "topic", "settings": { "label": "Wardrobe", "tag": "Wardrobe", "description": "Wardrobe staples, new arrivals and how to wear them." } },
        { "type": "topic", "settings": { "label": "The Lifestyle", "tag": "The Lifestyle", "description": "Skincare, grooming, fragrance and the small rituals of everyday life." } },
        { "type": "topic", "settings": { "label": "The Home", "tag": "The Home", "description": "Furniture, lighting and objects for a home with form." } },
        { "type": "brands", "settings": { "label": "Brands", "description": "Stories from the brands we carry. Pick a brand to read more about it." } }
      ]
    }
  ]
}
{% endschema %}
