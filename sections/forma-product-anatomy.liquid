{% liquid
  assign detail_image = product.metafields.forma.detail_image.value
  assign details = product.metafields.forma.details.value
  assign model_info = product.metafields.forma.model.value
  assign fit_value = product.metafields.forma.fit.value
  assign material = product.metafields.forma.material.value
  assign care = product.metafields.forma.care.value

  assign has_anatomy = false
  if detail_image != blank
    assign has_anatomy = true
  endif

  assign has_facts = false
  if model_info != blank or fit_value != blank or material != blank or care != blank
    assign has_facts = true
  endif

  assign product_brand_handle = product.vendor | handleize
  assign brand_collection = collections[product_brand_handle]
  if brand_collection.url != blank
    assign brand_link = brand_collection.url
  else
    assign brand_link = product.vendor | url_for_vendor
  endif

  assign fit_position = 50
  if fit_value != blank
    assign fit_clamped = fit_value | at_least: 1 | at_most: 5
    assign fit_position = fit_clamped | minus: 1 | times: 25
  endif

  assign details_count = details | size
%}

{% if has_anatomy or has_facts %}
  <section
    id="forma-anatomy-{{ section.id }}"
    class="fpa"
    aria-label="{{ section.settings.heading | escape }}"
  >
    <div class="fpa__inner">

      {% if has_anatomy %}
        <div class="fpa__main">
          <div class="fpa__stage">
            {{
              detail_image
              | image_url: width: 1400
              | image_tag:
                class: 'fpa__image',
                widths: '480, 750, 1000, 1400',
                sizes: '(max-width: 749px) 100vw, 58vw',
                loading: 'lazy',
                alt: product.title
            }}
            {% for d in details %}
              <button
                class="fpa__dot{% if forloop.first %} is-active{% endif %}"
                type="button"
                data-fpa-dot="{{ forloop.index0 }}"
                style="left: {{ d.x.value | default: 50 }}%; top: {{ d.y.value | default: 50 }}%;"
                aria-label="{{ d.title.value | escape }}"
              >
                <span class="fpa__dot-num" aria-hidden="true">{{ forloop.index }}</span>
              </button>
            {% endfor %}
          </div>

          <div class="fpa__panel">
            <p class="fpa__kicker">{{ section.settings.heading | escape }}</p>
            {% if details_count > 0 %}
              <ol class="fpa__list">
                {% for d in details %}
                  <li class="fpa__item{% if forloop.first %} is-active{% endif %}" data-fpa-item="{{ forloop.index0 }}">
                    <button
                      class="fpa__item-btn"
                      type="button"
                      data-fpa-trigger="{{ forloop.index0 }}"
                      aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                    >
                      <span class="fpa__item-num">{{ forloop.index | prepend: '0' }}</span>
                      <span class="fpa__item-title">{{ d.title.value | escape }}</span>
                    </button>
                    <div class="fpa__item-body">
                      <p>{{ d.text.value | escape | newline_to_br }}</p>
                    </div>
                  </li>
                {% endfor %}
              </ol>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if has_facts %}
        <dl class="fpa__facts">
          {% if model_info != blank or fit_value != blank %}
            <div class="fpa__fact">
              <dt>Fit</dt>
              {% if model_info != blank %}<dd>{{ model_info | escape }}</dd>{% endif %}
              {% if fit_value != blank %}
                <div class="fpa__scale" aria-hidden="true">
                  <span class="fpa__scale-line"><span class="fpa__scale-dot" style="left: {{ fit_position }}%;"></span></span>
                  <span class="fpa__scale-labels"><span>Slim</span><span>Relaxed</span></span>
                </div>
              {% endif %}
            </div>
          {% endif %}
          {% if material != blank %}
            <div class="fpa__fact">
              <dt>Material</dt>
              <dd>{{ material | escape }}</dd>
            </div>
          {% endif %}
          {% if care != blank %}
            <div class="fpa__fact">
              <dt>Care</dt>
              <dd>{{ care | escape }}</dd>
            </div>
          {% endif %}
        </dl>
      {% endif %}

      {% if section.settings.show_brand_credit %}
        <div class="fpa__credit">
          <p>Curated by Forma <span class="fpa__credit-sep">¬∑</span> {{ product.vendor | escape }}</p>
          <a href="{{ brand_link }}">View collection <span aria-hidden="true">‚Üí</span></a>
        </div>
      {% endif %}

    </div>
  </section>

  <style>
    #shopify-section-{{ section.id }} .fpa {
      --fpa-ink: #242421;
      --fpa-muted: #77766f;
      --fpa-line: rgba(36, 36, 33, .14);
      width: 100%;
      padding: clamp(40px, 5vw, 80px) 0;
      background: #fff;
      color: var(--fpa-ink);
    }
    #shopify-section-{{ section.id }} .fpa * { box-sizing: border-box; }
    #shopify-section-{{ section.id }} .fpa__inner { width: 100%; max-width: 1600px; margin: 0 auto; padding: 0 clamp(28px, 4vw, 64px); }

    #shopify-section-{{ section.id }} .fpa__main {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      column-gap: clamp(32px, 6vw, 112px);
      align-items: center;
    }
    #shopify-section-{{ section.id }} .fpa__stage { position: relative; width: 100%; aspect-ratio: 4 / 5; max-height: 720px; overflow: hidden; background: #f4f3f0; }
    #shopify-section-{{ section.id }} .fpa__image { display: block; width: 100%; height: 100%; object-fit: cover; }

    #shopify-section-{{ section.id }} .fpa__dot {
      position: absolute; width: 28px; height: 28px; margin: -14px 0 0 -14px; padding: 0;
      display: inline-flex; align-items: center; justify-content: center;
      border: 1px solid rgba(255, 255, 255, .95); border-radius: 50%;
      background: rgba(255, 255, 255, .85); color: var(--fpa-ink); font: inherit; font-size: 10px; line-height: 1;
      cursor: pointer; transition: background 200ms ease, color 200ms ease, transform 200ms ease;
    }
    #shopify-section-{{ section.id }} .fpa__dot::after {
      content: ""; position: absolute; inset: -1px; border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, .9); opacity: 0; animation: fpa-pulse 2.8s ease-out infinite;
    }
    #shopify-section-{{ section.id }} .fpa__dot:hover { transform: scale(1.08); }
    #shopify-section-{{ section.id }} .fpa__dot.is-active { background: var(--fpa-ink); border-color: var(--fpa-ink); color: #fff; }
    #shopify-section-{{ section.id }} .fpa__dot.is-active::after { animation: none; }
    #shopify-section-{{ section.id }} .fpa__dot:focus-visible,
    #shopify-section-{{ section.id }} .fpa__item-btn:focus-visible,
    #shopify-section-{{ section.id }} .fpa__credit a:focus-visible { outline: 2px solid var(--fpa-ink); outline-offset: 3px; }
    @keyframes fpa-pulse {
      0% { transform: scale(1); opacity: .7; }
      100% { transform: scale(1.9); opacity: 0; }
    }

    #shopify-section-{{ section.id }} .fpa__panel { min-width: 0; max-width: 420px; }
    #shopify-section-{{ section.id }} .fpa__kicker { margin: 0 0 24px; color: var(--fpa-muted); font-size: 10px; font-weight: 600; letter-spacing: .18em; line-height: 1.5; text-transform: uppercase; }
    #shopify-section-{{ section.id }} .fpa__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--fpa-line); }
    #shopify-section-{{ section.id }} .fpa__item { border-bottom: 1px solid var(--fpa-line); }
    #shopify-section-{{ section.id }} .fpa__item-btn {
      display: flex; align-items: baseline; gap: 16px; width: 100%; padding: 18px 0; border: 0; background: transparent;
      color: var(--fpa-muted); font: inherit; text-align: left; cursor: pointer; transition: color 200ms ease;
    }
    #shopify-section-{{ section.id }} .fpa__item-num { flex: 0 0 auto; font-size: 10px; letter-spacing: .1em; }
    #shopify-section-{{ section.id }} .fpa__item-title { font-size: 15px; line-height: 1.4; }
    #shopify-section-{{ section.id }} .fpa__item-btn:hover,
    #shopify-section-{{ section.id }} .fpa__item.is-active .fpa__item-btn { color: var(--fpa-ink); }
    #shopify-section-{{ section.id }} .fpa__item-body { padding: 0 0 0 30px; }
    #shopify-section-{{ section.id }} .fpa__item-body p { margin: 0 0 20px; max-width: 36ch; color: var(--fpa-muted); font-size: 13px; line-height: 1.8; }

    #shopify-section-{{ section.id }} .fpa.is-js .fpa__item-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 380ms cubic-bezier(.2, .65, .3, 1); }
    #shopify-section-{{ section.id }} .fpa.is-js .fpa__item-body > p { overflow: hidden; min-height: 0; margin: 0; }
    #shopify-section-{{ section.id }} .fpa.is-js .fpa__item.is-active .fpa__item-body { grid-template-rows: 1fr; }
    #shopify-section-{{ section.id }} .fpa.is-js .fpa__item.is-active .fpa__item-body > p { padding-bottom: 20px; }

    #shopify-section-{{ section.id }} .fpa__facts {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 24px clamp(24px, 4vw, 64px);
      margin: clamp(32px, 4vw, 56px) 0 0; padding: 24px 0 0; border-top: 1px solid var(--fpa-line);
    }
    #shopify-section-{{ section.id }} .fpa__fact { min-width: 0; margin: 0; }
    #shopify-section-{{ section.id }} .fpa__fact dt { margin: 0 0 8px; color: var(--fpa-muted); font-size: 10px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; }
    #shopify-section-{{ section.id }} .fpa__fact dd { margin: 0; font-size: 13px; line-height: 1.7; }
    #shopify-section-{{ section.id }} .fpa__scale { margin-top: 14px; max-width: 220px; }
    #shopify-section-{{ section.id }} .fpa__scale-line { position: relative; display: block; height: 1px; background: var(--fpa-line); }
    #shopify-section-{{ section.id }} .fpa__scale-dot { position: absolute; top: -3px; width: 7px; height: 7px; margin-left: -3.5px; border-radius: 50%; background: var(--fpa-ink); }
    #shopify-section-{{ section.id }} .fpa__scale-labels { display: flex; justify-content: space-between; margin-top: 8px; color: var(--fpa-muted); font-size: 10px; }

    #shopify-section-{{ section.id }} .fpa__credit {
      display: flex; align-items: center; justify-content: space-between; gap: 16px;
      margin-top: clamp(28px, 3vw, 40px); padding-top: 20px; border-top: 1px solid var(--fpa-line);
      color: var(--fpa-muted); font-size: 12px;
    }
    #shopify-section-{{ section.id }} .fpa__credit p { margin: 0; }
    #shopify-section-{{ section.id }} .fpa__credit-sep { margin: 0 4px; }
    #shopify-section-{{ section.id }} .fpa__credit a { color: var(--fpa-ink); text-decoration: none; border-bottom: 1px solid var(--fpa-ink); padding-bottom: 1px; }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .fpa { padding: 32px 0; }
      #shopify-section-{{ section.id }} .fpa__inner { padding: 0 18px; }
      #shopify-section-{{ section.id }} .fpa__main { grid-template-columns: 1fr; row-gap: 28px; }
      #shopify-section-{{ section.id }} .fpa__panel { max-width: none; }
      #shopify-section-{{ section.id }} .fpa__facts { grid-template-columns: 1fr; gap: 20px; }
    }
    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .fpa__dot::after { animation: none; }
      #shopify-section-{{ section.id }} .fpa * { transition: none !important; }
    }
  </style>

  <script>
    (function () {
      var root = document.getElementById('forma-anatomy-{{ section.id }}');
      if (!root) return;
      var dots = root.querySelectorAll('[data-fpa-dot]');
      var items = root.querySelectorAll('[data-fpa-item]');
      var triggers = root.querySelectorAll('[data-fpa-trigger]');
      if (!items.length) return;
      root.classList.add('is-js');

      function setActive(i) {
        for (var n = 0; n < items.length; n++) {
          var on = n === i;
          items[n].classList.toggle('is-active', on);
          if (triggers[n]) triggers[n].setAttribute('aria-expanded', on ? 'true' : 'false');
          if (dots[n]) dots[n].classList.toggle('is-active', on);
        }
      }

      dots.forEach(function (d) {
        d.addEventListener('click', function () { setActive(parseInt(d.getAttribute('data-fpa-dot'), 10)); });
      });
      triggers.forEach(function (t) {
        t.addEventListener('click', function () { setActive(parseInt(t.getAttribute('data-fpa-trigger'), 10)); });
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Forma product anatomy",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Label",
      "default": "The piece"
    },
    {
      "type": "checkbox",
      "id": "show_brand_credit",
      "label": "Show brand credit line",
      "default": true
    }
  ],
  "presets": [
    { "name": "Forma product anatomy" }
  ]
}
{% endschema %}

