<style>

  /* ============================================================
     FORMA — FOOTER
     Complete footer redesign
     ============================================================ */

  #shopify-section-{{ section.id }} {
    --forma-footer-bg: #f4f4f1;
    --forma-footer-text: #171717;
    --forma-footer-muted: rgba(23, 23, 23, 0.52);
    --forma-footer-faint: rgba(23, 23, 23, 0.18);
    --forma-footer-border: rgba(23, 23, 23, 0.10);
    --forma-footer-max: 1480px;
  }


  /* ============================================================
     BASE
     ============================================================ */

  #shopify-section-{{ section.id }} .forma-footer {
    position: relative;

    width: 100%;

    margin: 0;
    padding: 0;

    background: var(--forma-footer-bg);
    color: var(--forma-footer-text);

    overflow: hidden;
  }


  #shopify-section-{{ section.id }} .forma-footer a {
    color: inherit;
    text-decoration: none;
  }


  /* ============================================================
     MAIN FOOTER CONTAINER
     ============================================================ */

  #shopify-section-{{ section.id }} .forma-footer__inner {
    width: 100%;
    max-width: var(--forma-footer-max);

    margin: 0 auto;

    padding: 0 48px;
  }


  /* ============================================================
     BRAND STATEMENT
     ============================================================ */

  #shopify-section-{{ section.id }} .forma-footer__brand {

    display: flex;

    align-items: flex-end;
    justify-content: space-between;

    gap: 40px;

    padding: 72px 0 54px;

    border-bottom: 1px solid var(--forma-footer-border);
  }


  #shopify-section-{{ section.id }} .forma-footer__brand-mark {

    margin: 0;

    font-size: clamp(72px, 11vw, 170px);

    line-height: 0.78;

    font-weight: 400;

    letter-spacing: -0.075em;

    text-transform: uppercase;

    color: var(--forma-footer-text);

    user-select: none;
  }


  #shopify-section-{{ section.id }} .forma-footer__brand-note {

    max-width: 300px;

    margin: 0 0 4px;

    font-size: 11px;

    line-height: 1.6;

    letter-spacing: 0.08em;

    text-transform: uppercase;

    color: var(--forma-footer-muted);

    text-align: right;
  }


  /* ============================================================
     NAVIGATION
     ============================================================ */

  #shopify-section-{{ section.id }} .forma-footer__navigation {

    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    column-gap: 80px;

    padding: 58px 0 62px;
  }


  #shopify-section-{{ section.id }} .forma-footer__column {
    min-width: 0;
  }


  #shopify-section-{{ section.id }} .forma-footer__heading {

    margin: 0 0 22px;

    font-size: 9px;

    line-height: 1;

    font-weight: 500;

    letter-spacing: 0.15em;

    text-transform: uppercase;

    color: var(--forma-footer-muted);
  }


  #shopify-section-{{ section.id }} .forma-footer__links {

    display: flex;

    flex-direction: column;

    align-items: flex-start;

    gap: 10px;

    padding: 0;
    margin: 0;

    list-style: none;
  }


  #shopify-section-{{ section.id }} .forma-footer__links li {
    margin: 0;
    padding: 0;
  }


  #shopify-section-{{ section.id }} .forma-footer__links a {

    position: relative;

    display: inline-block;

    font-size: 13px;

    line-height: 1.45;

    font-weight: 400;

    letter-spacing: -0.005em;

    color: rgba(23,23,23,0.72);

    transition:
      color 0.25s ease,
      transform 0.25s ease;
  }


  #shopify-section-{{ section.id }} .forma-footer__links a::after {

    content: "";

    position: absolute;

    left: 0;
    bottom: -3px;

    width: 100%;
    height: 1px;

    background: currentColor;

    transform: scaleX(0);

    transform-origin: right center;

    transition:
      transform 0.3s cubic-bezier(.22,.61,.36,1);
  }


  #shopify-section-{{ section.id }} .forma-footer__links a:hover {

    color: var(--forma-footer-text);

    transform: translateX(3px);
  }


  #shopify-section-{{ section.id }} .forma-footer__links a:hover::after {

    transform: scaleX(1);

    transform-origin: left center;
  }


  /* ============================================================
     FORMA LETTER
     ============================================================ */

  #shopify-section-{{ section.id }} .forma-footer__letter {

    position: relative;

    padding: 94px 0 100px;

    border-top: 1px solid var(--forma-footer-border);
    border-bottom: 1px solid var(--forma-footer-border);

    text-align: center;
  }


  #shopify-section-{{ section.id }} .forma-footer__letter::before {

    content: "";

    position: absolute;

    top: 0;
    left: 50%;

    width: 1px;
    height: 36px;

    background: var(--forma-footer-border);

    transform: translateX(-50%);
  }


  #shopify-section-{{ section.id }} .forma-footer__letter-eyebrow {

    margin: 0 0 24px;

    font-size: 9px;

    line-height: 1;

    font-weight: 500;

    letter-spacing: 0.22em;

    text-transform: uppercase;

    color: var(--forma-footer-muted);
  }


  #shopify-section-{{ section.id }} .forma-footer__letter-title {

    margin: 0;

    font-family: var(--font-heading-family, inherit);

    font-size: clamp(42px, 5.4vw, 76px);

    line-height: 0.98;

    font-weight: 400;

    letter-spacing: -0.045em;
  }


  #shopify-section-{{ section.id }} .forma-footer__letter-description {

    max-width: 520px;

    margin: 22px auto 0;

    font-size: 13px;

    line-height: 1.6;

    color: var(--forma-footer-muted);
  }


  /* ============================================================
     NEWSLETTER FORM
     ============================================================ */

  #shopify-section-{{ section.id }} .forma-footer__form {

    width: min(720px, 100%);

    margin: 54px auto 0;
  }


  #shopify-section-{{ section.id }} .forma-footer__input-row {

    display: flex;

    align-items: center;

    width: 100%;

    border-bottom: 1px solid rgba(23,23,23,0.55);

    transition:
      border-color 0.25s ease;
  }


  #shopify-section-{{ section.id }} .forma-footer__input-row:focus-within {

    border-color: var(--forma-footer-text);
  }


  #shopify-section-{{ section.id }} .forma-footer__input {

    flex: 1;

    min-width: 0;

    height: 58px;

    padding: 0;

    margin: 0;

    border: 0;

    outline: none;

    background: transparent;

    color: var(--forma-footer-text);

    font-family: inherit;

    font-size: 15px;

    line-height: 1;
  }


  #shopify-section-{{ section.id }} .forma-footer__input::placeholder {

    color: rgba(23,23,23,0.40);
  }


  #shopify-section-{{ section.id }} .forma-footer__submit {

    display: flex;

    align-items: center;
    justify-content: center;

    width: 52px;
    height: 58px;

    padding: 0;
    margin: 0;

    border: 0;

    background: transparent;

    color: var(--forma-footer-text);

    cursor: pointer;

    font-size: 24px;

    line-height: 1;

    transition:
      transform 0.25s ease;
  }


  #shopify-section-{{ section.id }} .forma-footer__submit:hover {

    transform: translateX(5px);
  }


  #shopify-section-{{ section.id }} .forma-footer__letter-signature {

    margin: 22px 0 0;

    font-size: 9px;

    line-height: 1;

    font-weight: 500;

    letter-spacing: 0.20em;

    text-transform: uppercase;

    color: rgba(23,23,23,0.35);
  }


  /* ============================================================
     SUCCESS / ERROR
     ============================================================ */

  #shopify-section-{{ section.id }} .forma-footer__message {

    margin: 22px auto 0;

    font-size: 12px;

    color: var(--forma-footer-muted);
  }


  /* ============================================================
     BOTTOM AREA
     ============================================================ */

  #shopify-section-{{ section.id }} .forma-footer__bottom {

    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 30px;

    padding: 24px 0 28px;
  }


  #shopify-section-{{ section.id }} .forma-footer__bottom-left {

    display: flex;

    align-items: center;

    gap: 28px;
  }


  #shopify-section-{{ section.id }} .forma-footer__copyright {

    margin: 0;

    font-size: 9px;

    line-height: 1;

    letter-spacing: 0.10em;

    text-transform: uppercase;

    color: rgba(23,23,23,0.42);
  }


  #shopify-section-{{ section.id }} .forma-footer__shopify {

    font-size: 9px;

    color: rgba(23,23,23,0.35);
  }


  /* ============================================================
     LOCALIZATION
     ============================================================ */

  #shopify-section-{{ section.id }} .forma-footer__localization {

    display: flex;

    align-items: center;

    gap: 8px;
  }


  #shopify-section-{{ section.id }} .forma-footer__localization .localization-selectors {

    display: flex;

    align-items: center;

    gap: 8px;
  }


  #shopify-section-{{ section.id }} .forma-footer__localization button,
  #shopify-section-{{ section.id }} .forma-footer__localization select {

    font-size: 10px !important;

    letter-spacing: 0.05em;
  }


  /* ============================================================
     PAYMENT METHODS
     ============================================================ */

  #shopify-section-{{ section.id }} .forma-footer__payments {

    display: flex;

    align-items: center;

    gap: 7px;

    margin-left: auto;
  }


  #shopify-section-{{ section.id }} .forma-footer__payments-list {

    display: flex;

    align-items: center;

    justify-content: flex-end;

    gap: 6px;

    margin: 0;
    padding: 0;

    list-style: none;

    flex-wrap: wrap;
  }


  #shopify-section-{{ section.id }} .forma-footer__payments-list li {

    display: flex;

    align-items: center;
    justify-content: center;

    min-width: 34px;
    height: 22px;

    padding: 3px 5px;

    border: 1px solid rgba(23,23,23,0.10);

    border-radius: 3px;

    background: rgba(255,255,255,0.40);
  }


  #shopify-section-{{ section.id }} .forma-footer__payments-list svg {

    width: auto;

    max-width: 30px;

    height: 15px;
  }


  /* ============================================================
     BOTTOM SIGNATURE
     ============================================================ */

  #shopify-section-{{ section.id }} .forma-footer__signature {

    padding: 0 0 20px;

    text-align: center;
  }


  #shopify-section-{{ section.id }} .forma-footer__signature p {

    margin: 0;

    font-size: 8px;

    line-height: 1;

    letter-spacing: 0.24em;

    text-transform: uppercase;

    color: rgba(23,23,23,0.25);
  }


  /* ============================================================
     MOBILE
     ============================================================ */

  @media screen and (max-width: 749px) {

    #shopify-section-{{ section.id }} .forma-footer__inner {

      padding: 0 18px;
    }


    #shopify-section-{{ section.id }} .forma-footer__brand {

      display: block;

      padding: 48px 0 36px;
    }


    #shopify-section-{{ section.id }} .forma-footer__brand-mark {

      font-size: 76px;

      line-height: 0.8;
    }


    #shopify-section-{{ section.id }} .forma-footer__brand-note {

      margin-top: 26px;

      max-width: 260px;

      font-size: 9px;

      text-align: left;
    }


    #shopify-section-{{ section.id }} .forma-footer__navigation {

      grid-template-columns: repeat(2, minmax(0, 1fr));

      gap: 48px 24px;

      padding: 42px 0 48px;
    }


    #shopify-section-{{ section.id }} .forma-footer__column:last-child {

      grid-column: 1 / -1;
    }


    #shopify-section-{{ section.id }} .forma-footer__heading {

      margin-bottom: 18px;
    }


    #shopify-section-{{ section.id }} .forma-footer__links {

      gap: 9px;
    }


    #shopify-section-{{ section.id }} .forma-footer__links a {

      font-size: 13px;
    }


    #shopify-section-{{ section.id }} .forma-footer__letter {

      padding: 70px 0 76px;
    }


    #shopify-section-{{ section.id }} .forma-footer__letter-title {

      font-size: 43px;

      letter-spacing: -0.045em;
    }


    #shopify-section-{{ section.id }} .forma-footer__letter-description {

      max-width: 320px;

      font-size: 12px;
    }


    #shopify-section-{{ section.id }} .forma-footer__form {

      margin-top: 42px;
    }


    #shopify-section-{{ section.id }} .forma-footer__input {

      height: 54px;

      font-size: 14px;
    }


    #shopify-section-{{ section.id }} .forma-footer__submit {

      height: 54px;
    }


    #shopify-section-{{ section.id }} .forma-footer__bottom {

      display: flex;

      flex-direction: column;

      align-items: flex-start;

      gap: 24px;

      padding: 24px 0;
    }


    #shopify-section-{{ section.id }} .forma-footer__bottom-left {

      width: 100%;

      justify-content: space-between;
    }


    #shopify-section-{{ section.id }} .forma-footer__payments {

      width: 100%;

      margin-left: 0;

      justify-content: flex-start;
    }


    #shopify-section-{{ section.id }} .forma-footer__payments-list {

      justify-content: flex-start;
    }


    #shopify-section-{{ section.id }} .forma-footer__signature {

      padding-bottom: 18px;
    }

  }


  /* ============================================================
     REDUCED MOTION
     ============================================================ */

  @media (prefers-reduced-motion: reduce) {

    #shopify-section-{{ section.id }} *,
    #shopify-section-{{ section.id }} *::before,
    #shopify-section-{{ section.id }} *::after {

      transition: none !important;
      animation: none !important;
    }

  }

</style>


<footer
  class="forma-footer"
  aria-label="FORMA footer"
>

  <div class="forma-footer__inner">


    <!-- ========================================================
         BRAND
         ======================================================== -->

    <div class="forma-footer__brand">

      <p class="forma-footer__brand-mark">
        FORMA
      </p>

      <p class="forma-footer__brand-note">
        A curated world of brands,<br>
        places, stories and ideas.
      </p>

    </div>


    <!-- ========================================================
         NAVIGATION
         ======================================================== -->

    <div class="forma-footer__navigation">


      <!-- INFORMATION -->

      <div class="forma-footer__column">

        <p class="forma-footer__heading">
          {{ section.settings.information_heading }}
        </p>

        {% assign information_menu = section.settings.information_menu %}

        {% if information_menu != blank %}

          {% assign menu = linklists[information_menu] %}

          {% if menu != blank and menu.links.size > 0 %}

            <ul class="forma-footer__links">

              {% for link in menu.links %}

                <li>
                  <a href="{{ link.url }}">
                    {{ link.title }}
                  </a>
                </li>

              {% endfor %}

            </ul>

          {% endif %}

        {% endif %}

      </div>


      <!-- FORMA -->

      <div class="forma-footer__column">

        <p class="forma-footer__heading">
          {{ section.settings.forma_heading }}
        </p>

        {% assign forma_menu = section.settings.forma_menu %}

        {% if forma_menu != blank %}

          {% assign menu = linklists[forma_menu] %}

          {% if menu != blank and menu.links.size > 0 %}

            <ul class="forma-footer__links">

              {% for link in menu.links %}

                <li>
                  <a href="{{ link.url }}">
                    {{ link.title }}
                  </a>
                </li>

              {% endfor %}

            </ul>

          {% endif %}

        {% endif %}

      </div>


      <!-- SOCIAL -->

      <div class="forma-footer__column">

        <p class="forma-footer__heading">
          {{ section.settings.social_heading }}
        </p>

        {% assign social_menu = section.settings.social_menu %}

        {% if social_menu != blank %}

          {% assign menu = linklists[social_menu] %}

          {% if menu != blank and menu.links.size > 0 %}

            <ul class="forma-footer__links">

              {% for link in menu.links %}

                <li>
                  <a
                    href="{{ link.url }}"
                    {% if link.url contains 'instagram.com'
                      or link.url contains 'facebook.com'
                      or link.url contains 'linkedin.com'
                      or link.url contains 'tiktok.com'
                    %}
                      target="_blank"
                      rel="noopener noreferrer"
                    {% endif %}
                  >
                    {{ link.title }}
                  </a>
                </li>

              {% endfor %}

            </ul>

          {% else %}

            <ul class="forma-footer__links">

              <li>
                <a
                  href="https://www.instagram.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Instagram
                </a>
              </li>

              <li>
                <a
                  href="https://www.facebook.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Facebook
                </a>
              </li>

              <li>
                <a
                  href="https://www.linkedin.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  LinkedIn
                </a>
              </li>

            </ul>

          {% endif %}

        {% endif %}

      </div>


    </div>


    <!-- ========================================================
         THE FORMA LETTER
         ======================================================== -->

    <section class="forma-footer__letter">

      <p class="forma-footer__letter-eyebrow">
        From Forma
      </p>

      <h2 class="forma-footer__letter-title">
        The Forma Letter
      </h2>

      <p class="forma-footer__letter-description">
        Stories, places, brands and ideas worth knowing.
      </p>


      {% assign newsletter_form_id = 'forma-letter-' | append: section.id %}

      {% form 'customer',
        id: newsletter_form_id,
        class: 'forma-footer__form'
      %}

        {% if form.posted_successfully? %}

          <p class="forma-footer__message">
            You're in. Welcome to Forma.
          </p>

        {% else %}

          {% if form.errors %}

            <p class="forma-footer__message">
              {{ form.errors.translated_fields['email'] }}
              {{ form.errors.messages['email'] }}
            </p>

          {% endif %}


          <input
            type="hidden"
            name="contact[tags]"
            value="newsletter"
          >


          <div class="forma-footer__input-row">

            <input
              class="forma-footer__input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              placeholder="Your email"
              aria-label="Your email"
              required
            >

            <button
              type="submit"
              class="forma-footer__submit"
              aria-label="Subscribe"
            >
              →
            </button>

          </div>


        {% endif %}

      {% endform %}


      <p class="forma-footer__letter-signature">
        Stories. Places. Brands. Ideas.
      </p>

    </section>


    <!-- ========================================================
         BOTTOM
         ======================================================== -->

    <div class="forma-footer__bottom">


      <div class="forma-footer__bottom-left">

        <p class="forma-footer__copyright">
          © {{ 'now' | date: '%Y' }} — {{ shop.name }}
        </p>


        {% if section.settings.show_powered_by_shopify %}

          <span class="forma-footer__shopify">
            {{ powered_by_link }}
          </span>

        {% endif %}

      </div>


      <!-- LOCALIZATION -->

      {% assign show_country_selector = false %}
      {% assign show_locale_selector = false %}


      {% if section.settings.show_country_selector
        and localization.available_countries.size > 1
      %}

        {% assign show_country_selector = true %}

      {% endif %}


      {% if section.settings.show_locale_selector
        and localization.available_languages.size > 1
      %}

        {% assign show_locale_selector = true %}

      {% endif %}


      {% if show_country_selector or show_locale_selector %}

        <div class="forma-footer__localization">

          <div class="localization-selectors">

            {% if show_country_selector %}

              {% render 'localization-selector',
                type: 'country',
                placement: 'top-start',
                show_country_name: section.settings.show_country_name,
                show_country_flag: section.settings.show_country_flag
              %}

            {% endif %}


            {% if show_locale_selector %}

              {% render 'localization-selector',
                type: 'locale',
                placement: 'top-start'
              %}

            {% endif %}

          </div>

        </div>

      {% endif %}


      <!-- PAYMENT METHODS -->

      {% if section.settings.show_payment_icons
        and shop.enabled_payment_types.size > 0
      %}

        <div class="forma-footer__payments">

          <ul class="forma-footer__payments-list">

            {% for type in shop.enabled_payment_types %}

              <li>
                {{ type | payment_type_svg_tag }}
              </li>

            {% endfor %}

          </ul>

        </div>

      {% endif %}


    </div>


    <!-- ========================================================
         SIGNATURE
         ======================================================== -->

    <div class="forma-footer__signature">

      <p>
        Copenhagen · Scandinavia · Everywhere
      </p>

    </div>


  </div>

</footer>


{% schema %}

{
  "name": "FORMA Footer",
  "class": "shopify-section--footer",
  "tag": "footer",

  "settings": [

    {
      "type": "header",
      "content": "Navigation"
    },

    {
      "type": "link_list",
      "id": "information_menu",
      "label": "Information menu"
    },

    {
      "type": "text",
      "id": "information_heading",
      "label": "Information heading",
      "default": "Information"
    },

    {
      "type": "link_list",
      "id": "forma_menu",
      "label": "Forma menu"
    },

    {
      "type": "text",
      "id": "forma_heading",
      "label": "Forma heading",
      "default": "Forma"
    },

    {
      "type": "link_list",
      "id": "social_menu",
      "label": "Social menu"
    },

    {
      "type": "text",
      "id": "social_heading",
      "label": "Social heading",
      "default": "Social"
    },


    {
      "type": "header",
      "content": "The Forma Letter"
    },


    {
      "type": "header",
      "content": "Footer"
    },

    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_powered_by_shopify",
      "label": "Show powered by Shopify",
      "default": false
    },


    {
      "type": "header",
      "content": "Country & language"
    },

    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "Show country selector",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_country_name",
      "label": "Show country name",
      "default": true,

      "visible_if": "{{ section.settings.show_country_selector }}"
    },

    {
      "type": "checkbox",
      "id": "show_country_flag",
      "label": "Show country flag",
      "default": true,

      "visible_if": "{{ section.settings.show_country_selector }}"
    },

    {
      "type": "checkbox",
      "id": "show_locale_selector",
      "label": "Show language selector",
      "default": true
    }

  ],


  "presets": [

    {
      "name": "FORMA Footer"
    }

  ]

}

{% endschema %}