<footer class="forma-footer">

  <!-- =========================
       FOOTER NAVIGATION
  ========================== -->

  <div class="forma-footer__top">

    <div class="forma-footer__column">
      <div class="forma-footer__heading">
        {{ section.settings.info_heading }}
      </div>

      {% if section.settings.info_menu != blank %}
        <ul class="forma-footer__menu">
          {% for link in section.settings.info_menu.links %}
            <li>
              <a href="{{ link.url }}">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>


    <div class="forma-footer__column">
      <div class="forma-footer__heading">
        {{ section.settings.forma_heading }}
      </div>

      {% if section.settings.forma_menu != blank %}
        <ul class="forma-footer__menu">
          {% for link in section.settings.forma_menu.links %}
            <li>
              <a href="{{ link.url }}">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>


    <div class="forma-footer__column">
      <div class="forma-footer__heading">
        {{ section.settings.social_heading }}
      </div>

      {% if section.settings.social_menu != blank %}
        <ul class="forma-footer__menu">
          {% for link in section.settings.social_menu.links %}
            <li>
              <a href="{{ link.url }}" target="_blank" rel="noopener">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

  </div>


  <!-- =========================
       THE FORMA LETTER
  ========================== -->

  <div class="forma-letter">

    <div class="forma-letter__inner">

      <div class="forma-letter__eyebrow">
        FROM FORMA
      </div>

      <h2 class="forma-letter__title">
        The Forma Letter
      </h2>

      <p class="forma-letter__intro">
        Stories, places, brands and ideas worth knowing.
      </p>


      {% form 'customer', class: 'forma-letter__form' %}

        <input type="hidden" name="contact[tags]" value="newsletter">

        <div class="forma-letter__input-wrap">

          <input
            type="email"
            name="contact[email]"
            class="forma-letter__input"
            value="{{ form.email }}"
            placeholder="Your email"
            autocomplete="email"
            required
          >

          <button
            type="submit"
            class="forma-letter__submit"
            aria-label="Subscribe"
          >
            <span>→</span>
          </button>

        </div>

        {% if form.posted_successfully? %}
          <p class="forma-letter__message forma-letter__message--success">
            Thank you for joining The Forma Letter.
          </p>
        {% endif %}

        {% if form.errors %}
          <div class="forma-letter__message forma-letter__message--error">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

      {% endform %}


      <div class="forma-letter__note">
        No noise. Just the good stuff.
      </div>

    </div>

  </div>


  <!-- =========================
       FOOTER BOTTOM
  ========================== -->

  <div class="forma-footer__bottom">

    <div class="forma-footer__copyright">
      © {{ 'now' | date: '%Y' }} — FORMA.COPENHAGEN
    </div>

    {% if section.settings.show_payment %}
      <div class="forma-footer__payment">
        {{ shop.enabled_payment_types | payment_type_svg_tag }}
      </div>
    {% endif %}

  </div>

</footer>


<style>

  /* ==========================================
     FORMA FOOTER
  ========================================== */

  .forma-footer {
    width: 100%;
    background: #f5f5f3;
    color: #222;
    margin-top: 0;
  }


  /* ==========================================
     TOP NAVIGATION
  ========================================== */

  .forma-footer__top {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 60px;

    padding: 64px 48px 72px;

    max-width: 1600px;
    margin: 0 auto;
  }


  .forma-footer__column {
    min-width: 0;
  }


  .forma-footer__heading {
    font-family: inherit;
    font-size: 11px;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;

    margin-bottom: 26px;

    color: #222;
  }


  .forma-footer__menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }


  .forma-footer__menu li {
    margin: 0 0 12px;
  }


  .forma-footer__menu a {
    position: relative;

    color: #666;
    text-decoration: none;

    font-size: 13px;
    line-height: 1.5;

    transition:
      color 0.25s ease,
      opacity 0.25s ease;
  }


  .forma-footer__menu a:hover {
    color: #111;
  }


  /* ==========================================
     THE FORMA LETTER
  ========================================== */

  .forma-letter {
    border-top: 1px solid rgba(0,0,0,0.10);
    border-bottom: 1px solid rgba(0,0,0,0.10);

    padding: 105px 30px 115px;

    text-align: center;
  }


  .forma-letter__inner {
    width: 100%;
    max-width: 920px;
    margin: 0 auto;
  }


  .forma-letter__eyebrow {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;

    color: #777;

    margin-bottom: 24px;
  }


  .forma-letter__title {
    margin: 0;

    font-family: Georgia, "Times New Roman", serif;

    font-size: clamp(48px, 6vw, 86px);
    line-height: 0.95;
    font-weight: 400;
    letter-spacing: -0.035em;

    color: #222;
  }


  .forma-letter__intro {
    margin: 28px auto 48px;

    max-width: 520px;

    font-size: 14px;
    line-height: 1.6;

    color: #666;
  }


  /* ==========================================
     EMAIL FIELD
  ========================================== */

  .forma-letter__form {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
  }


  .forma-letter__input-wrap {
    position: relative;

    width: 100%;

    display: flex;
    align-items: center;

    border-bottom: 1px solid #222;

    transition:
      border-color 0.3s ease,
      transform 0.3s ease;
  }


  .forma-letter__input-wrap:focus-within {
    border-color: #777;
  }


  .forma-letter__input {
    width: 100%;

    border: 0;
    outline: none;

    background: transparent;

    padding: 20px 60px 20px 4px;

    font-family: inherit;
    font-size: 15px;

    color: #222;
  }


  .forma-letter__input::placeholder {
    color: #999;
    opacity: 1;
  }


  .forma-letter__submit {
    position: absolute;

    right: 0;
    top: 50%;

    transform: translateY(-50%);

    width: 46px;
    height: 46px;

    border: 0;
    padding: 0;

    background: transparent;

    cursor: pointer;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #222;

    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }


  .forma-letter__submit span {
    display: block;

    font-size: 24px;
    line-height: 1;

    transition: transform 0.3s ease;
  }


  .forma-letter__submit:hover span {
    transform: translateX(5px);
  }


  .forma-letter__note {
    margin-top: 24px;

    font-size: 10px;
    letter-spacing: 0.13em;
    text-transform: uppercase;

    color: #999;
  }


  /* ==========================================
     FORM MESSAGES
  ========================================== */

  .forma-letter__message {
    margin-top: 18px;

    font-size: 12px;
  }


  .forma-letter__message--success {
    color: #555;
  }


  .forma-letter__message--error {
    color: #a33;
  }


  /* ==========================================
     FOOTER BOTTOM
  ========================================== */

  .forma-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 30px 48px 34px;

    max-width: 1600px;
    margin: 0 auto;
  }


  .forma-footer__copyright {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;

    color: #999;
  }


  .forma-footer__payment {
    display: flex;
    align-items: center;

    opacity: 0.65;
  }


  .forma-footer__payment svg {
    max-height: 24px;
    width: auto;
  }


  /* ==========================================
     TABLET
  ========================================== */

  @media screen and (max-width: 749px) {

    .forma-footer__top {
      grid-template-columns: repeat(2, minmax(0, 1fr));

      gap: 45px 30px;

      padding: 48px 22px 55px;
    }


    .forma-letter {
      padding: 75px 22px 80px;
    }


    .forma-letter__title {
      font-size: clamp(42px, 12vw, 64px);
    }


    .forma-letter__intro {
      margin-bottom: 38px;
    }


    .forma-footer__bottom {
      padding: 25px 22px 30px;
    }

  }


  /* ==========================================
     MOBILE
  ========================================== */

  @media screen and (max-width: 480px) {

    .forma-footer__top {
      grid-template-columns: 1fr 1fr;

      gap: 40px 24px;

      padding: 42px 18px 48px;
    }


    .forma-footer__heading {
      font-size: 10px;
      margin-bottom: 20px;
    }


    .forma-footer__menu li {
      margin-bottom: 10px;
    }


    .forma-footer__menu a {
      font-size: 12px;
    }


    .forma-letter {
      padding: 65px 18px 70px;
    }


    .forma-letter__eyebrow {
      font-size: 9px;
      margin-bottom: 20px;
    }


    .forma-letter__title {
      font-size: 44px;
    }


    .forma-letter__intro {
      font-size: 13px;
      margin: 24px auto 38px;
    }


    .forma-letter__input {
      padding: 17px 50px 17px 2px;
      font-size: 14px;
    }


    .forma-letter__submit {
      width: 40px;
      height: 40px;
    }


    .forma-letter__submit span {
      font-size: 21px;
    }


    .forma-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;

      padding: 24px 18px 30px;
    }

  }

</style>


{% schema %}
{
  "name": "FORMA Footer",
  "settings": [
    {
      "type": "text",
      "id": "info_heading",
      "label": "Info heading",
      "default": "Information"
    },
    {
      "type": "link_list",
      "id": "info_menu",
      "label": "Information menu"
    },
    {
      "type": "text",
      "id": "forma_heading",
      "label": "Forma heading",
      "default": "Forma"
    },
    {
      "type": "link_list",
      "id": "forma_menu",
      "label": "Forma menu"
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social heading",
      "default": "Social"
    },
    {
      "type": "link_list",
      "id": "social_menu",
      "label": "Social menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Show payment icons",
      "default": true
    }
  ]
}
{% endschema %}