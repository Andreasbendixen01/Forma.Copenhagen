{% comment %}
  FORMA — Brand Discover
  Editorial brand discovery + Brands A-Z
{% endcomment %}

<section
  id="forma-brand-discover-{{ section.id }}"
  class="forma-brand-discover"
  style="
    --bd-pad-top: {{ section.settings.top_padding }}px;
    --bd-pad-bottom: {{ section.settings.bottom_padding }}px;
    --bd-pad-side: {{ section.settings.side_padding }}px;
    --bd-pad-top-mobile: {{ section.settings.mobile_top_padding }}px;
    --bd-pad-bottom-mobile: {{ section.settings.mobile_bottom_padding }}px;
    --bd-heading-size: {{ section.settings.heading_size }}px;
    --bd-card-gap: {{ section.settings.card_gap }}px;
    --bd-card-width: {{ section.settings.card_width }}%;
    --bd-card-width-tablet: {{ section.settings.card_width_tablet }}%;
    --bd-card-width-mobile: {{ section.settings.card_width_mobile }}%;
    --bd-image-ratio: {{ section.settings.image_ratio }};
  "
>

  <div class="forma-bd-header">
    <div class="forma-bd-heading">
      <h1>{{ section.settings.heading }}</h1>
      {% if section.settings.intro != blank %}
        <p>{{ section.settings.intro }}</p>
      {% endif %}
    </div>

    <div class="forma-bd-search">
      <input
        type="search"
        class="forma-bd-search-input"
        placeholder="{{ section.settings.search_placeholder }}"
        aria-label="Search brands"
      >
      <span class="forma-bd-search-label">SEARCH</span>
    </div>
  </div>

  <div class="forma-bd-navigation">
    <button class="forma-bd-tab is-active" data-tab="discover">
      Discover
    </button>
    <button class="forma-bd-tab" data-tab="az">
      Brands A–Z
    </button>
  </div>

  {% assign categories = "Wardrobe,Footwear,Accessories,The Home,The Lifestyle,The Form" | split: "," %}

  <div class="forma-bd-discover-panel">

    {% for category in categories %}

      {% assign category_has_brands = false %}

      {% for block in section.blocks %}
        {% if block.settings.category == category and block.settings.brand_name != blank %}
          {% assign category_has_brands = true %}
        {% endif %}
      {% endfor %}

      {% if category_has_brands %}

        <div class="forma-bd-category" data-category="{{ category | escape }}">

          <div class="forma-bd-category-header">
            <h2>{{ category }}</h2>

            <div class="forma-bd-controls">
              <button class="forma-bd-arrow forma-bd-prev" aria-label="Previous">
                &#8592;
              </button>
              <button class="forma-bd-arrow forma-bd-next" aria-label="Next">
                &#8594;
              </button>
            </div>
          </div>

          <div class="forma-bd-track">

            {% for block in section.blocks %}

              {% if block.settings.category == category and block.settings.brand_name != blank %}

                <a
                  href="{{ block.settings.brand_link | default: '#' }}"
                  class="forma-bd-card"
                  data-brand="{{ block.settings.brand_name | downcase | escape }}"
                  data-letter="{{ block.settings.brand_name | slice: 0 | downcase }}"
                  {{ block.shopify_attributes }}
                >

                  <div class="forma-bd-image">

                    {% if block.settings.image != blank %}
                      {{
                        block.settings.image
                        | image_url: width: 1600
                        | image_tag:
                          loading: 'lazy',
                          class: 'forma-bd-img',
                          alt: block.settings.brand_name
                      }}
                    {% else %}
                      <div class="forma-bd-placeholder"></div>
                    {% endif %}

                    {% if block.settings.logo != blank %}
                      <div class="forma-bd-logo">
                        {{
                          block.settings.logo
                          | image_url: width: 600
                          | image_tag:
                            loading: 'lazy',
                            alt: block.settings.brand_name
                        }}
                      </div>
                    {% elsif block.settings.overlay_name %}
                      <div class="forma-bd-brand-overlay">
                        {{ block.settings.brand_name }}
                      </div>
                    {% endif %}

                  </div>

                  <div class="forma-bd-card-meta">
                    <span class="forma-bd-brand-name">
                      {{ block.settings.brand_name }}
                    </span>

                    <span class="forma-bd-card-category">
                      {{ category | upcase }}
                    </span>
                  </div>

                </a>

              {% endif %}

            {% endfor %}

          </div>
        </div>

      {% endif %}

    {% endfor %}

  </div>

  <div class="forma-bd-az-panel" hidden>

    <div class="forma-bd-alphabet">
      <span class="forma-bd-index-label">INDEX</span>

      {% assign alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ" | split: "" %}

      {% for letter in alphabet %}
        <button class="forma-bd-letter" data-letter-filter="{{ letter | downcase }}">
          {{ letter }}
        </button>
      {% endfor %}

      <button class="forma-bd-letter forma-bd-all is-active" data-letter-filter="all">
        ALL
      </button>
    </div>

    <div class="forma-bd-az-results">

      {% for block in section.blocks %}

        {% if block.settings.brand_name != blank %}

          <a
            href="{{ block.settings.brand_link | default: '#' }}"
            class="forma-bd-az-brand"
            data-brand="{{ block.settings.brand_name | downcase | escape }}"
            data-letter="{{ block.settings.brand_name | slice: 0 | downcase }}"
          >
            {{ block.settings.brand_name }}
          </a>

        {% endif %}

      {% endfor %}

    </div>

    <div class="forma-bd-no-results" hidden>
      No brands found.
    </div>

  </div>

</section>

{% stylesheet %}
.forma-brand-discover {
  background: #ffffff;
  color: #111111;
  width: 100%;
  padding: var(--bd-pad-top) var(--bd-pad-side) var(--bd-pad-bottom);
  font-family: inherit;
}

/* HEADER */

.forma-brand-discover .forma-bd-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 40px;
  margin-bottom: 35px;
}

.forma-brand-discover .forma-bd-heading h1 {
  font-size: var(--bd-heading-size);
  line-height: 1.1;
  letter-spacing: -0.04em;
  font-weight: 400;
  margin: 0;
}

.forma-brand-discover .forma-bd-heading p {
  margin: 14px 0 0;
  font-size: 14px;
  color: #777777;
  max-width: 500px;
  line-height: 1.6;
}

.forma-brand-discover .forma-bd-search {
  width: 300px;
  max-width: 100%;
  position: relative;
  border-bottom: 1px solid #cccccc;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.forma-brand-discover .forma-bd-search-input {
  width: 100%;
  border: none;
  background: transparent;
  padding: 12px 10px 12px 0;
  font-size: 14px;
  outline: none;
  color: #111;
}

.forma-brand-discover .forma-bd-search-input::placeholder {
  color: #999999;
}

.forma-brand-discover .forma-bd-search-label {
  font-size: 9px;
  letter-spacing: 0.12em;
  color: #999;
  white-space: nowrap;
}

/* NAVIGATION */

.forma-brand-discover .forma-bd-navigation {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin: 0 0 45px;
}

.forma-brand-discover .forma-bd-tab {
  appearance: none;
  border: 1px solid #e3e3e3;
  background: white;
  color: #111;
  padding: 13px 27px;
  border-radius: 50px;
  font-size: 12px;
  cursor: pointer;
  transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
}

.forma-brand-discover .forma-bd-tab:hover {
  border-color: #111;
}

.forma-brand-discover .forma-bd-tab.is-active {
  background: #111;
  color: #fff;
  border-color: #111;
}

/* CATEGORY */

.forma-brand-discover .forma-bd-category {
  margin-bottom: 52px;
}

.forma-brand-discover .forma-bd-category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
}

.forma-brand-discover .forma-bd-category-header h2 {
  font-size: 19px;
  font-weight: 400;
  letter-spacing: -0.025em;
  margin: 0;
}

.forma-brand-discover .forma-bd-controls {
  display: flex;
  gap: 8px;
}

.forma-brand-discover .forma-bd-arrow {
  border: 1px solid #e5e5e5;
  background: white;
  color: #111;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  font-size: 15px;
  transition: background 0.2s ease, color 0.2s ease;
}

.forma-brand-discover .forma-bd-arrow:hover {
  background: #111;
  color: white;
}

/* CAROUSEL */

.forma-brand-discover .forma-bd-track {
  display: flex;
  gap: var(--bd-card-gap);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}

.forma-brand-discover .forma-bd-track::-webkit-scrollbar {
  display: none;
}

.forma-brand-discover .forma-bd-card {
  flex: 0 0 var(--bd-card-width);
  min-width: 0;
  scroll-snap-align: start;
  text-decoration: none;
  color: #111;
}

.forma-brand-discover .forma-bd-image {
  position: relative;
  overflow: hidden;
  width: 100%;
  aspect-ratio: var(--bd-image-ratio);
  background: #f5f5f5;
}

.forma-brand-discover .forma-bd-img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.forma-brand-discover .forma-bd-card:hover .forma-bd-img {
  transform: scale(1.035);
}

.forma-brand-discover .forma-bd-placeholder {
  width: 100%;
  height: 100%;
  background: #f5f5f5;
}

.forma-brand-discover .forma-bd-logo {
  position: absolute;
  inset: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 12%;
}

.forma-brand-discover .forma-bd-logo img {
  max-width: 80%;
  max-height: 45%;
  width: auto;
  height: auto;
  object-fit: contain;
}

.forma-brand-discover .forma-bd-brand-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: clamp(20px, 3vw, 42px);
  font-weight: 400;
  text-align: center;
  padding: 20px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  text-shadow: 0 1px 15px rgba(0, 0, 0, 0.15);
}

.forma-brand-discover .forma-bd-card-meta {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 15px;
  padding-top: 10px;
}

.forma-brand-discover .forma-bd-brand-name {
  font-size: 13px;
  color: #111;
}

.forma-brand-discover .forma-bd-card-category {
  font-size: 9px;
  letter-spacing: 0.08em;
  color: #999;
  text-align: right;
}

/* A-Z */

.forma-brand-discover .forma-bd-alphabet {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 9px;
  margin: 0 0 45px;
}

.forma-brand-discover .forma-bd-index-label {
  font-size: 9px;
  letter-spacing: 0.1em;
  color: #999;
  margin-right: 12px;
}

.forma-brand-discover .forma-bd-letter {
  border: none;
  background: transparent;
  color: #999;
  padding: 5px;
  font-size: 10px;
  cursor: pointer;
  transition: color 0.2s ease;
}

.forma-brand-discover .forma-bd-letter:hover {
  color: #111;
}

.forma-brand-discover .forma-bd-letter.is-active {
  background: #111;
  color: white;
  border-radius: 50%;
  width: 30px;
  height: 30px;
}

.forma-brand-discover .forma-bd-az-results {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  column-gap: 40px;
  row-gap: 14px;
}

.forma-brand-discover .forma-bd-az-brand {
  color: #111;
  text-decoration: none;
  font-size: 13px;
  transition: opacity 0.2s ease;
}

.forma-brand-discover .forma-bd-az-brand:hover {
  opacity: 0.5;
}

.forma-brand-discover .forma-bd-no-results {
  padding: 30px 0;
  font-size: 13px;
  color: #777;
}

.forma-brand-discover [hidden] {
  display: none !important;
}

/* RESPONSIVE */

@media screen and (max-width: 990px) {
  .forma-brand-discover {
    padding-left: 25px;
    padding-right: 25px;
  }

  .forma-brand-discover .forma-bd-card {
    flex-basis: var(--bd-card-width-tablet);
  }

  .forma-brand-discover .forma-bd-az-results {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media screen and (max-width: 749px) {
  .forma-brand-discover {
    padding: var(--bd-pad-top-mobile) 16px var(--bd-pad-bottom-mobile);
  }

  .forma-brand-discover .forma-bd-header {
    flex-direction: column;
    align-items: stretch;
    gap: 25px;
    margin-bottom: 30px;
  }

  .forma-brand-discover .forma-bd-heading h1 {
    font-size: 32px;
  }

  .forma-brand-discover .forma-bd-search {
    width: 100%;
  }

  .forma-brand-discover .forma-bd-navigation {
    justify-content: flex-start;
    margin-bottom: 35px;
  }

  .forma-brand-discover .forma-bd-tab {
    padding: 11px 20px;
  }

  .forma-brand-discover .forma-bd-category {
    margin-bottom: 38px;
  }

  .forma-brand-discover .forma-bd-category-header h2 {
    font-size: 17px;
  }

  .forma-brand-discover .forma-bd-controls {
    display: none;
  }

  .forma-brand-discover .forma-bd-track {
    gap: 10px;
  }

  .forma-brand-discover .forma-bd-card {
    flex-basis: var(--bd-card-width-mobile);
  }

  .forma-brand-discover .forma-bd-card-meta {
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
  }

  .forma-brand-discover .forma-bd-card-category {
    text-align: left;
  }

  .forma-brand-discover .forma-bd-alphabet {
    gap: 7px;
    margin-bottom: 30px;
  }

  .forma-brand-discover .forma-bd-index-label {
    width: 100%;
    margin-bottom: 5px;
  }

  .forma-brand-discover .forma-bd-letter {
    font-size: 10px;
  }

  .forma-brand-discover .forma-bd-az-results {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 20px;
    row-gap: 18px;
  }
}
{% endstylesheet %}

{% javascript %}
(function () {
  function initFormaBrandDiscover(root) {
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const tabs = root.querySelectorAll('.forma-bd-tab');
    const discoverPanel = root.querySelector('.forma-bd-discover-panel');
    const azPanel = root.querySelector('.forma-bd-az-panel');
    const searchInput = root.querySelector('.forma-bd-search-input');
    const letters = root.querySelectorAll('.forma-bd-letter');
    const azBrands = root.querySelectorAll('.forma-bd-az-brand');
    const azResults = root.querySelector('.forma-bd-az-results');
    const noResults = root.querySelector('.forma-bd-no-results');

    let activeLetter = 'all';

    /* A-Z FILTER */

    function filterBrands() {
      const query = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      azBrands.forEach(function (brand) {
        const name = brand.dataset.brand || '';
        const letter = brand.dataset.letter || '';

        const matchesSearch = name.includes(query);
        const matchesLetter = activeLetter === 'all' || letter === activeLetter;
        const visible = matchesSearch && matchesLetter;

        brand.style.display = visible ? '' : 'none';

        if (visible) visibleCount++;
      });

      noResults.hidden = visibleCount > 0;
      azResults.hidden = visibleCount === 0;
    }

    /* TABS */

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        tabs.forEach(function (t) {
          t.classList.remove('is-active');
        });
        tab.classList.add('is-active');

        if (tab.dataset.tab === 'discover') {
          discoverPanel.hidden = false;
          azPanel.hidden = true;
        } else {
          discoverPanel.hidden = true;
          azPanel.hidden = false;
          filterBrands();
        }
      });
    });

    /* LETTER FILTER */

    letters.forEach(function (button) {
      button.addEventListener('click', function () {
        letters.forEach(function (letter) {
          letter.classList.remove('is-active');
        });
        button.classList.add('is-active');

        activeLetter = button.dataset.letterFilter;
        filterBrands();
      });
    });

    /* CAROUSEL CONTROLS */

    root.querySelectorAll('.forma-bd-category').forEach(function (category) {
      const track = category.querySelector('.forma-bd-track');
      const prev = category.querySelector('.forma-bd-prev');
      const next = category.querySelector('.forma-bd-next');

      if (!track || !prev || !next) return;

      prev.addEventListener('click', function () {
        track.scrollBy({ left: -track.clientWidth * 0.8, behavior: 'smooth' });
      });

      next.addEventListener('click', function () {
        track.scrollBy({ left: track.clientWidth * 0.8, behavior: 'smooth' });
      });
    });

    /* SEARCH (A-Z + DISCOVER) */

    searchInput.addEventListener('input', function () {
      const query = searchInput.value.trim().toLowerCase();

      filterBrands();

      root.querySelectorAll('.forma-bd-category').forEach(function (category) {
        let categoryHasVisibleCards = false;

        category.querySelectorAll('.forma-bd-card').forEach(function (card) {
          const name = card.dataset.brand || '';
          const visible = name.includes(query);

          card.style.display = visible ? '' : 'none';

          if (visible) categoryHasVisibleCards = true;
        });

        category.style.display = categoryHasVisibleCards ? '' : 'none';
      });
    });
  }

  function initAll() {
    document.querySelectorAll('.forma-brand-discover').forEach(initFormaBrandDiscover);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }

  /* Shopify theme editor */
  document.addEventListener('shopify:section:load', function (event) {
    const root = event.target.querySelector('.forma-brand-discover');
    initFormaBrandDiscover(root);
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Forma Brand Discover",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore all brands"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": ""
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Find a brand"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 60,
      "step": 2,
      "default": 36
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Desktop card width (%)",
      "min": 20,
      "max": 80,
      "step": 1,
      "default": 32
    },
    {
      "type": "range",
      "id": "card_width_tablet",
      "label": "Tablet card width (%)",
      "min": 30,
      "max": 90,
      "step": 1,
      "default": 45
    },
    {
      "type": "range",
      "id": "card_width_mobile",
      "label": "Mobile card width (%)",
      "min": 60,
      "max": 100,
      "step": 1,
      "default": 85
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card spacing",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1/1", "label": "Square" },
        { "value": "4/5", "label": "Portrait" },
        { "value": "3/2", "label": "Landscape" }
      ],
      "default": "4/5"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "top_padding",
      "label": "Desktop top spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "bottom_padding",
      "label": "Desktop bottom spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Desktop side spacing",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_top_padding",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_bottom_padding",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand name",
          "default": "Brand name"
        },
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "options": [
            { "value": "Wardrobe", "label": "Wardrobe" },
            { "value": "Footwear", "label": "Footwear" },
            { "value": "Accessories", "label": "Accessories" },
            { "value": "The Home", "label": "The Home" },
            { "value": "The Lifestyle", "label": "The Lifestyle" },
            { "value": "The Form", "label": "The Form" }
          ],
          "default": "Wardrobe"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Brand editorial image"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Brand logo (optional)"
        },
        {
          "type": "checkbox",
          "id": "overlay_name",
          "label": "Show brand name over image if no logo",
          "default": true
        },
        {
          "type": "url",
          "id": "brand_link",
          "label": "Brand link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Forma Brand Discover",
