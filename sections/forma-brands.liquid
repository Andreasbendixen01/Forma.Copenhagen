{% comment %}
  ================================================================
  FORMA BRANDS
  Editorial brand carousel
  ================================================================
{% endcomment %}

<section
  id="forma-brands-{{ section.id }}"
  class="forma-brands"
>

  <div class="forma-brands__header">

    <div class="forma-brands__heading">

      <h2 class="forma-brands__title">
        {{ section.settings.heading }}
      </h2>

      {% if section.settings.subheading != blank %}
        <p class="forma-brands__subtitle">
          {{ section.settings.subheading }}
        </p>
      {% endif %}

    </div>

    <div class="forma-brands__actions">

  {% if section.settings.view_all_text != blank %}
    <a
      href="{{ section.settings.view_all_link }}"
      class="forma-brands__view-all"
    >
      {{ section.settings.view_all_text }}
    </a>
  {% endif %}

</div>

  </div>


  <div
    class="forma-brands__track"
    data-forma-brands-track
  >

    {% for block in section.blocks %}

      <article
        class="forma-brand"
        {{ block.shopify_attributes }}
      >

        <a
          href="{{ block.settings.link | default: '#' }}"
          class="forma-brand__link"
        >

          <div class="forma-brand__image-wrapper">

            {% if block.settings.image != blank %}

              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  widths: '600, 900, 1200, 1600',
                  sizes: '(max-width: 699px) 82vw, 31vw',
                  class: 'forma-brand__image'
              }}

            {% else %}

              {{ 'image' | placeholder_svg_tag: 'forma-brand__placeholder' }}

            {% endif %}


            {% if block.settings.recommend != blank %}
              <span class="forma-brand__recommend">
                {{ block.settings.recommend }}
              </span>
            {% endif %}

          </div>


          <div class="forma-brand__content">

            <div class="forma-brand__top">

              {% if block.settings.location != blank %}
                <span class="forma-brand__location">
                  {{ block.settings.location }}
                </span>
              {% endif %}

              <span class="forma-brand__arrow">
                ↗
              </span>

            </div>


            {% if block.settings.title != blank %}
              <h3 class="forma-brand__title">
                {{ block.settings.title }}
              </h3>
            {% endif %}


            {% if block.settings.description != blank %}
              <p class="forma-brand__description">
                {{ block.settings.description }}
              </p>
            {% endif %}

          </div>

        </a>

      </article>

    {% endfor %}

  </div>


  <style>

    /* ============================================================
       FORMA BRANDS
       ============================================================ */

    #forma-brands-{{ section.id }} {

      --brands-gap: 5px;

      width: 100%;
      overflow: hidden;

      padding-top: 20px;
      padding-bottom: 54px;

    }


    /* ============================================================
       HEADER
       ============================================================ */

    #forma-brands-{{ section.id }} .forma-brands__header {

      display: flex;
      align-items: flex-end;
      justify-content: space-between;

      padding: 0 12px 18px;

    }


    #forma-brands-{{ section.id }} .forma-brands__heading {

      display: flex;
      align-items: baseline;

      gap: 18px;

    }


    #forma-brands-{{ section.id }} .forma-brands__title {

      margin: 0;

      font-size: 17px;
      font-weight: 400;

      line-height: 1.1;

      letter-spacing: -0.02em;

      font-family: Georgia, "Times New Roman", serif !important;

    }


    #forma-brands-{{ section.id }} .forma-brands__subtitle {

      margin: 0 0 0 16px;

      font-size: 13px;
      line-height: 1.2;

      font-weight: 400;

      opacity: 0.55;

    }


    /* ============================================================
   ACTIONS
   ============================================================ */

#forma-brands-{{ section.id }} .forma-brands__actions {

  display: flex;
  align-items: center;

}


#forma-brands-{{ section.id }} .forma-brands__view-all {

  color: inherit;

  text-decoration: none;

  font-size: 13px;

  line-height: 1;

  white-space: nowrap;

}


#forma-brands-{{ section.id }} .forma-brands__view-all:hover {

  opacity: 0.55;

}


    /* ============================================================
       TRACK
       ============================================================ */

    #forma-brands-{{ section.id }} .forma-brands__track {

      display: flex;

      gap: var(--brands-gap);

      width: 100%;

      overflow-x: auto;
      overflow-y: hidden;

      padding: 0 5px;

      scroll-behavior: smooth;

      scroll-snap-type: x mandatory;

      scrollbar-width: none;

      -webkit-overflow-scrolling: touch;

    }


    #forma-brands-{{ section.id }} .forma-brands__track::-webkit-scrollbar {

      display: none;

    }


    /* ============================================================
       CARD
       ============================================================ */

    #forma-brands-{{ section.id }} .forma-brand {

    flex: 0 0 31vw;

    min-width: 0;

    scroll-snap-align: start;

    }


    #forma-brands-{{ section.id }} .forma-brand__link {

      display: block;

      color: inherit;

      text-decoration: none;

    }


    /* ============================================================
       IMAGE
       ============================================================ */

    #forma-brands-{{ section.id }} .forma-brand__image-wrapper {

      position: relative;

      width: 100%;

      aspect-ratio: 4 / 5;

      overflow: hidden;

      background: #f3f3f3;

    }


    #forma-brands-{{ section.id }} .forma-brand__image {

      display: block;

      width: 100%;
      height: 100%;

      object-fit: cover;

      transition:
        transform 0.6s cubic-bezier(.2,.6,.2,1);

    }


    #forma-brands-{{ section.id }} .forma-brand__link:hover
    .forma-brand__image {

      transform: scale(1.025);

    }


    /* ============================================================
       PLACEHOLDER
       ============================================================ */

    #forma-brands-{{ section.id }} .forma-brand__placeholder {

      display: block;

      width: 100%;
      height: 100%;

    }


    /* ============================================================
       FORMA RECOMMENDS
       ============================================================ */

    #forma-brands-{{ section.id }} .forma-brand__recommend {

      position: absolute;

      top: 14px;
      left: 14px;

      padding: 6px 8px;

      color: white;

      font-size: 9px;

      line-height: 1;

      letter-spacing: 0.08em;

      text-transform: uppercase;

      background: rgba(0,0,0,0.28);

      backdrop-filter: blur(8px);

      -webkit-backdrop-filter: blur(8px);

    }


    /* ============================================================
       CONTENT
       ============================================================ */

    #forma-brands-{{ section.id }} .forma-brand__content {

      padding-top: 11px;

    }


    #forma-brands-{{ section.id }} .forma-brand__top {

      display: flex;

      align-items: center;

      justify-content: space-between;

      margin-bottom: 5px;

    }


    #forma-brands-{{ section.id }} .forma-brand__location {

      font-size: 10px;

      line-height: 1.2;

      letter-spacing: 0.08em;

      text-transform: uppercase;

      opacity: 0.5;

    }


    #forma-brands-{{ section.id }} .forma-brand__arrow {

      font-size: 15px;

      opacity: 0;

      transform: translate(-3px, 3px);

      transition:
        opacity 0.2s ease,
        transform 0.2s ease;

    }


    #forma-brands-{{ section.id }} .forma-brand__link:hover
    .forma-brand__arrow {

      opacity: 0.8;

      transform: translate(0, 0);

    }


    #forma-brands-{{ section.id }} .forma-brand__title {

      margin: 0;

      font-size: 19px;

      font-weight: 400;

      line-height: 1.15;

      letter-spacing: -0.015em;

    }


    #forma-brands-{{ section.id }} .forma-brand__description {

      margin: 5px 0 0;

      font-size: 12px;

      line-height: 1.3;

      opacity: 0.55;

    }


    /* ============================================================
       MOBILE
       ============================================================ */

    @media screen and (max-width: 699px) {

      #forma-brands-{{ section.id }} {

        padding-top: 32px;

        padding-bottom: 40px;

      }


      #forma-brands-{{ section.id }} .forma-brands__header {

        align-items: center;

        padding: 0 12px 14px;

      }


      #forma-brands-{{ section.id }} .forma-brands__heading {

        display: block;

      }


      #forma-brands-{{ section.id }} .forma-brands__title {

        font-size: 20px;

      }


      #forma-brands-{{ section.id }} .forma-brands__subtitle {

        margin-top: 4px;

        font-size: 11px;

      }


      #forma-brands-{{ section.id }} .forma-brands__arrows {

        display: none;

      }


      #forma-brands-{{ section.id }} .forma-brands__view-all {

        font-size: 12px;

      }


      #forma-brands-{{ section.id }} .forma-brands__track {

        gap: 5px;

        padding: 0 12px;

        scroll-snap-type: x mandatory;

      }


      #forma-brands-{{ section.id }} .forma-brand {

        flex: 0 0 82vw;

      }


      #forma-brands-{{ section.id }} .forma-brand__image-wrapper {

        aspect-ratio: 4 / 5;

      }


      #forma-brands-{{ section.id }} .forma-brand__title {

        font-size: 18px;

      }

    }

  </style>


  <script>

    document.addEventListener('DOMContentLoaded', function () {

      const section = document.querySelector(
        '#forma-brands-{{ section.id }}'
      );

      if (!section) return;


      const track = section.querySelector(
        '[data-forma-brands-track]'
      );


      const prev = section.querySelector(
        '.forma-brands__arrow--prev'
      );


      const next = section.querySelector(
        '.forma-brands__arrow--next'
      );


      if (!track || !prev || !next) return;


      function scrollAmount() {

        const card = track.querySelector('.forma-brand');

        if (!card) return 0;


        const gap = parseFloat(
          getComputedStyle(track).gap
        ) || 0;


        return card.offsetWidth + gap;

      }


      next.addEventListener('click', function () {

        track.scrollBy({

          left: scrollAmount(),

          behavior: 'smooth'

        });

      });


      prev.addEventListener('click', function () {

        track.scrollBy({

          left: -scrollAmount(),

          behavior: 'smooth'

        });

      });

    });

  </script>


  {% schema %}

  {

    "name": "FORMA Brands",

    "tag": "section",

    "class": "forma-brands-section",


    "settings": [

      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "FORMA Brands"
      },

      {
        "type": "text",
        "id": "subheading",
        "label": "Subheading",
        "default": "Brands worth knowing."
      },

      {
        "type": "text",
        "id": "view_all_text",
        "label": "View all text",
        "default": "View all →"
      },

      {
        "type": "url",
        "id": "view_all_link",
        "label": "View all link"
      }

    ],


    "blocks": [

      {

        "type": "brand",

        "name": "Brand",

        "settings": [

          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },

          {
            "type": "text",
            "id": "recommend",
            "label": "Recommendation label",
            "default": "FORMA RECOMMENDS"
          },

          {
            "type": "text",
            "id": "location",
            "label": "Location",
            "default": "Copenhagen"
          },

          {
            "type": "text",
            "id": "title",
            "label": "Brand name",
            "default": "Brand name"
          },

          {
            "type": "textarea",
            "id": "description",
            "label": "Description"
          },

          {
            "type": "url",
            "id": "link",
            "label": "Brand link"
          }

        ]

      }

    ],


    "presets": [

      {

        "name": "FORMA Brands",

        "blocks": [

          {
            "type": "brand"
          },

          {
            "type": "brand"
          },

          {
            "type": "brand"
          },

          {
            "type": "brand"
          },

          {
            "type": "brand"
          }

        ]

      }

    ]

  }

  {% endschema %}

</section>