{% comment %}
  ============================================================
  FORMA JOURNAL — Editorial Blog Slider
  ============================================================
{% endcomment %}

<section
  id="forma-journal-{{ section.id }}"
  class="forma-journal"
>

  <div class="forma-journal__inner">

    <!-- HEADER -->
    <div class="forma-journal__header">

      <div class="forma-journal__header-content">

        <h2 class="forma-journal__title">
          {{ section.settings.heading }}
        </h2>

        {% if section.settings.subheading != blank %}
          <p class="forma-journal__subheading">
            {{ section.settings.subheading }}
          </p>
        {% endif %}

      </div>

      {% if section.settings.show_view_all and section.settings.blog != blank %}
        <a
          href="{{ section.settings.blog.url }}"
          class="forma-journal__view-all"
        >
          {{ section.settings.view_all_text }}
        </a>
      {% endif %}

    </div>


    <!-- CAROUSEL -->
    {% if section.settings.blog != blank %}

      <div class="forma-journal__carousel">

        <!-- PREVIOUS -->
        <button
          type="button"
          class="forma-journal__arrow forma-journal__arrow--prev"
          aria-label="Previous articles"
        >
          <span aria-hidden="true">←</span>
        </button>


        <!-- TRACK -->
        <div
          class="forma-journal__track"
          data-forma-journal-track
        >

          {% for article in section.settings.blog.articles limit: section.settings.articles_count %}

            <article class="forma-journal__card">

              <a
                href="{{ article.url }}"
                class="forma-journal__card-link"
              >

                <!-- IMAGE -->
                <div class="forma-journal__image">

                  {% if article.image != blank %}

                    {{
                      article.image
                      | image_url: width: 1400
                      | image_tag:
                        loading: 'lazy',
                        widths: '400, 600, 800, 1000, 1200, 1400',
                        sizes: '(min-width: 1200px) 32vw, (min-width: 700px) 45vw, 85vw',
                        alt: article.image.alt | default: article.title
                    }}

                  {% else %}

                    <div class="forma-journal__image-placeholder"></div>

                  {% endif %}

                </div>


                <!-- CONTENT -->
                <div class="forma-journal__content">

                  {% if section.settings.show_category and article.tags.first != blank %}
                    <div class="forma-journal__category">
                      {{ article.tags.first }}
                    </div>
                  {% endif %}

                  <h3 class="forma-journal__article-title">
                    {{ article.title }}
                  </h3>

                  {% if section.settings.show_excerpt and article.excerpt != blank %}
                    <div class="forma-journal__excerpt">
                      {{ article.excerpt | strip_html | truncate: 110 }}
                    </div>
                  {% endif %}

                  {% if section.settings.show_read_more %}
                    <span class="forma-journal__read-more">
                      {{ section.settings.read_more_text }}
                      <span aria-hidden="true">→</span>
                    </span>
                  {% endif %}

                </div>

              </a>

            </article>

          {% endfor %}

        </div>


        <!-- NEXT -->
        <button
          type="button"
          class="forma-journal__arrow forma-journal__arrow--next"
          aria-label="Next articles"
        >
          <span aria-hidden="true">→</span>
        </button>

      </div>

    {% else %}

      <div class="forma-journal__empty">
        Select a blog in the theme editor.
      </div>

    {% endif %}

  </div>

</section>


<style>

/* =========================================================
   FORMA JOURNAL — 5PX SIDE SPACING
   ========================================================= */

#shopify-section-{{ section.id }} {
  margin-left: 5px !important;
  margin-right: 5px !important;
  width: auto !important;
}

  /* =========================================================
     FORMA JOURNAL
     ========================================================= */

  #forma-journal-{{ section.id }} {
    width: 100%;
    background: #fff;
    color: #111;
  }


  /* =========================================================
     INNER
     ========================================================= */

  #forma-journal-{{ section.id }} .forma-journal__inner {
    width: 100%;
    margin: 0;
    padding-bottom: 1.75rem;
  }


  /* =========================================================
     HEADER
     ========================================================= */

  #forma-journal-{{ section.id }} .forma-journal__header {
    width: 100%;
    margin-bottom: 1rem;
    padding: 0 5px;

    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }


  #forma-journal-{{ section.id }} .forma-journal__header-content {
    min-width: 0;
  }


  #forma-journal-{{ section.id }} .forma-journal__title {
    margin: 0;
    padding: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 18px;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: 0;
  }


  #forma-journal-{{ section.id }} .forma-journal__subheading {
    margin: 4px 0 0;

    font-size: 12px;
    line-height: 1.4;
    color: rgba(17, 17, 17, 0.55);
  }


  #forma-journal-{{ section.id }} .forma-journal__view-all {
    position: relative;

    flex-shrink: 0;

    font-size: 12px;
    line-height: 1.2;
    color: #111;

    text-decoration: none;
  }


  #forma-journal-{{ section.id }} .forma-journal__view-all::after {
    content: "→";
    margin-left: 5px;

    display: inline-block;
    transition: transform 0.2s ease;
  }


  #forma-journal-{{ section.id }} .forma-journal__view-all:hover::after {
    transform: translateX(3px);
  }


  /* =========================================================
     CAROUSEL
     ========================================================= */

  #forma-journal-{{ section.id }} .forma-journal__carousel {
    position: relative;
    width: 100%;
  }


  #forma-journal-{{ section.id }} .forma-journal__track {
    display: flex;

    gap: 5px;

    width: 100%;

    overflow-x: auto;
    overflow-y: hidden;

    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;

    scrollbar-width: none;

    padding: 0;
    margin: 0;
  }


  #forma-journal-{{ section.id }} .forma-journal__track::-webkit-scrollbar {
    display: none;
  }


  /* =========================================================
     CARD
     ========================================================= */

  #forma-journal-{{ section.id }} .forma-journal__card {

     flex: 0 0 calc((100% - 30px) / 3.75);
    min-width: 0;

    scroll-snap-align: start;
  }


  #forma-journal-{{ section.id }} .forma-journal__card-link {
    display: block;

    color: inherit;
    text-decoration: none;
  }

  .forma-journal__content{
    font-family: Georgia, "Times New Roman", serif;
    font-size: 14px;
    line-height: 1.3;
    font-weight: 400;
  }


  /* =========================================================
     IMAGE
     ========================================================= */

  #forma-journal-{{ section.id }} .forma-journal__image {

    position: relative;

    width: 100%;

    aspect-ratio: 1.45 / 1;

    overflow: hidden;

    background: #f7f7f7;
  }


  #forma-journal-{{ section.id }} .forma-journal__image img {

    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transition: transform 0.45s ease;
  }


  #forma-journal-{{ section.id }} .forma-journal__card-link:hover
  .forma-journal__image img {
    transform: scale(1.025);
  }


  #forma-journal-{{ section.id }} .forma-journal__image-placeholder {
    width: 100%;
    height: 100%;
    background: #f7f7f7;
  }


  /* =========================================================
     CONTENT
     ========================================================= */

  #forma-journal-{{ section.id }} .forma-journal__content {
    padding-top: 12px;
  }


  #forma-journal-{{ section.id }} .forma-journal__category {

    margin-bottom: 5px;

    font-size: 10px;
    line-height: 1.2;

    text-transform: uppercase;
    letter-spacing: 0.06em;

    color: rgba(17, 17, 17, 0.55);
  }


  #forma-journal-{{ section.id }} .forma-journal__article-title {

    margin: 0;

    font-size: 15px;
    line-height: 1.3;
    font-weight: 400;
  }


  #forma-journal-{{ section.id }} .forma-journal__excerpt {

    margin-top: 6px;

    font-size: 12px;
    line-height: 1.45;

    color: rgba(17, 17, 17, 0.6);
  }


  #forma-journal-{{ section.id }} .forma-journal__read-more {

    display: inline-block;

    margin-top: 8px;

    font-size: 11px;
    line-height: 1.2;

    color: rgba(17, 17, 17, 0.65);
  }


  #forma-journal-{{ section.id }} .forma-journal__read-more span {
    margin-left: 4px;
  }


  /* =========================================================
     ARROWS
     ========================================================= */

  #forma-journal-{{ section.id }} .forma-journal__arrow {

    position: absolute;

    top: calc(
      (100% - 0px) / 2
    );

    transform: translateY(-50%);

    z-index: 5;

    width: 32px;
    height: 32px;

    padding: 0;

    border: 0;
    border-radius: 0;

    background: transparent;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 16px;
    line-height: 1;

    color: #111;

    cursor: pointer;

    opacity: 0.8;

    transition: opacity 0.2s ease;
  }


  #forma-journal-{{ section.id }} .forma-journal__arrow:hover {
    opacity: 0.45;
  }


  #forma-journal-{{ section.id }} .forma-journal__arrow--prev {
    left: 8px;
  }


  #forma-journal-{{ section.id }} .forma-journal__arrow--next {
    right: 8px;
  }


  /* =========================================================
     EMPTY
     ========================================================= */

  #forma-journal-{{ section.id }} .forma-journal__empty {

    padding: 40px 10px;

    font-size: 12px;

    color: rgba(17, 17, 17, 0.5);
  }


  /* =========================================================
     MOBILE
     ========================================================= */

  @media screen and (max-width: 699px) {

    #forma-journal-{{ section.id }} .forma-journal__inner {
      padding-top: 0.9rem;
      padding-bottom: 2rem;
    }


    #forma-journal-{{ section.id }} .forma-journal__header {

      margin-bottom: 0.85rem;

      padding-left: 6px;
      padding-right: 6px;
    }


    #forma-journal-{{ section.id }} .forma-journal__title {
      font-size: 16px;
    }


    #forma-journal-{{ section.id }} .forma-journal__subheading {
      font-size: 11px;
    }


    #forma-journal-{{ section.id }} .forma-journal__view-all {
      font-size: 11px;
    }


    #forma-journal-{{ section.id }} .forma-journal__track {
      gap: 10px;
      padding-left: 6px;
      padding-right: 6px;
    }


    #forma-journal-{{ section.id }} .forma-journal__card {

      flex: 0 0 82vw;
    }


    #forma-journal-{{ section.id }} .forma-journal__image {
      aspect-ratio: 1.35 / 1;
    }


    #forma-journal-{{ section.id }} .forma-journal__article-title {
      font-size: 14px;
    }


    #forma-journal-{{ section.id }} .forma-journal__arrow {
      display: none;
    }

  }

</style>


<script>

  (function() {

    const section = document.getElementById(
      'forma-journal-{{ section.id }}'
    );

    if (!section) return;

    const track = section.querySelector(
      '[data-forma-journal-track]'
    );

    if (!track) return;

    const prevButton = section.querySelector(
      '.forma-journal__arrow--prev'
    );

    const nextButton = section.querySelector(
      '.forma-journal__arrow--next'
    );

    const getScrollAmount = function() {

      const card = track.querySelector(
        '.forma-journal__card'
      );

      if (!card) return 0;

      const gap = 10;

      return card.getBoundingClientRect().width + gap;
    };


    if (prevButton) {

      prevButton.addEventListener(
        'click',
        function() {

          track.scrollBy({
            left: -getScrollAmount(),
            behavior: 'smooth'
          });

        }
      );

    }


    if (nextButton) {

      nextButton.addEventListener(
        'click',
        function() {

          track.scrollBy({
            left: getScrollAmount(),
            behavior: 'smooth'
          });

        }
      );

    }

  })();

</script>


{% schema %}

{
  "name": "Forma Journal",
  "tag": "section",
  "class": "section-forma-journal",
  "settings": [

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Forma Journal"
    },

    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover stories, ideas and places."
    },

    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },

    {
      "type": "range",
      "id": "articles_count",
      "label": "Number of articles",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 8
    },

    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View all",
      "default": true
    },

    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "View all"
    },

    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Show category",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": false
    },

    {
      "type": "checkbox",
      "id": "show_read_more",
      "label": "Show read more",
      "default": false
    },

    {
      "type": "text",
      "id": "read_more_text",
      "label": "Read more text",
      "default": "Read story"
    }

  ],

  "presets": [
    {
      "name": "Forma Journal"
    }
  ]

}

{% endschema %}