{%- if section.blocks.size > 0 -%}

  <style>

  /* =========================================================
   FORMA — SECTION SIDE SPACING
   ========================================================= */

#shopify-section-{{ section.id }} {
  margin-left: 5px !important;
  margin-right: 5px !important;
  width: auto !important;
}

    /* =========================================================
       FORMA FEATURED COLLECTIONS
       Clean editorial product carousel
       ========================================================= */

    #shopify-section-{{ section.id }} {
      --forma-gap: 14px;
      --forma-card-width: 355px;
      --forma-text: #111111;
      --forma-muted: #777777;
    }


    /* =========================================================
       SECTION
       ========================================================= */

    #shopify-section-{{ section.id }} .section-spacing {
      padding-top: 1.25rem !important;
      padding-bottom: 3.5rem !important;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    #shopify-section-{{ section.id }} .forma-featured-header {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;

      margin: 0 0 1rem 0 !important;
      padding: 0 5px !important;
    }


    /* TITLE */

    #shopify-section-{{ section.id }} .forma-featured-title {
      margin: 0 !important;
      padding: 0 !important;

      font-family: Georgia, "Times New Roman", serif !important;
      font-size: 18px !important;
      font-weight: 400 !important;
      line-height: 1.15 !important;
      letter-spacing: 0 !important;

      color: var(--forma-text) !important;
    }


    /* VIEW ALL */

    #shopify-section-{{ section.id }} .forma-featured-view-all {
      display: inline-flex;
      align-items: center;
      gap: 4px;

      margin: 0 !important;
      padding: 0 !important;

      font-family: Georgia, "Times New Roman", serif !important;
      font-size: 12px !important;
      font-weight: 400 !important;
      line-height: 1 !important;

      color: var(--forma-text) !important;
      text-decoration: none !important;

      transition: opacity 0.2s ease;
    }

    #shopify-section-{{ section.id }} .forma-featured-view-all::after {
      content: "→";

      font-family: Georgia, "Times New Roman", serif !important;
      font-size: 13px;

      transition: transform 0.2s ease;
    }

    #shopify-section-{{ section.id }} .forma-featured-view-all:hover {
      opacity: 0.55;
    }

    #shopify-section-{{ section.id }} .forma-featured-view-all:hover::after {
      transform: translateX(3px);
    }


    /* =========================================================
       PRODUCT CAROUSEL
       ========================================================= */

    #shopify-section-{{ section.id }} .forma-featured-carousel {
      position: relative;
      width: 100%;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .forma-featured-product-list {
      display: grid !important;
      grid-auto-flow: column !important;

      grid-auto-columns: var(--forma-card-width) !important;

      gap: var(--forma-gap) !important;

      width: 100% !important;
      max-width: none !important;

      overflow-x: auto !important;

      padding: 0 10px 8px !important;
      margin: 0 !important;

      scrollbar-width: none;
    }

    #shopify-section-{{ section.id }} .forma-featured-product-list::-webkit-scrollbar {
      display: none;
    }


    /* =========================================================
       PRODUCT CARD
       ========================================================= */

    #shopify-section-{{ section.id }}
    .forma-featured-product-list > * {

      width: var(--forma-card-width) !important;
      min-width: var(--forma-card-width) !important;
      max-width: var(--forma-card-width) !important;

      margin: 0 !important;
    }


    #shopify-section-{{ section.id }}
    .forma-featured-product-list product-card {

      display: block !important;

      width: var(--forma-card-width) !important;
      min-width: var(--forma-card-width) !important;
      max-width: var(--forma-card-width) !important;
    }


    /* =========================================================
       PRODUCT IMAGE
       ========================================================= */

    #shopify-section-{{ section.id }}
    .forma-featured-product-list .product-card__figure {

      width: 100% !important;

      aspect-ratio: 4 / 5 !important;

      overflow: hidden !important;

      background: #f5f5f5 !important;
    }


    #shopify-section-{{ section.id }}
    .forma-featured-product-list .product-card__figure img {

      width: 100% !important;
      height: 100% !important;

      object-fit: cover !important;

      transition: transform 0.45s cubic-bezier(.22,.61,.36,1);
    }


    /* Very subtle image movement */

    #shopify-section-{{ section.id }}
    .forma-featured-product-list product-card:hover
    .product-card__figure img {

      transform: scale(1.025);
    }


    /* =========================================================
       PRODUCT INFORMATION
       ========================================================= */

    #shopify-section-{{ section.id }}
    .forma-featured-product-list .product-card__info {

      display: block !important;

      width: 100% !important;

      height: auto !important;
      min-height: 0 !important;

      margin: 0 !important;
      padding: 11px 0 0 0 !important;

      opacity: 1 !important;
      visibility: visible !important;

      text-align: left !important;
    }


    /* Make sure hidden theme states cannot hide info */

    #shopify-section-{{ section.id }}
    .forma-featured-product-list
    .product-card__info[hidden],

    #shopify-section-{{ section.id }}
    .forma-featured-product-list
    .product-card__info.is-hidden {

      display: block !important;
      opacity: 1 !important;
      visibility: visible !important;
    }


    /* =========================================================
       INFORMATION GRID
       ========================================================= */

    #shopify-section-{{ section.id }}
    .forma-featured-product-list
    .product-card__info > .v-stack {

      display: grid !important;

      grid-template-columns: minmax(0, 1fr) auto;

      align-items: start;

      column-gap: 12px;

      width: 100% !important;

      margin: 0 !important;
      padding: 0 !important;
    }


    /* =========================================================
       BRAND
       ========================================================= */

    #shopify-section-{{ section.id }}
    .forma-featured-product-list
    .product-card__info > .v-stack > :first-child {

      grid-column: 2;
      grid-row: 1;

      justify-self: end;

      margin: 1px 0 0 0 !important;
      padding: 0 !important;

      text-align: right !important;

      font-family: Arial, Helvetica, sans-serif !important;
      font-size: 9px !important;
      font-weight: 400 !important;

      line-height: 1.2 !important;

      letter-spacing: 0.08em !important;
      text-transform: uppercase !important;

      color: var(--forma-muted) !important;
    }


    /* =========================================================
       PRODUCT NAME + PRICE
       ========================================================= */

    #shopify-section-{{ section.id }}
    .forma-featured-product-list
    .product-card__info > .v-stack > :last-child {

      grid-column: 1;
      grid-row: 1;

      display: flex !important;
      flex-direction: column !important;

      align-items: flex-start !important;

      width: 100% !important;

      margin: 0 !important;
      padding: 0 !important;

      text-align: left !important;
    }


    /* PRODUCT TITLE */

    #shopify-section-{{ section.id }}
    .forma-featured-product-list
    .product-card__info .product-title {

      display: block !important;
      width: 100% !important;

      margin: 0 !important;
      padding: 0 !important;

    font-family: Georgia, "Times New Roman", serif !important;
      font-size: 12px !important;
      font-weight: 300 !important;
      line-height: 1.25 !important;
      letter-spacing: 0 !important;

      color: var(--forma-text) !important;
      text-align: left !important;
    }


    /* PRICE */

    #shopify-section-{{ section.id }}
    .forma-featured-product-list
    .product-card__info .price-list {

      display: flex !important;

      justify-content: flex-start !important;
      align-items: flex-start !important;

      width: 100% !important;

      margin: 3px 0 0 0 !important;
      padding: 0 !important;

      font-family: Arial, Helvetica, sans-serif !important;

      font-size: 11px !important;
      font-weight: 400 !important;

      line-height: 1.2 !important;

      color: #555555 !important;

      text-align: left !important;
    }


    /* =========================================================
       HEART / SAVE
       ========================================================= */

    #shopify-section-{{ section.id }}
    .forma-featured-product-list
    .forma-save-button,
    #shopify-section-{{ section.id }}
    .forma-featured-product-list
    .forma-save-button button {

      width: 32px !important;
      height: 32px !important;

      min-width: 32px !important;
      min-height: 32px !important;

      padding: 0 !important;
      margin: 0 !important;

      border: 0 !important;
      border-radius: 0 !important;

      background: transparent !important;
      box-shadow: none !important;

      display: flex !important;

      align-items: center !important;
      justify-content: center !important;
    }


    #shopify-section-{{ section.id }}
    .forma-featured-product-list
    .forma-save-button svg,
    #shopify-section-{{ section.id }}
    .forma-featured-product-list
    .forma-save-button button svg {

      width: 18px !important;
      height: 18px !important;

      stroke-width: 1.4 !important;

      fill: none !important;
    }


    /* =========================================================
       CAROUSEL ARROWS
       ========================================================= */

    #shopify-section-{{ section.id }}
    .forma-featured-carousel
    .floating-controls-container__control {

      position: absolute;

      top: 40%;

      transform: translateY(-50%);

      z-index: 10;

      opacity: 0;

      transition: opacity 0.2s ease;
    }


    /* Show arrows when section is hovered */

    #shopify-section-{{ section.id }}
    .forma-featured-carousel:hover
    .floating-controls-container__control {

      opacity: 1;
    }


    /* Left */

    #shopify-section-{{ section.id }}
    .forma-featured-carousel
    .floating-controls-container__control:first-child {

      left: 15px;
    }


    /* Right */

    #shopify-section-{{ section.id }}
    .forma-featured-carousel
    .floating-controls-container__control:last-child {

      right: 15px;
    }


    /* =========================================================
       DESKTOP
       ========================================================= */

    @media screen and (min-width: 700px) {

      #shopify-section-{{ section.id }} {
        --forma-card-width: 355px;
        --forma-gap: 5px;
      }

      #shopify-section-{{ section.id }}
      .section-spacing {

        padding-top: 1.25rem !important;
        padding-bottom: 3.5rem !important;
      }

      #shopify-section-{{ section.id }}
      .forma-featured-header {

        margin-bottom: 1rem !important;

        padding-left: 5px !important;
        padding-right: 5px !important;
      }

      #shopify-section-{{ section.id }}
      .forma-featured-title {

        font-size: 18px !important;
      }

      #shopify-section-{{ section.id }}
      .forma-featured-product-list {

        padding-left: 10px !important;
        padding-right: 10px !important;
      }
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @media screen and (max-width: 699px) {

      #shopify-section-{{ section.id }} {
        --forma-card-width: 78vw;
        --forma-gap: 12px;
      }


      #shopify-section-{{ section.id }}
      .section-spacing {

        padding-top: 0.9rem !important;
        padding-bottom: 0rem !important;
      }


      #shopify-section-{{ section.id }}
      .forma-featured-header {

        margin-bottom: 0.8rem !important;

        padding-left: 6px !important;
        padding-right: 6px !important;
      }


      #shopify-section-{{ section.id }}
      .forma-featured-title {

        font-size: 16px !important;
      }


      #shopify-section-{{ section.id }}
      .forma-featured-view-all {

        font-size: 11px !important;
      }


      #shopify-section-{{ section.id }}
      .forma-featured-product-list {

        grid-auto-columns: var(--forma-card-width) !important;

        gap: var(--forma-gap) !important;

        padding-left: 6px !important;
        padding-right: 6px !important;
      }


      #shopify-section-{{ section.id }}
      .forma-featured-product-list > * {

        width: var(--forma-card-width) !important;
        min-width: var(--forma-card-width) !important;
        max-width: var(--forma-card-width) !important;
      }


      #shopify-section-{{ section.id }}
      .forma-featured-product-list product-card {

        width: var(--forma-card-width) !important;
        min-width: var(--forma-card-width) !important;
        max-width: var(--forma-card-width) !important;
      }


      /* Always show arrows on mobile */

      #shopify-section-{{ section.id }}
      .forma-featured-carousel
      .floating-controls-container__control {

        opacity: 1;
      }


      #shopify-section-{{ section.id }}
      .forma-featured-carousel
      .floating-controls-container__control:first-child {

        left: 7px;
      }


      #shopify-section-{{ section.id }}
      .forma-featured-carousel
      .floating-controls-container__control:last-child {

        right: 7px;
      }


      #shopify-section-{{ section.id }}
      .forma-featured-carousel
      .prev-next-button {

        width: 30px !important;
        height: 30px !important;

        min-width: 30px !important;
        min-height: 30px !important;
      }


      #shopify-section-{{ section.id }}
      .forma-featured-carousel
      .prev-next-button svg {

        width: 11px !important;
        height: 11px !important;
      }


      #shopify-section-{{ section.id }}
      .forma-featured-product-list
      .product-card__info .product-title {

        font-size: 13px !important;
      }


      #shopify-section-{{ section.id }}
      .forma-featured-product-list
      .product-card__info > .v-stack > :first-child {

        font-size: 8px !important;
      }
    }

  </style>


  {%- assign color_scheme_hash =
    section.settings.color_scheme.settings.background_gradient
    | default: section.settings.color_scheme.settings.background
    | md5
  -%}


  <div
    class="
      section-spacing
      color-scheme
      color-scheme--{{ section.settings.color_scheme.id }}
      color-scheme--bg-{{ color_scheme_hash }}
      {% if section.settings.separate_section_with_border %}
        bordered-section
      {% endif %}
    "
  >

    <div class="container">

      {%- assign wrapper_carousel_id =
        'forma-featured-carousel-' | append: section.id
      -%}


      <!-- =====================================================
           HEADER
           ===================================================== -->

      {%- unless section.settings.hide_collection_title -%}

        <div class="forma-featured-header">

          <h2 class="forma-featured-title">
            {{ section.blocks.first.settings.title }}
          </h2>


          {%- if section.blocks.size == 1
            and section.blocks.first.settings.link_text != blank
          -%}

            {%- assign header_link =
              section.blocks.first.settings.link_url
              | default: section.blocks.first.settings.collection.url
              | default: '#'
            -%}

            <a
              href="{{ header_link }}"
              class="forma-featured-view-all"
            >
              {{ section.blocks.first.settings.link_text }}
            </a>

          {%- endif -%}

        </div>

      {%- endunless -%}


      <!-- =====================================================
           COLLECTION CAROUSEL
           ===================================================== -->

      <featured-collections-carousel
        id="{{ wrapper_carousel_id }}"
        class="forma-featured-carousel"
      >

        {%- for block in section.blocks -%}

          <div
            class="
              featured-collections-carousel__item
              {% if forloop.first %}is-selected{% endif %}
            "
            {{ block.shopify_attributes }}
          >

            {%- capture product_list -%}

              {%- assign should_reveal = false -%}

              {%- if settings.stagger_products_apparition
                and forloop.first
              -%}

                {%- assign should_reveal = true -%}

              {%- endif -%}


              {%- for product in block.settings.collection.products
                limit: block.settings.products_count
              -%}

                {%- render 'product-card',
                  product: product,
                  reveal: should_reveal,
                  position: forloop.index,
                  hide_product_information: false,
                  block: block
                -%}

              {%- else -%}

                {%- for i in (1..block.settings.products_count) -%}

                  {%- render 'product-card-placeholder',
                    reveal: should_reveal,
                    loop_index: forloop.index0,
                    hide_product_information: false
                  -%}

                {%- endfor -%}

              {%- endfor -%}

            {%- endcapture -%}


            <div class="forma-featured-products">

              {%- if section.settings.stack_products -%}

                <product-list
                  class="
                    product-list
                    justify-center
                    forma-featured-product-list
                  "
                >

                  {{- product_list -}}

                </product-list>


              {%- else -%}


                {%- assign product_carousel_id =
                  'forma-featured-products-' | append: block.id
                -%}


                <product-list
                  class="
                    floating-controls-container
                    floating-controls-container--inside
                    forma-featured-product-list-wrapper
                  "
                >


                  <!-- PREVIOUS -->

                  <carousel-prev-button
                    class="floating-controls-container__control"
                    aria-controls="{{ product_carousel_id }}"
                  >

                    <button
                      type="button"
                      class="
                        prev-next-button
                        prev-next-button--prev
                        circle-button
                      "
                      disabled
                    >

                      <span class="sr-only">
                        {{ 'general.accessibility.previous' | t }}
                      </span>

                      {%- render 'icon',
                        with: 'arrow-left',
                        direction_aware: true
                      -%}

                    </button>

                  </carousel-prev-button>


                  <!-- PRODUCTS -->

                  <scroll-carousel
                    id="{{ product_carousel_id }}"
                    group-cells
                    allow-drag
                    class="
                      product-list
                      product-list--carousel
                      scroll-area
                      bleed
                      md:unbleed
                      forma-featured-product-list
                    "
                  >

                    {{- product_list -}}

                  </scroll-carousel>


                  <!-- NEXT -->

                  <carousel-next-button
                    class="floating-controls-container__control"
                    aria-controls="{{ product_carousel_id }}"
                  >

                    <button
                      type="button"
                      class="
                        prev-next-button
                        prev-next-button--next
                        circle-button
                      "
                    >

                      <span class="sr-only">
                        {{ 'general.accessibility.next' | t }}
                      </span>

                      {%- render 'icon',
                        with: 'arrow-right',
                        direction_aware: true
                      -%}

                    </button>

                  </carousel-next-button>


                </product-list>

              {%- endif -%}

            </div>

          </div>

        {%- endfor -%}

      </featured-collections-carousel>

    </div>

  </div>


{% endif %}

{% schema %}

{
  "name": "FORMA Collections",

  "class": "shopify-section--featured-collections",

  "tag": "section",

  "disabled_on": {
    "templates": [
      "password"
    ],
    "groups": [
      "header",
      "custom.overlay"
    ]
  },

  "max_blocks": 5,

  "settings": [

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },

    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": false
    },

    {
      "type": "checkbox",
      "id": "stack_products",
      "label": "t:global.product_list.stack_products",
      "default": false
    },

    {
      "type": "select",
      "id": "products_per_row_mobile",
      "label": "t:global.product_list.products_per_row_mobile",

      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],

      "default": "2",

      "visible_if": "{{ section.settings.stack_products }}"
    },

    {
      "type": "range",
      "id": "products_per_row_desktop",

      "min": 2,
      "max": 6,

      "label": "t:global.product_list.products_per_row_desktop",

      "default": 4,

      "visible_if": "{{ section.settings.stack_products }}"
    },

    {
      "type": "range",
      "min": 0.2,
      "max": 2,
      "step": 0.1,

      "id": "horizontal_spacing_factor",

      "label": "Horizontal spacing factor",

      "default": 1
    },

    {
      "type": "range",
      "min": 0.2,
      "max": 2,
      "step": 0.1,

      "id": "vertical_spacing_factor",

      "label": "Vertical spacing factor",

      "default": 1
    },

    {
      "type": "checkbox",
      "id": "hide_collection_title",

      "label": "t:sections.featured_collections.hide_collection_title",

      "default": false
    }

  ],

  "blocks": [

    {
      "type": "collection",

      "name": "Collection",

      "settings": [

        {
          "type": "collection",

          "id": "collection",

          "label": "Collection"
        },

        {
          "type": "range",

          "id": "products_count",

          "min": 2,
          "max": 50,

          "label": "Products to show",

          "default": 8
        },

        {
          "type": "inline_richtext",

          "id": "title",

          "label": "Heading",

          "default": "The Forma Edit"
        },

        {
          "type": "url",

          "id": "link_url",

          "label": "View all link"
        },

        {
          "type": "text",

          "id": "link_text",

          "label": "Link text",

          "default": "View all"
        }

      ]
    }

  ],

  "presets": [

    {
      "name": "FORMA Collections",

      "category": "Collections",

      "blocks": [
        {
          "type": "collection"
        }
      ]
    }

  ]
}

{% endschema %}
