{%- if section.blocks.size > 0 -%}

  <style>
    #shopify-section-{{ section.id }} {
      --product-list-items-per-row: {{ section.settings.products_per_row_mobile | times: 1 }};
      --product-list-horizontal-spacing-factor: {{ section.settings.horizontal_spacing_factor }};
      --product-list-vertical-spacing-factor: {{ section.settings.vertical_spacing_factor }};
    }

    /* =========================================================
       FORMA EDIT — SECTION HEADER
       ========================================================= */

    #shopify-section-{{ section.id }} .forma-edit-section-header {
      width: 100%;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
      margin-bottom: 2.5rem;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .forma-edit-section-header__content {
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .forma-edit-section-header__title {
      display: block !important;

      margin: 0 !important;
      padding: 0 !important;

      font-family:
        Didot,
        "Bodoni 72",
        "Bodoni MT",
        Georgia,
        "Times New Roman",
        serif !important;

      font-size: clamp(2.2rem, 3vw, 3.4rem) !important;
      font-weight: 400 !important;
      font-style: normal !important;
      line-height: 1 !important;
      letter-spacing: -0.025em !important;

      color: #111111 !important;
      opacity: 1 !important;
      visibility: visible !important;
    }

    #shopify-section-{{ section.id }} .forma-edit-section-header__subheading {
      display: block;

      margin: 0.7rem 0 0;
      padding: 0;

      font-family: inherit;
      font-size: 0.72rem;
      font-weight: 400;
      line-height: 1.4;
      letter-spacing: 0.12em;
      text-transform: uppercase;

      color: #111111 !important;
      opacity: 0.55;
    }

    /* =========================================================
       VIEW ALL
       ========================================================= */

    #shopify-section-{{ section.id }} .forma-edit-section-header__link {
      position: relative;

      display: inline-block;
      flex-shrink: 0;

      margin-bottom: 0.25rem;
      padding-bottom: 0.4rem;

      font-family: inherit;
      font-size: 0.72rem;
      font-weight: 500;
      line-height: 1;

      letter-spacing: 0.12em;
      text-transform: uppercase;

      color: #111111 !important;
      text-decoration: none !important;

      transition: opacity 0.25s ease;
    }

    #shopify-section-{{ section.id }} .forma-edit-section-header__link::after {
      content: "";

      position: absolute;
      left: 0;
      bottom: 0;

      width: 100%;
      height: 1px;

      background: #111111;

      transform: scaleX(1);
      transform-origin: right;

      transition: transform 0.3s ease;
    }

    #shopify-section-{{ section.id }} .forma-edit-section-header__link:hover {
      opacity: 0.65;
    }

    #shopify-section-{{ section.id }} .forma-edit-section-header__link:hover::after {
      transform: scaleX(0);
      transform-origin: left;
    }

    /* =========================================================
       PRODUCT AREA
       ========================================================= */

    #shopify-section-{{ section.id }} .forma-edit-row {
      width: 100%;
      display: block;
    }

    #shopify-section-{{ section.id }} .forma-edit-products {
      width: 100%;
      min-width: 0;
      flex: 1 1 100%;
    }

    #shopify-section-{{ section.id }} .forma-edit-products .product-list {
      width: 100%;
    }

    /* =========================================================
       DESKTOP
       ========================================================= */

    @media screen and (min-width: 700px) {

      #shopify-section-{{ section.id }} {
        --product-list-items-per-row: {{ section.settings.products_per_row_desktop }};
      }

      #shopify-section-{{ section.id }} .forma-edit-section-header {
        margin-bottom: 2.5rem;
      }

    }

    /* =========================================================
       MOBILE
       ========================================================= */

    @media screen and (max-width: 699px) {

      #shopify-section-{{ section.id }} .forma-edit-section-header {
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }

      #shopify-section-{{ section.id }} .forma-edit-section-header__title {
        font-size: 2rem !important;
      }

      #shopify-section-{{ section.id }} .forma-edit-section-header__subheading {
        margin-top: 0.55rem;
        font-size: 0.65rem;
      }

      #shopify-section-{{ section.id }} .forma-edit-section-header__link {
        margin-top: 0.35rem;
        margin-bottom: 0;
        font-size: 0.65rem;
      }

    }
  </style>


  {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}


  <div
    class="
      section-spacing
      color-scheme
      color-scheme--{{ section.settings.color_scheme.id }}
      color-scheme--bg-{{ color_scheme_hash }}
      {% if section.settings.separate_section_with_border %}bordered-section{% endif %}
    "
  >

    <div class="container">

      {%- assign wrapper_carousel_id = 'featured-collections-carousel-' | append: section.id -%}

      <div class="section-stack">


        <!-- =====================================================
             FORMA EDIT HEADER
             ===================================================== -->

        {%- unless section.settings.hide_collection_title -%}

          <div class="forma-edit-section-header">

            <div class="forma-edit-section-header__content">

              <h2 class="forma-edit-section-header__title">
                The Forma Edit
              </h2>

              <p class="forma-edit-section-header__subheading">
                Curated by FORMA
              </p>

            </div>


            {%- if section.blocks.size == 1 and section.blocks.first.settings.link_text != blank -%}

              {%- assign header_link = section.blocks.first.settings.link_url | default: section.blocks.first.settings.collection.url | default: '#' -%}

              <a
                href="{{ header_link }}"
                class="forma-edit-section-header__link"
              >
                {{ section.blocks.first.settings.link_text }}
              </a>

            {%- endif -%}

          </div>

        {%- endunless -%}



        <!-- =====================================================
             PRODUCT CAROUSEL
             ===================================================== -->

        <featured-collections-carousel
          id="{{ wrapper_carousel_id }}"
          class="featured-collections-carousel"
        >

          {%- for block in section.blocks -%}

            <div
              class="
                featured-collections-carousel__item
                {% if forloop.first %}is-selected{% endif %}
              "
              {{ block.shopify_attributes }}
            >


              {%- capture product_list -%}

                {%- assign should_reveal = false -%}

                {%- if settings.stagger_products_apparition and forloop.first -%}
                  {%- assign should_reveal = true -%}
                {%- endif -%}


                {%- for product in block.settings.collection.products limit: block.settings.products_count -%}

                  {%- render 'product-card',
                    product: product,
                    reveal: should_reveal,
                    position: forloop.index,
                    hide_product_information: section.settings.hide_product_information,
                    block: block
                  -%}

                {%- else -%}

                  {%- for i in (1..block.settings.products_count) -%}

                    {%- render 'product-card-placeholder',
                      reveal: should_reveal,
                      loop_index: forloop.index0,
                      hide_product_information: section.settings.hide_product_information
                    -%}

                  {%- endfor -%}

                {%- endfor -%}

              {%- endcapture -%}


              <div class="forma-edit-row">

                <div class="forma-edit-products">


                  {%- if section.settings.stack_products -%}

                    <product-list
                      class="
                        product-list
                        {% if section.settings.hide_product_information %}
                          product-list--compact
                        {% endif %}
                        justify-center
                      "
                    >
                      {{- product_list -}}
                    </product-list>


                  {%- else -%}


                    {%- assign product_carousel_id = 'featured-collections-product-list-carousel-' | append: block.id -%}


                    <product-list
                      class="
                        floating-controls-container
                        floating-controls-container--inside
                        floating-controls-container--on-hover
                      "
                    >


                      <!-- PREVIOUS -->

                      <carousel-prev-button
                        class="floating-controls-container__control"
                        aria-controls="{{ product_carousel_id }}"
                      >

                        <button
                          type="button"
                          class="
                            prev-next-button
                            prev-next-button--prev
                            circle-button
                            hover:animate-icon-inline
                          "
                          disabled
                        >

                          <span class="sr-only">
                            {{ 'general.accessibility.previous' | t }}
                          </span>

                          {%- render 'icon' with 'arrow-left', direction_aware: true -%}

                        </button>

                      </carousel-prev-button>



                      <!-- PRODUCTS -->

                      <scroll-carousel
                        id="{{ product_carousel_id }}"
                        group-cells
                        allow-drag
                        class="
                          product-list
                          {% if section.settings.hide_product_information %}
                            product-list--compact
                          {% endif %}
                          product-list--carousel
                          scroll-area
                          bleed
                          md:unbleed
                        "
                      >

                        {{- product_list -}}

                      </scroll-carousel>



                      <!-- NEXT -->

                      <carousel-next-button
                        class="floating-controls-container__control"
                        aria-controls="{{ product_carousel_id }}"
                      >

                        <button
                          type="button"
                          class="
                            prev-next-button
                            prev-next-button--next
                            circle-button
                            hover:animate-icon-inline
                          "
                        >

                          <span class="sr-only">
                            {{ 'general.accessibility.next' | t }}
                          </span>

                          {%- render 'icon' with 'arrow-right', direction_aware: true -%}

                        </button>

                      </carousel-next-button>


                    </product-list>


                  {%- endif -%}

                </div>

              </div>


            </div>

          {%- endfor -%}

        </featured-collections-carousel>


      </div>

    </div>

  </div>

{%- endif -%}



{% schema %}

{
  "name": "t:sections.featured_collections.name",

  "class": "shopify-section--featured-collections",

  "tag": "section",

  "disabled_on": {
    "templates": [
      "password"
    ],
    "groups": [
      "header",
      "custom.overlay"
    ]
  },

  "max_blocks": 5,


  "settings": [

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },

    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "hide_product_information",
      "label": "t:global.product_list.hide_product_information",
      "info": "t:global.product_list.hide_product_information_info"
    },


    {
      "type": "header",
      "content": "t:global.product_list.product_list_category"
    },

    {
      "type": "checkbox",
      "id": "stack_products",
      "label": "t:global.product_list.stack_products",
      "default": false
    },

    {
      "type": "select",
      "id": "products_per_row_mobile",
      "label": "t:global.product_list.products_per_row_mobile",

      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],

      "default": "2",

      "visible_if": "{{ section.settings.stack_products }}"
    },


    {
      "type": "range",
      "id": "products_per_row_desktop",

      "min": 2,
      "max": 6,

      "label": "t:global.product_list.products_per_row_desktop",

      "info": "t:global.product_list.products_per_row_desktop_info",

      "default": 4,

      "visible_if": "{{ section.settings.stack_products }}"
    },


    {
      "type": "header",
      "content": "t:global.product_list.spacing_category",

      "info": "t:global.product_list.spacing_category_info"
    },


    {
      "type": "range",

      "min": 0.2,
      "max": 2,
      "step": 0.1,

      "id": "horizontal_spacing_factor",

      "label": "Horizontal spacing factor",

      "default": 1
    },


    {
      "type": "range",

      "min": 0.2,
      "max": 2,
      "step": 0.1,

      "id": "vertical_spacing_factor",

      "label": "Vertical spacing factor",

      "default": 1
    },


    {
      "type": "header",
      "content": "t:global.section.header_category"
    },


    {
      "type": "checkbox",

      "id": "hide_collection_title",

      "label": "t:sections.featured_collections.hide_collection_title",

      "info": "t:sections.featured_collections.hide_collection_title_info",

      "default": false
    }

  ],


  "blocks": [

    {
      "type": "collection",

      "name": "t:sections.featured_collections.blocks.collection.name",


      "settings": [

        {
          "type": "collection",

          "id": "collection",

          "label": "t:sections.featured_collections.blocks.collection.collection"
        },


        {
          "type": "range",

          "id": "products_count",

          "min": 2,
          "max": 50,

          "label": "t:global.product_list.products_to_show",

          "default": 8
        },


        {
          "type": "inline_richtext",

          "id": "title",

          "label": "t:global.text.heading",

          "info": "t:sections.featured_collections.blocks.collection.title_info"
        },


        {
          "type": "url",

          "id": "link_url",

          "label": "t:global.text.link_url",

          "info": "t:sections.featured_collections.blocks.collection.default_link_url"
        },


        {
          "type": "text",

          "id": "link_text",

          "label": "t:global.text.link_text",

          "default": "View all"
        }

      ]

    }

  ],


  "presets": [

    {
      "name": "t:sections.featured_collections.presets.featured_collections.name",

      "category": "t:global.categories.collections",

      "blocks": [
        {
          "type": "collection"
        }
      ]

    }

  ]

}

{% endschema %}