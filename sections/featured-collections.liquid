{%- if section.blocks.size > 0 -%}

  <style>

    /* =========================================================
       FORMA EDIT — LES DEUX INSPIRED
       ========================================================= */

    #shopify-section-{{ section.id }} {
      --product-list-items-per-row: {{ section.settings.products_per_row_mobile | times: 1 }};
      --product-list-horizontal-spacing-factor: {{ section.settings.horizontal_spacing_factor }};
      --product-list-vertical-spacing-factor: {{ section.settings.vertical_spacing_factor }};
    }


    /* =========================================================
       SECTION
       ========================================================= */

    #shopify-section-{{ section.id }} .section-spacing {
      padding-top: 1rem !important;
      padding-bottom: 2.5rem !important;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    #shopify-section-{{ section.id }} .forma-edit-section-header {
  width: 100%;

  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  margin: 2px 0 0.75rem 0 !important;
  padding: 0 10px !important;

  text-align: left;
}


    /* =========================================================
       HEADER CONTENT
       ========================================================= */

    #shopify-section-{{ section.id }} .forma-edit-section-header__content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;

      min-width: 0;
    }


    /* =========================================================
       HEADING
       ========================================================= */

    #shopify-section-{{ section.id }} .forma-edit-section-header__title {
      display: block !important;

      margin: 0 !important;
      padding: 0 !important;

      font-family: Georgia, "Times New Roman", serif !important;

      font-size: 18px !important;

      font-weight: 400 !important;

      font-style: normal !important;

      line-height: 1.15 !important;

      letter-spacing: 0 !important;

      color: #111111 !important;

      opacity: 1 !important;
      visibility: visible !important;
    }


    /* =========================================================
       VIEW ALL
       ========================================================= */

    #shopify-section-{{ section.id }} .forma-edit-section-header__link {
      display: inline-flex;

      align-items: center;

      gap: 4px;

      margin: 5px 0 0 0 !important;
      padding: 0 !important;

      font-family: Georgia, "Times New Roman", serif !important;

      font-size: 12px !important;

      font-weight: 400 !important;

      font-style: normal !important;

      line-height: 1.15 !important;

      letter-spacing: 0 !important;

      text-transform: none !important;

      color: #111111 !important;

      text-decoration: none !important;

      opacity: 1;

      transition: opacity 0.2s ease;
    }


    /* Arrow */

    #shopify-section-{{ section.id }} .forma-edit-section-header__link::after {
      content: "→";

      display: inline-block;

      font-family: Georgia, "Times New Roman", serif !important;

      font-size: 13px;

      font-weight: 400;

      line-height: 1;

      transition: transform 0.2s ease;
    }


    #shopify-section-{{ section.id }} .forma-edit-section-header__link:hover {
      opacity: 0.65;
    }


    #shopify-section-{{ section.id }} .forma-edit-section-header__link:hover::after {
      transform: translateX(2px);
    }


    /* =========================================================
       PRODUCT AREA
       ========================================================= */

    #shopify-section-{{ section.id }} .forma-edit-row {
      width: 100%;

      display: block;

      margin: 0 !important;
      padding: 0 !important;
    }


    #shopify-section-{{ section.id }} .forma-edit-products {
      width: 100%;

      min-width: 0;

      margin: 0 !important;
      padding: 0 !important;
    }


    /* =========================================================
       CAROUSEL
       ========================================================= */

    #shopify-section-{{ section.id }} .featured-collections-carousel {
      margin: 0 !important;
      padding: 0 !important;
    }


    #shopify-section-{{ section.id }} .featured-collections-carousel__item {
      margin: 0 !important;
      padding: 0 !important;
    }


    /* =========================================================
       PRODUCT LIST
       ========================================================= */

    #shopify-section-{{ section.id }} .product-list {
      margin-top: 0 !important;
    }


    /* =========================================================
       CAROUSEL ARROWS
       ========================================================= */

    #shopify-section-{{ section.id }} .floating-controls-container {
      position: relative;
    }


    #shopify-section-{{ section.id }} .floating-controls-container__control {
      z-index: 5;
    }


    /* Keep controls subtle */

    #shopify-section-{{ section.id }} .prev-next-button {
      width: 32px !important;
      height: 32px !important;

      background: transparent !important;

      border: none !important;

      box-shadow: none !important;

      opacity: 0.75;
    }


    /* =========================================================
       DESKTOP
       ========================================================= */

    @media screen and (min-width: 700px) {

      #shopify-section-{{ section.id }} {
        --product-list-items-per-row: 3;
      }


      #shopify-section-{{ section.id }} .section-spacing {
        padding-top: 1rem !important;
        padding-bottom: 3rem !important;
      }


      #shopify-section-{{ section.id }} .forma-edit-section-header {
        margin-bottom: 1rem !important;
        padding-left: 10px !important;
        padding-right: 10px !important;
      }


      #shopify-section-{{ section.id }} .forma-edit-section-header__title {
        font-size: 17px !important;
      }


      #shopify-section-{{ section.id }} .forma-edit-section-header__link {
        font-size: 12px !important;
      }

    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @media screen and (max-width: 699px) {

      #shopify-section-{{ section.id }} .section-spacing {
        padding-top: 0.9rem !important;
        padding-bottom: 2rem !important;
      }


      #shopify-section-{{ section.id }} .forma-edit-section-header {
        margin-bottom: 0.85rem !important;
        padding-left: 6px !important;
        padding-right: 6px !important;
      }


      #shopify-section-{{ section.id }} .forma-edit-section-header__title {
        font-size: 16px !important;
      }


      #shopify-section-{{ section.id }} .forma-edit-section-header__link {
        font-size: 11px !important;
      }

    }

    /* =========================================================
   FORMA – PRODUCT CAROUSEL ARROWS
   ========================================================= */

#shopify-section-{{ section.id }} .forma-product-carousel {
  position: relative;
}

/* Arrow containers */
#shopify-section-{{ section.id }} .forma-product-carousel
.floating-controls-container__control {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 5;
  opacity: 1 !important;
  visibility: visible !important;
  pointer-events: auto;
}

/* Left arrow */
#shopify-section-{{ section.id }} .forma-product-carousel
.floating-controls-container__control:first-child {
  left: 18px;
}

/* Right arrow */
#shopify-section-{{ section.id }} .forma-product-carousel
.floating-controls-container__control:last-child {
  right: 18px;
}

/* Remove the round button styling */
#shopify-section-{{ section.id }} .forma-product-carousel
.prev-next-button {
  width: 32px;
  height: 32px;
  min-width: 32px;
  min-height: 32px;

  padding: 0;
  border: 0;
  border-radius: 0;

  background: transparent !important;
  box-shadow: none !important;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #111 !important;
}

/* Arrow size */
#shopify-section-{{ section.id }} .forma-product-carousel
.prev-next-button svg {
  width: 14px;
  height: 14px;
  stroke-width: 1.4;
}

/* Subtle hover */
#shopify-section-{{ section.id }} .forma-product-carousel
.prev-next-button:hover {
  opacity: 0.55;
}

/* Disabled previous arrow */
#shopify-section-{{ section.id }} .forma-product-carousel
.prev-next-button:disabled {
  opacity: 0.25;
  pointer-events: none;
}

/* Mobile */
@media screen and (max-width: 699px) {

  #shopify-section-{{ section.id }} .forma-product-carousel
  .floating-controls-container__control:first-child {
    left: 8px;
  }

  #shopify-section-{{ section.id }} .forma-product-carousel
  .floating-controls-container__control:last-child {
    right: 8px;
  }

  #shopify-section-{{ section.id }} .forma-product-carousel
  .prev-next-button {
    width: 28px;
    height: 28px;
    min-width: 28px;
    min-height: 28px;
  }

  #shopify-section-{{ section.id }} .forma-product-carousel
  .prev-next-button svg {
    width: 12px;
    height: 12px;
  }
}

  </style>


  {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}


  <div
    class="
      section-spacing
      color-scheme
      color-scheme--{{ section.settings.color_scheme.id }}
      color-scheme--bg-{{ color_scheme_hash }}
      {% if section.settings.separate_section_with_border %}bordered-section{% endif %}
    "
  >

    <div class="container">

      {%- assign wrapper_carousel_id = 'featured-collections-carousel-' | append: section.id -%}

      <div class="section-stack">


        <!-- =====================================================
             FORMA EDIT HEADER
             ===================================================== -->

        {%- unless section.settings.hide_collection_title -%}

          <div class="forma-edit-section-header">

            <div class="forma-edit-section-header__content">

              <h2 class="forma-edit-section-header__title">
                {{ section.blocks.first.settings.title }}
              </h2>


              {%- if section.blocks.size == 1 and section.blocks.first.settings.link_text != blank -%}

                {%- assign header_link = section.blocks.first.settings.link_url | default: section.blocks.first.settings.collection.url | default: '#' -%}

                <a
                  href="{{ header_link }}"
                  class="forma-edit-section-header__link"
                >
                  {{ section.blocks.first.settings.link_text }}
                </a>

              {%- endif -%}

            </div>

          </div>

        {%- endunless -%}



        <!-- =====================================================
             PRODUCT CAROUSEL
             ===================================================== -->

        <featured-collections-carousel
          id="{{ wrapper_carousel_id }}"
          class="featured-collections-carousel"
        >

          {%- for block in section.blocks -%}

            <div
              class="
                featured-collections-carousel__item
                {% if forloop.first %}is-selected{% endif %}
              "
              {{ block.shopify_attributes }}
            >

              {%- capture product_list -%}

                {%- assign should_reveal = false -%}

                {%- if settings.stagger_products_apparition and forloop.first -%}
                  {%- assign should_reveal = true -%}
                {%- endif -%}


                {%- for product in block.settings.collection.products limit: block.settings.products_count -%}

                  {%- render 'product-card',
                    product: product,
                    reveal: should_reveal,
                    position: forloop.index,
                    hide_product_information: section.settings.hide_product_information,
                    block: block
                  -%}

                {%- else -%}

                  {%- for i in (1..block.settings.products_count) -%}

                    {%- render 'product-card-placeholder',
                      reveal: should_reveal,
                      loop_index: forloop.index0,
                      hide_product_information: section.settings.hide_product_information
                    -%}

                  {%- endfor -%}

                {%- endfor -%}

              {%- endcapture -%}


              <div class="forma-edit-row">

                <div class="forma-edit-products">


                  {%- if section.settings.stack_products -%}

                    <product-list
                      class="
                        product-list
                        {% if section.settings.hide_product_information %}
                          product-list--compact
                        {% endif %}
                        justify-center
                      "
                    >

                      {{- product_list -}}

                    </product-list>


                  {%- else -%}


                    {%- assign product_carousel_id = 'featured-collections-product-list-carousel-' | append: block.id -%}


                    <product-list 
                    class="floating-controls-container 
                    floating-controls-container--inside 
                    forma-product-carousel">


                      <!-- PREVIOUS -->

                      <carousel-prev-button
                        class="floating-controls-container__control"
                        aria-controls="{{ product_carousel_id }}"
                      >

                        <button
                          type="button"
                          class="
                            prev-next-button
                            prev-next-button--prev
                            circle-button
                            hover:animate-icon-inline
                          "
                          disabled
                        >

                          <span class="sr-only">
                            {{ 'general.accessibility.previous' | t }}
                          </span>

                          {%- render 'icon' with 'arrow-left', direction_aware: true -%}

                        </button>

                      </carousel-prev-button>



                      <!-- PRODUCTS -->

                      <scroll-carousel
                        id="{{ product_carousel_id }}"
                        group-cells
                        allow-drag
                        class="
                          product-list
                          {% if section.settings.hide_product_information %}
                            product-list--compact
                          {% endif %}
                          product-list--carousel
                          scroll-area
                          bleed
                          md:unbleed
                        "
                      >

                        {{- product_list -}}

                      </scroll-carousel>



                      <!-- NEXT -->

                      <carousel-next-button
                        class="floating-controls-container__control"
                        aria-controls="{{ product_carousel_id }}"
                      >

                        <button
                          type="button"
                          class="
                            prev-next-button
                            prev-next-button--next
                            circle-button
                            hover:animate-icon-inline
                          "
                        >

                          <span class="sr-only">
                            {{ 'general.accessibility.next' | t }}
                          </span>

                          {%- render 'icon' with 'arrow-right', direction_aware: true -%}

                        </button>

                      </carousel-next-button>


                    </product-list>


                  {%- endif -%}

                </div>

              </div>


            </div>

          {%- endfor -%}

        </featured-collections-carousel>


      </div>

    </div>

  </div>

{%- endif -%}



{% schema %}

{
  "name": "t:sections.featured_collections.name",

  "class": "shopify-section--featured-collections",

  "tag": "section",

  "disabled_on": {
    "templates": [
      "password"
    ],
    "groups": [
      "header",
      "custom.overlay"
    ]
  },

  "max_blocks": 5,

  "settings": [

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },

    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "hide_product_information",
      "label": "t:global.product_list.hide_product_information",
      "info": "t:global.product_list.hide_product_information_info"
    },

    {
      "type": "header",
      "content": "t:global.product_list.product_list_category"
    },

    {
      "type": "checkbox",
      "id": "stack_products",
      "label": "t:global.product_list.stack_products",
      "default": false
    },

    {
      "type": "select",
      "id": "products_per_row_mobile",
      "label": "t:global.product_list.products_per_row_mobile",

      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],

      "default": "2",

      "visible_if": "{{ section.settings.stack_products }}"
    },

    {
      "type": "range",
      "id": "products_per_row_desktop",
      "min": 2,
      "max": 6,
      "label": "t:global.product_list.products_per_row_desktop",
      "info": "t:global.product_list.products_per_row_desktop_info",
      "default": 4,

      "visible_if": "{{ section.settings.stack_products }}"
    },

    {
      "type": "header",
      "content": "t:global.product_list.spacing_category",
      "info": "t:global.product_list.spacing_category_info"
    },

    {
      "type": "range",
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "id": "horizontal_spacing_factor",
      "label": "Horizontal spacing factor",
      "default": 1
    },

    {
      "type": "range",
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "id": "vertical_spacing_factor",
      "label": "Vertical spacing factor",
      "default": 1
    },

    {
      "type": "header",
      "content": "t:global.section.header_category"
    },

    {
      "type": "checkbox",
      "id": "hide_collection_title",
      "label": "t:sections.featured_collections.hide_collection_title",
      "info": "t:sections.featured_collections.hide_collection_title_info",
      "default": false
    }

  ],

  "blocks": [

    {
      "type": "collection",

      "name": "t:sections.featured_collections.blocks.collection.name",

      "settings": [

        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.featured_collections.blocks.collection.collection"
        },

        {
          "type": "range",
          "id": "products_count",
          "min": 2,
          "max": 50,
          "label": "t:global.product_list.products_to_show",
          "default": 8
        },

        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:global.text.heading",
          "info": "t:sections.featured_collections.blocks.collection.title_info"
        },

        {
          "type": "url",
          "id": "link_url",
          "label": "t:global.text.link_url",
          "info": "t:sections.featured_collections.blocks.collection.default_link_url"
        },

        {
          "type": "text",
          "id": "link_text",
          "label": "t:global.text.link_text",
          "default": "View all"
        }

      ]

    }

  ],

  "presets": [

    {
      "name": "t:sections.featured_collections.presets.featured_collections.name",

      "category": "t:global.categories.collections",

      "blocks": [
        {
          "type": "collection"
        }
      ]

    }

  ]

}

{% endschema %}