<product-recommendations
  class="block forma-related-recommendations"
  product="{{ product.id }}"
  limit="{{ section.settings.recommendations_count }}"
  intent="related"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <style>
      #shopify-section-{{ section.id }} {
        --forma-related-gap: 5px;
        --forma-related-card-width: 355px;
        background: #fff;
        color: #111;
      }
      #shopify-section-{{ section.id }} .forma-related-inner {
        padding: 1.25rem 0 1.5rem;
      }
      #shopify-section-{{ section.id }} .forma-related-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        width: 100%;
        margin: 0 0 1rem !important;
        padding: 0 10px 12px !important;
        border-bottom: 1px solid rgba(17,17,17,.12);
      }
      #shopify-section-{{ section.id }} .forma-related-eyebrow {
        margin: 0 0 8px;
        color: #777;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 9px;
        line-height: 1.4;
        letter-spacing: .15em;
        text-transform: uppercase;
      }
      #shopify-section-{{ section.id }} .forma-related-title {
        margin: 0 !important;
        padding: 0 !important;
        color: #111 !important;
        font-family: inherit !important;
        font-size: clamp(22px, 2.1vw, 30px) !important;
        font-weight: 400 !important;
        line-height: 1 !important;
        letter-spacing: -.055em !important;
        text-transform: uppercase;
      }
      #shopify-section-{{ section.id }} .forma-related-carousel {
        position: relative;
        display: block;
        width: 100%;
        overflow: hidden;
      }
      #shopify-section-{{ section.id }} .forma-related-product-list {
        display: grid !important;
        grid-auto-flow: column !important;
        grid-auto-columns: var(--forma-related-card-width) !important;
        gap: var(--forma-related-gap) !important;
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        padding: 0 10px 8px !important;
        overflow-x: auto !important;
        scrollbar-width: none;
      }
      #shopify-section-{{ section.id }} .forma-related-product-list::-webkit-scrollbar { display: none; }
      #shopify-section-{{ section.id }} .forma-related-product-list > * {
        width: var(--forma-related-card-width) !important;
        min-width: var(--forma-related-card-width) !important;
        max-width: var(--forma-related-card-width) !important;
        margin: 0 !important;
      }
      /* Match The Forma Edit card proportions while retaining the original shared product-card snippet. */
      #shopify-section-{{ section.id }} .forma-related-product-list .product-card__figure {
        width: 100% !important;
        aspect-ratio: 4 / 5 !important;
        overflow: hidden !important;
        background: #f5f5f5 !important;
        border-radius: 0 !important;
      }
      #shopify-section-{{ section.id }} .forma-related-product-list .product-card__figure img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        transition: transform .45s cubic-bezier(.22,.61,.36,1);
      }
      #shopify-section-{{ section.id }} .forma-related-product-list product-card:hover .product-card__figure img { transform: scale(1.025); }
      #shopify-section-{{ section.id }} .forma-related-product-list .product-card__info {
        display: block !important;
        width: 100% !important;
        height: auto !important;
        min-height: 0 !important;
        margin: 0 !important;
        padding: 11px 0 0 !important;
        opacity: 1 !important;
        visibility: visible !important;
        text-align: left !important;
      }
      #shopify-section-{{ section.id }} .forma-related-product-list .product-card__info > .v-stack {
        display: grid !important;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: start;
        column-gap: 12px;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
      }
      #shopify-section-{{ section.id }} .forma-related-product-list .product-card__info > .v-stack > :first-child {
        grid-column: 2;
        grid-row: 1;
        justify-self: end;
        margin: 1px 0 0 !important;
        padding: 0 !important;
        color: #777 !important;
        font-family: Arial, Helvetica, sans-serif !important;
        font-size: 9px !important;
        font-weight: 400 !important;
        line-height: 1.2 !important;
        letter-spacing: .08em !important;
        text-align: right !important;
        text-transform: uppercase !important;
      }
      #shopify-section-{{ section.id }} .forma-related-product-list .product-card__info > .v-stack > :last-child {
        grid-column: 1;
        grid-row: 1;
        display: flex !important;
        flex-direction: column !important;
        align-items: flex-start !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        text-align: left !important;
      }
      #shopify-section-{{ section.id }} .forma-related-product-list .product-card__info .product-title {
        display: block !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        color: #111 !important;
        font-family: Georgia, 'Times New Roman', serif !important;
        font-size: 12px !important;
        font-weight: 300 !important;
        line-height: 1.25 !important;
        letter-spacing: 0 !important;
        text-align: left !important;
      }
      #shopify-section-{{ section.id }} .forma-related-product-list .product-card__info .price-list {
        display: flex !important;
        justify-content: flex-start !important;
        align-items: flex-start !important;
        width: 100% !important;
        margin: 3px 0 0 !important;
        padding: 0 !important;
        color: #555 !important;
        font-family: Arial, Helvetica, sans-serif !important;
        font-size: 11px !important;
        font-weight: 400 !important;
        line-height: 1.2 !important;
        text-align: left !important;
      }
      #shopify-section-{{ section.id }} .forma-related-carousel .floating-controls-container__control {
        position: absolute;
        top: 40%;
        z-index: 10;
        opacity: 0;
        transition: opacity .2s ease;
      }
      #shopify-section-{{ section.id }} .forma-related-carousel:hover .floating-controls-container__control { opacity: 1; }
      #shopify-section-{{ section.id }} .forma-related-carousel .floating-controls-container__control:first-child { left: 15px; }
      #shopify-section-{{ section.id }} .forma-related-carousel .floating-controls-container__control:last-child { right: 15px; }
      #shopify-section-{{ section.id }} .forma-related-carousel .prev-next-button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        min-width: 32px;
        min-height: 32px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: rgba(255,255,255,.9) !important;
        box-shadow: none !important;
        color: #111 !important;
      }
      #shopify-section-{{ section.id }} .forma-related-carousel .prev-next-button svg { width: 12px; height: 12px; }
      @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} .forma-related-inner { padding: 1.25rem 0 1.5rem; }
        #shopify-section-{{ section.id }} .forma-related-product-list { padding-left: 10px !important; padding-right: 10px !important; }
      }
      @media screen and (max-width: 699px) {
        #shopify-section-{{ section.id }} { --forma-related-card-width: 78vw; --forma-related-gap: 12px; }
        #shopify-section-{{ section.id }} .forma-related-inner { padding: 1rem 0 1.5rem; }
        #shopify-section-{{ section.id }} .forma-related-header { margin-bottom: .8rem !important; padding: 0 6px 10px !important; }
        #shopify-section-{{ section.id }} .forma-related-title { font-size: 16px !important; }
        #shopify-section-{{ section.id }} .forma-related-product-list { padding-left: 6px !important; padding-right: 6px !important; }
        #shopify-section-{{ section.id }} .forma-related-carousel .floating-controls-container__control { top: 38%; opacity: 1; }
        #shopify-section-{{ section.id }} .forma-related-carousel .floating-controls-container__control:first-child { left: 7px; }
        #shopify-section-{{ section.id }} .forma-related-carousel .floating-controls-container__control:last-child { right: 7px; }
        #shopify-section-{{ section.id }} .forma-related-carousel .prev-next-button { width: 30px; height: 30px; min-width: 30px; min-height: 30px; }
        #shopify-section-{{ section.id }} .forma-related-product-list .product-card__info .product-title { font-size: 13px !important; }
        #shopify-section-{{ section.id }} .forma-related-product-list .product-card__info > .v-stack > :first-child { font-size: 8px !important; }
      }
    </style>

    {%- assign carousel_id = 'forma-related-products-' | append: section.id -%}
    <section class="forma-related-inner">
      <div class="forma-related-header">
        <div>
          <p class="forma-related-eyebrow">{{ section.settings.subheading | default: 'The Forma Edit' }}</p>
          <h2 class="forma-related-title">{{ section.settings.title | default: 'Complete your Forma' }}</h2>
        </div>
      </div>

      <product-list class="floating-controls-container floating-controls-container--inside forma-related-carousel">
        <carousel-prev-button class="floating-controls-container__control" aria-controls="{{ carousel_id }}">
          <button type="button" class="prev-next-button prev-next-button--prev circle-button" disabled>
            <span class="sr-only">{{ 'general.accessibility.previous' | t }}</span>
            {%- render 'icon', with: 'arrow-left', direction_aware: true -%}
          </button>
        </carousel-prev-button>

        <scroll-carousel
          id="{{ carousel_id }}"
          group-cells
          allow-drag
          class="product-list product-list--carousel scroll-area bleed md:unbleed forma-related-product-list"
        >
          {%- for product in recommendations.products -%}
            {%- render 'product-card',
              product: product,
              reveal: settings.stagger_products_apparition,
              position: forloop.index,
              hide_product_information: false
            -%}
          {%- endfor -%}
        </scroll-carousel>

        <carousel-next-button class="floating-controls-container__control" aria-controls="{{ carousel_id }}">
          <button type="button" class="prev-next-button prev-next-button--next circle-button">
            <span class="sr-only">{{ 'general.accessibility.next' | t }}</span>
            {%- render 'icon', with: 'arrow-right', direction_aware: true -%}
          </button>
        </carousel-next-button>
      </product-list>
    </section>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "t:sections.related_products.name",
  "enabled_on": { "templates": ["product"] },
  "class": "shopify-section--related-products",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "t:sections.related_products.info" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:global.colors.scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "separate_section_with_border", "label": "t:global.section.separate_section_with_border", "default": true },
    { "type": "checkbox", "id": "hide_product_information", "label": "t:global.product_list.hide_product_information", "info": "t:global.product_list.hide_product_information_info" },
    { "type": "header", "content": "t:global.product_list.product_list_category" },
    { "type": "checkbox", "id": "stack_products", "label": "t:global.product_list.stack_products", "default": false },
    { "type": "range", "id": "recommendations_count", "min": 2, "max": 10, "label": "t:sections.related_products.recommendations_count", "default": 10 },
    {
      "type": "select", "id": "products_per_row_mobile", "label": "t:global.product_list.products_per_row_mobile",
      "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }],
      "default": "2", "visible_if": "{{ section.settings.stack_products }}"
    },
    {
      "type": "range", "id": "products_per_row_desktop", "min": 2, "max": 6,
      "label": "t:global.product_list.products_per_row_desktop", "default": 4,
      "visible_if": "{{ section.settings.stack_products }}"
    },
    { "type": "header", "content": "t:global.product_list.spacing_category", "info": "t:global.product_list.spacing_category_info" },
    { "type": "range", "min": 0.2, "max": 2, "step": 0.1, "id": "horizontal_spacing_factor", "label": "t:global.product_list.horizontal_spacing_factor", "default": 1 },
    { "type": "range", "min": 0.2, "max": 2, "step": 0.1, "id": "vertical_spacing_factor", "label": "t:global.product_list.vertical_spacing_factor", "default": 1 },
    { "type": "header", "content": "t:global.section.header_category" },
    { "type": "inline_richtext", "id": "subheading", "label": "t:global.text.subheading", "default": "The Forma Edit" },
    { "type": "inline_richtext", "id": "title", "label": "t:global.text.heading", "default": "Complete your Forma" }
  ],
  "presets": [
    { "name": "t:sections.related_products.presets.related_products.name", "category": "t:global.categories.products" }
  ]
}
{% endschema %}

