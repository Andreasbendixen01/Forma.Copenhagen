<product-recommendations
  class="block forma-related-section"
  product="{{ product.id }}"
  limit="{{ section.settings.recommendations_count }}"
  intent="related"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <style>
      #shopify-section-{{ section.id }} {
        --product-list-items-per-row: {{ section.settings.products_per_row_mobile | times: 1 }};
        --product-list-horizontal-spacing-factor: {{ section.settings.horizontal_spacing_factor }};
        --product-list-vertical-spacing-factor: {{ section.settings.vertical_spacing_factor }};
      }

      @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} {
          --product-list-items-per-row: {{ section.settings.products_per_row_desktop }};
        }
      }

      /*
        FORMA RELATED PRODUCTS
        Important: product-card markup and styling are intentionally left to
        Prestige's existing shared product-card snippet, just like The Forma Edit.
      */
      #shopify-section-{{ section.id }} {
        background: #f5f4f0;
        color: #171715;
      }

      #shopify-section-{{ section.id }} .forma-related-section__inner {
        padding-block: clamp(48px, 6vw, 88px);
      }

      #shopify-section-{{ section.id }} .forma-related-section__container {
        width: min(100% - 64px, 1600px);
        margin-inline: auto;
      }

      #shopify-section-{{ section.id }} .forma-related-section__header {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 32px;
        margin-bottom: clamp(26px, 3.5vw, 48px);
        padding-bottom: 22px;
        border-bottom: 1px solid rgba(23, 23, 21, .14);
      }

      #shopify-section-{{ section.id }} .forma-related-section__heading-wrap {
        min-width: 0;
      }

      #shopify-section-{{ section.id }} .forma-related-section__eyebrow {
        margin: 0 0 13px;
        color: #777772;
        font-size: 10px;
        line-height: 1.4;
        letter-spacing: .19em;
        text-transform: uppercase;
      }

      #shopify-section-{{ section.id }} .forma-related-section__heading {
        margin: 0;
        color: #171715;
        font-size: clamp(30px, 4.2vw, 64px);
        line-height: .98;
        letter-spacing: -.055em;
        font-weight: 400;
        text-transform: uppercase;
      }

      #shopify-section-{{ section.id }} .forma-related-section__intro {
        max-width: 300px;
        margin: 0 0 3px;
        color: #777772;
        font-size: 11px;
        line-height: 1.65;
        letter-spacing: .025em;
        text-align: right;
      }

      #shopify-section-{{ section.id }} .forma-related-section__intro p {
        margin: 0;
      }

      #shopify-section-{{ section.id }} .forma-related-section__carousel {
        position: relative;
      }

      /* Only style the carousel controls ‚Äî never the product cards/images. */
      #shopify-section-{{ section.id }} .forma-related-section__carousel .prev-next-button {
        border: 1px solid rgba(23, 23, 21, .18);
        background: rgba(245, 244, 240, .96);
        color: #171715;
        box-shadow: none;
      }

      #shopify-section-{{ section.id }} .forma-related-section__carousel .prev-next-button:hover {
        background: #171715;
        color: #fff;
      }

      @media screen and (max-width: 999px) {
        #shopify-section-{{ section.id }} .forma-related-section__container {
          width: min(100% - 36px, 1600px);
        }

        #shopify-section-{{ section.id }} .forma-related-section__header {
          align-items: start;
        }

        #shopify-section-{{ section.id }} .forma-related-section__intro {
          max-width: 220px;
          font-size: 10px;
        }
      }

      @media screen and (max-width: 699px) {
        #shopify-section-{{ section.id }} .forma-related-section__inner {
          padding-block: 42px 52px;
        }

        #shopify-section-{{ section.id }} .forma-related-section__container {
          width: calc(100% - 32px);
        }

        #shopify-section-{{ section.id }} .forma-related-section__header {
          display: block;
          margin-bottom: 24px;
          padding-bottom: 18px;
        }

        #shopify-section-{{ section.id }} .forma-related-section__eyebrow {
          margin-bottom: 10px;
          font-size: 9px;
        }

        #shopify-section-{{ section.id }} .forma-related-section__heading {
          font-size: clamp(29px, 9vw, 42px);
          line-height: 1;
        }

        #shopify-section-{{ section.id }} .forma-related-section__intro {
          max-width: 300px;
          margin-top: 14px;
          text-align: left;
          font-size: 10px;
        }
      }
    </style>

    {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

    <section class="forma-related-section__inner color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
      <div class="forma-related-section__container">
        <header class="forma-related-section__header">
          <div class="forma-related-section__heading-wrap">
            {%- if section.settings.subheading != blank -%}
              <p class="forma-related-section__eyebrow">{{ section.settings.subheading }}</p>
            {%- else -%}
              <p class="forma-related-section__eyebrow">THE FORMA EDIT</p>
            {%- endif -%}

            {%- if section.settings.title != blank -%}
              <h2 class="forma-related-section__heading">{{ section.settings.title }}</h2>
            {%- else -%}
              <h2 class="forma-related-section__heading">Complete your Forma</h2>
            {%- endif -%}
          </div>

          {%- if section.settings.content != blank -%}
            <div class="forma-related-section__intro">{{ section.settings.content }}</div>
          {%- else -%}
            <p class="forma-related-section__intro">Considered pieces. New perspectives. Your next favourite find.</p>
          {%- endif -%}
        </header>

        {%- capture product_list -%}
          {%- for product in recommendations.products -%}
            {%- render 'product-card',
              product: product,
              reveal: settings.stagger_products_apparition,
              position: forloop.index,
              hide_product_information: section.settings.hide_product_information
            -%}
          {%- endfor -%}
        {%- endcapture -%}

        <div class="forma-related-section__carousel">
          {%- if section.settings.stack_products -%}
            <product-list class="product-list {% if section.settings.hide_product_information %}product-list--compact{% endif %} justify-center">
              {{- product_list -}}
            </product-list>
          {%- else -%}
            {%- assign carousel_id = 'carousel-' | append: section.id -%}

            <product-list class="floating-controls-container floating-controls-container--inside floating-controls-container--on-hover">
              <carousel-prev-button class="floating-controls-container__control" aria-controls="{{ carousel_id }}">
                <button type="button" class="prev-next-button prev-next-button--prev circle-button hover:animate-icon-inline" disabled>
                  <span class="sr-only">{{ 'general.accessibility.previous' | t }}</span>
                  {%- render 'icon' with 'arrow-left', direction_aware: true -%}
                </button>
              </carousel-prev-button>

              <scroll-carousel
                id="{{ carousel_id }}"
                group-cells
                allow-drag
                class="product-list {% if section.settings.hide_product_information %}product-list--compact{% endif %} product-list--carousel scroll-area bleed md:unbleed"
              >
                {{- product_list -}}
              </scroll-carousel>

              <carousel-next-button class="floating-controls-container__control" aria-controls="{{ carousel_id }}">
                <button type="button" class="prev-next-button prev-next-button--next circle-button hover:animate-icon-inline">
                  <span class="sr-only">{{ 'general.accessibility.next' | t }}</span>
                  {%- render 'icon' with 'arrow-right', direction_aware: true -%}
                </button>
              </carousel-next-button>
            </product-list>
          {%- endif -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "t:sections.related_products.name",
  "enabled_on": {
    "templates": ["product"]
  },
  "class": "shopify-section--related-products",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.related_products.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_product_information",
      "label": "t:global.product_list.hide_product_information",
      "info": "t:global.product_list.hide_product_information_info"
    },
    {
      "type": "header",
      "content": "t:global.product_list.product_list_category"
    },
    {
      "type": "checkbox",
      "id": "stack_products",
      "label": "t:global.product_list.stack_products",
      "default": false
    },
    {
      "type": "range",
      "id": "recommendations_count",
      "min": 2,
      "max": 10,
      "label": "t:sections.related_products.recommendations_count",
      "default": 10
    },
    {
      "type": "select",
      "id": "products_per_row_mobile",
      "label": "t:global.product_list.products_per_row_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.stack_products }}"
    },
    {
      "type": "range",
      "id": "products_per_row_desktop",
      "min": 2,
      "max": 6,
      "label": "t:global.product_list.products_per_row_desktop",
      "default": 4,
      "visible_if": "{{ section.settings.stack_products }}"
    },
    {
      "type": "header",
      "content": "t:global.product_list.spacing_category",
      "info": "t:global.product_list.spacing_category_info"
    },
    {
      "type": "range",
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "id": "horizontal_spacing_factor",
      "label": "t:global.product_list.horizontal_spacing_factor",
      "default": 1
    },
    {
      "type": "range",
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "id": "vertical_spacing_factor",
      "label": "t:global.product_list.vertical_spacing_factor",
      "default": 1
    },
    {
      "type": "header",
      "content": "t:global.section.header_category"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading",
      "default": "The Forma Edit"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Complete your Forma"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content",
      "default": "<p>Considered pieces. New perspectives. Your next favourite find.</p>"
    }
  ],
  "presets": [
    {
      "name": "t:sections.related_products.presets.related_products.name",
      "category": "t:global.categories.products"
    }
  ]
}
{% endschema %}

