<product-recommendations
  class="block forma-related-recommendations"
  product="{{ product.id }}"
  limit="{{ section.settings.recommendations_count }}"
  intent="related"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <style>
      #shopify-section-{{ section.id }} {
        --product-list-items-per-row: {{ section.settings.products_per_row_mobile | times: 1 }};
        --product-list-horizontal-spacing-factor: {{ section.settings.horizontal_spacing_factor }};
        --product-list-vertical-spacing-factor: {{ section.settings.vertical_spacing_factor }};
        background: #fff;
        color: #111;
      }

      @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} {
          --product-list-items-per-row: {{ section.settings.products_per_row_desktop }};
        }
      }

      #shopify-section-{{ section.id }} .forma-related-inner {
        padding-block: clamp(34px, 4vw, 58px);
      }

      #shopify-section-{{ section.id }} .forma-related-container {
        width: 100%;
        max-width: none;
        margin: 0;
      }

      #shopify-section-{{ section.id }} .forma-edit-section-header {
        width: 100%;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin: 0 0 18px !important;
        padding: 0 10px 16px !important;
        border-bottom: 1px solid rgba(17,17,17,.12);
        text-align: left;
      }

      #shopify-section-{{ section.id }} .forma-edit-section-header__content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        min-width: 0;
      }

      #shopify-section-{{ section.id }} .forma-edit-section-header__eyebrow {
        margin: 0 0 10px;
        font-size: 10px;
        line-height: 1.4;
        letter-spacing: .19em;
        text-transform: uppercase;
        color: #777772;
      }

      #shopify-section-{{ section.id }} .forma-edit-section-header__title {
        display: block !important;
        margin: 0 !important;
        padding: 0 !important;
        font-family: inherit !important;
        font-size: clamp(30px, 4vw, 60px) !important;
        font-weight: 400 !important;
        line-height: .98 !important;
        letter-spacing: -.055em !important;
        text-transform: uppercase;
        color: #111 !important;
      }

      #shopify-section-{{ section.id }} .forma-related-intro {
        max-width: 300px;
        margin: 0 0 2px;
        color: #777772;
        font-size: 11px;
        line-height: 1.65;
        text-align: right;
      }

      #shopify-section-{{ section.id }} .forma-related-intro p {
        margin: 0;
      }

      #shopify-section-{{ section.id }} .forma-edit-row,
      #shopify-section-{{ section.id }} .forma-edit-products {
        display: block;
        width: 100%;
        min-width: 0;
        margin: 0 !important;
        padding: 0 !important;
      }

      #shopify-section-{{ section.id }} .forma-product-carousel {
        position: relative;
        width: 100%;
        min-width: 0;
        overflow: hidden;
      }

      #shopify-section-{{ section.id }} .forma-product-carousel .product-list {
        display: grid !important;
        grid-auto-flow: column !important;
        gap: 5px !important;
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        padding: 0 5px 8px !important;
        overflow-x: auto !important;
        scrollbar-width: none;
      }

      #shopify-section-{{ section.id }} .forma-product-carousel .product-list::-webkit-scrollbar {
        display: none;
      }

      /* Match The Forma Edit product-card image proportions and image fit */
      #shopify-section-{{ section.id }} .forma-product-carousel .product-card {
        min-width: 0 !important;
        width: 100% !important;
      }

      #shopify-section-{{ section.id }} .forma-product-carousel .product-card__figure {
        width: 100% !important;
        height: auto !important;
        min-height: 0 !important;
        aspect-ratio: 4 / 5 !important;
        overflow: hidden !important;
      }

      #shopify-section-{{ section.id }} .forma-product-carousel .product-card__figure img {
        display: block !important;
        width: 100% !important;
        height: 100% !important;
        max-width: 100% !important;
        max-height: 100% !important;
        object-fit: contain !important;
        object-position: center center !important;
      }

      #shopify-section-{{ section.id }} .forma-product-carousel .product-card__info,
      #shopify-section-{{ section.id }} .forma-product-carousel .product-card__info-wrapper {
        text-align: left !important;
        padding-top: 10px !important;
      }

      #shopify-section-{{ section.id }} .forma-product-carousel .floating-controls-container__control {
        position: absolute;
        top: 40%;
        transform: translateY(-50%);
        z-index: 5;
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto;
      }

      #shopify-section-{{ section.id }} .forma-product-carousel .floating-controls-container__control:first-child {
        left: 5px;
      }

      #shopify-section-{{ section.id }} .forma-product-carousel .floating-controls-container__control:last-child {
        right: 5px;
      }

      #shopify-section-{{ section.id }} .forma-product-carousel .prev-next-button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        min-width: 32px;
        min-height: 32px;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent !important;
        box-shadow: none !important;
        color: #111 !important;
      }

      #shopify-section-{{ section.id }} .forma-product-carousel .prev-next-button svg {
        width: 14px;
        height: 14px;
        stroke-width: 1.4;
      }

      #shopify-section-{{ section.id }} .forma-product-carousel .prev-next-button:disabled {
        opacity: .25;
        pointer-events: none;
      }

      @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} .forma-product-carousel .product-list {
          grid-auto-columns: calc((100% - 15px) / 4) !important;
        }
      }

      @media screen and (max-width: 999px) {
        #shopify-section-{{ section.id }} .forma-related-intro {
          max-width: 220px;
          font-size: 10px;
        }
      }

      @media screen and (max-width: 699px) {
        #shopify-section-{{ section.id }} .forma-related-inner {
          padding-block: 30px 38px;
        }

        #shopify-section-{{ section.id }} .forma-edit-section-header {
          display: block;
          margin-bottom: 14px !important;
          padding: 0 5px 12px !important;
        }

        #shopify-section-{{ section.id }} .forma-edit-section-header__eyebrow {
          margin-bottom: 8px;
          font-size: 9px;
        }

        #shopify-section-{{ section.id }} .forma-edit-section-header__title {
          font-size: clamp(28px, 8vw, 40px) !important;
          line-height: 1 !important;
        }

        #shopify-section-{{ section.id }} .forma-related-intro {
          margin-top: 10px;
          max-width: 300px;
          text-align: left;
        }

        #shopify-section-{{ section.id }} .forma-product-carousel .product-list {
          grid-auto-columns: 78% !important;
        }

        #shopify-section-{{ section.id }} .forma-product-carousel .floating-controls-container__control {
          top: 38%;
        }

        #shopify-section-{{ section.id }} .forma-product-carousel .prev-next-button {
          width: 28px;
          height: 28px;
          min-width: 28px;
          min-height: 28px;
        }

        #shopify-section-{{ section.id }} .forma-product-carousel .prev-next-button svg {
          width: 12px;
          height: 12px;
        }
      }
    </style>

    {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}
    {%- assign carousel_id = 'forma-related-carousel-' | append: section.id -%}

    <section class="forma-related-inner color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
      <div class="forma-related-container">
        <header class="forma-edit-section-header">
          <div class="forma-edit-section-header__content">
            <p class="forma-edit-section-header__eyebrow">{{ section.settings.subheading | default: 'The Forma Edit' }}</p>
            <h2 class="forma-edit-section-header__title">{{ section.settings.title | default: 'Complete your Forma' }}</h2>
          </div>
          <div class="forma-related-intro">
            {%- if section.settings.content != blank -%}
              {{ section.settings.content }}
            {%- else -%}
              <p>Considered pieces. New perspectives. Your next favourite find.</p>
            {%- endif -%}
          </div>
        </header>

        <div class="forma-edit-row">
          <div class="forma-edit-products">
            <product-list class="floating-controls-container floating-controls-container--inside forma-product-carousel">
              <carousel-prev-button class="floating-controls-container__control" aria-controls="{{ carousel_id }}">
                <button type="button" class="prev-next-button prev-next-button--prev circle-button hover:animate-icon-inline" disabled>
                  <span class="sr-only">{{ 'general.accessibility.previous' | t }}</span>
                  {%- render 'icon' with 'arrow-left', direction_aware: true -%}
                </button>
              </carousel-prev-button>

              <scroll-carousel
                id="{{ carousel_id }}"
                group-cells
                allow-drag
                class="product-list {% if section.settings.hide_product_information %}product-list--compact{% endif %} product-list--carousel scroll-area bleed md:unbleed"
              >
                {%- for product in recommendations.products -%}
                  {%- render 'product-card',
                    product: product,
                    reveal: settings.stagger_products_apparition,
                    position: forloop.index,
                    hide_product_information: section.settings.hide_product_information
                  -%}
                {%- endfor -%}
              </scroll-carousel>

              <carousel-next-button class="floating-controls-container__control" aria-controls="{{ carousel_id }}">
                <button type="button" class="prev-next-button prev-next-button--next circle-button hover:animate-icon-inline">
                  <span class="sr-only">{{ 'general.accessibility.next' | t }}</span>
                  {%- render 'icon' with 'arrow-right', direction_aware: true -%}
                </button>
              </carousel-next-button>
            </product-list>
          </div>
        </div>
      </div>
    </section>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "t:sections.related_products.name",
  "enabled_on": { "templates": ["product"] },
  "class": "shopify-section--related-products",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "t:sections.related_products.info" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:global.colors.scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "separate_section_with_border", "label": "t:global.section.separate_section_with_border", "default": true },
    { "type": "checkbox", "id": "hide_product_information", "label": "t:global.product_list.hide_product_information", "info": "t:global.product_list.hide_product_information_info" },
    { "type": "header", "content": "t:global.product_list.product_list_category" },
    { "type": "checkbox", "id": "stack_products", "label": "t:global.product_list.stack_products", "default": false },
    { "type": "range", "id": "recommendations_count", "min": 2, "max": 10, "label": "t:sections.related_products.recommendations_count", "default": 10 },
    {
      "type": "select", "id": "products_per_row_mobile", "label": "t:global.product_list.products_per_row_mobile",
      "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }],
      "default": "2", "visible_if": "{{ section.settings.stack_products }}"
    },
    {
      "type": "range", "id": "products_per_row_desktop", "min": 2, "max": 6,
      "label": "t:global.product_list.products_per_row_desktop", "default": 4,
      "visible_if": "{{ section.settings.stack_products }}"
    },
    { "type": "header", "content": "t:global.product_list.spacing_category", "info": "t:global.product_list.spacing_category_info" },
    { "type": "range", "min": 0.2, "max": 2, "step": 0.1, "id": "horizontal_spacing_factor", "label": "t:global.product_list.horizontal_spacing_factor", "default": 1 },
    { "type": "range", "min": 0.2, "max": 2, "step": 0.1, "id": "vertical_spacing_factor", "label": "t:global.product_list.vertical_spacing_factor", "default": 1 },
    { "type": "header", "content": "t:global.section.header_category" },
    { "type": "inline_richtext", "id": "subheading", "label": "t:global.text.subheading", "default": "The Forma Edit" },
    { "type": "inline_richtext", "id": "title", "label": "t:global.text.heading", "default": "Complete your Forma" },
    { "type": "richtext", "id": "content", "label": "t:global.text.content", "default": "<p>Considered pieces. New perspectives. Your next favourite find.</p>" }
  ],
  "presets": [
    { "name": "t:sections.related_products.presets.related_products.name", "category": "t:global.categories.products" }
  ]
}
{% endschema %}

