<product-recommendations
  class="block forma-related"
  product="{{ product.id }}"
  limit="{{ section.settings.recommendations_count }}"
  intent="related"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <style>
      #shopify-section-{{ section.id }} {
        --product-list-items-per-row: {{ section.settings.products_per_row_mobile | times: 1 }};
        --product-list-horizontal-spacing-factor: {{ section.settings.horizontal_spacing_factor }};
        --product-list-vertical-spacing-factor: {{ section.settings.vertical_spacing_factor }};
      }

      @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} {
          --product-list-items-per-row: {{ section.settings.products_per_row_desktop }};
        }
      }

      /* FORMA ‚Äî related product editorial section */
      #shopify-section-{{ section.id }} {
        --forma-related-ink: #171715;
        --forma-related-muted: #777772;
        --forma-related-line: rgba(23, 23, 21, .14);
        background: #f5f4f0;
      }

      #shopify-section-{{ section.id }} .forma-related__section {
        padding-block: clamp(52px, 7vw, 104px);
        overflow: hidden;
      }

      #shopify-section-{{ section.id }} .forma-related__container {
        width: min(100% - 64px, 1600px);
        margin-inline: auto;
      }

      #shopify-section-{{ section.id }} .forma-related__header {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 32px;
        margin-bottom: clamp(28px, 4vw, 54px);
        padding-bottom: 22px;
        border-bottom: 1px solid var(--forma-related-line);
      }

      #shopify-section-{{ section.id }} .forma-related__heading-wrap {
        max-width: 820px;
      }

      #shopify-section-{{ section.id }} .forma-related__eyebrow {
        display: block;
        margin: 0 0 14px;
        color: var(--forma-related-muted);
        font-size: 10px;
        line-height: 1.4;
        letter-spacing: .19em;
        text-transform: uppercase;
      }

      #shopify-section-{{ section.id }} .forma-related__heading {
        margin: 0;
        color: var(--forma-related-ink);
        font-size: clamp(30px, 4.4vw, 66px);
        line-height: .98;
        letter-spacing: -.055em;
        font-weight: 400;
        text-transform: uppercase;
      }

      #shopify-section-{{ section.id }} .forma-related__intro {
        max-width: 300px;
        margin: 0 0 3px;
        color: var(--forma-related-muted);
        font-size: 11px;
        line-height: 1.65;
        letter-spacing: .045em;
        text-align: right;
      }

      #shopify-section-{{ section.id }} .forma-related__intro p {
        margin: 0;
      }

      #shopify-section-{{ section.id }} .forma-related__list-shell {
        position: relative;
      }

      #shopify-section-{{ section.id }} .forma-related product-list {
        display: block;
        position: relative;
      }

      #shopify-section-{{ section.id }} .forma-related scroll-carousel.product-list {
        display: flex;
        gap: clamp(12px, 1.5vw, 24px);
        padding: 0 0 10px;
        scroll-padding-inline: 0;
        scrollbar-width: none;
      }

      #shopify-section-{{ section.id }} .forma-related scroll-carousel.product-list::-webkit-scrollbar {
        display: none;
      }

      #shopify-section-{{ section.id }} .forma-related scroll-carousel.product-list > * {
        flex: 0 0 calc((100% - (3 * clamp(12px, 1.5vw, 24px))) / 4);
        min-width: 0;
      }

      #shopify-section-{{ section.id }} .forma-related .product-list:not(scroll-carousel) {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: clamp(12px, 1.5vw, 24px);
      }

      /* Keep the product photography clean and consistent */
      #shopify-section-{{ section.id }} .forma-related .product-card {
        min-width: 0;
      }

      #shopify-section-{{ section.id }} .forma-related .product-card__figure,
      #shopify-section-{{ section.id }} .forma-related .product-card__image {
        background: #eeede8;
      }

      #shopify-section-{{ section.id }} .forma-related .product-card__figure {
        overflow: hidden;
      }

      #shopify-section-{{ section.id }} .forma-related .product-card img {
        transition: transform .55s cubic-bezier(.2, .65, .3, 1);
      }

      @media (hover: hover) {
        #shopify-section-{{ section.id }} .forma-related .product-card:hover img {
          transform: scale(1.035);
        }
      }

      #shopify-section-{{ section.id }} .forma-related .product-card__info,
      #shopify-section-{{ section.id }} .forma-related .product-card__details {
        padding-top: 15px;
      }

      #shopify-section-{{ section.id }} .forma-related .product-card__vendor,
      #shopify-section-{{ section.id }} .forma-related .vendor {
        color: var(--forma-related-muted);
        font-size: 9px;
        line-height: 1.4;
        letter-spacing: .14em;
        text-transform: uppercase;
      }

      #shopify-section-{{ section.id }} .forma-related .product-card__title,
      #shopify-section-{{ section.id }} .forma-related .product-card__title a {
        color: var(--forma-related-ink);
        font-size: 11px;
        line-height: 1.5;
        letter-spacing: .035em;
        text-decoration: none;
      }

      #shopify-section-{{ section.id }} .forma-related .price {
        margin-top: 5px;
        color: var(--forma-related-muted);
        font-size: 11px;
      }

      #shopify-section-{{ section.id }} .forma-related .floating-controls-container__control {
        top: 38%;
        z-index: 3;
      }

      #shopify-section-{{ section.id }} .forma-related .prev-next-button {
        width: 42px;
        height: 42px;
        border: 1px solid rgba(23, 23, 21, .18);
        background: rgba(245, 244, 240, .94);
        color: var(--forma-related-ink);
        box-shadow: none;
        opacity: 0;
        transition: opacity .2s ease, background .2s ease;
      }

      #shopify-section-{{ section.id }} .forma-related .prev-next-button:disabled {
        opacity: 0 !important;
      }

      @media (hover: hover) {
        #shopify-section-{{ section.id }} .forma-related__list-shell:hover .prev-next-button:not(:disabled) {
          opacity: 1;
        }
      }

      #shopify-section-{{ section.id }} .forma-related .prev-next-button:not(:disabled) {
        opacity: 1;
      }

      #shopify-section-{{ section.id }} .forma-related .prev-next-button:hover {
        background: #171715;
        color: #fff;
      }

      @media screen and (max-width: 999px) {
        #shopify-section-{{ section.id }} .forma-related__container {
          width: min(100% - 36px, 1600px);
        }

        #shopify-section-{{ section.id }} .forma-related__header {
          align-items: start;
        }

        #shopify-section-{{ section.id }} .forma-related__intro {
          max-width: 220px;
          font-size: 10px;
        }

        #shopify-section-{{ section.id }} .forma-related scroll-carousel.product-list > * {
          flex-basis: calc((100% - 2 * 14px) / 3);
        }

        #shopify-section-{{ section.id }} .forma-related .product-list:not(scroll-carousel) {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        #shopify-section-{{ section.id }} .forma-related .prev-next-button {
          opacity: 1;
          width: 36px;
          height: 36px;
        }
      }

      @media screen and (max-width: 699px) {
        #shopify-section-{{ section.id }} .forma-related__section {
          padding-block: 44px 56px;
        }

        #shopify-section-{{ section.id }} .forma-related__container {
          width: calc(100% - 32px);
        }

        #shopify-section-{{ section.id }} .forma-related__header {
          display: block;
          margin-bottom: 24px;
          padding-bottom: 18px;
        }

        #shopify-section-{{ section.id }} .forma-related__eyebrow {
          margin-bottom: 10px;
          font-size: 9px;
        }

        #shopify-section-{{ section.id }} .forma-related__heading {
          font-size: clamp(29px, 9vw, 42px);
          line-height: 1;
        }

        #shopify-section-{{ section.id }} .forma-related__intro {
          margin-top: 14px;
          max-width: 300px;
          text-align: left;
          font-size: 10px;
        }

        #shopify-section-{{ section.id }} .forma-related scroll-carousel.product-list > * {
          flex-basis: 72%;
        }

        #shopify-section-{{ section.id }} .forma-related .product-list:not(scroll-carousel) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 24px 12px;
        }

        #shopify-section-{{ section.id }} .forma-related .product-card__info,
        #shopify-section-{{ section.id }} .forma-related .product-card__details {
          padding-top: 10px;
        }

        #shopify-section-{{ section.id }} .forma-related .product-card__title,
        #shopify-section-{{ section.id }} .forma-related .product-card__title a {
          font-size: 10px;
        }

        #shopify-section-{{ section.id }} .forma-related .prev-next-button {
          width: 32px;
          height: 32px;
        }

        #shopify-section-{{ section.id }} .forma-related .floating-controls-container__control {
          top: 34%;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        #shopify-section-{{ section.id }} .forma-related .product-card img,
        #shopify-section-{{ section.id }} .forma-related .prev-next-button {
          transition: none;
        }
      }
    </style>

    <div class="forma-related__section color-scheme color-scheme--{{ section.settings.color_scheme.id }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
      <div class="forma-related__container">
        <header class="forma-related__header">
          <div class="forma-related__heading-wrap">
            {%- if section.settings.subheading != blank -%}
              <p class="forma-related__eyebrow">{{ section.settings.subheading }}</p>
            {%- else -%}
              <p class="forma-related__eyebrow">THE FORMA EDIT</p>
            {%- endif -%}

            {%- if section.settings.title != blank -%}
              <h2 class="forma-related__heading">{{ section.settings.title }}</h2>
            {%- else -%}
              <h2 class="forma-related__heading">Complete your Forma</h2>
            {%- endif -%}
          </div>

          {%- if section.settings.content != blank -%}
            <div class="forma-related__intro">{{ section.settings.content }}</div>
          {%- else -%}
            <p class="forma-related__intro">Considered pieces. New perspectives. Your next favourite find.</p>
          {%- endif -%}
        </header>

        {%- capture product_list -%}
          {%- for product in recommendations.products -%}
            {%- render 'product-card',
              product: product,
              reveal: settings.stagger_products_apparition,
              position: forloop.index,
              hide_product_information: section.settings.hide_product_information
            -%}
          {%- endfor -%}
        {%- endcapture -%}

        <div class="forma-related__list-shell">
          {%- if section.settings.stack_products -%}
            <product-list class="product-list {% if section.settings.hide_product_information %}product-list--compact{% endif %} justify-center">
              {{- product_list -}}
            </product-list>
          {%- else -%}
            {%- assign carousel_id = 'carousel-' | append: section.id -%}

            <product-list class="floating-controls-container floating-controls-container--inside floating-controls-container--on-hover">
              <carousel-prev-button class="floating-controls-container__control" aria-controls="{{ carousel_id }}">
                <button type="button" class="prev-next-button prev-next-button--prev circle-button hover:animate-icon-inline" disabled>
                  <span class="sr-only">{{ 'general.accessibility.previous' | t }}</span>
                  {%- render 'icon' with 'arrow-left', direction_aware: true -%}
                </button>
              </carousel-prev-button>

              <scroll-carousel
                id="{{ carousel_id }}"
                group-cells
                allow-drag
                class="product-list {% if section.settings.hide_product_information %}product-list--compact{% endif %} product-list--carousel scroll-area bleed md:unbleed"
              >
                {{- product_list -}}
              </scroll-carousel>

              <carousel-next-button class="floating-controls-container__control" aria-controls="{{ carousel_id }}">
                <button type="button" class="prev-next-button prev-next-button--next circle-button hover:animate-icon-inline">
                  <span class="sr-only">{{ 'general.accessibility.next' | t }}</span>
                  {%- render 'icon' with 'arrow-right', direction_aware: true -%}
                </button>
              </carousel-next-button>
            </product-list>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "t:sections.related_products.name",
  "enabled_on": {
    "templates": ["product"]
  },
  "class": "shopify-section--related-products",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.related_products.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_product_information",
      "label": "t:global.product_list.hide_product_information",
      "info": "t:global.product_list.hide_product_information_info"
    },
    {
      "type": "header",
      "content": "t:global.product_list.product_list_category"
    },
    {
      "type": "checkbox",
      "id": "stack_products",
      "label": "t:global.product_list.stack_products",
      "default": false
    },
    {
      "type": "range",
      "id": "recommendations_count",
      "min": 2,
      "max": 10,
      "label": "t:sections.related_products.recommendations_count",
      "default": 10
    },
    {
      "type": "select",
      "id": "products_per_row_mobile",
      "label": "t:global.product_list.products_per_row_mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.stack_products }}"
    },
    {
      "type": "range",
      "id": "products_per_row_desktop",
      "min": 2,
      "max": 6,
      "label": "t:global.product_list.products_per_row_desktop",
      "default": 4,
      "visible_if": "{{ section.settings.stack_products }}"
    },
    {
      "type": "header",
      "content": "t:global.product_list.spacing_category",
      "info": "t:global.product_list.spacing_category_info"
    },
    {
      "type": "range",
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "id": "horizontal_spacing_factor",
      "label": "t:global.product_list.horizontal_spacing_factor",
      "default": 1
    },
    {
      "type": "range",
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "id": "vertical_spacing_factor",
      "label": "t:global.product_list.vertical_spacing_factor",
      "default": 1
    },
    {
      "type": "header",
      "content": "t:global.section.header_category"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Complete your Forma"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content",
      "default": "<p>Considered pieces. New perspectives. Your next favourite find.</p>"
    }
  ],
  "presets": [
    {
      "name": "t:sections.related_products.presets.related_products.name",
      "category": "t:global.categories.products"
    }
  ]
}
{% endschema %}

