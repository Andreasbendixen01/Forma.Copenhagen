{%- comment -%}
  ==========================================================================
  FORMA — THE FORM
  Editorial category grid inspired by premium lifestyle platforms
  ==========================================================================

  Cards:
  1. Wardrobe
  2. The Lifestyle
  3. The Home
  4. The Form
  5. Places
  6. Journal
{%- endcomment -%}

<section
  id="forma-the-form-{{ section.id }}"
  class="forma-the-form"
>

  <div class="forma-the-form__header">
    <h2 class="forma-the-form__title">
      {{ section.settings.heading | default: 'The Form' }}
    </h2>

    {%- if section.settings.intro != blank -%}
      <p class="forma-the-form__intro">
        {{ section.settings.intro }}
      </p>
    {%- endif -%}
  </div>

  <div class="forma-the-form__grid">

    {%- for block in section.blocks -%}

      <a
        href="{{ block.settings.link | default: '#' }}"
        class="forma-the-form__card"
        {{ block.shopify_attributes }}
      >

        <div class="forma-the-form__image-wrap">

          {%- if block.settings.image != blank -%}

            {{
              block.settings.image
              | image_url: width: 2200
              | image_tag:
                loading: 'lazy',
                widths: '500,700,900,1200,1600,2000,2200',
                class: 'forma-the-form__image',
                alt: block.settings.title
            }}

          {%- else -%}

            <div class="forma-the-form__placeholder"></div>

          {%- endif -%}

          <div class="forma-the-form__image-overlay"></div>

          <div class="forma-the-form__card-content">

            {%- if block.settings.eyebrow != blank -%}
              <span class="forma-the-form__eyebrow">
                {{ block.settings.eyebrow }}
              </span>
            {%- endif -%}

            <span class="forma-the-form__card-title">
              {{ block.settings.title }}
            </span>

            {%- if block.settings.subtitle != blank -%}
              <span class="forma-the-form__subtitle">
                {{ block.settings.subtitle }}
              </span>
            {%- endif -%}

            <span class="forma-the-form__explore">
              Explore
              <span aria-hidden="true">→</span>
            </span>

          </div>

        </div>

      </a>

    {%- endfor -%}

  </div>

</section>


<style>

  /* ==========================================================================
     FORMA — THE FORM
     ========================================================================== */

  #forma-the-form-{{ section.id }} {
    width: 100%;
    margin: 0;
    padding: 0;
    background: #fff;
    color: #111;
    overflow: hidden;
  }


  /* ==========================================================================
     HEADER
     ========================================================================== */

  #forma-the-form-{{ section.id }} .forma-the-form__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;

    padding: 26px 12px 18px;
  }

  #forma-the-form-{{ section.id }} .forma-the-form__title {
    margin: 0;

    font-family: inherit;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  #forma-the-form-{{ section.id }} .forma-the-form__intro {
    margin: 0;

    max-width: 520px;

    font-size: 12px;
    line-height: 1.5;
    color: rgba(17,17,17,0.55);
  }


  /* ==========================================================================
     GRID
     ========================================================================== */

  #forma-the-form-{{ section.id }} .forma-the-form__grid {
    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 2px;

    width: 100%;
  }


  /* ==========================================================================
     CARD
     ========================================================================== */

  #forma-the-form-{{ section.id }} .forma-the-form__card {
    position: relative;

    display: block;

    min-width: 0;

    color: inherit;
    text-decoration: none;

    overflow: hidden;

    background: #e8e8e8;

    aspect-ratio: 1 / 0.92;

    transition:
      opacity 0.45s ease,
      filter 0.45s ease,
      transform 0.45s ease;
  }


  /* ==========================================================================
     IMAGE
     ========================================================================== */

  #forma-the-form-{{ section.id }} .forma-the-form__image-wrap {
    position: absolute;
    inset: 0;

    overflow: hidden;
  }

  #forma-the-form-{{ section.id }} .forma-the-form__image {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;

    display: block;

    transition:
      transform 0.8s cubic-bezier(.22,.61,.36,1),
      filter 0.6s ease;
  }

  #forma-the-form-{{ section.id }} .forma-the-form__placeholder {
    position: absolute;
    inset: 0;

    background: #d9d9d9;
  }


  /* ==========================================================================
     IMAGE OVERLAY
     ========================================================================== */

  #forma-the-form-{{ section.id }} .forma-the-form__image-overlay {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        to top,
        rgba(0,0,0,0.42) 0%,
        rgba(0,0,0,0.08) 42%,
        rgba(0,0,0,0.02) 70%,
        rgba(0,0,0,0.08) 100%
      );

    transition:
      background 0.5s ease,
      backdrop-filter 0.5s ease;
  }


  /* ==========================================================================
     CARD CONTENT
     ========================================================================== */

  #forma-the-form-{{ section.id }} .forma-the-form__card-content {
    position: absolute;
    inset: 0;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;

    padding: 30px;

    color: #fff;
  }


  /* Small FORMA label */

  #forma-the-form-{{ section.id }} .forma-the-form__eyebrow {
    position: absolute;

    top: 20px;
    left: 20px;

    padding: 7px 11px;

    border: 1px solid rgba(255,255,255,0.42);

    background: rgba(20,20,20,0.20);

    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);

    font-size: 9px;
    font-weight: 500;

    letter-spacing: 0.16em;
    text-transform: uppercase;

    line-height: 1;

    color: rgba(255,255,255,0.92);
  }


  /* Main category */

  #forma-the-form-{{ section.id }} .forma-the-form__card-title {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  padding: 13px 24px;

  background: transparent;

  border: 1px solid rgba(255,255,255,0.78);

  border-radius: 4px;

  font-family: inherit;

  font-size: 15px;
  font-weight: 400;

  line-height: 1;

  letter-spacing: 0.03em;

  color: #fff;

  transition:
    background 0.35s ease,
    border-color 0.35s ease;
}


  /* Subtitle */

  #forma-the-form-{{ section.id }} .forma-the-form__subtitle {
    margin-top: 12px;

    max-width: 280px;

    font-size: 11px;
    line-height: 1.45;

    color: rgba(255,255,255,0.82);

    opacity: 0;

    transform: translateY(8px);

    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
  }


  /* Explore */

  #forma-the-form-{{ section.id }} .forma-the-form__explore {
    position: absolute;

    bottom: 20px;

    display: flex;
    align-items: center;
    gap: 7px;

    font-size: 9px;
    font-weight: 500;

    letter-spacing: 0.15em;
    text-transform: uppercase;

    color: rgba(255,255,255,0.88);

    opacity: 0;

    transform: translateY(8px);

    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
  }

  #forma-the-form-{{ section.id }} .forma-the-form__explore span {
    font-size: 12px;
    transition: transform 0.35s ease;
  }


  /* ==========================================================================
     HOVER — ACTIVE CARD
     ========================================================================== */

  @media screen and (min-width: 750px) {


    #forma-the-form-{{ section.id }} .forma-the-form__card:hover {
      z-index: 2;
    }

    #forma-the-form-{{ section.id }} .forma-the-form__card:hover
    .forma-the-form__image {
      transform: scale(1.045);
    }

    }

    #forma-the-form-{{ section.id }} .forma-the-form__card:hover
    .forma-the-form__subtitle {
      opacity: 1;
      transform: translateY(0);
    }

    #forma-the-form-{{ section.id }} .forma-the-form__card:hover
    .forma-the-form__explore {
      opacity: 1;
      transform: translateY(0);
    }

    #forma-the-form-{{ section.id }} .forma-the-form__card:hover
    .forma-the-form__explore span {
      transform: translateX(4px);
    }

  


  /* ==========================================================================
     MOBILE
     ========================================================================== */

  @media screen and (max-width: 749px) {

    #forma-the-form-{{ section.id }} .forma-the-form__header {
      padding: 22px 12px 16px;
    }

    #forma-the-form-{{ section.id }} .forma-the-form__intro {
      display: none;
    }

    #forma-the-form-{{ section.id }} .forma-the-form__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2px;
    }

    #forma-the-form-{{ section.id }} .forma-the-form__card {
      aspect-ratio: 1 / 1.12;
    }

    #forma-the-form-{{ section.id }} .forma-the-form__card-content {
      padding: 16px;
    }

    #forma-the-form-{{ section.id }} .forma-the-form__eyebrow {
      top: 12px;
      left: 12px;

      padding: 6px 8px;

      font-size: 7px;
    }

    #forma-the-form-{{ section.id }} .forma-the-form__card-title {
      padding: 10px 14px;

      font-size: 11px;
    }

    #forma-the-form-{{ section.id }} .forma-the-form__subtitle {
      display: none;
    }

    #forma-the-form-{{ section.id }} .forma-the-form__explore {
      bottom: 13px;

      font-size: 7px;

      opacity: 0.85;
      transform: none;
    }

  }


  /* ==========================================================================
     REDUCED MOTION
     ========================================================================== */

  @media (prefers-reduced-motion: reduce) {

    #forma-the-form-{{ section.id }} *,
    #forma-the-form-{{ section.id }} *::before,
    #forma-the-form-{{ section.id }} *::after {
      transition: none !important;
      animation: none !important;
    }

  }

</style>


