{%- comment -%}
  ==========================================================================
  FORMA THE FORM
  Editorial category grid

  Cards:
  1. Wardrobe
  2. The Lifestyle
  3. The Home
  4. The Form
  5. Places
  6. Journal
  ==========================================================================
{%- endcomment -%}

{%- assign overlay_strength = section.settings.overlay | default: 30 | divided_by: 100.0 -%}

<section
  id="forma-the-form-{{ section.id }}"
  class="forma-the-form"
  style="--ftf-overlay: {{ overlay_strength }};"
>

  <div class="forma-the-form__header">
    <h2 class="forma-the-form__title">
      {{ section.settings.heading | default: 'The Form' }}
    </h2>

    {%- if section.settings.intro != blank -%}
      <p class="forma-the-form__intro">
        {{ section.settings.intro }}
      </p>
    {%- endif -%}
  </div>

  <div class="forma-the-form__grid">

    {%- for block in section.blocks -%}

      <a
        href="{{ block.settings.link | default: '#' }}"
        class="forma-the-form__card"
        {{ block.shopify_attributes }}
      >

        <div class="forma-the-form__image-wrap">

          {%- if block.settings.image != blank -%}

            {{
              block.settings.image
              | image_url: width: 2200
              | image_tag:
                loading: 'lazy',
                widths: '500,700,900,1200,1600,2000,2200',
                class: 'forma-the-form__image',
                alt: block.settings.title
            }}

          {%- else -%}

            <div class="forma-the-form__placeholder"></div>

          {%- endif -%}

          <div class="forma-the-form__image-overlay"></div>

          <div class="forma-the-form__card-content">

            {%- if block.settings.eyebrow != blank -%}
              <span class="forma-the-form__eyebrow">
                {{ block.settings.eyebrow }}
              </span>
            {%- endif -%}

            <span class="forma-the-form__card-title">
              {{ block.settings.title }}
            </span>

          </div>

        </div>

      </a>

    {%- endfor -%}

  </div>

</section>


<style>

  /* =========================================================
     5PX SIDE SPACING
     ========================================================= */

  #shopify-section-{{ section.id }} {
    margin-left: 5px !important;
    margin-right: 5px !important;
    width: calc(100% - 10px) !important;
  }


  /* ==========================================================================
     ROOT
     --ftf-hover-bg styrer knappens farve ved hover (sort med opacity).
     ========================================================================== */

  #forma-the-form-{{ section.id }} {
    --ftf-hover-bg: rgba(0, 0, 0, 0.6);

    width: 100%;
    margin: 0;
    padding: 0;
    background: #fff;
    color: #111;
    overflow: hidden;
  }


  /* ==========================================================================
     HEADER
     ========================================================================== */

  #forma-the-form-{{ section.id }} .forma-the-form__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 5px 5px 18px;
  }

  #forma-the-form-{{ section.id }} .forma-the-form__title {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif !important;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  #forma-the-form-{{ section.id }} .forma-the-form__intro {
    margin: 0;
    max-width: 520px;
    font-size: 12px;
    line-height: 1.5;
    color: rgba(17, 17, 17, 0.55);
  }


  /* ==========================================================================
     GRID
     ========================================================================== */

  #forma-the-form-{{ section.id }} .forma-the-form__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 5px;
    width: 100%;
  }


  /* ==========================================================================
     CARD
     ========================================================================== */

  #forma-the-form-{{ section.id }} .forma-the-form__card {
    position: relative;
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    background: #e8e8e8;
    aspect-ratio: 1 / 0.98;
  }


  /* ==========================================================================
     IMAGE
     ========================================================================== */

  #forma-the-form-{{ section.id }} .forma-the-form__image-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  #forma-the-form-{{ section.id }} .forma-the-form__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #forma-the-form-{{ section.id }} .forma-the-form__placeholder {
    position: absolute;
    inset: 0;
    background: #d9d9d9;
  }


  /* ==========================================================================
     IMAGE OVERLAY
     ========================================================================== */

  #forma-the-form-{{ section.id }} .forma-the-form__image-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to top, rgba(0, 0, 0, 0.30) 0%, rgba(0, 0, 0, 0) 55%),
      rgba(0, 0, 0, var(--ftf-overlay, 0.3));
  }


  /* ==========================================================================
     CARD CONTENT
     pointer-events: none p√• laget, s√• kun selve knappen reagerer p√• hover.
     ========================================================================== */

  #forma-the-form-{{ section.id }} .forma-the-form__card-content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 30px;
    color: #fff;
    pointer-events: none;
  }

  #forma-the-form-{{ section.id }} .forma-the-form__eyebrow {
    position: absolute;
    top: 18px;
    left: 20px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1;
    color: rgba(255, 255, 255, 0.9);
  }


  /* ==========================================================================
     KATEGORIKNAP
     Hviler som outline. Ved hover • selve knappen: sort med opacity.
     ========================================================================== */

  #forma-the-form-{{ section.id }} .forma-the-form__card-title {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 26px;
    background-color: transparent;
    border: 0.5px solid rgba(255, 255, 255, 0.78);
    border-radius: 999px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 300;
    line-height: 1;
    letter-spacing: 0.03em;
    color: #fff;
    pointer-events: auto;
    cursor: pointer;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  #forma-the-form-{{ section.id }} .forma-the-form__card:focus-visible .forma-the-form__card-title {
    background-color: var(--ftf-hover-bg);
    outline: 2px solid #fff;
    outline-offset: 3px;
  }


  /* ==========================================================================
     MOBILE
     ========================================================================== */

  @media screen and (max-width: 749px) {

    #forma-the-form-{{ section.id }} .forma-the-form__header {
      padding: 22px 12px 16px;
    }

    #forma-the-form-{{ section.id }} .forma-the-form__intro {
      display: none;
    }

    #forma-the-form-{{ section.id }} .forma-the-form__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2px;
    }

    #forma-the-form-{{ section.id }} .forma-the-form__card {
      aspect-ratio: 1 / 1.12;
    }

    #forma-the-form-{{ section.id }} .forma-the-form__card-content {
      padding: 16px;
    }

    #forma-the-form-{{ section.id }} .forma-the-form__eyebrow {
      top: 12px;
      left: 12px;
      font-size: 8px;
    }

    #forma-the-form-{{ section.id }} .forma-the-form__card-title {
      padding: 10px 16px;
      font-size: 11px;
    }

  }


  /* ==========================================================================
     REDUCED MOTION
     ========================================================================== */

  @media (prefers-reduced-motion: reduce) {

    #forma-the-form-{{ section.id }} *,
    #forma-the-form-{{ section.id }} *::before,
    #forma-the-form-{{ section.id }} *::after {
      transition: none !important;
      animation: none !important;
    }

  }

</style>


{% schema %}
{
  "name": "FORMA The Form",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Form"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "The world of Forma, curated around the way we live."
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Image overlay darkness",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "FORMA"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Wardrobe"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FORMA The Form",
      "blocks": [
        { "type": "category", "settings": { "eyebrow": "FORMA", "title": "Wardrobe" } },
        { "type": "category", "settings": { "eyebrow": "FORMA", "title": "The Lifestyle" } },
        { "type": "category", "settings": { "eyebrow": "FORMA", "title": "The Home" } },
        { "type": "category", "settings": { "eyebrow": "FORMA", "title": "The Form" } },
        { "type": "category", "settings": { "eyebrow": "FORMA", "title": "Places" } },
        { "type": "category", "settings": { "eyebrow": "FORMA", "title": "Journal" } }
      ]
    }
  ]
}
{% endschema %}

