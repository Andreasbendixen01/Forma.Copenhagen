{% comment %}
  ================================================================
  FORMA — THE FORM
  Editorial lifestyle discovery section
  ================================================================
{% endcomment %}

<section
  id="forma-the-form-{{ section.id }}"
  class="forma-the-form"
>

  <!-- ============================================================
       HEADER
       ============================================================ -->

  <div class="forma-the-form__header">

    <div class="forma-the-form__heading">

      <h2 class="forma-the-form__title">
        {{ section.settings.heading }}
      </h2>

      {% if section.settings.subheading != blank %}
        <p class="forma-the-form__subtitle">
          {{ section.settings.subheading }}
        </p>
      {% endif %}

    </div>


    {% if section.settings.view_all_text != blank %}
      <a
        href="{{ section.settings.view_all_link }}"
        class="forma-the-form__view-all"
      >
        {{ section.settings.view_all_text }}
      </a>
    {% endif %}

  </div>


  <!-- ============================================================
       EDITORIAL GRID
       ============================================================ -->

  <div
    class="forma-the-form__grid"
    data-forma-the-form-grid
  >

    {% for block in section.blocks %}

      <article
        class="
          forma-the-form__item
          forma-the-form__item--{{ forloop.index }}
        "
        {{ block.shopify_attributes }}
      >

        <a
          href="{{ block.settings.link | default: '#' }}"
          class="forma-the-form__link"
        >

          <div class="forma-the-form__image-wrapper">

            {% if block.settings.image != blank %}

              {{
                block.settings.image
                | image_url: width: 1800
                | image_tag:
                  loading: 'lazy',
                  widths: '700, 1000, 1400, 1800',
                  sizes: '(max-width: 699px) 92vw, 50vw',
                  class: 'forma-the-form__image'
              }}

            {% else %}

              {{ 'image' | placeholder_svg_tag: 'forma-the-form__placeholder' }}

            {% endif %}


            <!-- GLASS LABEL -->

            <span class="forma-the-form__label">
              THE FORM
            </span>


            <!-- CONTENT OVERLAY -->

            <div class="forma-the-form__overlay">

              {% if block.settings.title != blank %}
                <h3 class="forma-the-form__item-title">
                  {{ block.settings.title }}
                </h3>
              {% endif %}

              {% if block.settings.subtitle != blank %}
                <p class="forma-the-form__item-subtitle">
                  {{ block.settings.subtitle }}
                </p>
              {% endif %}

              <span class="forma-the-form__explore">
                Explore →
              </span>

            </div>

          </div>

        </a>

      </article>

    {% endfor %}

  </div>


  <style>

    /* ============================================================
       ROOT
       ============================================================ */

    #forma-the-form-{{ section.id }} {

      --form-gap: 5px;

      width: 100%;

      overflow: hidden;

      padding-top: 0;
      padding-bottom: 0;
    }


    /* ============================================================
       HEADER
       ============================================================ */

    #forma-the-form-{{ section.id }} .forma-the-form__header {

      display: flex;

      align-items: baseline;

      justify-content: space-between;

      width: 100%;

      padding: 0 12px 18px;
    }


    #forma-the-form-{{ section.id }} .forma-the-form__heading {

      display: flex;

      align-items: baseline;

      min-width: 0;
    }


    #forma-the-form-{{ section.id }} .forma-the-form__title {

      margin: 0;
      padding: 0;

      font-size: 17px;

      line-height: 1.2;

      font-weight: 400;

      letter-spacing: 0;

      font-family:
        Georgia,
        "Times New Roman",
        serif !important;
    }


    #forma-the-form-{{ section.id }} .forma-the-form__subtitle {

      margin: 0 0 0 16px;

      font-size: 13px;

      line-height: 1.2;

      font-weight: 400;

      opacity: 0.55;
    }


    /* ============================================================
       VIEW ALL
       ============================================================ */

    #forma-the-form-{{ section.id }} .forma-the-form__view-all {

      flex-shrink: 0;

      margin-left: auto;

      color: inherit;

      text-decoration: none;

      font-size: 13px;

      line-height: 1.2;

      font-weight: 400;

      transition:
        opacity 0.25s ease;
    }


    #forma-the-form-{{ section.id }} .forma-the-form__view-all:hover {

      opacity: 0.5;
    }


    /* ============================================================
       GRID
       ============================================================ */

    #forma-the-form-{{ section.id }} .forma-the-form__grid {

      display: grid;

      grid-template-columns:
        1.45fr
        0.9fr
        1.15fr;

      grid-template-rows:
        310px
        310px;

      gap: var(--form-gap);

      width: 100%;
    }


    /* ============================================================
       GRID POSITIONS
       ============================================================ */

    #forma-the-form-{{ section.id }} .forma-the-form__item--1 {

      grid-column: 1 / 2;

      grid-row: 1 / 3;
    }


    #forma-the-form-{{ section.id }} .forma-the-form__item--2 {

      grid-column: 2 / 3;

      grid-row: 1 / 2;
    }


    #forma-the-form-{{ section.id }} .forma-the-form__item--3 {

      grid-column: 3 / 4;

      grid-row: 1 / 2;
    }


    #forma-the-form-{{ section.id }} .forma-the-form__item--4 {

      grid-column: 2 / 4;

      grid-row: 2 / 3;
    }


    /* ============================================================
       LINK
       ============================================================ */

    #forma-the-form-{{ section.id }} .forma-the-form__link {

      display: block;

      width: 100%;
      height: 100%;

      color: inherit;

      text-decoration: none;
    }


    /* ============================================================
       IMAGE
       ============================================================ */

    #forma-the-form-{{ section.id }} .forma-the-form__image-wrapper {

      position: relative;

      width: 100%;
      height: 100%;

      overflow: hidden;

      background: #f2f2f2;

      isolation: isolate;

      transition:
        transform 0.55s cubic-bezier(.2,.6,.2,1),
        box-shadow 0.55s cubic-bezier(.2,.6,.2,1);
    }


    #forma-the-form-{{ section.id }} .forma-the-form__image {

      display: block;

      width: 100%;
      height: 100%;

      object-fit: cover;

      transition:
        transform 0.8s cubic-bezier(.2,.6,.2,1),
        filter 0.6s ease;
    }


    /* ============================================================
       DARK GRADIENT
       ============================================================ */

    #forma-the-form-{{ section.id }} .forma-the-form__image-wrapper::after {

      content: "";

      position: absolute;

      inset: 0;

      z-index: 1;

      background:
        linear-gradient(
          to top,
          rgba(0,0,0,0.58) 0%,
          rgba(0,0,0,0.16) 42%,
          rgba(0,0,0,0.02) 70%
        );

      pointer-events: none;
    }


    /* ============================================================
       GLASS LABEL
       ============================================================ */

    #forma-the-form-{{ section.id }} .forma-the-form__label {

      position: absolute;

      top: 14px;
      left: 14px;

      z-index: 3;

      display: inline-flex;

      align-items: center;

      padding: 7px 10px;

      color:
        rgba(255,255,255,0.96);

      font-size: 9px;

      font-weight: 500;

      line-height: 1;

      letter-spacing: 0.13em;

      text-transform: uppercase;

      background:
        rgba(20,20,20,0.30);

      border:
        1px solid rgba(255,255,255,0.20);

      backdrop-filter:
        blur(12px)
        saturate(120%);

      -webkit-backdrop-filter:
        blur(12px)
        saturate(120%);

      box-shadow:
        0 4px 18px rgba(0,0,0,0.10);

      transition:
        background 0.35s ease,
        border-color 0.35s ease,
        transform 0.35s ease;
    }


    /* ============================================================
       CONTENT OVERLAY
       ============================================================ */

    #forma-the-form-{{ section.id }} .forma-the-form__overlay {

      position: absolute;

      left: 20px;
      right: 20px;
      bottom: 20px;

      z-index: 3;

      color: white;

      transform:
        translateY(8px);

      transition:
        transform 0.5s cubic-bezier(.2,.6,.2,1);
    }


    #forma-the-form-{{ section.id }} .forma-the-form__item-title {

      margin: 0;

      font-size: 28px;

      line-height: 1.05;

      font-weight: 400;

      letter-spacing: -0.02em;

      font-family:
        Georgia,
        "Times New Roman",
        serif;
    }


    #forma-the-form-{{ section.id }} .forma-the-form__item-subtitle {

      max-width: 320px;

      margin: 7px 0 0;

      font-size: 12px;

      line-height: 1.35;

      font-weight: 400;

      opacity: 0.82;
    }


    #forma-the-form-{{ section.id }} .forma-the-form__explore {

      display: inline-block;

      margin-top: 13px;

      font-size: 10px;

      line-height: 1;

      letter-spacing: 0.10em;

      text-transform: uppercase;

      opacity: 0;

      transform:
        translateY(7px);

      transition:
        opacity 0.35s ease,
        transform 0.35s ease;
    }


    /* ============================================================
       HOVER — ACTIVE CARD
       ============================================================ */

    #forma-the-form-{{ section.id }} .forma-the-form__item:hover
    .forma-the-form__image-wrapper {

      transform:
        translateY(-3px);

      box-shadow:
        0 18px 42px rgba(0,0,0,0.15);
    }


    #forma-the-form-{{ section.id }} .forma-the-form__item:hover
    .forma-the-form__image {

      transform:
        scale(1.035);
    }


    #forma-the-form-{{ section.id }} .forma-the-form__item:hover
    .forma-the-form__overlay {

      transform:
        translateY(0);
    }


    #forma-the-form-{{ section.id }} .forma-the-form__item:hover
    .forma-the-form__explore {

      opacity: 0.95;

      transform:
        translateY(0);
    }


    #forma-the-form-{{ section.id }} .forma-the-form__item:hover
    .forma-the-form__label {

      background:
        rgba(20,20,20,0.48);

      border-color:
        rgba(255,255,255,0.32);

      transform:
        translateY(-1px);
    }


    /* ============================================================
       HOVER — DIM OTHER CARDS
       ============================================================ */

    #forma-the-form-{{ section.id }} .forma-the-form__grid:hover
    .forma-the-form__item:not(:hover)
    .forma-the-form__image {

      filter:
        blur(4px)
        brightness(0.78)
        saturate(0.75);

      transform:
        scale(1.015);
    }


    #forma-the-form-{{ section.id }} .forma-the-form__grid:hover
    .forma-the-form__item:not(:hover)
    .forma-the-form__image-wrapper::before {

      content: "";

      position: absolute;

      inset: 0;

      z-index: 2;

      background:
        rgba(255,255,255,0.10);

      backdrop-filter:
        blur(3px);

      -webkit-backdrop-filter:
        blur(3px);

      pointer-events: none;
    }


    /* ============================================================
       MOBILE
       ============================================================ */

    @media screen and (max-width: 699px) {

      #forma-the-form-{{ section.id }} {

        padding-top: 0;
        padding-bottom: 0;
      }


      #forma-the-form-{{ section.id }} .forma-the-form__header {

        align-items: baseline;

        padding:
          0
          12px
          14px;
      }


      #forma-the-form-{{ section.id }} .forma-the-form__title {

        font-size: 16px;
      }


      #forma-the-form-{{ section.id }} .forma-the-form__subtitle {

        margin-left: 10px;

        font-size: 11px;
      }


      #forma-the-form-{{ section.id }} .forma-the-form__view-all {

        font-size: 12px;
      }


      /* Mobile becomes a horizontal discovery rail */

      #forma-the-form-{{ section.id }} .forma-the-form__grid {

        display: flex;

        gap: 8px;

        width: 100%;

        overflow-x: auto;
        overflow-y: hidden;

        padding-left: 0;
        padding-right: 12px;

        scrollbar-width: none;

        -webkit-overflow-scrolling: touch;
      }


      #forma-the-form-{{ section.id }} .forma-the-form__grid::-webkit-scrollbar {

        display: none;
      }


      #forma-the-form-{{ section.id }} .forma-the-form__item,
      #forma-the-form-{{ section.id }} .forma-the-form__item--1,
      #forma-the-form-{{ section.id }} .forma-the-form__item--2,
      #forma-the-form-{{ section.id }} .forma-the-form__item--3,
      #forma-the-form-{{ section.id }} .forma-the-form__item--4 {

        flex:
          0 0
          82vw;

        height:
          108vw;

        min-height: 0;

        grid-column: auto;
        grid-row: auto;
      }


      #forma-the-form-{{ section.id }} .forma-the-form__overlay {

        left: 16px;
        right: 16px;
        bottom: 16px;
      }


      #forma-the-form-{{ section.id }} .forma-the-form__item-title {

        font-size: 25px;
      }


      #forma-the-form-{{ section.id }} .forma-the-form__label {

        top: 10px;
        left: 10px;

        padding: 6px 8px;

        font-size: 8px;
      }


      /* No blur interaction on touch */

      #forma-the-form-{{ section.id }} .forma-the-form__grid:hover
      .forma-the-form__item:not(:hover)
      .forma-the-form__image {

        filter: none;

        transform: none;
      }


      #forma-the-form-{{ section.id }} .forma-the-form__grid:hover
      .forma-the-form__item:not(:hover)
      .forma-the-form__image-wrapper::before {

        display: none;
      }

    }

  </style>


  {% schema %}

  {
    "name": "FORMA The Form",

    "tag": "section",

    "class": "forma-the-form-section",

    "settings": [

      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "The Form"
      },

      {
        "type": "text",
        "id": "subheading",
        "label": "Subheading",
        "default": "The things that shape how we live."
      },

      {
        "type": "text",
        "id": "view_all_text",
        "label": "View all text",
        "default": "View all →"
      },

      {
        "type": "url",
        "id": "view_all_link",
        "label": "View all link"
      }

    ],

    "blocks": [

      {
        "type": "form_item",

        "name": "Form item",

        "settings": [

          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },

          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Taste"
          },

          {
            "type": "text",
            "id": "subtitle",
            "label": "Subtitle",
            "default": "Places worth tasting."
          },

          {
            "type": "url",
            "id": "link",
            "label": "Link"
          }

        ]
      }

    ],

    "presets": [

      {
        "name": "FORMA The Form",

        "blocks": [

          {
            "type": "form_item",

            "settings": {

              "title": "Taste",

              "subtitle": "Places worth tasting."
            }
          },

          {
            "type": "form_item",

            "settings": {

              "title": "Movement",

              "subtitle": "Move with intention."
            }
          },

          {
            "type": "form_item",

            "settings": {

              "title": "Culture",

              "subtitle": "Things worth experiencing."
            }
          },

          {
            "type": "form_item",

            "settings": {

              "title": "Objects",

              "subtitle": "Objects worth living with."
            }
          }

        ]
      }

    ]

  }

  {% endschema %}

</section>