
{% liquid
  assign contact_email = section.settings.contact_email | default: 'Customercare@formacopenhagen.com'
%}

<section
  id="forma-contact-{{ section.id }}"
  class="forma-contact"
>
  <div class="forma-contact__inner">

    <!-- INTRODUCTION -->
    <div class="forma-contact__main">

      <div class="forma-contact__intro">
        <div class="forma-contact__eyebrow">
          <span class="forma-contact__number">01</span>
          <span class="forma-contact__eyebrow-line"></span>
          <span>{{ section.settings.eyebrow | escape }}</span>
        </div>

        <h1 class="forma-contact__title">
          {{ section.settings.title | escape }}
        </h1>

        <div class="forma-contact__description">
          {{ section.settings.description }}
        </div>

        <div class="forma-contact__email-block">
          <span class="forma-contact__label">PREFER EMAIL?</span>

          <a
            class="forma-contact__email"
            href="mailto:{{ contact_email | strip | escape }}"
          >
            {{ contact_email | escape }}
            <span aria-hidden="true">↗</span>
          </a>

          <p class="forma-contact__note">
            {{ section.settings.email_note | escape }}
          </p>
        </div>
      </div>

      <!-- FORM -->
      <div class="forma-contact__form-column">

        <div class="forma-contact__form-heading">
          <span class="forma-contact__label">CONTACT FORM</span>
          <span class="forma-contact__required">* REQUIRED FIELDS</span>
        </div>

        {% form 'contact', id: 'FormaContactForm', class: 'forma-contact__form' %}

          {% if form.posted_successfully? %}
            <div class="forma-contact__notice forma-contact__notice--success" role="status">
              <span class="forma-contact__notice-mark">✓</span>
              <div>
                <strong>Thank you for reaching out.</strong>
                <p>Your message has been submitted successfully.</p>
              </div>
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="forma-contact__notice forma-contact__notice--error" role="alert">
              <strong>Something needs your attention.</strong>
              <p>
                {{ form.errors.translated_fields.email | default: 'Please check the required fields and try again.' }}
                {% if form.errors.messages.email %}
                  — {{ form.errors.messages.email }}
                {% endif %}
              </p>
            </div>
          {% endif %}

          <div class="forma-contact__fields">

            <div class="forma-contact__field">
              <label for="FormaContactName-{{ section.id }}">
                NAME <span>*</span>
              </label>
              <input
                id="FormaContactName-{{ section.id }}"
                type="text"
                name="contact[name]"
                autocomplete="name"
                placeholder="Your full name"
                value="{{ form.name | default: customer.name | escape }}"
                required
              >
            </div>

            <div class="forma-contact__field">
              <label for="FormaContactEmail-{{ section.id }}">
                E-MAIL <span>*</span>
              </label>
              <input
                id="FormaContactEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="Your email address"
                value="{{ form.email | default: customer.email | escape }}"
                required
              >
            </div>

            <div class="forma-contact__field forma-contact__field--message">
              <label for="FormaContactMessage-{{ section.id }}">
                MESSAGE <span>*</span>
              </label>
              <textarea
                id="FormaContactMessage-{{ section.id }}"
                name="contact[body]"
                rows="5"
                placeholder="Tell us what is on your mind..."
                required
              >{{ form.body | escape }}</textarea>
            </div>

          </div>

          <div class="forma-contact__form-bottom">
            <p class="forma-contact__privacy">
              Your information will only be used to respond to your enquiry.
            </p>

            <button type="submit" class="forma-contact__submit">
              <span>{{ section.settings.button_text | escape }}</span>
              <span class="forma-contact__submit-arrow" aria-hidden="true">↗</span>
            </button>
          </div>

        {% endform %}
      </div>

    </div>

  </div>
</section>

<style>
  #forma-contact-{{ section.id }} {
    --fc-bg: #f5f4f0;
    --fc-text: #1b1b1a;
    --fc-muted: #85847e;
    --fc-line: rgba(27, 27, 26, 0.14);
    --fc-gutter: clamp(24px, 5.2vw, 80px);

    background: var(--fc-bg);
    color: var(--fc-text);
    width: 100%;
    overflow: hidden;
  }

  #forma-contact-{{ section.id }} *,
  #forma-contact-{{ section.id }} *::before,
  #forma-contact-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #forma-contact-{{ section.id }} .forma-contact__inner {
    width: 100%;
    padding: 64px var(--fc-gutter) 72px;
  }

  /* MAIN LAYOUT */

  #forma-contact-{{ section.id }} .forma-contact__main {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(40px, 8vw, 140px);
    border-top: 1px solid var(--fc-line);
    border-bottom: 1px solid var(--fc-line);
    padding: 42px 0 58px;
  }

  /* INTRO */

  #forma-contact-{{ section.id }} .forma-contact__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  #forma-contact-{{ section.id }} .forma-contact__eyebrow {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 48px;
    color: var(--fc-muted);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #forma-contact-{{ section.id }} .forma-contact__number {
    font-variant-numeric: tabular-nums;
  }

  #forma-contact-{{ section.id }} .forma-contact__eyebrow-line {
    width: 28px;
    height: 1px;
    background: var(--fc-line);
  }

  #forma-contact-{{ section.id }} .forma-contact__title {
    max-width: 560px;
    margin: 0 0 25px;
    font-size: clamp(42px, 5.1vw, 76px);
    font-weight: 400;
    letter-spacing: -0.075em;
    line-height: 0.99;
    overflow-wrap: anywhere;
  }

  #forma-contact-{{ section.id }} .forma-contact__description {
    max-width: 370px;
    color: var(--fc-muted);
    font-size: 14px;
    line-height: 1.9;
  }

  #forma-contact-{{ section.id }} .forma-contact__description p {
    margin: 0 0 12px;
  }

  #forma-contact-{{ section.id }} .forma-contact__description p:last-child {
    margin-bottom: 0;
  }

  #forma-contact-{{ section.id }} .forma-contact__email-block {
    width: 100%;
    max-width: 370px;
    margin-top: auto;
    padding-top: 58px;
  }

  #forma-contact-{{ section.id }} .forma-contact__label {
    display: block;
    color: var(--fc-muted);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.15em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  #forma-contact-{{ section.id }} .forma-contact__email {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    max-width: 100%;
    margin-top: 16px;
    color: var(--fc-text);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: opacity 220ms ease;
  }

  #forma-contact-{{ section.id }} .forma-contact__email span {
    font-size: 18px;
    transition: transform 220ms ease;
  }

  #forma-contact-{{ section.id }} .forma-contact__email:hover {
    opacity: 0.65;
  }

  #forma-contact-{{ section.id }} .forma-contact__email:hover span {
    transform: translate(3px, -3px);
  }

  #forma-contact-{{ section.id }} .forma-contact__note {
    max-width: 330px;
    margin: 25px 0 0;
    color: var(--fc-muted);
    font-size: 11px;
    line-height: 1.8;
  }

  /* FORM COLUMN */

  #forma-contact-{{ section.id }} .forma-contact__form-column {
    min-width: 0;
    padding-left: clamp(28px, 4.5vw, 68px);
    border-left: 1px solid var(--fc-line);
  }

  #forma-contact-{{ section.id }} .forma-contact__form-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 0 20px;
    border-bottom: 1px solid var(--fc-line);
  }

  #forma-contact-{{ section.id }} .forma-contact__required {
    color: var(--fc-muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-align: right;
  }

  #forma-contact-{{ section.id }} .forma-contact__form {
    margin-top: 12px;
  }

  #forma-contact-{{ section.id }} .forma-contact__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 28px;
  }

  #forma-contact-{{ section.id }} .forma-contact__field {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 23px 0 0;
  }

  #forma-contact-{{ section.id }} .forma-contact__field label {
    display: block;
    margin-bottom: 13px;
    color: var(--fc-text);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.13em;
    line-height: 1.5;
  }

  #forma-contact-{{ section.id }} .forma-contact__field label span {
    color: var(--fc-muted);
  }

  #forma-contact-{{ section.id }} .forma-contact__field input,
  #forma-contact-{{ section.id }} .forma-contact__field textarea {
    display: block;
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0 0 16px;
    border: 0;
    border-bottom: 1px solid var(--fc-line);
    border-radius: 0;
    outline: none;
    background: transparent;
    box-shadow: none;
    color: var(--fc-text);
    font-family: inherit;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.7;
    transition: border-color 220ms ease;
  }

  #forma-contact-{{ section.id }} .forma-contact__field input {
    min-height: 42px;
  }

  #forma-contact-{{ section.id }} .forma-contact__field textarea {
    min-height: 155px;
    padding-top: 2px;
    resize: vertical;
  }

  #forma-contact-{{ section.id }} .forma-contact__field input::placeholder,
  #forma-contact-{{ section.id }} .forma-contact__field textarea::placeholder {
    color: #999891;
    opacity: 1;
  }

  #forma-contact-{{ section.id }} .forma-contact__field input:focus,
  #forma-contact-{{ section.id }} .forma-contact__field textarea:focus {
    border-bottom-color: var(--fc-text);
  }

  #forma-contact-{{ section.id }} .forma-contact__field--message {
    grid-column: 1 / -1;
    padding-top: 34px;
  }

  #forma-contact-{{ section.id }} .forma-contact__form-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
    margin-top: 34px;
  }

  #forma-contact-{{ section.id }} .forma-contact__privacy {
    max-width: 300px;
    margin: 0;
    color: var(--fc-muted);
    font-size: 10px;
    line-height: 1.8;
  }

  /* SUBMIT BUTTON */

  #forma-contact-{{ section.id }} .forma-contact__submit {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
    min-width: 230px;
    min-height: 58px;
    padding: 0 22px;
    border: 1px solid var(--fc-text);
    border-radius: 0;
    background: var(--fc-text);
    color: #fff;
    cursor: pointer;
    font-family: inherit;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.13em;
    line-height: 1.4;
    text-align: left;
    text-transform: uppercase;
    transition:
      background 250ms ease,
      color 250ms ease,
      border-color 250ms ease;
  }

  #forma-contact-{{ section.id }} .forma-contact__submit-arrow {
    font-size: 21px;
    font-weight: 300;
    transition: transform 250ms ease;
  }

  #forma-contact-{{ section.id }} .forma-contact__submit:hover {
    background: transparent;
    color: var(--fc-text);
  }

  #forma-contact-{{ section.id }} .forma-contact__submit:hover .forma-contact__submit-arrow {
    transform: translate(3px, -3px);
  }

  #forma-contact-{{ section.id }} .forma-contact__submit:focus-visible,
  #forma-contact-{{ section.id }} .forma-contact__email:focus-visible {
    outline: 2px solid var(--fc-text);
    outline-offset: 5px;
  }

  /* FORM FEEDBACK */

  #forma-contact-{{ section.id }} .forma-contact__notice {
    display: flex;
    gap: 14px;
    margin: 0 0 20px;
    padding: 18px;
    border: 1px solid var(--fc-line);
    font-size: 12px;
    line-height: 1.7;
  }

  #forma-contact-{{ section.id }} .forma-contact__notice p {
    margin: 4px 0 0;
  }

  #forma-contact-{{ section.id }} .forma-contact__notice--success {
    background: rgba(255, 255, 255, 0.4);
  }

  #forma-contact-{{ section.id }} .forma-contact__notice--error {
    border-color: #b64a42;
  }

  #forma-contact-{{ section.id }} .forma-contact__notice-mark {
    font-size: 17px;
  }

  /* TABLET */

  @media screen and (max-width: 900px) {
    #forma-contact-{{ section.id }} .forma-contact__inner {
      padding-top: 45px;
      padding-bottom: 55px;
    }

    #forma-contact-{{ section.id }} .forma-contact__main {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: 32px;
    }

    #forma-contact-{{ section.id }} .forma-contact__form-column {
      padding-left: 28px;
    }

    #forma-contact-{{ section.id }} .forma-contact__form-bottom {
      align-items: stretch;
      flex-direction: column;
      gap: 22px;
    }

    #forma-contact-{{ section.id }} .forma-contact__submit {
      width: 100%;
    }
  }

  /* MOBILE */

  @media screen and (max-width: 640px) {
    #forma-contact-{{ section.id }} .forma-contact__inner {
      padding: 28px 22px 42px;
    }

    #forma-contact-{{ section.id }} .forma-contact__main {
      grid-template-columns: minmax(0, 1fr);
      gap: 38px;
      padding: 27px 0 36px;
    }

    #forma-contact-{{ section.id }} .forma-contact__eyebrow {
      margin-bottom: 32px;
    }

    #forma-contact-{{ section.id }} .forma-contact__title {
      max-width: 100%;
      margin-bottom: 18px;
      font-size: clamp(43px, 12vw, 64px);
    }

    #forma-contact-{{ section.id }} .forma-contact__description {
      max-width: 100%;
      font-size: 13px;
    }

    #forma-contact-{{ section.id }} .forma-contact__email-block {
      margin-top: 0;
      padding-top: 32px;
    }

    #forma-contact-{{ section.id }} .forma-contact__note {
      margin-top: 16px;
    }

    #forma-contact-{{ section.id }} .forma-contact__form-column {
      padding: 28px 0 0;
      border-top: 1px solid var(--fc-line);
      border-left: 0;
    }

    #forma-contact-{{ section.id }} .forma-contact__form-heading {
      align-items: flex-start;
      gap: 12px;
    }

    #forma-contact-{{ section.id }} .forma-contact__required {
      max-width: 120px;
      line-height: 1.7;
    }

    #forma-contact-{{ section.id }} .forma-contact__fields {
      grid-template-columns: minmax(0, 1fr);
      column-gap: 0;
    }

    #forma-contact-{{ section.id }} .forma-contact__field {
      padding-top: 25px;
    }

    #forma-contact-{{ section.id }} .forma-contact__field--message {
      grid-column: auto;
      padding-top: 28px;
    }

    #forma-contact-{{ section.id }} .forma-contact__field textarea {
      min-height: 125px;
    }

    #forma-contact-{{ section.id }} .forma-contact__form-bottom {
      margin-top: 28px;
    }

    #forma-contact-{{ section.id }} .forma-contact__submit {
      min-height: 56px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #forma-contact-{{ section.id }} *,
    #forma-contact-{{ section.id }} *::before,
    #forma-contact-{{ section.id }} *::after {
      transition-duration: 0.01ms !important;
    }
  }
</style>

{% schema %}
{
  "name": "FORMA Contact",
  "tag": "section",
  "class": "shopify-section--forma-contact",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "YOUR MESSAGE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "What brings you to Forma?"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Introduction",
      "default": "<p>Tell us a little about what you have in mind. Whether it is a question, a partnership or a creative idea, we are listening.</p>"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email",
      "default": "Customercare@formacopenhagen.com"
    },
    {
      "type": "textarea",
      "id": "email_note",
      "label": "Email note",
      "default": "For questions about a product, delivery or return, please contact the brand you purchased from directly."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SEND YOUR MESSAGE"
    }
  ],
  "presets": [
    {
      "name": "FORMA Contact"
    }
  ]
}
{% endschema %}
