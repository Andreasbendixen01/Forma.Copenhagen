
{%- liquid
  assign contact_email = section.settings.contact_email | strip
  assign contact_heading = section.settings.heading
-%}

<section
  id="forma-contact-{{ section.id }}"
  class="forma-contact"
>
  <div class="forma-contact__inner">

    <!-- HERO -->
    <header class="forma-contact__hero">
      <div class="forma-contact__eyebrow">
        <span class="forma-contact__eyebrow-line"></span>
        <span>{{ section.settings.eyebrow | escape }}</span>
      </div>

      <div class="forma-contact__hero-main">
        <h1 class="forma-contact__headline">
          {{ contact_heading | escape }}
        </h1>

        <p class="forma-contact__intro">
          {{ section.settings.intro | escape }}
        </p>
      </div>

      <div class="forma-contact__location">
        <span>COPENHAGEN, DENMARK</span>
        <span class="forma-contact__location-divider"></span>
        <span>SCANDINAVIA AND BEYOND</span>
      </div>
    </header>

    <!-- CONTACT CONTENT -->
    <div class="forma-contact__content">

      <!-- CONTACT DETAILS -->
      <aside class="forma-contact__details">
        <div class="forma-contact__section-label">
          <span>01</span>
          <span class="forma-contact__label-line"></span>
          <span>CONTACT DETAILS</span>
        </div>

        <div class="forma-contact__details-main">
          <h2 class="forma-contact__details-title">
            Prefer a direct conversation?
          </h2>

          <p class="forma-contact__details-copy">
            For general enquiries, partnerships and other questions,
            feel free to reach out to us directly.
          </p>
        </div>

        <div class="forma-contact__email-block">
          <span class="forma-contact__micro-label">
            GENERAL ENQUIRIES
          </span>

          <a
            class="forma-contact__email"
            href="mailto:{{ contact_email | escape }}"
          >
            <span>{{ contact_email | escape }}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7 17 17 7M7 7h10v10"/>
            </svg>
          </a>
        </div>

        <div class="forma-contact__details-note">
          <p>
            For questions about a product, delivery or return,
            please contact the brand you purchased from directly.
          </p>
        </div>
      </aside>

      <!-- CONTACT FORM -->
      <div class="forma-contact__form-panel">
        <div class="forma-contact__form-heading">
          <div class="forma-contact__section-label">
            <span>02</span>
            <span class="forma-contact__label-line"></span>
            <span>SEND US A MESSAGE</span>
          </div>

          <span class="forma-contact__required-note">
            * REQUIRED
          </span>
        </div>

        {%- form 'contact', class: 'forma-contact__form' -%}

          {%- if form.posted_successfully? -%}
            <div
              class="forma-contact__notice forma-contact__notice--success"
              role="status"
              tabindex="-1"
            >
              Thank you for reaching out. We will be in touch soon.
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div
              class="forma-contact__notice forma-contact__notice--error"
              role="alert"
              tabindex="-1"
            >
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="forma-contact__fields">

            <div class="forma-contact__field">
              <label for="FormaContactName-{{ section.id }}">
                FULL NAME <span>*</span>
              </label>

              <input
                id="FormaContactName-{{ section.id }}"
                type="text"
                name="contact[name]"
                autocomplete="name"
                placeholder="Your full name"
                value="{{ form.name | escape }}"
                required
              >
            </div>

            <div class="forma-contact__field">
              <label for="FormaContactEmail-{{ section.id }}">
                E-MAIL ADDRESS <span>*</span>
              </label>

              <input
                id="FormaContactEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                autocomplete="email"
                placeholder="Your e-mail address"
                value="{{ form.email | escape }}"
                autocorrect="off"
                autocapitalize="off"
                required
              >
            </div>

            <div class="forma-contact__field forma-contact__field--message">
              <label for="FormaContactMessage-{{ section.id }}">
                YOUR MESSAGE <span>*</span>
              </label>

              <textarea
                id="FormaContactMessage-{{ section.id }}"
                name="contact[body]"
                rows="5"
                placeholder="Tell us what is on your mind..."
                required
              >{{ form.body | escape }}</textarea>
            </div>

          </div>

          <div class="forma-contact__form-bottom">
            <p class="forma-contact__privacy">
              Your information will only be used to respond to your enquiry.
            </p>

            <button
              type="submit"
              class="forma-contact__submit"
            >
              <span>SEND YOUR MESSAGE</span>

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 17 17 7M7 7h10v10"/>
              </svg>
            </button>
          </div>

        {%- endform -%}
      </div>

    </div>

    <!-- BOTTOM DIVIDER -->
    <div class="forma-contact__bottom-line"></div>

  </div>
</section>

<style>
  /* =========================================
     FORMA CONTACT — EDITORIAL REFINED
     ========================================= */

  #forma-contact-{{ section.id }} {
    --fc-background: #f5f4f0;
    --fc-foreground: #191919;
    --fc-muted: #85847e;
    --fc-line: rgba(25, 25, 25, 0.15);
    --fc-inset: clamp(24px, 5.2vw, 88px);

    display: block;
    width: 100%;
    overflow: hidden;
    background: var(--fc-background);
    color: var(--fc-foreground);
    font-family: inherit;
  }

  #forma-contact-{{ section.id }} *,
  #forma-contact-{{ section.id }} *::before,
  #forma-contact-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #forma-contact-{{ section.id }} .forma-contact__inner {
    width: 100%;
    max-width: 1920px;
    margin-inline: auto;
    padding: clamp(48px, 5.5vw, 88px) var(--fc-inset)
      clamp(30px, 4vw, 64px);
  }

  /* HERO */

  #forma-contact-{{ section.id }} .forma-contact__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: clamp(34px, 4.5vw, 68px);
    color: var(--fc-muted);
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 0.16em;
    line-height: 1.5;
  }

  #forma-contact-{{ section.id }} .forma-contact__eyebrow-line {
    display: block;
    width: 25px;
    height: 1px;
    flex: 0 0 25px;
    background: var(--fc-muted);
  }

  #forma-contact-{{ section.id }} .forma-contact__hero-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 0.31fr);
    align-items: end;
    column-gap: clamp(30px, 4vw, 70px);
  }

  #forma-contact-{{ section.id }} .forma-contact__headline {
    margin: 0;
    max-width: 100%;
    color: var(--fc-foreground);
    font-size: clamp(36px, 4.2vw, 68px);
    font-weight: 400;
    letter-spacing: -0.075em;
    line-height: 1.02;
    white-space: nowrap;
  }

  #forma-contact-{{ section.id }} .forma-contact__intro {
    max-width: 330px;
    margin: 0 0 5px auto;
    color: var(--fc-muted);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.95;
  }

  #forma-contact-{{ section.id }} .forma-contact__location {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: clamp(36px, 4.5vw, 66px);
    padding: 21px 0 23px;
    border-top: 1px solid var(--fc-line);
    color: var(--fc-muted);
    font-size: 9px;
    font-weight: 650;
    letter-spacing: 0.13em;
  }

  #forma-contact-{{ section.id }} .forma-contact__location-divider {
    display: block;
    width: 23px;
    height: 1px;
    background: var(--fc-line);
  }

  /* TWO-COLUMN LAYOUT */

  #forma-contact-{{ section.id }} .forma-contact__content {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.6fr);
    gap: clamp(40px, 6.3vw, 110px);
    align-items: stretch;
    padding: clamp(38px, 4.5vw, 66px) 0
      clamp(46px, 5.5vw, 82px);
    border-top: 1px solid var(--fc-line);
  }

  #forma-contact-{{ section.id }} .forma-contact__details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    padding-right: clamp(28px, 4vw, 64px);
    border-right: 1px solid var(--fc-line);
  }

  #forma-contact-{{ section.id }} .forma-contact__section-label {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--fc-muted);
    font-size: 9px;
    font-weight: 650;
    letter-spacing: 0.14em;
    line-height: 1.5;
  }

  #forma-contact-{{ section.id }} .forma-contact__label-line {
    display: block;
    width: 22px;
    height: 1px;
    flex: 0 0 22px;
    background: var(--fc-line);
  }

  #forma-contact-{{ section.id }} .forma-contact__details-main {
    margin-top: clamp(34px, 4vw, 54px);
  }

  #forma-contact-{{ section.id }} .forma-contact__details-title {
    max-width: 360px;
    margin: 0 0 21px;
    font-size: clamp(29px, 2.8vw, 42px);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 1.12;
  }

  #forma-contact-{{ section.id }} .forma-contact__details-copy {
    max-width: 355px;
    margin: 0;
    color: var(--fc-muted);
    font-size: 13px;
    line-height: 1.95;
  }

  #forma-contact-{{ section.id }} .forma-contact__email-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    width: 100%;
    margin-top: clamp(36px, 4.5vw, 60px);
  }

  #forma-contact-{{ section.id }} .forma-contact__micro-label {
    color: var(--fc-muted);
    font-size: 9px;
    font-weight: 650;
    letter-spacing: 0.15em;
  }

  #forma-contact-{{ section.id }} .forma-contact__email {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    max-width: 100%;
    color: var(--fc-foreground);
    font-size: 13px;
    line-height: 1.7;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: opacity 180ms ease;
  }

  #forma-contact-{{ section.id }} .forma-contact__email:hover {
    opacity: 0.58;
  }

  #forma-contact-{{ section.id }} .forma-contact__email svg,
  #forma-contact-{{ section.id }} .forma-contact__submit svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: 0 0 auto;
  }

  #forma-contact-{{ section.id }} .forma-contact__details-note {
    width: 100%;
    margin-top: auto;
    padding-top: clamp(26px, 3vw, 40px);
  }

  #forma-contact-{{ section.id }} .forma-contact__details-note p {
    max-width: 360px;
    margin: 0;
    padding-top: 22px;
    border-top: 1px solid var(--fc-line);
    color: var(--fc-muted);
    font-size: 11px;
    line-height: 1.95;
  }

  /* FORM */

  #forma-contact-{{ section.id }} .forma-contact__form-panel {
    min-width: 0;
  }

  #forma-contact-{{ section.id }} .forma-contact__form-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding-bottom: 25px;
    border-bottom: 1px solid var(--fc-line);
  }

  #forma-contact-{{ section.id }} .forma-contact__required-note {
    color: var(--fc-muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  #forma-contact-{{ section.id }} .forma-contact__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(22px, 3vw, 46px);
    row-gap: clamp(27px, 3vw, 42px);
    padding-top: 7px;
  }

  #forma-contact-{{ section.id }} .forma-contact__field {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding-top: 25px;
  }

  #forma-contact-{{ section.id }} .forma-contact__field label {
    display: block;
    margin-bottom: 18px;
    color: var(--fc-foreground);
    font-size: 9px;
    font-weight: 650;
    letter-spacing: 0.13em;
  }

  #forma-contact-{{ section.id }} .forma-contact__field label span {
    color: var(--fc-muted);
  }

  #forma-contact-{{ section.id }} .forma-contact__field input,
  #forma-contact-{{ section.id }} .forma-contact__field textarea {
    display: block;
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0 0 17px;
    border: 0;
    border-bottom: 1px solid var(--fc-line);
    border-radius: 0;
    outline: none;
    background: transparent;
    color: var(--fc-foreground);
    font: inherit;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.8;
    box-shadow: none;
    -webkit-appearance: none;
    appearance: none;
    transition: border-color 220ms ease;
  }

  #forma-contact-{{ section.id }} .forma-contact__field input {
    min-height: 43px;
  }

  #forma-contact-{{ section.id }} .forma-contact__field textarea {
    min-height: 145px;
    resize: vertical;
  }

  #forma-contact-{{ section.id }} .forma-contact__field input::placeholder,
  #forma-contact-{{ section.id }} .forma-contact__field textarea::placeholder {
    color: #999891;
    opacity: 1;
  }

  #forma-contact-{{ section.id }} .forma-contact__field input:focus,
  #forma-contact-{{ section.id }} .forma-contact__field textarea:focus {
    border-bottom-color: var(--fc-foreground);
  }

  #forma-contact-{{ section.id }} .forma-contact__field--message {
    grid-column: 1 / -1;
    padding-top: 0;
  }

  #forma-contact-{{ section.id }} .forma-contact__form-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
    margin-top: clamp(30px, 3.5vw, 48px);
  }

  #forma-contact-{{ section.id }} .forma-contact__privacy {
    max-width: 340px;
    margin: 0;
    color: var(--fc-muted);
    font-size: 10px;
    line-height: 1.9;
  }

  #forma-contact-{{ section.id }} .forma-contact__submit {
    display: inline-flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    min-width: 245px;
    min-height: 60px;
    padding: 18px 21px;
    border: 1px solid var(--fc-foreground);
    border-radius: 0;
    background: var(--fc-foreground);
    color: #fff;
    cursor: pointer;
    font-family: inherit;
    font-size: 9px;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-align: left;
    transition:
      background 220ms ease,
      color 220ms ease,
      border-color 220ms ease;
  }

  #forma-contact-{{ section.id }} .forma-contact__submit:hover {
    background: transparent;
    color: var(--fc-foreground);
  }

  #forma-contact-{{ section.id }} .forma-contact__submit svg {
    width: 20px;
    height: 20px;
    transition: transform 220ms ease;
  }

  #forma-contact-{{ section.id }} .forma-contact__submit:hover svg {
    transform: translate(2px, -2px);
  }

  /* FORM FEEDBACK */

  #forma-contact-{{ section.id }} .forma-contact__notice {
    margin: 24px 0 0;
    padding: 20px 22px;
    border: 1px solid var(--fc-line);
    font-size: 13px;
    line-height: 1.8;
  }

  #forma-contact-{{ section.id }} .forma-contact__notice--success {
    background: rgba(255, 255, 255, 0.45);
  }

  #forma-contact-{{ section.id }} .forma-contact__notice--error {
    border-color: #a33c32;
    color: #a33c32;
  }

  #forma-contact-{{ section.id }} .forma-contact__notice ul {
    margin: 8px 0 0;
    padding-left: 20px;
  }

  /* BOTTOM */

  #forma-contact-{{ section.id }} .forma-contact__bottom-line {
    width: 100%;
    height: 1px;
    background: var(--fc-line);
  }

  /* TABLET */

  @media screen and (max-width: 1050px) {
    #forma-contact-{{ section.id }} .forma-contact__headline {
      font-size: clamp(33px, 4vw, 48px);
    }

    #forma-contact-{{ section.id }} .forma-contact__hero-main {
      grid-template-columns: minmax(0, 1fr) minmax(190px, 0.35fr);
      gap: 28px;
    }

    #forma-contact-{{ section.id }} .forma-contact__content {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.5fr);
      gap: 38px;
    }

    #forma-contact-{{ section.id }} .forma-contact__details {
      padding-right: 28px;
    }

    #forma-contact-{{ section.id }} .forma-contact__form-bottom {
      align-items: flex-start;
      flex-direction: column;
    }

    #forma-contact-{{ section.id }} .forma-contact__submit {
      width: 100%;
    }
  }

  /* MOBILE */

  @media screen and (max-width: 700px) {
    #forma-contact-{{ section.id }} {
      --fc-inset: 23px;
    }

    #forma-contact-{{ section.id }} .forma-contact__inner {
      padding-top: 42px;
      padding-bottom: 32px;
    }

    #forma-contact-{{ section.id }} .forma-contact__eyebrow {
      margin-bottom: 35px;
    }

    #forma-contact-{{ section.id }} .forma-contact__hero-main {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 23px;
    }

    #forma-contact-{{ section.id }} .forma-contact__headline {
      max-width: 100%;
      font-size: clamp(38px, 9vw, 58px);
      line-height: 1.04;
      letter-spacing: -0.075em;
      white-space: normal;
      overflow-wrap: anywhere;
    }

    #forma-contact-{{ section.id }} .forma-contact__intro {
      max-width: 380px;
      margin: 0;
      font-size: 13px;
    }

    #forma-contact-{{ section.id }} .forma-contact__location {
      gap: 10px;
      margin-top: 31px;
      padding: 19px 0 20px;
      font-size: 8px;
      letter-spacing: 0.09em;
    }

    #forma-contact-{{ section.id }} .forma-contact__location-divider {
      width: 15px;
      flex-basis: 15px;
    }

    #forma-contact-{{ section.id }} .forma-contact__content {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
      padding: 30px 0 38px;
    }

    #forma-contact-{{ section.id }} .forma-contact__details {
      padding: 0 0 32px;
      border-right: 0;
      border-bottom: 1px solid var(--fc-line);
    }

    #forma-contact-{{ section.id }} .forma-contact__details-main {
      margin-top: 29px;
    }

    #forma-contact-{{ section.id }} .forma-contact__details-title {
      max-width: 350px;
      margin-bottom: 15px;
      font-size: clamp(30px, 7vw, 40px);
    }

    #forma-contact-{{ section.id }} .forma-contact__details-copy {
      max-width: 400px;
    }

    #forma-contact-{{ section.id }} .forma-contact__email-block {
      gap: 14px;
      margin-top: 29px;
    }

    #forma-contact-{{ section.id }} .forma-contact__details-note {
      margin-top: 25px;
      padding-top: 0;
    }

    #forma-contact-{{ section.id }} .forma-contact__details-note p {
      padding-top: 19px;
    }

    #forma-contact-{{ section.id }} .forma-contact__form-heading {
      align-items: flex-start;
      padding-bottom: 20px;
    }

    #forma-contact-{{ section.id }} .forma-contact__section-label {
      gap: 9px;
      font-size: 8px;
      letter-spacing: 0.11em;
    }

    #forma-contact-{{ section.id }} .forma-contact__label-line {
      width: 16px;
      flex-basis: 16px;
    }

    #forma-contact-{{ section.id }} .forma-contact__required-note {
      font-size: 8px;
    }

    #forma-contact-{{ section.id }} .forma-contact__fields {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 20px;
      padding-top: 0;
    }

    #forma-contact-{{ section.id }} .forma-contact__field {
      padding-top: 22px;
    }

    #forma-contact-{{ section.id }} .forma-contact__field label {
      margin-bottom: 13px;
    }

    #forma-contact-{{ section.id }} .forma-contact__field input,
    #forma-contact-{{ section.id }} .forma-contact__field textarea {
      font-size: 13px;
    }

    #forma-contact-{{ section.id }} .forma-contact__field--message {
      grid-column: auto;
      padding-top: 2px;
    }

    #forma-contact-{{ section.id }} .forma-contact__field textarea {
      min-height: 120px;
    }

    #forma-contact-{{ section.id }} .forma-contact__form-bottom {
      gap: 22px;
      margin-top: 26px;
    }

    #forma-contact-{{ section.id }} .forma-contact__privacy {
      max-width: 320px;
    }

    #forma-contact-{{ section.id }} .forma-contact__submit {
      min-height: 57px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #forma-contact-{{ section.id }} *,
    #forma-contact-{{ section.id }} *::before,
    #forma-contact-{{ section.id }} *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>

{% schema %}
{
  "name": "FORMA Contact",
  "tag": "section",
  "class": "shopify-section--forma-contact",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "WE WOULD LOVE TO HEAR FROM YOU"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Every good thing starts with a conversation."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "A question, a collaboration or an idea worth sharing. Whatever brings you here, there's a place for it at Forma."
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email",
      "default": "Customercare@formacopenhagen.com"
    }
  ],
  "presets": [
