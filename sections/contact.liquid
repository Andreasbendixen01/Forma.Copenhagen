
{% comment %}
  FORMA — Contact
  Minimal editorial contact page
{% endcomment %}

<section id="forma-contact-{{ section.id }}" class="forma-contact">
  <div class="forma-contact__inner">

    <header class="forma-contact__intro">
      <div class="forma-contact__eyebrow">
        <span class="forma-contact__eyebrow-line"></span>
        <span>{{ section.settings.eyebrow | escape }}</span>
      </div>

      <div class="forma-contact__hero">
        <h1 class="forma-contact__title">
          {{ section.settings.heading | escape }}
        </h1>

        <div class="forma-contact__intro-copy">
          {{ section.settings.intro_text | escape }}
        </div>
      </div>

      <div class="forma-contact__location">
        <span>{{ section.settings.location_left | escape }}</span>
        <span class="forma-contact__location-divider"></span>
        <span>{{ section.settings.location_right | escape }}</span>
      </div>
    </header>

    <div class="forma-contact__content">

      <aside class="forma-contact__details">
        <div class="forma-contact__section-label">
          <span>01</span>
          <span class="forma-contact__label-line"></span>
          <span>{{ section.settings.details_label | escape }}</span>
        </div>

        <h2 class="forma-contact__details-title">
          {{ section.settings.details_heading | escape | newline_to_br }}
        </h2>

        <p class="forma-contact__details-copy">
          {{ section.settings.details_text | escape }}
        </p>

        <div class="forma-contact__email-block">
          <span class="forma-contact__micro-label">
            {{ section.settings.email_label | escape }}
          </span>

          <a
            class="forma-contact__email"
            href="mailto:{{ section.settings.contact_email | escape }}"
          >
            <span>{{ section.settings.contact_email | escape }}</span>
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 15L15 5M6 5H15V14"
                stroke="currentColor" stroke-width="1.3"
                stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <div class="forma-contact__details-note">
          {{ section.settings.note_text | escape }}
        </div>
      </aside>

      <div class="forma-contact__form-area">
        <div class="forma-contact__form-heading">
          <div class="forma-contact__section-label">
            <span>02</span>
            <span class="forma-contact__label-line"></span>
            <span>{{ section.settings.form_label | escape }}</span>
          </div>

          <span class="forma-contact__required-note">
            * {{ section.settings.required_text | escape }}
          </span>
        </div>

        {% form 'contact', id: 'FormaContactForm', class: 'forma-contact__form' %}

          {% if form.posted_successfully? %}
            <div class="forma-contact__message" role="status" tabindex="-1">
              {{ section.settings.success_message | escape }}
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="forma-contact__message forma-contact__message--error" role="alert">
              <p>{{ section.settings.error_message | escape }}</p>
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="forma-contact__fields">
            <div class="forma-contact__field">
              <label for="FormaContactName">
                {{ section.settings.name_label | escape }} *
              </label>
              <input
                id="FormaContactName"
                type="text"
                name="contact[name]"
                autocomplete="name"
                placeholder="{{ section.settings.name_placeholder | escape }}"
                value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
                required
              >
            </div>

            <div class="forma-contact__field">
              <label for="FormaContactEmail">
                {{ section.settings.visitor_email_label | escape }} *
              </label>
              <input
                id="FormaContactEmail"
                type="email"
                name="contact[email]"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="{{ section.settings.email_placeholder | escape }}"
                value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
                required
              >
            </div>

            <div class="forma-contact__field forma-contact__field--message">
              <label for="FormaContactMessage">
                {{ section.settings.message_label | escape }} *
              </label>
              <textarea
                id="FormaContactMessage"
                name="contact[body]"
                rows="4"
                placeholder="{{ section.settings.message_placeholder | escape }}"
                required
              >{{ form.body | escape }}</textarea>
            </div>
          </div>

          <div class="forma-contact__form-bottom">
            <p class="forma-contact__privacy">
              {{ section.settings.privacy_text | escape }}
            </p>

            <button type="submit" class="forma-contact__submit">
              <span>{{ section.settings.button_text | escape }}</span>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 19L19 5M8 5H19V16"
                  stroke="currentColor" stroke-width="1.4"
                  stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>

        {% endform %}
      </div>
    </div>

    <div class="forma-contact__bottom-line"></div>
  </div>
</section>

<style>
  #forma-contact-{{ section.id }} {
    --fc-bg: {{ section.settings.background_color }};
    --fc-text: {{ section.settings.text_color }};
    --fc-muted: {{ section.settings.muted_color }};
    --fc-border: {{ section.settings.border_color }};
    --fc-button: {{ section.settings.button_color }};
    --fc-button-text: {{ section.settings.button_text_color }};

    background: var(--fc-bg);
    color: var(--fc-text);
    width: 100%;
    overflow: hidden;
  }

  #forma-contact-{{ section.id }} *,
  #forma-contact-{{ section.id }} *::before,
  #forma-contact-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #forma-contact-{{ section.id }} .forma-contact__inner {
    width: min(100% - 10.4%, 1440px);
    margin-inline: auto;
    padding-top: clamp(38px, 5vw, 76px);
  }

  #forma-contact-{{ section.id }} .forma-contact__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: clamp(28px, 4vw, 54px);
    color: var(--fc-muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  #forma-contact-{{ section.id }} .forma-contact__eyebrow-line {
    width: 25px;
    height: 1px;
    flex: 0 0 25px;
    background: var(--fc-muted);
  }

  #forma-contact-{{ section.id }} .forma-contact__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, .35fr);
    align-items: end;
    gap: clamp(30px, 4vw, 70px);
  }

  #forma-contact-{{ section.id }} .forma-contact__title {
    margin: 0;
    color: var(--fc-text);
    font-size: clamp(35px, 4.05vw, 64px);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -.075em;
    white-space: nowrap;
  }

  #forma-contact-{{ section.id }} .forma-contact__intro-copy {
    max-width: 350px;
    justify-self: end;
    padding-bottom: 5px;
    color: var(--fc-muted);
    font-size: 12px;
    line-height: 1.9;
  }

  #forma-contact-{{ section.id }} .forma-contact__location {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(25px, 3vw, 40px);
    padding: 17px 0 19px;
    border-top: 1px solid var(--fc-border);
    color: var(--fc-muted);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  #forma-contact-{{ section.id }} .forma-contact__location-divider {
    width: 20px;
    height: 1px;
    background: var(--fc-border);
  }

  #forma-contact-{{ section.id }} .forma-contact__content {
    display: grid;
    grid-template-columns: minmax(220px, .72fr) minmax(0, 1.5fr);
    gap: clamp(35px, 6vw, 90px);
    padding: clamp(30px, 4vw, 50px) 0 clamp(36px, 4.5vw, 60px);
  }

  #forma-contact-{{ section.id }} .forma-contact__details {
    min-width: 0;
    padding-right: clamp(24px, 4vw, 55px);
    border-right: 1px solid var(--fc-border);
  }

  #forma-contact-{{ section.id }} .forma-contact__section-label {
    display: flex;
    align-items: center;
    gap: 11px;
    color: var(--fc-muted);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  #forma-contact-{{ section.id }} .forma-contact__label-line {
    width: 22px;
    height: 1px;
    flex: 0 0 22px;
    background: var(--fc-border);
  }

  #forma-contact-{{ section.id }} .forma-contact__details-title {
    margin: 32px 0 14px;
    font-size: clamp(25px, 2.5vw, 36px);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -.055em;
  }

  #forma-contact-{{ section.id }} .forma-contact__details-copy {
    margin: 0;
    max-width: 350px;
    color: var(--fc-muted);
    font-size: 11px;
    line-height: 1.9;
  }

  #forma-contact-{{ section.id }} .forma-contact__email-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 13px;
    margin-top: 32px;
  }

  #forma-contact-{{ section.id }} .forma-contact__micro-label {
    color: var(--fc-muted);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  #forma-contact-{{ section.id }} .forma-contact__email {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    max-width: 100%;
    color: var(--fc-text);
    font-size: 11px;
    line-height: 1.7;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: opacity .18s ease;
  }

  #forma-contact-{{ section.id }} .forma-contact__email:hover {
    opacity: .58;
  }

  #forma-contact-{{ section.id }} .forma-contact__email svg {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
  }

  #forma-contact-{{ section.id }} .forma-contact__details-note {
    margin-top: 27px;
    padding-top: 19px;
    border-top: 1px solid var(--fc-border);
    color: var(--fc-muted);
    font-size: 10px;
    line-height: 1.8;
  }

  #forma-contact-{{ section.id }} .forma-contact__form-area {
    min-width: 0;
  }

  #forma-contact-{{ section.id }} .forma-contact__form-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-bottom: 19px;
    border-bottom: 1px solid var(--fc-border);
  }

  #forma-contact-{{ section.id }} .forma-contact__required-note {
    color: var(--fc-muted);
    font-size: 8px;
    letter-spacing: .12em;
    text-align: right;
    text-transform: uppercase;
  }

  #forma-contact-{{ section.id }} .forma-contact__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 26px;
    row-gap: 23px;
  }

  #forma-contact-{{ section.id }} .forma-contact__field {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding-top: 24px;
  }

  #forma-contact-{{ section.id }} .forma-contact__field label {
    display: block;
    margin-bottom: 12px;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  #forma-contact-{{ section.id }} .forma-contact__field input,
  #forma-contact-{{ section.id }} .forma-contact__field textarea {
    display: block;
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0 0 12px;
    border: 0;
    border-bottom: 1px solid var(--fc-border);
    border-radius: 0;
    outline: none;
    box-shadow: none;
    background: transparent;
    color: var(--fc-text);
    font: inherit;
    font-size: 12px;
    line-height: 1.7;
    appearance: none;
    transition: border-color .18s ease;
  }

  #forma-contact-{{ section.id }} .forma-contact__field input {
    min-height: 34px;
  }

  #forma-contact-{{ section.id }} .forma-contact__field textarea {
    min-height: 100px;
    resize: vertical;
  }

  #forma-contact-{{ section.id }} .forma-contact__field input::placeholder,
  #forma-contact-{{ section.id }} .forma-contact__field textarea::placeholder {
    color: var(--fc-muted);
    opacity: .75;
  }

  #forma-contact-{{ section.id }} .forma-contact__field input:focus,
  #forma-contact-{{ section.id }} .forma-contact__field textarea:focus {
    border-bottom-color: var(--fc-text);
  }

  #forma-contact-{{ section.id }} .forma-contact__field--message {
    grid-column: 1 / -1;
    padding-top: 0;
  }

  #forma-contact-{{ section.id }} .forma-contact__form-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    margin-top: 24px;
  }

  #forma-contact-{{ section.id }} .forma-contact__privacy {
    max-width: 310px;
    margin: 0;
    color: var(--fc-muted);
    font-size: 9px;
    line-height: 1.8;
  }

  #forma-contact-{{ section.id }} .forma-contact__submit {
    display: inline-flex;
    justify-content: space-between;
    align-items: center;
    gap: 28px;
    min-width: 205px;
    min-height: 49px;
    padding: 0 17px;
    border: 1px solid var(--fc-button);
    border-radius: 0;
    background: var(--fc-button);
    color: var(--fc-button-text);
    font-family: inherit;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: .14em;
    text-align: left;
    text-transform: uppercase;
    cursor: pointer;
    transition: background .22s ease, color .22s ease;
  }

  #forma-contact-{{ section.id }} .forma-contact__submit svg {
    width: 19px;
    height: 19px;
    flex: 0 0 19px;
    transition: transform .22s ease;
  }

  #forma-contact-{{ section.id }} .forma-contact__submit:hover {
    background: transparent;
    color: var(--fc-text);
  }

  #forma-contact-{{ section.id }} .forma-contact__submit:hover svg {
    transform: translate(2px, -2px);
  }

  #forma-contact-{{ section.id }} .forma-contact__message {
    margin-top: 20px;
    padding: 15px 17px;
    border: 1px solid var(--fc-border);
    font-size: 12px;
    line-height: 1.7;
  }

  #forma-contact-{{ section.id }} .forma-contact__message--error {
    border-left: 2px solid #9a3c32;
  }

  #forma-contact-{{ section.id }} .forma-contact__bottom-line {
    width: 100%;
    height: 1px;
    background: var(--fc-border);
  }

  @media screen and (max-width: 1100px) {
    #forma-contact-{{ section.id }} .forma-contact__title {
      font-size: clamp(30px, 3.7vw, 42px);
      letter-spacing: -.065em;
    }

    #forma-contact-{{ section.id }} .forma-contact__hero {
      grid-template-columns: minmax(0, 1fr) minmax(190px, .38fr);
      gap: 25px;
    }
  }

  @media screen and (max-width: 900px) {
    #forma-contact-{{ section.id }} .forma-contact__inner {
      width: calc(100% - 48px);
    }

    #forma-contact-{{ section.id }} .forma-contact__hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }

    #forma-contact-{{ section.id }} .forma-contact__title {
      font-size: clamp(35px, 5.4vw, 50px);
      white-space: normal;
    }

    #forma-contact-{{ section.id }} .forma-contact__intro-copy {
      justify-self: start;
      max-width: 480px;
    }

    #forma-contact-{{ section.id }} .forma-contact__content {
      grid-template-columns: minmax(190px, .7fr) minmax(0, 1.4fr);
      gap: 30px;
    }

    #forma-contact-{{ section.id }} .forma-contact__details {
      padding-right: 25px;
    }

    #forma-contact-{{ section.id }} .forma-contact__fields {
      column-gap: 20px;
    }

    #forma-contact-{{ section.id }} .forma-contact__form-bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media screen and (max-width: 640px) {
    #forma-contact-{{ section.id }} .forma-contact__inner {
      width: calc(100% - 40px);
      padding-top: 34px;
    }

    #forma-contact-{{ section.id }} .forma-contact__eyebrow {
      margin-bottom: 30px;
      font-size: 8px;
    }

    #forma-contact-{{ section.id }} .forma-contact__title {
      font-size: clamp(37px, 9.2vw, 54px);
      line-height: 1.02;
    }

    #forma-contact-{{ section.id }} .forma-contact__intro-copy {
      font-size: 11px;
      line-height: 1.8;
    }

    #forma-contact-{{ section.id }} .forma-contact__location {
      gap: 9px;
      margin-top: 25px;
      padding: 15px 0 17px;
      font-size: 7px;
      letter-spacing: .1em;
    }

    #forma-contact-{{ section.id }} .forma-contact__content {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      padding: 25px 0 30px;
    }

    #forma-contact-{{ section.id }} .forma-contact__details {
      padding: 0 0 25px;
      border-right: 0;
      border-bottom: 1px solid var(--fc-border);
    }

    #forma-contact-{{ section.id }} .forma-contact__details-title {
      margin-top: 22px;
      margin-bottom: 11px;
      font-size: 29px;
    }

    #forma-contact-{{ section.id }} .forma-contact__email-block {
      margin-top: 24px;
    }

    #forma-contact-{{ section.id }} .forma-contact__details-note {
      margin-top: 22px;
      padding-top: 16px;
    }

    #forma-contact-{{ section.id }} .forma-contact__form-heading {
      align-items: flex-start;
      gap: 12px;
      padding-bottom: 15px;
    }

    #forma-contact-{{ section.id }} .forma-contact__section-label {
      gap: 8px;
      font-size: 7px;
      letter-spacing: .12em;
    }

    #forma-contact-{{ section.id }} .forma-contact__label-line {
      width: 15px;
      flex-basis: 15px;
    }

    #forma-contact-{{ section.id }} .forma-contact__fields {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 18px;
    }

    #forma-contact-{{ section.id }} .forma-contact__field {
      padding-top: 20px;
    }

    #forma-contact-{{ section.id }} .forma-contact__field--message {
      grid-column: auto;
      padding-top: 0;
    }

    #forma-contact-{{ section.id }} .forma-contact__field textarea {
      min-height: 95px;
    }

    #forma-contact-{{ section.id }} .forma-contact__form-bottom {
      align-items: stretch;
      flex-direction: column;
      gap: 20px;
      margin-top: 23px;
    }

    #forma-contact-{{ section.id }} .forma-contact__submit {
      width: 100%;
      min-height: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #forma-contact-{{ section.id }} *,
    #forma-contact-{{ section.id }} *::before,
    #forma-contact-{{ section.id }} *::after {
      transition-duration: .01ms !important;
    }


/* ==========================================
   FORMA CONTACT — REFINED SPACING
   ========================================== */

#forma-contact-{{ section.id }} .forma-contact__inner {
  padding-top: clamp(54px, 6vw, 88px);
}

/* Hero: give overskrift og introduktion mere ro */
#forma-contact-{{ section.id }} .forma-contact__eyebrow {
  margin-bottom: clamp(36px, 4.5vw, 64px);
}

#forma-contact-{{ section.id }} .forma-contact__hero {
  gap: clamp(40px, 5vw, 84px);
}

#forma-contact-{{ section.id }} .forma-contact__intro-copy {
  max-width: 320px;
  line-height: 2;
}

#forma-contact-{{ section.id }} .forma-contact__location {
  margin-top: clamp(32px, 4vw, 52px);
  padding: 22px 0 24px;
}

/* Kontaktområdet: tydeligere opdeling */
#forma-contact-{{ section.id }} .forma-contact__content {
  grid-template-columns: minmax(250px, 0.72fr) minmax(0, 1.6fr);
  gap: clamp(42px, 6vw, 100px);
  padding: clamp(42px, 5vw, 68px) 0 clamp(48px, 5vw, 70px);
}

/* Venstre kolonne */
#forma-contact-{{ section.id }} .forma-contact__details {
  padding-right: clamp(30px, 4vw, 60px);
}

#forma-contact-{{ section.id }} .forma-contact__details-title {
  margin-top: 38px;
  margin-bottom: 20px;
  line-height: 1.17;
}

#forma-contact-{{ section.id }} .forma-contact__details-copy {
  max-width: 330px;
  line-height: 2;
}

#forma-contact-{{ section.id }} .forma-contact__email-block {
  gap: 16px;
  margin-top: 40px;
}

#forma-contact-{{ section.id }} .forma-contact__details-note {
  margin-top: 34px;
  padding-top: 24px;
  line-height: 1.9;
}

/* Højre kolonne */
#forma-contact-{{ section.id }} .forma-contact__form-heading {
  padding-bottom: 24px;
}

#forma-contact-{{ section.id }} .forma-contact__fields {
  column-gap: clamp(24px, 3vw, 42px);
  row-gap: 32px;
}

#forma-contact-{{ section.id }} .forma-contact__field {
  padding-top: 30px;
}

#forma-contact-{{ section.id }} .forma-contact__field label {
  margin-bottom: 16px;
}

#forma-contact-{{ section.id }} .forma-contact__field input {
  min-height: 40px;
  padding-bottom: 15px;
}

#forma-contact-{{ section.id }} .forma-contact__field--message {
  padding-top: 2px;
}

#forma-contact-{{ section.id }} .forma-contact__field textarea {
  min-height: 125px;
  padding-bottom: 16px;
  line-height: 1.9;
}

#forma-contact-{{ section.id }} .forma-contact__form-bottom {
  margin-top: 32px;
  gap: 30px;
}

#forma-contact-{{ section.id }} .forma-contact__privacy {
  max-width: 340px;
  line-height: 2;
}

#forma-contact-{{ section.id }} .forma-contact__submit {
  min-width: 220px;
  min-height: 54px;
  padding-inline: 20px;
}

/* Afslutning */
#forma-contact-{{ section.id }} .forma-contact__bottom-line {
  margin-top: 0;
}

/* Tablet */
@media screen and (max-width: 900px) {
  #forma-contact-{{ section.id }} .forma-contact__content {
    gap: 34px;
  }

  #forma-contact-{{ section.id }} .forma-contact__details {
    padding-right: 25px;
  }

  #forma-contact-{{ section.id }} .forma-contact__fields {
    row-gap: 24px;
  }

  #forma-contact-{{ section.id }} .forma-contact__form-bottom {
    gap: 22px;
  }
}

/* Mobil: kompakt, men stadig luftigt */
@media screen and (max-width: 640px) {
  #forma-contact-{{ section.id }} .forma-contact__inner {
    padding-top: 42px;
  }

  #forma-contact-{{ section.id }} .forma-contact__eyebrow {
    margin-bottom: 32px;
  }

  #forma-contact-{{ section.id }} .forma-contact__location {
    margin-top: 26px;
    padding: 18px 0 20px;
  }

  #forma-contact-{{ section.id }} .forma-contact__content {
    gap: 30px;
    padding: 30px 0 38px;
  }

  #forma-contact-{{ section.id }} .forma-contact__details {
    padding: 0 0 28px;
  }

  #forma-contact-{{ section.id }} .forma-contact__details-title {
    margin-top: 26px;
    margin-bottom: 14px;
  }

  #forma-contact-{{ section.id }} .forma-contact__email-block {
    margin-top: 28px;
  }

  #forma-contact-{{ section.id }} .forma-contact__details-note {
    margin-top: 24px;
    padding-top: 19px;
  }

  #forma-contact-{{ section.id }} .forma-contact__form-heading {
    padding-bottom: 18px;
  }

  #forma-contact-{{ section.id }} .forma-contact__fields {
    row-gap: 22px;
  }

  #forma-contact-{{ section.id }} .forma-contact__field {
    padding-top: 23px;
  }

  #forma-contact-{{ section.id }} .forma-contact__field--message {
    padding-top: 0;
  }

  #forma-contact-{{ section.id }} .forma-contact__field textarea {
    min-height: 115px;
  }

  #forma-contact-{{ section.id }} .forma-contact__form-bottom {
    margin-top: 26px;
    gap: 22px;
  }

  #forma-contact-{{ section.id }} .forma-contact__submit {
    min-width: 0;
    min-height: 52px;
  }
}

  }
</style>

{% schema %}
{
  "name": "FORMA Contact",
  "tag": "section",
  "class": "shopify-section--forma-contact",
  "settings": [
    {
