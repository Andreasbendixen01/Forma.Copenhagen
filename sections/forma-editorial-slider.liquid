{% comment %}
  FORMA — OPUMO STYLE EDITORIAL SLIDER
{% endcomment %}

<section
  id="forma-editorial-{{ section.id }}"
  class="forma-editorial"
>

  {% if section.settings.banner_text != blank %}
    <div class="forma-editorial__banner">
      {{ section.settings.banner_text }}
    </div>
  {% endif %}

  <div class="forma-editorial__viewport">

    <div
      class="forma-editorial__track"
      data-forma-editorial-track
    >

      {% for block in section.blocks %}

        <article
          class="forma-editorial__slide"
          data-forma-editorial-slide
          {{ block.shopify_attributes }}
        >

          {% if block.settings.link != blank %}
            <a
              href="{{ block.settings.link }}"
              class="forma-editorial__slide-link"
            >
          {% else %}
            <div class="forma-editorial__slide-link">
          {% endif %}

            <div class="forma-editorial__media">

              {% if block.settings.image != blank %}

                {{
                  block.settings.image
                  | image_url: width: 3200
                  | image_tag:
                    loading: 'lazy',
                    widths: '1000, 1400, 1800, 2200, 2600, 3000, 3200',
                    sizes: '(min-width: 750px) 46vw, 88vw',
                    class: 'forma-editorial__image',
                    alt: block.settings.image.alt | default: block.settings.title,
                    draggable: 'false'
                }}

              {% else %}

                {{ 'lifestyle-1' | placeholder_svg_tag: 'forma-editorial__placeholder' }}

              {% endif %}

              <div class="forma-editorial__overlay"></div>
              <div class="forma-editorial__gradient"></div>

            </div>

            <div class="forma-editorial__content">

              {% if block.settings.eyebrow != blank %}
                <div class="forma-editorial__eyebrow">
                  {{ block.settings.eyebrow }}
                </div>
              {% endif %}

              {% if block.settings.title != blank %}
                <h2 class="forma-editorial__title">
                  {{ block.settings.title }}
                </h2>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="forma-editorial__description">
                  {{ block.settings.description }}
                </div>
              {% endif %}

              {% if block.settings.button_text != blank %}
                <div class="forma-editorial__cta">

                  <span>
                    {{ block.settings.button_text }}
                  </span>

                  <span class="forma-editorial__cta-arrow">
                    ↗
                  </span>

                </div>
              {% endif %}

            </div>

          {% if block.settings.link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}

        </article>

      {% endfor %}

    </div>

    {% if section.settings.show_arrows %}
      <button
        class="forma-editorial__arrow forma-editorial__arrow--left"
        type="button"
        aria-label="Previous slide"
        data-forma-prev
      >
        ‹
      </button>

      <button
        class="forma-editorial__arrow forma-editorial__arrow--right"
        type="button"
        aria-label="Next slide"
        data-forma-next
      >
        ›
      </button>
    {% endif %}

  </div>

</section>


<style>

  /* ============================================================
     SECTION
     ============================================================ */

  #forma-editorial-{{ section.id }} {

    --forma-gap: {{ section.settings.slide_gap }}px;
    --forma-desktop-height: {{ section.settings.desktop_height }}vh;
    --forma-mobile-height: {{ section.settings.mobile_height }}vh;

    position: relative;
    width: 100%;
    margin: 0;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;

    overflow: hidden;

    background: {{ section.settings.background_color }};
    color: #111;

  }


  /* ============================================================
     BANNER
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__banner {

    width: 100%;
    text-align: center;

    padding: 28px 20px;

    font-size: {{ section.settings.banner_font_size }}px;
    font-weight: 500;
    line-height: 1.4;

    color: {{ section.settings.banner_color }};

    letter-spacing: {{ section.settings.banner_letter_spacing }}px;

  }


  /* ============================================================
     VIEWPORT
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__viewport {

    position: relative;
    width: 100%;
    overflow: hidden;

  }


  /* ============================================================
     TRACK
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__track {

    display: flex;
    gap: var(--forma-gap);

    width: 100%;

    overflow-x: auto;
    overflow-y: hidden;

    padding: 0;
    margin: 0;

    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;

    scrollbar-width: none;
    -ms-overflow-style: none;

    overscroll-behavior-x: contain;

    cursor: grab;

    -webkit-overflow-scrolling: touch;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__track::-webkit-scrollbar {

    display: none;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__track.is-dragging {

    cursor: grabbing;
    scroll-behavior: auto;

    user-select: none;
    -webkit-user-select: none;

  }


  /* ============================================================
     SLIDE
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__slide {

    position: relative;

    flex: 0 0 {{ section.settings.slide_width }}vw;

    width: {{ section.settings.slide_width }}vw;

    height: var(--forma-desktop-height);

    min-height: 560px;

    overflow: hidden;

    scroll-snap-align: start;
    scroll-snap-stop: always;

    flex-shrink: 0;

    border-radius: {{ section.settings.border_radius }}px;

    background: #111;

    isolation: isolate;

  }


  /* ============================================================
     LINK
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__slide-link {

    position: absolute;
    inset: 0;

    display: block;

    color: inherit;
    text-decoration: none;

  }


  /* ============================================================
     MEDIA
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__media {

    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    overflow: hidden;

    z-index: 0;

    background: transparent;

  }


  /* ============================================================
     IMAGE
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__image {

    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
    object-position: center;

    transform: scale(1.001);

    pointer-events: none;

    user-select: none;
    -webkit-user-select: none;

    transition:
      transform 1.2s cubic-bezier(.22,.61,.36,1);

    will-change: transform;

  }


  /* ============================================================
     IMAGE HOVER
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__slide:hover
  .forma-editorial__image {

    transform: scale(1.025);

  }


  /* ============================================================
     OVERLAY
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__overlay {

    position: absolute;
    inset: 0;

    z-index: 1;

    background: rgba(0,0,0,.025);

    pointer-events: none;

  }


  /* ============================================================
     GRADIENT
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__gradient {

    position: absolute;
    inset: 0;

    z-index: 2;

    pointer-events: none;

    background:
      linear-gradient(
        180deg,
        rgba(0,0,0,0) 25%,
        rgba(0,0,0,.025) 45%,
        rgba(0,0,0,.15) 63%,
        rgba(0,0,0,.76) 100%
      );

  }


  /* ============================================================
     CONTENT
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__content {

    position: absolute;

    left: {{ section.settings.content_left }}px;
    right: {{ section.settings.content_left }}px;

    bottom: {{ section.settings.content_bottom }}px;

    z-index: 4;

    max-width: 1000px;

    color: #fff;

    pointer-events: none;

  }


  /* ============================================================
     EYEBROW
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__eyebrow {

    margin-bottom: 15px;

    font-size: 10px;
    line-height: 1;

    font-weight: 600;

    letter-spacing: .20em;

    text-transform: uppercase;

    color: rgba(255,255,255,.88);

  }


  /* ============================================================
     TITLE
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__title {

    margin: 0;

    max-width: 1000px;

    font-size:
      clamp(
        56px,
        7vw,
        112px
      );

    line-height: .86;

    font-weight: 400;

    letter-spacing: -.065em;

    color: #fff;

    text-wrap: balance;

  }


  /* ============================================================
     DESCRIPTION
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__description {

    max-width: 440px;

    margin-top: 20px;

    font-size: 14px;
    line-height: 1.5;

    color: rgba(255,255,255,.86);

  }


  /* ============================================================
     CTA
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__cta {

    display: inline-flex;

    align-items: center;

    gap: 10px;

    margin-top: 25px;

    padding-bottom: 7px;

    border-bottom: 1px solid rgba(255,255,255,.65);

    font-size: 10px;
    line-height: 1;

    font-weight: 600;

    letter-spacing: .16em;

    text-transform: uppercase;

    transition:
      gap .35s ease,
      border-color .35s ease;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__slide:hover
  .forma-editorial__cta {

    gap: 17px;

    border-color: #fff;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__cta-arrow {

    font-size: 14px;
    line-height: .7;

  }


  /* ============================================================
     PLACEHOLDER
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__placeholder {

    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    background: #e9e9e7;

  }


  /* ============================================================
     ARROWS
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__arrow {

    position: absolute;

    z-index: 10;

    top: 50%;
    transform: translateY(-50%);

    display: flex;
    align-items: center;
    justify-content: center;

    width: 48px;
    height: 48px;

    border: none;
    border-radius: 50%;

    background: rgba(255,255,255,.15);

    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);

    color: white;

    font-size: 35px;
    font-weight: 300;

    line-height: 1;

    cursor: pointer;

    transition:
      background .3s ease,
      opacity .3s ease;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__arrow:hover {

    background: rgba(255,255,255,.35);

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__arrow--left {

    left: 20px;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__arrow--right {

    right: 20px;

  }


  /* ============================================================
     MOBILE
     ============================================================ */

  @media screen and (max-width: 749px) {

    #forma-editorial-{{ section.id }} {

      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;

      --forma-gap: 10px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__banner {

      padding: 22px 20px;

      font-size: {{ section.settings.mobile_banner_font_size }}px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__track {

      padding: 0;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__slide {

      flex-basis: 88vw;
      width: 88vw;

      height: var(--forma-mobile-height);

      min-height: 520px;

      border-radius: {{ section.settings.mobile_border_radius }}px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__content {

      left: 24px;
      right: 24px;

      bottom: 30px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__eyebrow {

      margin-bottom: 12px;

      font-size: 9px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__title {

      font-size:
        clamp(
          44px,
          13vw,
          70px
        );

      line-height: .87;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__description {

      max-width: 310px;

      margin-top: 16px;

      font-size: 13px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__cta {

      margin-top: 20px;

      font-size: 9px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__arrow {

      width: 38px;
      height: 38px;

      font-size: 28px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__arrow--left {

      left: 10px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__arrow--right {

      right: 10px;

    }

  }


  /* ============================================================
     REDUCED MOTION
     ============================================================ */

  @media (prefers-reduced-motion: reduce) {

    #forma-editorial-{{ section.id }}
    .forma-editorial__track {

      scroll-behavior: auto;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__image {

      transition: none;

    }

  }

</style>


<script>

  (() => {

    const section = document.getElementById(
      'forma-editorial-{{ section.id }}'
    );

    if (!section) return;

    const track = section.querySelector(
      '[data-forma-editorial-track]'
    );

    const slides = Array.from(
      section.querySelectorAll(
        '[data-forma-editorial-slide]'
      )
    );

    const prevButton = section.querySelector(
      '[data-forma-prev]'
    );

    const nextButton = section.querySelector(
      '[data-forma-next]'
    );

    if (!track || slides.length === 0) return;


    /* ============================================================
       SLIDE DISTANCE
       ============================================================ */

    function getSlideDistance() {

      const slide = slides[0];

      if (!slide) return 0;

      const styles = window.getComputedStyle(track);

      const gap = parseFloat(
        styles.columnGap || styles.gap
      ) || 0;

      return slide.getBoundingClientRect().width + gap;

    }


    function getCurrentIndex() {

      const distance = getSlideDistance();

      if (!distance) return 0;

      return Math.round(track.scrollLeft / distance);

    }


    function goToIndex(index) {

      const distance = getSlideDistance();

      if (!distance) return;

      const target = Math.max(
        0,
        Math.min(
          index * distance,
          track.scrollWidth - track.clientWidth
        )
      );

      track.scrollTo({
        left: target,
        behavior: 'smooth'
      });

    }


    /* ============================================================
       NAVIGATION
       ============================================================ */

    if (nextButton) {

      nextButton.addEventListener('click', () => {

        const currentIndex = getCurrentIndex();

        const maxScroll =
          track.scrollWidth - track.clientWidth;

        if (track.scrollLeft >= maxScroll - 5) {

          goToIndex(0);

        } else {

          goToIndex(currentIndex + 1);

        }

      });

    }


    if (prevButton) {

      prevButton.addEventListener('click', () => {

        const currentIndex = getCurrentIndex();

        if (currentIndex <= 0) {

          goToIndex(slides.length - 1);

        } else {

          goToIndex(currentIndex - 1);

        }

      });

    }


    /* ============================================================
       MOUSE DRAG
       ============================================================ */

    let isDragging = false;
    let startX = 0;
    let startScrollLeft = 0;
    let hasDragged = false;
    let suppressClick = false;


    track.addEventListener('pointerdown', (event) => {

      if (event.pointerType !== 'mouse') return;
      if (event.button !== 0) return;

      isDragging = true;
      hasDragged = false;

      startX = event.clientX;
      startScrollLeft = track.scrollLeft;

      track.classList.add('is-dragging');

      track.setPointerCapture(event.pointerId);

    });


    track.addEventListener('pointermove', (event) => {

      if (!isDragging) return;

      const delta = event.clientX - startX;

      if (Math.abs(delta) > 5) {

        hasDragged = true;
        suppressClick = true;

      }

      track.scrollLeft = startScrollLeft - delta;

    });


    function finishDrag(event) {

      if (!isDragging) return;

      isDragging = false;

      track.classList.remove('is-dragging');

      try {

        track.releasePointerCapture(event.pointerId);

      } catch (error) {}


      if (!hasDragged) return;

      const distance = getSlideDistance();

      if (!distance) return;

      const target = Math.round(
        track.scrollLeft / distance
      );

      track.scrollTo({
        left: target * distance,
        behavior: 'smooth'
      });

      setTimeout(() => {

        suppressClick = false;

      }, 150);

    }


    track.addEventListener('pointerup', finishDrag);
    track.addEventListener('pointercancel', finishDrag);


    /* ============================================================
       PREVENT LINK CLICK AFTER DRAG
       ============================================================ */

    section.addEventListener('click', (event) => {

      if (suppressClick) {

        event.preventDefault();
        event.stopPropagation();

        suppressClick = false;

      }

    }, true);


    /* ============================================================
       PREVENT IMAGE DRAGGING
       ============================================================ */

    section.querySelectorAll('img').forEach((image) => {

      image.addEventListener('dragstart', (event) => {

        event.preventDefault();

      });

    });


    /* ============================================================
       AUTOPLAY
       ============================================================ */

    {% if section.settings.autoplay %}

      let autoplayTimer = null;
      let isHovered = false;
      let isInteracting = false;

      const AUTOPLAY_DELAY = {{ section.settings.autoplay_delay }} * 1000;


      function stopAutoplay() {

        clearTimeout(autoplayTimer);
        autoplayTimer = null;

      }


      function goToNextSlide() {

        if (slides.length <= 1 || isDragging) return;

        const maxScroll =
          track.scrollWidth - track.clientWidth;

        if (track.scrollLeft >= maxScroll - 5) {

          track.scrollTo({
            left: 0,
            behavior: 'smooth'
          });

        } else {

          const currentIndex = getCurrentIndex();

          goToIndex(currentIndex + 1);

        }

      }


      function scheduleAutoplay() {

        stopAutoplay();

        if (
          document.hidden ||
          isHovered ||
          isDragging ||
          isInteracting ||
          slides.length <= 1
        ) {

          return;

        }

        autoplayTimer = setTimeout(() => {

          goToNextSlide();
          scheduleAutoplay();

        }, AUTOPLAY_DELAY);

      }


      track.addEventListener('pointerenter', (event) => {

        if (event.pointerType === 'mouse') {

          isHovered = true;
          stopAutoplay();

        }

      });


      track.addEventListener('pointerleave', () => {

        isHovered = false;
        scheduleAutoplay();

      });


      track.addEventListener('pointerdown', () => {

        isInteracting = true;
        stopAutoplay();

      });


      track.addEventListener('pointerup', () => {

        isInteracting = false;

        setTimeout(() => {

          scheduleAutoplay();

        }, 700);

      });


      track.addEventListener('pointercancel', () => {

        isInteracting = false;
        scheduleAutoplay();

      });


      document.addEventListener('visibilitychange', () => {

        if (document.hidden) {

          stopAutoplay();

        } else {

          scheduleAutoplay();

        }

      });


      scheduleAutoplay();

    {% endif %}


  })();

</script>


{% schema %}

{
  "name": "FORMA Editorial Slider",
  "tag": "section",
  "class": "forma-editorial-slider-section",

  "settings": [

    {
      "type": "header",
      "content": "Banner"
    },

    {
      "type": "text",
      "id": "banner_text",
      "label": "Banner text",
      "default": "Discover brands, places and experiences worth knowing."
    },

    {
      "type": "range",
      "id": "banner_font_size",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Desktop banner font size",
      "default": 18
    },

    {
      "type": "range",
      "id": "mobile_banner_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Mobile banner font size",
      "default": 14
    },

    {
      "type": "range",
      "id": "banner_letter_spacing",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "label": "Banner letter spacing",
      "default": 0
    },

    {
      "type": "color",
      "id": "banner_color",
      "label": "Banner color",
      "default": "#111111"
    },

    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "slide_width",
      "min": 35,
      "max": 70,
      "step": 1,
      "unit": "vw",
      "label": "Desktop slide width",
      "default": 45
    },

    {
      "type": "range",
      "id": "desktop_height",
      "min": 55,
      "max": 85,
      "step": 1,
      "unit": "vh",
      "label": "Desktop height",
      "default": 68
    },

    {
      "type": "range",
      "id": "mobile_height",
      "min": 60,
      "max": 90,
      "step": 1,
      "unit": "vh",
      "label": "Mobile height",
      "default": 74
    },

    {
      "type": "range",
      "id": "slide_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Slide gap",
      "default": 6
    },

    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },

    {
      "type": "range",
      "id": "mobile_border_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Mobile border radius",
      "default": 0
    },

    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show slider arrows",
      "default": true
    },

    {
      "type": "header",
      "content": "Text placement"
    },

    {
      "type": "range",
      "id": "content_left",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Text left position",
      "default": 24
    },

    {
      "type": "range",
      "id": "content_bottom",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Text bottom position",
      "default": 40
    },

    {
      "type": "header",
      "content": "Autoplay"
    },

    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },

    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 3,
      "max": 15,
      "step": 1,
      "unit": "s",
      "label": "Autoplay delay",
      "default": 5
    },

    {
      "type": "header",
      "content": "Spacing"
    },

    {
      "type": "range",
