{% comment %}
  FORMA — EDITORIAL DISCOVERY SLIDER
  Inspired by OPUMO
  Manual navigation only
{% endcomment %}

<section id="forma-editorial-{{ section.id }}" class="forma-editorial">

  {% if section.settings.banner_text != blank %}
    <div class="forma-editorial__banner">
      {{ section.settings.banner_text }}
    </div>
  {% endif %}

  <div class="forma-editorial__viewport">

    <div class="forma-editorial__track" data-forma-track>

      {% for block in section.blocks %}
        <article class="forma-editorial__slide" {{ block.shopify_attributes }}>

          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="forma-editorial__slide-link">
          {% else %}
            <div class="forma-editorial__slide-link">
          {% endif %}

            <div class="forma-editorial__media">

              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 3200
                  | image_tag:
                    loading: 'lazy',
                    widths: '1000, 1400, 1800, 2200, 2600, 3000, 3200',
                    sizes: '(min-width: 750px) 48vw, 88vw',
                    class: 'forma-editorial__image',
                    alt: block.settings.image.alt | default: block.settings.title,
                    draggable: 'false'
                }}
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'forma-editorial__placeholder' }}
              {% endif %}

              <div class="forma-editorial__overlay"></div>
              <div class="forma-editorial__gradient"></div>

            </div>

            {% if block.settings.show_content %}
              <div class="forma-editorial__content forma-editorial__content--{{ block.settings.content_alignment }}">

                {% if block.settings.eyebrow != blank %}
                  <div class="forma-editorial__eyebrow">
                    {{ block.settings.eyebrow }}
                  </div>
                {% endif %}

                {% if block.settings.title != blank %}
                  <h2 class="forma-editorial__title">
                    {{ block.settings.title }}
                  </h2>
                {% endif %}

                {% if block.settings.description != blank %}
                  <div class="forma-editorial__description">
                    {{ block.settings.description }}
                  </div>
                {% endif %}

                {% if block.settings.button_text != blank %}
                  <div class="forma-editorial__cta">
                    <span>{{ block.settings.button_text }}</span>
                    <span class="forma-editorial__cta-arrow">↗</span>
                  </div>
                {% endif %}

              </div>
            {% endif %}

          {% if block.settings.link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}

        </article>
      {% endfor %}

    </div>

    {% if section.settings.show_arrows %}
      <button class="forma-editorial__arrow forma-editorial__arrow--left"
        type="button"
        aria-label="Previous slide"
        data-forma-prev>
        ‹
      </button>

      <button class="forma-editorial__arrow forma-editorial__arrow--right"
        type="button"
        aria-label="Next slide"
        data-forma-next>
        ›
      </button>
    {% endif %}

  </div>
</section>


<style>

  /* ============================================================
     SECTION
     ============================================================ */

  #forma-editorial-{{ section.id }} {

    --forma-gap: {{ section.settings.slide_gap }}px;
    --forma-desktop-height: {{ section.settings.desktop_height }}vh;
    --forma-mobile-height: {{ section.settings.mobile_height }}vh;

    position: relative;
    width: 100%;
    margin: 0;

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;

    overflow: hidden;

    background: {{ section.settings.background_color }};
    color: #111;

  }


  /* ============================================================
     BANNER
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__banner {

    width: 100%;
    text-align: center;

    padding: {{ section.settings.banner_padding }}px 20px;

    font-size: {{ section.settings.banner_font_size }}px;
    font-weight: 400;
    line-height: 1.4;

    letter-spacing: {{ section.settings.banner_letter_spacing }}px;

    color: {{ section.settings.banner_color }};

  }


  /* ============================================================
     VIEWPORT
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__viewport {

    position: relative;
    width: 100%;
    overflow: hidden;

  }


  /* ============================================================
     TRACK
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__track {

    display: flex;
    gap: var(--forma-gap);

    width: 100%;

    overflow-x: auto;
    overflow-y: hidden;

    padding: 0;
    margin: 0;

    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;

    scrollbar-width: none;
    -ms-overflow-style: none;

    overscroll-behavior-x: contain;

    cursor: grab;

    -webkit-overflow-scrolling: touch;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__track::-webkit-scrollbar {
    display: none;
  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__track.is-dragging {

    cursor: grabbing;
    scroll-behavior: auto;

    user-select: none;
    -webkit-user-select: none;

  }


  /* ============================================================
     SLIDES
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__slide {

    position: relative;

    flex: 0 0 {{ section.settings.slide_width }}vw;
    width: {{ section.settings.slide_width }}vw;

    height: var(--forma-desktop-height);

    min-height: 560px;

    overflow: hidden;

    scroll-snap-align: start;
    scroll-snap-stop: always;

    flex-shrink: 0;

    border-radius: {{ section.settings.border_radius }}px;

    background: #111;

    isolation: isolate;

  }


  /* ============================================================
     LINK
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__slide-link {

    position: absolute;
    inset: 0;

    display: block;

    color: inherit;
    text-decoration: none;

  }


  /* ============================================================
     MEDIA
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__media {

    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    overflow: hidden;
    z-index: 0;

    background: #111;

  }


  /* ============================================================
     IMAGE
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__image {

    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
    object-position: center;

    transform: scale(1.001);

    pointer-events: none;

    user-select: none;
    -webkit-user-select: none;

    transition: transform 1.2s cubic-bezier(.22,.61,.36,1);

    will-change: transform;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__slide:hover
  .forma-editorial__image {

    transform: scale(1.025);

  }


  /* ============================================================
     OVERLAY
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__overlay {

    position: absolute;
    inset: 0;

    z-index: 1;

    background: rgba(0,0,0,.025);

    pointer-events: none;

  }


  /* ============================================================
     GRADIENT
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__gradient {

    position: absolute;
    inset: 0;

    z-index: 2;

    pointer-events: none;

    background:
      linear-gradient(
        180deg,
        rgba(0,0,0,0) 25%,
        rgba(0,0,0,.025) 45%,
        rgba(0,0,0,.15) 63%,
        rgba(0,0,0,.76) 100%
      );

  }


  /* ============================================================
     CONTENT
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__content {

    position: absolute;

    left: {{ section.settings.content_left }}px;
    right: {{ section.settings.content_left }}px;

    bottom: {{ section.settings.content_bottom }}px;

    z-index: 4;

    max-width: 1000px;

    color: #fff;

    pointer-events: none;

  }


  /* CONTENT ALIGNMENT */

  #forma-editorial-{{ section.id }}
  .forma-editorial__content--left {

    text-align: left;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__content--center {

    text-align: center;
    left: 24px;
    right: 24px;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__content--right {

    text-align: right;

  }


  /* ============================================================
     EYEBROW
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__eyebrow {

    margin-bottom: {{ section.settings.eyebrow_spacing }}px;

    font-size: {{ section.settings.eyebrow_font_size }}px;

    line-height: 1;

    font-weight: {{ section.settings.eyebrow_weight }};

    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}em;

    text-transform: {{ section.settings.eyebrow_transform }};

    color: rgba(255,255,255,.92);

  }


  /* ============================================================
     TITLE
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__title {

    margin: 0;

    max-width: 1000px;

    font-size:
      clamp(
        {{ section.settings.title_min_size }}px,
        {{ section.settings.title_desktop_size }}vw,
        {{ section.settings.title_max_size }}px
      );

    line-height: {{ section.settings.title_line_height }};

    font-weight: {{ section.settings.title_weight }};

    letter-spacing: {{ section.settings.title_letter_spacing }}em;

    color: #fff;

    text-wrap: balance;

  }


  /* ============================================================
     DESCRIPTION
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__description {

    max-width: {{ section.settings.description_width }}px;

    margin-top: {{ section.settings.description_spacing }}px;

    font-size: {{ section.settings.description_font_size }}px;

    line-height: 1.5;

    color: rgba(255,255,255,.86);

  }


  /* ============================================================
     CTA
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__cta {

    display: inline-flex;

    align-items: center;

    gap: 10px;

    margin-top: {{ section.settings.cta_spacing }}px;

    padding-bottom: 7px;

    border-bottom: 1px solid rgba(255,255,255,.65);

    font-size: {{ section.settings.cta_font_size }}px;

    line-height: 1;

    font-weight: 600;

    letter-spacing: .16em;

    text-transform: uppercase;

    transition:
      gap .35s ease,
      border-color .35s ease;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__slide:hover
  .forma-editorial__cta {

    gap: 17px;
    border-color: #fff;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__cta-arrow {

    font-size: 14px;
    line-height: .7;

  }


  /* ============================================================
     PLACEHOLDER
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__placeholder {

    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    background: #e9e9e7;

  }


  /* ============================================================
     ARROWS — MINIMAL / NO GLASS
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__arrow {

    position: absolute;

    z-index: 10;

    top: 50%;
    transform: translateY(-50%);

    display: flex;
    align-items: center;
    justify-content: center;

    width: 48px;
    height: 48px;

    border: none;
    border-radius: 0;

    background: transparent;

    backdrop-filter: none;
    -webkit-backdrop-filter: none;

    color: white;

    font-size: 48px;
    font-weight: 300;

    line-height: 1;

    cursor: pointer;

    transition: opacity .3s ease;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__arrow:hover {

    background: transparent;
    opacity: .65;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__arrow--left {

    left: 20px;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__arrow--right {

    right: 20px;

  }


  /* ============================================================
     MOBILE
     ============================================================ */

  @media screen and (max-width: 749px) {

    #forma-editorial-{{ section.id }} {

      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;

      --forma-gap: 10px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__banner {

      padding: {{ section.settings.mobile_banner_padding }}px 20px;

      font-size: {{ section.settings.mobile_banner_font_size }}px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__slide {

      flex-basis: {{ section.settings.mobile_slide_width }}vw;
      width: {{ section.settings.mobile_slide_width }}vw;

      height: var(--forma-mobile-height);

      min-height: 520px;

      border-radius: {{ section.settings.mobile_border_radius }}px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__content {

      left: {{ section.settings.mobile_content_left }}px;
      right: {{ section.settings.mobile_content_left }}px;

      bottom: {{ section.settings.mobile_content_bottom }}px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__eyebrow {

      margin-bottom: {{ section.settings.mobile_eyebrow_spacing }}px;

      font-size: {{ section.settings.mobile_eyebrow_font_size }}px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__title {

      font-size: {{ section.settings.mobile_title_size }}px;

      line-height: .88;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__description {

      max-width: 310px;

      margin-top: {{ section.settings.mobile_description_spacing }}px;

      font-size: {{ section.settings.mobile_description_font_size }}px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__cta {

      margin-top: {{ section.settings.mobile_cta_spacing }}px;

      font-size: 9px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__arrow {

      width: 38px;
      height: 38px;

      font-size: 34px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__arrow--left {

      left: 10px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__arrow--right {

      right: 10px;

    }

  }


  /* ============================================================
     REDUCED MOTION
     ============================================================ */

  @media (prefers-reduced-motion: reduce) {

    #forma-editorial-{{ section.id }}
    .forma-editorial__track {

      scroll-behavior: auto;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__image {

      transition: none;

    }

  }

</style>


<script>

  (() => {

    const section = document.getElementById(
      'forma-editorial-{{ section.id }}'
    );

    if (!section) return;

    const track = section.querySelector('[data-forma-track]');

    const slides = Array.from(
      section.querySelectorAll('.forma-editorial__slide')
    );

    const prevButton = section.querySelector('[data-forma-prev]');
    const nextButton = section.querySelector('[data-forma-next]');

    if (!track || slides.length === 0) return;


    /* ============================================================
       SLIDE DISTANCE
       ============================================================ */

    function getSlideDistance() {

      const slide = slides[0];

      if (!slide) return 0;

      const styles = window.getComputedStyle(track);

      const gap = parseFloat(
        styles.columnGap || styles.gap
      ) || 0;

      return slide.getBoundingClientRect().width + gap;

    }


    function getCurrentIndex() {

      const distance = getSlideDistance();

      if (!distance) return 0;

      return Math.round(track.scrollLeft / distance);

    }


    function goToIndex(index) {

      const distance = getSlideDistance();

      if (!distance) return;

      const target = Math.max(
        0,
        Math.min(
          index * distance,
          track.scrollWidth - track.clientWidth
        )
      );

      track.scrollTo({
        left: target,
        behavior: 'smooth'
      });

    }


    /* ============================================================
       ARROW NAVIGATION
       ============================================================ */

    if (nextButton) {

      nextButton.addEventListener('click', () => {

        const maxScroll = track.scrollWidth - track.clientWidth;

        if (track.scrollLeft >= maxScroll - 5) {

          goToIndex(0);

        } else {

          goToIndex(getCurrentIndex() + 1);

        }

      });

    }


    if (prevButton) {

      prevButton.addEventListener('click', () => {

        if (getCurrentIndex() <= 0) {

          goToIndex(slides.length - 1);

        } else {

          goToIndex(getCurrentIndex() - 1);

        }

      });

    }


    /* ============================================================
       MOUSE DRAG
       ============================================================ */

    let isDragging = false;
    let startX = 0;
    let startScrollLeft = 0;
    let hasDragged = false;
    let suppressClick = false;


    track.addEventListener('pointerdown', (event) => {

      if (event.pointerType !== 'mouse') return;
      if (event.button !== 0) return;

      isDragging = true;
      hasDragged = false;

      startX = event.clientX;
      startScrollLeft = track.scrollLeft;

      track.classList.add('is-dragging');

      track.setPointerCapture(event.pointerId);

    });


    track.addEventListener('pointermove', (event) => {

      if (!isDragging) return;

      const delta = event.clientX - startX;

      if (Math.abs(delta) > 5) {

        hasDragged = true;
        suppressClick = true;

      }

      track.scrollLeft = startScrollLeft - delta;

    });


    function finishDrag(event) {

      if (!isDragging) return;

      isDragging = false;

      track.classList.remove('is-dragging');

      try {

        track.releasePointerCapture(event.pointerId);

      } catch (error) {}


      if (!hasDragged) return;

      const distance = getSlideDistance();

      if (!distance) return;

      const target = Math.round(track.scrollLeft / distance);

      track.scrollTo({
        left: target * distance,
        behavior: 'smooth'
      });

      setTimeout(() => {

        suppressClick = false;

      }, 150);

    }


    track.addEventListener('pointerup', finishDrag);
    track.addEventListener('pointercancel', finishDrag);


    /* ============================================================
       PREVENT CLICK AFTER DRAG
       ============================================================ */

    section.addEventListener('click', (event) => {

      if (suppressClick) {

        event.preventDefault();
        event.stopPropagation();

        suppressClick = false;

      }

    }, true);


    /* ============================================================
       PREVENT IMAGE DRAG
       ============================================================ */

    section.querySelectorAll('img').forEach((image) => {

      image.addEventListener('dragstart', (event) => {

        event.preventDefault();

      });

    });


  })();

</script>


{% schema %}

{
  "name": "FORMA Editorial Slider",
  "tag": "section",
  "class": "forma-editorial-slider-section",

  "settings": [

    {
      "type": "header",
      "content": "Banner"
    },

    {
      "type": "text",
      "id": "banner_text",
      "label": "Banner text",
      "default": "Discover brands, places and experiences worth knowing."
    },

    {
      "type": "range",
      "id": "banner_font_size",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Desktop banner font size",
      "default": 18
    },

    {
      "type": "range",
      "id": "mobile_banner_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Mobile banner font size",
      "default": 14
    },

    {
      "type": "range",
      "id": "banner_letter_spacing",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "label": "Banner letter spacing",
      "default": 0
    },

    {
      "type": "range",
      "id": "banner_padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Banner vertical padding",
      "default": 24
    },

    {
      "type": "range",
      "id": "mobile_banner_padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Mobile banner padding",
      "default": 20
    },

    {
      "type": "color",
      "id": "banner_color",
      "label": "Banner color",
      "default": "#111111"
    },

    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "slide_width",
      "min": 35,
      "max": 70,
      "step": 1,
      "unit": "vw",
      "label": "Desktop slide width",
      "default": 48
    },

    {
      "type": "range",
      "id": "mobile_slide_width",
      "min": 70,
      "max": 100,
      "step": 1,
      "unit": "vw",
      "label": "Mobile slide width",
      "default": 88
    },

    {
      "type": "range",
      "id": "desktop_height",
      "min": 55,
      "max": 85,
      "step": 1,
      "unit": "vh",
      "label": "Desktop height",
      "default": 68
    },

    {
      "type": "range",
      "id": "mobile_height",
      "min": 60,
      "max": 90,
      "step": 1,
      "unit": "vh",
      "label": "Mobile height",
      "default": 74
    },

    {
      "type": "range",
      "id": "slide_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Slide gap",
      "default": 6
    },

    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },

    {
      "type": "range",
      "id": "mobile_border_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Mobile border radius",
      "default": 0
    },

    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },

    {
      "type": "header",
      "content": "Content placement"
    },

    {
      "type": "range",
      "id": "content_left",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Content left position",
      "default": 32
    },

    {
      "type": "range",
      "id": "content_bottom",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Content bottom position",
      "default": 45
    },

    {
      "type": "range",
      "id": "mobile_content_left",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Mobile content left position",
      "default": 24
    },

    {
      "type": "range",
      "id": "mobile_content_bottom",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Mobile content bottom position",
      "default": 30
    },

    {
      "type": "header",
      "content": "Typography — Eyebrow"
    },

    {
      "type": "range",
      "id": "eyebrow_font_size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow size",
      "default": 11
    },

    {
      "type": "range",
      "id": "mobile_eyebrow_font_size",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
