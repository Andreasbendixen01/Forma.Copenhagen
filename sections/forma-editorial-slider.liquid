{% comment %}
  FORMA — EDITORIAL SLIDER
  Manual slider. No autoplay.
{% endcomment %}

<section id="forma-editorial-{{ section.id }}" class="forma-editorial">

  <div class="forma-editorial__viewport">
    <div class="forma-editorial__track" data-track>

      {% for block in section.blocks %}
        <article class="forma-editorial__slide" {{ block.shopify_attributes }}>

          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="forma-editorial__link">
          {% else %}
            <div class="forma-editorial__link">
          {% endif %}

              <div class="forma-editorial__media">

                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 3200
                    | image_tag:
                      loading: 'lazy',
                      class: 'forma-editorial__image',
                      alt: block.settings.image.alt | default: block.settings.title
                  }}
                {% else %}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'forma-editorial__placeholder' }}
                {% endif %}

                <div class="forma-editorial__gradient"></div>

              </div>

              {% if block.settings.show_content %}
                <div class="forma-editorial__content
                  {% if block.settings.content_alignment == 'center' %}is-center{% endif %}
                  {% if block.settings.content_alignment == 'right' %}is-right{% endif %}">

                  {% if block.settings.eyebrow != blank %}
                    <div class="forma-editorial__eyebrow">
                      {{ block.settings.eyebrow }}
                    </div>
                  {% endif %}

                  {% if block.settings.title != blank %}
                    <h2 class="forma-editorial__title">
                      {{ block.settings.title }}
                    </h2>
                  {% endif %}

                  {% if block.settings.description != blank %}
                    <div class="forma-editorial__description">
                      {{ block.settings.description }}
                    </div>
                  {% endif %}

                  {% if block.settings.button_text != blank %}
                    <div class="forma-editorial__cta">
                      <span>{{ block.settings.button_text }}</span>
                      <span class="forma-editorial__arrow">↗</span>
                    </div>
                  {% endif %}

                </div>
              {% endif %}

          {% if block.settings.link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}

        </article>
      {% endfor %}

    </div>
  </div>

  {% if section.blocks.size > 1 %}
    <div class="forma-editorial__navigation">

      <button type="button" class="forma-editorial__nav forma-editorial__prev" aria-label="Previous slide">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </button>

      <button type="button" class="forma-editorial__nav forma-editorial__next" aria-label="Next slide">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </button>

    </div>
  {% endif %}

</section>


<style>

  #forma-editorial-{{ section.id }} {

    --slide-width: {{ section.settings.slide_width }}vw;
    --slide-gap: {{ section.settings.slide_gap }}px;
    --slide-height: {{ section.settings.desktop_height }}vh;
    --content-left: {{ section.settings.content_left }}px;
    --content-bottom: {{ section.settings.content_bottom }}px;
    --title-size: {{ section.settings.title_size }}px;
    --title-line-height: {{ section.settings.title_line_height | divided_by: 10.0 }};
    --title-letter-spacing: {{ section.settings.title_letter_spacing | divided_by: 100.0 }}em;
    --eyebrow-letter-spacing: {{ section.settings.eyebrow_letter_spacing | divided_by: 100.0 }}em;
    --cta-letter-spacing: {{ section.settings.cta_letter_spacing | divided_by: 100.0 }}em;

    position: relative;
    width: 100%;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
    overflow: hidden;

  }

  #forma-editorial-{{ section.id }} *,
  #forma-editorial-{{ section.id }} *::before,
  #forma-editorial-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__viewport {
    width: 100%;
    overflow: hidden;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__track {
    display: flex;
    gap: var(--slide-gap);
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0;
    margin: 0;
    overscroll-behavior-x: contain;
    cursor: grab;
    touch-action: pan-y;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__track::-webkit-scrollbar {
    display: none;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__track.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
    user-select: none;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__slide {
    position: relative;
    flex: 0 0 var(--slide-width);
    width: var(--slide-width);
    height: var(--slide-height);
    min-height: 500px;
    overflow: hidden;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    background: #111;
    border-radius: {{ section.settings.border_radius }}px;
    isolation: isolate;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__link {
    position: absolute;
    inset: 0;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 1.2s cubic-bezier(.22,.61,.36,1);
    user-select: none;
    pointer-events: none;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__slide:hover .forma-editorial__image {
    transform: scale(1.025);
  }

  #forma-editorial-{{ section.id }} .forma-editorial__gradient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(0,0,0,0) 20%,
      rgba(0,0,0,.03) 45%,
      rgba(0,0,0,.20) 65%,
      rgba(0,0,0,.75) 100%
    );
  }

  /* CONTENT */

  #forma-editorial-{{ section.id }} .forma-editorial__content {
    position: absolute;
    left: var(--content-left);
    bottom: var(--content-bottom);
    z-index: 3;
    max-width: {{ section.settings.content_max_width }}px;
    color: #fff;
    pointer-events: none;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__content.is-center {
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__content.is-right {
    left: auto;
    right: var(--content-left);
    text-align: right;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__eyebrow {
    margin-bottom: {{ section.settings.eyebrow_margin }}px;
    font-size: {{ section.settings.eyebrow_size }}px;
    line-height: 1.2;
    font-weight: {{ section.settings.eyebrow_weight }};
    letter-spacing: var(--eyebrow-letter-spacing);
    text-transform: uppercase;
    color: rgba(255,255,255,.9);
  }

  #forma-editorial-{{ section.id }} .forma-editorial__title {
    margin: 0;
    font-size: clamp(
      {{ section.settings.title_min_size }}px,
      {{ section.settings.title_desktop_size }}vw,
      {{ section.settings.title_size }}px
    );
    line-height: var(--title-line-height);
    font-weight: {{ section.settings.title_weight }};
    letter-spacing: var(--title-letter-spacing);
    color: #fff;
    text-wrap: balance;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__description {
    max-width: {{ section.settings.description_width }}px;
    margin-top: {{ section.settings.description_margin }}px;
    font-size: {{ section.settings.description_size }}px;
    line-height: {{ section.settings.description_line_height | divided_by: 10.0 }};
    font-weight: 400;
    color: rgba(255,255,255,.88);
  }

  #forma-editorial-{{ section.id }} .forma-editorial__content.is-center .forma-editorial__description {
    margin-left: auto;
    margin-right: auto;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: {{ section.settings.cta_margin }}px;
    font-size: {{ section.settings.cta_size }}px;
    font-weight: {{ section.settings.cta_weight }};
    letter-spacing: var(--cta-letter-spacing);
    text-transform: {{ section.settings.cta_transform }};
    color: #fff;
    border-bottom: 1px solid rgba(255,255,255,.8);
    padding-bottom: 5px;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__arrow {
    transition: transform .3s ease;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__slide:hover .forma-editorial__arrow {
    transform: translate(3px,-3px);
  }

  /* NAVIGATION */

  #forma-editorial-{{ section.id }} .forma-editorial__navigation {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: none;
    background: transparent;
    color: #fff;
    cursor: pointer;
    pointer-events: auto;
    transition: opacity .25s ease, transform .25s ease;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__nav:hover {
    opacity: .65;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__nav svg {
    width: 28px;
    height: 28px;
    display: block;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__prev {
    left: {{ section.settings.arrow_offset }}px;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__next {
    right: {{ section.settings.arrow_offset }}px;
  }

  /* MOBILE */

  @media screen and (max-width: 749px) {

    #forma-editorial-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #forma-editorial-{{ section.id }} .forma-editorial__track {
      gap: {{ section.settings.mobile_slide_gap }}px;
    }

    #forma-editorial-{{ section.id }} .forma-editorial__slide {
      flex: 0 0 {{ section.settings.mobile_slide_width }}vw;
      width: {{ section.settings.mobile_slide_width }}vw;
      height: {{ section.settings.mobile_height }}vh;
      min-height: 420px;
      border-radius: {{ section.settings.mobile_border_radius }}px;
    }

    #forma-editorial-{{ section.id }} .forma-editorial__content {
      left: {{ section.settings.mobile_content_left }}px;
      right: {{ section.settings.mobile_content_right }}px;
      bottom: {{ section.settings.mobile_content_bottom }}px;
      max-width: none;
    }

    #forma-editorial-{{ section.id }} .forma-editorial__content.is-right {
      left: auto;
      right: {{ section.settings.mobile_content_left }}px;
    }

    #forma-editorial-{{ section.id }} .forma-editorial__content.is-center {
      left: 50%;
      right: auto;
      width: calc(100% - 40px);
      transform: translateX(-50%);
    }

    #forma-editorial-{{ section.id }} .forma-editorial__eyebrow {
      font-size: {{ section.settings.mobile_eyebrow_size }}px;
      margin-bottom: 10px;
    }

    #forma-editorial-{{ section.id }} .forma-editorial__title {
      font-size: {{ section.settings.mobile_title_size }}px;
      line-height: .9;
    }

    #forma-editorial-{{ section.id }} .forma-editorial__description {
      font-size: {{ section.settings.mobile_description_size }}px;
      margin-top: 14px;
    }

    #forma-editorial-{{ section.id }} .forma-editorial__cta {
      font-size: {{ section.settings.mobile_cta_size }}px;
      margin-top: 20px;
    }

    #forma-editorial-{{ section.id }} .forma-editorial__nav {
      width: 36px;
      height: 36px;
    }

    #forma-editorial-{{ section.id }} .forma-editorial__nav svg {
      width: 24px;
      height: 24px;
    }

  }

</style>


<script>
(function() {

  const section = document.getElementById('forma-editorial-{{ section.id }}');
  if (!section || section.dataset.initialized === 'true') return;
  section.dataset.initialized = 'true';

  const track = section.querySelector('[data-track]');
  const slides = Array.from(section.querySelectorAll('.forma-editorial__slide'));
  const prev = section.querySelector('.forma-editorial__prev');
  const next = section.querySelector('.forma-editorial__next');

  if (!track || slides.length === 0) return;

  function getDistance() {
    if (slides.length < 2) {
      return slides[0].getBoundingClientRect().width;
    }

    return slides[1].offsetLeft - slides[0].offsetLeft;
  }

  function currentIndex() {
    const distance = getDistance();
    if (!distance) return 0;
    return Math.round(track.scrollLeft / distance);
  }

  function goTo(index) {
    const distance = getDistance();
    if (!distance) return;

    index = Math.max(0, Math.min(index, slides.length - 1));

    track.scrollTo({
      left: index * distance,
      behavior: 'smooth'
    });
  }

  if (prev) {
    prev.addEventListener('click', function() {
      goTo(currentIndex() - 1);
    });
  }

  if (next) {
    next.addEventListener('click', function() {
      goTo(currentIndex() + 1);
    });
  }

  /* DRAG */

  let isDragging = false;
  let startX = 0;
  let startScroll = 0;
  let hasDragged = false;
  let suppressClick = false;

  track.addEventListener('pointerdown', function(event) {

    if (event.pointerType === 'touch') return;
    if (event.target.closest('button')) return;

    isDragging = true;
    hasDragged = false;
    startX = event.clientX;
    startScroll = track.scrollLeft;

    track.classList.add('is-dragging');

    try {
      track.setPointerCapture(event.pointerId);
    } catch(e) {}

  });

  track.addEventListener('pointermove', function(event) {

    if (!isDragging) return;

    const delta = event.clientX - startX;

    if (Math.abs(delta) > 5) {
      hasDragged = true;
    }

    if (hasDragged) {
      track.scrollLeft = startScroll - delta;
    }

  });

  function endDrag(event) {

    if (!isDragging) return;

    isDragging = false;
    track.classList.remove('is-dragging');

    try {
      track.releasePointerCapture(event.pointerId);
    } catch(e) {}

    if (hasDragged) {

      suppressClick = true;

      goTo(currentIndex());

      setTimeout(function() {
        suppressClick = false;
      }, 250);

    }

  }

  track.addEventListener('pointerup', endDrag);
  track.addEventListener('pointercancel', endDrag);

  section.addEventListener('click', function(event) {

    if (suppressClick) {
      event.preventDefault();
      event.stopPropagation();
    }

  }, true);

  /* KEYBOARD */

  track.addEventListener('keydown', function(event) {

    if (event.key === 'ArrowRight') {
      goTo(currentIndex() + 1);
    }

    if (event.key === 'ArrowLeft') {
      goTo(currentIndex() - 1);
    }

  });

})();
</script>


{% schema %}
{
  "name": "FORMA Editorial Slider",
  "tag": "section",
  "class": "forma-editorial-slider-section",

  "settings": [

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "slide_width",
      "min": 35,
      "max": 100,
      "step": 1,
      "unit": "vw",
      "label": "Desktop slide width",
      "default": 48
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 40,
      "max": 90,
      "step": 1,
      "unit": "vh",
      "label": "Desktop height",
      "default": 68
    },
    {
      "type": "range",
      "id": "mobile_slide_width",
      "min": 75,
      "max": 100,
      "step": 1,
      "unit": "vw",
      "label": "Mobile slide width",
      "default": 88
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 50,
      "max": 90,
      "step": 1,
      "unit": "vh",
      "label": "Mobile height",
      "default": 74
    },
    {
      "type": "range",
      "id": "slide_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Slide gap",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_slide_gap",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Mobile slide gap",
      "default": 12
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_border_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Mobile border radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "arrow_offset",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Arrow offset",
      "default": 20
    },

    {
      "type": "header",
      "content": "Content position"
    },
    {
      "type": "range",
      "id": "content_left",
      "min": 0,
      "max": 200,
      "step": 5,
