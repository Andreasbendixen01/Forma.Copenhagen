    {
      "type": "range",
      "id": "title_desktop_size",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "vw",
      "label": "Title desktop scaling",
      "default": 7
    },
    {
      "type": "range",
      "id": "title_size",
