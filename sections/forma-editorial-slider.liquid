{% comment %}
  ============================================================
  FORMA — EDITORIAL SLIDER
  ============================================================

  Minimal editorial image slider for FORMA Copenhagen.

  Features:
  - No autoplay
  - No arrows
  - No visible controls
  - Mouse drag
  - Touch swipe
  - Infinite loop
  - Editorial typography
  - Responsive
  - Fully editable in Shopify
  ============================================================
{% endcomment %}

<section
  id="forma-editorial-{{ section.id }}"
  class="forma-editorial"
  data-forma-editorial
>

  <div class="forma-editorial__viewport" data-forma-viewport>

    <div class="forma-editorial__track" data-forma-track>

      {% assign slide_count = section.blocks.size %}

      {% if slide_count > 0 %}

        {% assign last_block = section.blocks | last %}

        <!-- CLONED LAST SLIDE -->

        <article
          class="forma-editorial__slide"
          data-forma-slide
          data-clone="last"
        >

          <div class="forma-editorial__image-wrap">

            {% if last_block.settings.image != blank %}

              {{
                last_block.settings.image
                | image_url: width: 3000
                | image_tag:
                  loading: 'lazy',
                  widths: '1000, 1400, 1800, 2200, 2600, 3000',
                  sizes: '(min-width: 1500px) 1400px, calc(100vw - 32px)',
                  class: 'forma-editorial__image',
                  alt: last_block.settings.image.alt
              }}

            {% else %}

              {{ 'lifestyle-1' | placeholder_svg_tag: 'forma-editorial__placeholder' }}

            {% endif %}

            <div class="forma-editorial__gradient"></div>

          </div>


          <div class="forma-editorial__content">

            {% if last_block.settings.eyebrow != blank %}

              <div class="forma-editorial__eyebrow">
                {{ last_block.settings.eyebrow }}
              </div>

            {% endif %}


            {% if last_block.settings.title != blank %}

              <h2 class="forma-editorial__title">
                {{ last_block.settings.title }}
              </h2>

            {% endif %}


            {% if last_block.settings.description != blank %}

              <div class="forma-editorial__description">
                {{ last_block.settings.description }}
              </div>

            {% endif %}


            {% if last_block.settings.button_text != blank and last_block.settings.link != blank %}

              <a
                href="{{ last_block.settings.link }}"
                class="forma-editorial__link"
                draggable="false"
              >
                <span>{{ last_block.settings.button_text }}</span>
                <span class="forma-editorial__link-arrow">↗</span>
              </a>

            {% endif %}

          </div>

        </article>


        <!-- REAL SLIDES -->

        {% for block in section.blocks %}

          <article
            class="forma-editorial__slide"
            data-forma-slide
            {{ block.shopify_attributes }}
          >

            <div class="forma-editorial__image-wrap">

              {% if block.settings.image != blank %}

                {{
                  block.settings.image
                  | image_url: width: 3000
                  | image_tag:
                    loading: 'lazy',
                    widths: '1000, 1400, 1800, 2200, 2600, 3000',
                    sizes: '(min-width: 1500px) 1400px, calc(100vw - 32px)',
                    class: 'forma-editorial__image',
                    alt: block.settings.image.alt,
                    draggable: 'false'
                }}

              {% else %}

                {{ 'lifestyle-1' | placeholder_svg_tag: 'forma-editorial__placeholder' }}

              {% endif %}

              <div class="forma-editorial__gradient"></div>

            </div>


            <div class="forma-editorial__content">

              {% if block.settings.eyebrow != blank %}

                <div class="forma-editorial__eyebrow">
                  {{ block.settings.eyebrow }}
                </div>

              {% endif %}


              {% if block.settings.title != blank %}

                <h2 class="forma-editorial__title">
                  {{ block.settings.title }}
                </h2>

              {% endif %}


              {% if block.settings.description != blank %}

                <div class="forma-editorial__description">
                  {{ block.settings.description }}
                </div>

              {% endif %}


              {% if block.settings.button_text != blank and block.settings.link != blank %}

                <a
                  href="{{ block.settings.link }}"
                  class="forma-editorial__link"
                  draggable="false"
                >
                  <span>{{ block.settings.button_text }}</span>
                  <span class="forma-editorial__link-arrow">↗</span>
                </a>

              {% endif %}

            </div>

          </article>

        {% endfor %}


        <!-- CLONED FIRST SLIDE -->

        {% assign first_block = section.blocks | first %}

        <article
          class="forma-editorial__slide"
          data-forma-slide
          data-clone="first"
        >

          <div class="forma-editorial__image-wrap">

            {% if first_block.settings.image != blank %}

              {{
                first_block.settings.image
                | image_url: width: 3000
                | image_tag:
                  loading: 'lazy',
                  widths: '1000, 1400, 1800, 2200, 2600, 3000',
                  sizes: '(min-width: 1500px) 1400px, calc(100vw - 32px)',
                  class: 'forma-editorial__image',
                  alt: first_block.settings.image.alt
              }}

            {% else %}

              {{ 'lifestyle-1' | placeholder_svg_tag: 'forma-editorial__placeholder' }}

            {% endif %}

            <div class="forma-editorial__gradient"></div>

          </div>


          <div class="forma-editorial__content">

            {% if first_block.settings.eyebrow != blank %}

              <div class="forma-editorial__eyebrow">
                {{ first_block.settings.eyebrow }}
              </div>

            {% endif %}


            {% if first_block.settings.title != blank %}

              <h2 class="forma-editorial__title">
                {{ first_block.settings.title }}
              </h2>

            {% endif %}


            {% if first_block.settings.description != blank %}

              <div class="forma-editorial__description">
                {{ first_block.settings.description }}
              </div>

            {% endif %}


            {% if first_block.settings.button_text != blank and first_block.settings.link != blank %}

              <a
                href="{{ first_block.settings.link }}"
                class="forma-editorial__link"
                draggable="false"
              >
                <span>{{ first_block.settings.button_text }}</span>
                <span class="forma-editorial__link-arrow">↗</span>
              </a>

            {% endif %}

          </div>

        </article>

      {% endif %}

    </div>

  </div>

</section>


<style>

  /* ============================================================
     ROOT
     ============================================================ */

  #forma-editorial-{{ section.id }} {

    --forma-max-width: {{ section.settings.max_width }}px;
    --forma-height: {{ section.settings.desktop_height }}vh;
    --forma-gap: {{ section.settings.slide_gap }}px;
    --forma-side-space: {{ section.settings.side_space }}px;

    width: 100%;

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;

    overflow: hidden;

    background: transparent;

  }


  /* ============================================================
     VIEWPORT
     ============================================================ */

  #forma-editorial-{{ section.id }} .forma-editorial__viewport {

    width: 100%;

    overflow: hidden;

    cursor: grab;

    user-select: none;
    -webkit-user-select: none;

    touch-action: pan-y;

  }


  #forma-editorial-{{ section.id }} .forma-editorial__viewport.is-dragging {

    cursor: grabbing;

  }


  /* ============================================================
     TRACK
     ============================================================ */

  #forma-editorial-{{ section.id }} .forma-editorial__track {

    display: flex;

    gap: var(--forma-gap);

    width: max-content;

    will-change: transform;

  }


  /* ============================================================
     SLIDE
     ============================================================ */

  #forma-editorial-{{ section.id }} .forma-editorial__slide {

    position: relative;

    flex: 0 0 min(
      calc(100vw - (var(--forma-side-space) * 2)),
      var(--forma-max-width)
    );

    height: var(--forma-height);

    min-height: 580px;

    overflow: hidden;

    border-radius: {{ section.settings.border_radius }}px;

    background: #111;

    isolation: isolate;

  }


  /* ============================================================
     IMAGE
     ============================================================ */

  #forma-editorial-{{ section.id }} .forma-editorial__image-wrap {

    position: absolute;

    inset: 0;

    overflow: hidden;

  }


  #forma-editorial-{{ section.id }} .forma-editorial__image {

    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transform: scale(1.001);

    pointer-events: none;

    transition:
      transform 1.4s cubic-bezier(.22,.61,.36,1);

  }


  /* Very subtle movement when hovering */

  #forma-editorial-{{ section.id }} .forma-editorial__slide:hover
  .forma-editorial__image {

    transform: scale(1.025);

  }


  /* ============================================================
     IMAGE GRADIENT
     ============================================================ */

  #forma-editorial-{{ section.id }} .forma-editorial__gradient {

    position: absolute;

    inset: 0;

    pointer-events: none;

    background:

      linear-gradient(
        180deg,
        rgba(0,0,0,0) 48%,
        rgba(0,0,0,.08) 62%,
        rgba(0,0,0,.58) 100%
      );

  }


  /* ============================================================
     CONTENT
     ============================================================ */

  #forma-editorial-{{ section.id }} .forma-editorial__content {

    position: absolute;

    z-index: 3;

    left: 48px;
    right: 48px;
    bottom: 46px;

    max-width: 850px;

    color: #fff;

    pointer-events: none;

  }


  /* ============================================================
     EYEBROW
     ============================================================ */

  #forma-editorial-{{ section.id }} .forma-editorial__eyebrow {

    margin-bottom: 15px;

    font-size: 10px;

    line-height: 1;

    font-weight: 600;

    letter-spacing: .19em;

    text-transform: uppercase;

    color: rgba(255,255,255,.86);

  }


  /* ============================================================
     TITLE
     ============================================================ */

  #forma-editorial-{{ section.id }} .forma-editorial__title {

    margin: 0;

    max-width: 900px;

    font-size: clamp(
      56px,
      7.4vw,
      116px
    );

    line-height: .84;

    font-weight: 400;

    letter-spacing: -.065em;

    color: #fff;

  }


  /* ============================================================
     DESCRIPTION
     ============================================================ */

  #forma-editorial-{{ section.id }} .forma-editorial__description {

    max-width: 440px;

    margin-top: 21px;

    font-size: 14px;

    line-height: 1.45;

    font-weight: 400;

    color: rgba(255,255,255,.88);

  }


  /* ============================================================
     LINK
     ============================================================ */

  #forma-editorial-{{ section.id }} .forma-editorial__link {

    display: inline-flex;

    align-items: center;

    gap: 10px;

    margin-top: 24px;

    padding-bottom: 5px;

    border-bottom: 1px solid rgba(255,255,255,.65);

    color: #fff;

    text-decoration: none;

    font-size: 10px;

    line-height: 1;

    font-weight: 600;

    letter-spacing: .15em;

    text-transform: uppercase;

    pointer-events: auto;

    transition:
      gap .3s ease,
      border-color .3s ease;

  }


  #forma-editorial-{{ section.id }} .forma-editorial__link:hover {

    gap: 16px;

    border-color: #fff;

  }


  #forma-editorial-{{ section.id }} .forma-editorial__link-arrow {

    font-size: 14px;

    line-height: .7;

  }


  /* ============================================================
     PLACEHOLDER
     ============================================================ */

  #forma-editorial-{{ section.id }} .forma-editorial__placeholder {

    width: 100%;
    height: 100%;

    background: #e8e8e6;

    opacity: .5;

  }


  /* ============================================================
     MOBILE
     ============================================================ */

  @media screen and (max-width: 749px) {

    #forma-editorial-{{ section.id }} {

      --forma-height: {{ section.settings.mobile_height }}vh;

      --forma-gap: 10px;

      --forma-side-space: 14px;

      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;

    }


    #forma-editorial-{{ section.id }} .forma-editorial__slide {

      flex-basis: calc(100vw - 28px);

      min-height: 540px;

      border-radius: {{ section.settings.mobile_border_radius }}px;

    }


    #forma-editorial-{{ section.id }} .forma-editorial__content {

      left: 24px;
      right: 24px;

      bottom: 30px;

    }


    #forma-editorial-{{ section.id }} .forma-editorial__eyebrow {

      margin-bottom: 12px;

      font-size: 9px;

      letter-spacing: .17em;

    }


    #forma-editorial-{{ section.id }} .forma-editorial__title {

      max-width: 100%;

      font-size: clamp(
        46px,
        13vw,
        72px
      );

      line-height: .86;

      letter-spacing: -.06em;

    }


    #forma-editorial-{{ section.id }} .forma-editorial__description {

      max-width: 300px;

      margin-top: 17px;

      font-size: 13px;

      line-height: 1.45;

    }


    #forma-editorial-{{ section.id }} .forma-editorial__link {

      margin-top: 20px;

      font-size: 9px;

    }


    #forma-editorial-{{ section.id }} .forma-editorial__gradient {

      background:

        linear-gradient(
          180deg,
          rgba(0,0,0,0) 42%,
          rgba(0,0,0,.10) 60%,
          rgba(0,0,0,.64) 100%
        );

    }

  }


  /* ============================================================
     REDUCED MOTION
     ============================================================ */

  @media (prefers-reduced-motion: reduce) {

    #forma-editorial-{{ section.id }} .forma-editorial__image {

      transition: none;

    }

  }

</style>


<script>

  (() => {

    const root = document.querySelector(
      '#forma-editorial-{{ section.id }}'
    );

    if (!root) return;


    const viewport = root.querySelector(
      '[data-forma-viewport]'
    );

    const track = root.querySelector(
      '[data-forma-track]'
    );

    const slides = Array.from(
      root.querySelectorAll('[data-forma-slide]')
    );


    const totalSlides = {{ slide_count }};


    if (
      !viewport ||
      !track ||
      totalSlides < 2
    ) {
      return;
    }


    /* ==========================================================
       STATE
       ========================================================== */

    let currentIndex = 1;

    let isDragging = false;

    let startX = 0;

    let currentX = 0;

    let dragDistance = 0;

    let animationLocked = false;

    let wheelDistance = 0;

    let wheelResetTimer = null;

    let wheelAnimating = false;


    /* ==========================================================
       SETTINGS
       ========================================================== */

    const TRANSITION =
      'transform 850ms cubic-bezier(.16,1,.3,1)';

    const DRAG_THRESHOLD = 0.22;

    const WHEEL_THRESHOLD = 120;


    /* ==========================================================
       DIMENSIONS
       ========================================================== */

    function getSlideWidth() {

      const slide = slides[0];

      if (!slide) return 0;

      return slide.getBoundingClientRect().width;

    }


    function getGap() {

      const styles =
        window.getComputedStyle(track);

      return parseFloat(styles.gap) || 0;

    }


    function getDistance() {

      return (
        getSlideWidth() +
        getGap()
      );

    }


    /* ==========================================================
       SET POSITION
       ========================================================== */

    function setPosition(
      animate = true,
      extraOffset = 0
    ) {

      const distance =
        currentIndex *
        getDistance();

      track.style.transition =
        animate
          ? TRANSITION
          : 'none';

      track.style.transform =
        `translate3d(${(-distance) + extraOffset}px, 0, 0)`;

    }


    /* ==========================================================
       NEXT
       ========================================================== */

    function nextSlide() {

      if (animationLocked) return;

      animationLocked = true;

      currentIndex++;

      setPosition(true);

    }


    /* ==========================================================
       PREVIOUS
       ========================================================== */

    function previousSlide() {

      if (animationLocked) return;

      animationLocked = true;

      currentIndex--;

      setPosition(true);

    }


    /* ==========================================================
       INFINITE LOOP
       ========================================================== */

    track.addEventListener(
      'transitionend',
      (event) => {

        if (
          event.propertyName !== 'transform'
        ) {
          return;
        }


        if (currentIndex === 0) {

          currentIndex =
            totalSlides;

          setPosition(false);

        }


        if (
          currentIndex ===
          totalSlides + 1
        ) {

          currentIndex = 1;

          setPosition(false);

        }


        animationLocked = false;

      }
    );


    /* ==========================================================
       POINTER DOWN
       ========================================================== */

    viewport.addEventListener(
      'pointerdown',
      (event) => {

        if (
          event.pointerType === 'mouse' &&
          event.button !== 0
        ) {
          return;
        }


        if (animationLocked) return;


        isDragging = true;

        startX = event.clientX;

        currentX = event.clientX;

        dragDistance = 0;


        viewport.classList.add(
          'is-dragging'
        );


        track.style.transition =
          'none';


        viewport.setPointerCapture(
          event.pointerId
        );

      }
    );


    /* ==========================================================
       POINTER MOVE
       ========================================================== */

    viewport.addEventListener(
      'pointermove',
      (event) => {

        if (!isDragging) return;


        currentX =
          event.clientX;


        dragDistance =
          currentX - startX;


        /*
          IMPORTANT:

          The slide follows the mouse/trackpad
          continuously.

          Nothing changes yet.

          The actual slide only changes
          when the user releases.
        */


        const baseDistance =
          currentIndex *
          getDistance();


        track.style.transition =
          'none';


        track.style.transform =
          `translate3d(${(-baseDistance) + dragDistance}px, 0, 0)`;

      }
    );


    /* ==========================================================
       POINTER UP
       ========================================================== */

    function finishDrag(event) {

      if (!isDragging) return;


      isDragging = false;


      viewport.classList.remove(
        'is-dragging'
      );


      try {

        viewport.releasePointerCapture(
          event.pointerId
        );

      } catch (error) {}


      const slideWidth =
        getSlideWidth();


      const threshold =
        Math.max(
          60,
          slideWidth * DRAG_THRESHOLD
        );


      /*
        Only change slide when the user
        has actually dragged far enough.
      */

      if (
        Math.abs(dragDistance) >= threshold
      ) {

        if (dragDistance < 0) {

          nextSlide();

        } else {

          previousSlide();

        }

      } else {

        /*
          Not enough movement:
          smoothly return to current slide.
        */

        setPosition(true);

      }

    }


    viewport.addEventListener(
      'pointerup',
      finishDrag
    );


    viewport.addEventListener(
      'pointercancel',
      finishDrag
    );


    /* ==========================================================
       TRACKPAD / MAGIC MOUSE
       ==========================================================

       IMPORTANT:

       We DON'T immediately change slide when
       deltaX is detected.

       Instead we collect the complete gesture.

       When the gesture has finished, we decide
       whether it was large enough to move to
       the next slide.
    */

    viewport.addEventListener(
      'wheel',
      (event) => {

        /*
          Ignore normal vertical scrolling.
        */

        if (
          Math.abs(event.deltaX) <=
          Math.abs(event.deltaY)
        ) {
          return;
        }


        /*
          Prevent horizontal browser scrolling
          inside the slider.
        */

        event.preventDefault();


        if (
          animationLocked ||
          wheelAnimating
        ) {
          return;
        }


        /*
          Accumulate the entire swipe.
        */

        wheelDistance +=
          event.deltaX;


        /*
          Keep the current slide following
          the trackpad slightly.

          This gives the gesture a physical,
          smooth feeling instead of an instant
          jump.
        */

        const maxDrag =
          getSlideWidth() * 0.65;


        const visualDistance =
          Math.max(
            -maxDrag,
            Math.min(
              maxDrag,
              -wheelDistance
            )
          );


        const baseDistance =
          currentIndex *
          getDistance();


        track.style.transition =
          'none';


        track.style.transform =
          `translate3d(${(-baseDistance) + visualDistance}px, 0, 0)`;


        /*
          Wait until the trackpad gesture has
          stopped generating events.

          Only THEN do we decide what to do.
        */

        clearTimeout(
          wheelResetTimer
        );


        wheelResetTimer =
          setTimeout(
            () => {

              const distance =
                wheelDistance;


              wheelDistance = 0;

              wheelAnimating = true;


              /*
                Strong enough swipe:
                move one slide.
              */

              if (
                Math.abs(distance) >=
                WHEEL_THRESHOLD
              ) {

                if (distance > 0) {

                  previousSlide();

                } else {

                  nextSlide();

                }

              } else {

                /*
                  Small swipe:
                  smoothly return.
                */

                setPosition(true);

              }


              setTimeout(
                () => {

                  wheelAnimating = false;

                },
                900
              );


            },
            110
          );

      },
      {
        passive: false
      }
    );


    /* ==========================================================
       PREVENT IMAGE DRAG
       ========================================================== */

    root.querySelectorAll('img').forEach(
      (image) => {

        image.addEventListener(
          'dragstart',
          (event) => {

            event.preventDefault();

          }
        );

      }
    );


    viewport.addEventListener(
      'dragstart',
      (event) => {

        event.preventDefault();

      }
    );


    /* ==========================================================
       KEYBOARD
       ========================================================== */

    root.addEventListener(
      'keydown',
      (event) => {

        if (
          event.key === 'ArrowRight'
        ) {

          event.preventDefault();

          nextSlide();

        }


        if (
          event.key === 'ArrowLeft'
        ) {

          event.preventDefault();

          previousSlide();

        }

      }
    );


    /* ==========================================================
       RESIZE
       ========================================================== */

    let resizeTimeout;


    window.addEventListener(
      'resize',
      () => {

        clearTimeout(
          resizeTimeout
        );


        resizeTimeout =
          setTimeout(
            () => {

              setPosition(false);

            },
            100
          );

      }
    );


    /* ==========================================================
       INITIALIZE
       ========================================================== */

    setPosition(false);

  })();

</script>


{% schema %}

{
  "name": "FORMA Editorial Slider",

  "tag": "section",

  "class": "forma-editorial-slider-section",

  "settings": [

    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Maximum width",
      "default": 1380
    },

    {
      "type": "range",
      "id": "desktop_height",
      "min": 55,
      "max": 85,
      "step": 1,
      "unit": "%",
      "label": "Desktop height",
      "default": 74
    },

    {
      "type": "range",
      "id": "mobile_height",
      "min": 60,
      "max": 88,
      "step": 1,
      "unit": "%",
      "label": "Mobile height",
      "default": 74
    },

    {
      "type": "range",
      "id": "side_space",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Side spacing",
      "default": 40
    },

    {
      "type": "range",
      "id": "slide_gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Space between slides",
      "default": 16
    },

    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },

    {
      "type": "range",
      "id": "mobile_border_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Mobile border radius",
      "default": 0
    },

    {
      "type": "header",
      "content": "Spacing"
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 5,
