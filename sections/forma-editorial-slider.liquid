      "label": "Content left",
      "default": 48
    },
    {
      "type": "range",
      "id": "content_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Content bottom",
      "default": 50
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 300,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Content maximum width",
      "default": 1000
    },
    {
      "type": "range",
      "id": "mobile_content_left",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Mobile content left",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_content_right",
