{% comment %}
  FORMA — EDITORIAL SLIDER
{% endcomment %}

<section
  id="forma-editorial-{{ section.id }}"
  class="forma-editorial"
>

  <div class="forma-editorial__viewport">

    <div
      class="forma-editorial__track"
      data-forma-editorial-track
    >

      {% for block in section.blocks %}

        <article
          class="forma-editorial__slide"
          data-forma-editorial-slide
          data-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.link != blank %}
            <a
              href="{{ block.settings.link }}"
              class="forma-editorial__slide-link"
              data-forma-slide-link
            >
          {% else %}
            <div class="forma-editorial__slide-link">
          {% endif %}


            <!-- IMAGE -->

            <div class="forma-editorial__media">

              {% if block.settings.image != blank %}

                {{
                  block.settings.image
                  | image_url: width: 3200
                  | image_tag:
                    loading: 'lazy',
                    widths: '1000, 1400, 1800, 2200, 2600, 3000, 3200',
                    sizes: '(min-width: 1500px) 1440px, 100vw',
                    class: 'forma-editorial__image',
                    alt: block.settings.image.alt | default: block.settings.title,
                    draggable: 'false'
                }}

              {% else %}

                {{ 'lifestyle-1' | placeholder_svg_tag: 'forma-editorial__placeholder' }}

              {% endif %}

              <div class="forma-editorial__overlay"></div>

              <div class="forma-editorial__gradient"></div>

            </div>


            <!-- CONTENT -->

            <div class="forma-editorial__content">

              {% if block.settings.eyebrow != blank %}

                <div class="forma-editorial__eyebrow">
                  {{ block.settings.eyebrow }}
                </div>

              {% endif %}


              {% if block.settings.title != blank %}

                <h2 class="forma-editorial__title">
                  {{ block.settings.title }}
                </h2>

              {% endif %}


              {% if block.settings.description != blank %}

                <div class="forma-editorial__description">
                  {{ block.settings.description }}
                </div>

              {% endif %}


              {% if block.settings.button_text != blank %}

                <div class="forma-editorial__cta">

                  <span>
                    {{ block.settings.button_text }}
                  </span>

                  <span class="forma-editorial__cta-arrow">
                    ↗
                  </span>

                </div>

              {% endif %}

            </div>


          {% if block.settings.link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}

        </article>

      {% endfor %}

    </div>

  </div>

</section>


<style>

  /* ============================================================
     SECTION
     ============================================================ */

  #forma-editorial-{{ section.id }} {

    --forma-max-width:
      {{ section.settings.max_width }}px;

    --forma-desktop-height:
      {{ section.settings.desktop_height }}vh;

    --forma-mobile-height:
      {{ section.settings.mobile_height }}vh;

    --forma-gap:
      {{ section.settings.slide_gap }}px;

    --forma-radius:
      {{ section.settings.border_radius }}px;

    position: relative;

    width: 100%;

    margin: 0;

    padding-top:
      {{ section.settings.padding_top }}px;

    padding-bottom:
      {{ section.settings.padding_bottom }}px;

    overflow: hidden;

    background: #fff;

    color: #111;

  }


  /* ============================================================
     VIEWPORT
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__viewport {

    position: relative;

    width: 100%;

    overflow: hidden;

  }


  /* ============================================================
     TRACK

     IMPORTANT:
     No left padding.
     The first slide starts completely at the
     left edge of the section.
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__track {

    display: flex;

    gap:
      var(--forma-gap);

    width: 100%;

    overflow-x: auto;

    overflow-y: hidden;

    padding: 0;

    margin: 0;

    scroll-behavior: smooth;

    scroll-snap-type: x mandatory;

    scroll-padding-left: 0;

    scrollbar-width: none;

    -ms-overflow-style: none;

    overscroll-behavior-x: contain;

    cursor: grab;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__track::-webkit-scrollbar {

    display: none;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__track.is-dragging {

    cursor: grabbing;

    scroll-behavior: auto;

    user-select: none;

    -webkit-user-select: none;

  }


  /* ============================================================
     SLIDE
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__slide {

    position: relative;

    flex:
      0 0 min(
        100vw,
        var(--forma-max-width)
      );

    width:
      min(
        100vw,
        var(--forma-max-width)
      );

    height:
      var(--forma-desktop-height);

    min-height: 560px;

    overflow: hidden;

    scroll-snap-align: start;

    scroll-snap-stop: always;

    flex-shrink: 0;

    border-radius:
      var(--forma-radius);

    background: #111;

    isolation: isolate;

  }


  /* ============================================================
     LINK
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__slide-link {

    position: absolute;

    inset: 0;

    display: block;

    color: inherit;

    text-decoration: none;

  }


  /* ============================================================
     MEDIA
     ============================================================ */

  #forma-editorial-{{ section.id }} .forma-editorial__media {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  z-index: 0;
  background: transparent;
}


  /* ============================================================
     IMAGE
     ============================================================ */

  #forma-editorial-{{ section.id }} .forma-editorial__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center;
  transform: scale(1.001);
  pointer-events: none;
  user-select: none;
  -webkit-user-select: none;
}


  /* ============================================================
     IMAGE HOVER
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__slide:hover
  .forma-editorial__image {

    transform:
      scale(1.025)
      translate3d(
        var(--forma-parallax-x, 0px),
        0,
        0
      );

  }


  /* ============================================================
     OVERLAY
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__overlay {

    position: absolute;

    inset: 0;

    z-index: 1;

    background:
      rgba(0,0,0,.025);

    pointer-events: none;

  }


  /* ============================================================
     GRADIENT
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__gradient {

    position: absolute;

    inset: 0;

    z-index: 2;

    pointer-events: none;

    background:
      linear-gradient(
        180deg,
        rgba(0,0,0,0) 25%,
        rgba(0,0,0,.025) 45%,
        rgba(0,0,0,.15) 63%,
        rgba(0,0,0,.76) 100%
      );

  }


  /* ============================================================
     CONTENT
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__content {

    position: absolute;

    left: 48px;

    right: 48px;

    bottom: 50px;

    z-index: 4;

    max-width: 1000px;

    color: #fff;

    pointer-events: none;

  }


  /* ============================================================
     EYEBROW
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__eyebrow {

    margin-bottom: 15px;

    font-size: 10px;

    line-height: 1;

    font-weight: 600;

    letter-spacing: .20em;

    text-transform: uppercase;

    color:
      rgba(255,255,255,.88);

  }


  /* ============================================================
     TITLE
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__title {

    margin: 0;

    max-width: 1000px;

    font-size:
      clamp(
        56px,
        7vw,
        112px
      );

    line-height: .86;

    font-weight: 400;

    letter-spacing: -.065em;

    color: #fff;

    text-wrap: balance;

  }


  /* ============================================================
     DESCRIPTION
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__description {

    max-width: 440px;

    margin-top: 20px;

    font-size: 14px;

    line-height: 1.5;

    color:
      rgba(255,255,255,.86);

  }


  /* ============================================================
     CTA
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__cta {

    display: inline-flex;

    align-items: center;

    gap: 10px;

    margin-top: 25px;

    padding-bottom: 7px;

    border-bottom:
      1px solid
      rgba(255,255,255,.65);

    font-size: 10px;

    line-height: 1;

    font-weight: 600;

    letter-spacing: .16em;

    text-transform: uppercase;

    transition:
      gap .35s ease,
      border-color .35s ease;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__slide:hover
  .forma-editorial__cta {

    gap: 17px;

    border-color: #fff;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__cta-arrow {

    font-size: 14px;

    line-height: .7;

  }


  /* ============================================================
     PLACEHOLDER
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__placeholder {

    position: absolute;

    inset: 0;

    width: 100%;

    height: 100%;

    background: #e9e9e7;

  }


  /* ============================================================
     MOBILE
     ============================================================ */

  @media screen and (max-width: 749px) {

    #forma-editorial-{{ section.id }} {

      --forma-gap: 10px;

      padding-top:
        {{ section.settings.mobile_padding_top }}px;

      padding-bottom:
        {{ section.settings.mobile_padding_bottom }}px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__track {

      padding: 0;

      scroll-padding-left: 0;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__slide {

      flex-basis:
        100vw;

      width:
        100vw;

      height:
        var(--forma-mobile-height);

      min-height: 520px;

      border-radius:
        {{ section.settings.mobile_border_radius }}px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__content {

      left: 24px;

      right: 24px;

      bottom: 30px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__eyebrow {

      margin-bottom: 12px;

      font-size: 9px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__title {

      font-size:
        clamp(
          44px,
          13vw,
          70px
        );

      line-height: .87;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__description {

      max-width: 310px;

      margin-top: 16px;

      font-size: 13px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__cta {

      margin-top: 20px;

      font-size: 9px;

    }

  }


  /* ============================================================
     REDUCED MOTION
     ============================================================ */

  @media (
    prefers-reduced-motion: reduce
  ) {

    #forma-editorial-{{ section.id }}
    .forma-editorial__track {

      scroll-behavior: auto;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__image {

      transition: none;

    }

  }

</style>


<script>

  (() => {

    const section =
      document.getElementById(
        'forma-editorial-{{ section.id }}'
      );

    if (!section) return;


    const track =
      section.querySelector(
        '[data-forma-editorial-track]'
      );


    const slides =
      Array.from(
        section.querySelectorAll(
          '[data-forma-editorial-slide]'
        )
      );


    if (
      !track ||
      slides.length === 0
    ) {
      return;
    }


    let isDragging = false;

    let startX = 0;

    let startScrollLeft = 0;

    let hasDragged = false;

    let suppressClick = false;


    /* ========================================================
       SLIDE DISTANCE
       ======================================================== */

    function getSlideDistance() {

      const slide =
        slides[0];

      if (!slide) return 0;


      const styles =
        window.getComputedStyle(track);


      const gap =
        parseFloat(
          styles.columnGap ||
          styles.gap
        ) || 0;


      return (
        slide.getBoundingClientRect().width +
        gap
      );

    }


    /* ========================================================
       MOUSE DRAG
       ======================================================== */

    track.addEventListener(
      'pointerdown',
      (event) => {

        if (
          event.pointerType !== 'mouse'
        ) {
          return;
        }


        if (
          event.button !== 0
        ) {
          return;
        }


        isDragging = true;

        hasDragged = false;

        startX =
          event.clientX;

        startScrollLeft =
          track.scrollLeft;


        track.classList.add(
          'is-dragging'
        );


        track.setPointerCapture(
          event.pointerId
        );

      }
    );


    track.addEventListener(
      'pointermove',
      (event) => {

        if (!isDragging) {
          return;
        }


        const delta =
          event.clientX -
          startX;


        if (
          Math.abs(delta) > 5
        ) {

          hasDragged = true;

          suppressClick = true;

        }


        track.scrollLeft =
          startScrollLeft -
          delta;

      }
    );


    function finishDrag(event) {

      if (!isDragging) {
        return;
      }


      isDragging = false;


      track.classList.remove(
        'is-dragging'
      );


      try {

        track.releasePointerCapture(
          event.pointerId
        );

      } catch (error) {}


      if (!hasDragged) {
        return;
      }


      const distance =
        getSlideDistance();


      if (!distance) {
        return;
      }


      const target =
        Math.round(
          track.scrollLeft /
          distance
        );


      track.scrollTo({

        left:
          target *
          distance,

        behavior:
          'smooth'

      });


      setTimeout(
        () => {

          suppressClick = false;

        },
        100
      );

    }


    track.addEventListener(
      'pointerup',
      finishDrag
    );


    track.addEventListener(
      'pointercancel',
      finishDrag
    );


    /* ========================================================
       PREVENT LINK CLICK AFTER DRAG
       ======================================================== */

    section.addEventListener(
      'click',
      (event) => {

        if (
          suppressClick
        ) {

          event.preventDefault();

          event.stopPropagation();

          suppressClick = false;

        }

      },
      true
    );


    /* ========================================================
       PREVENT IMAGE DRAGGING
       ======================================================== */

    section
      .querySelectorAll('img')
      .forEach(
        (image) => {

          image.addEventListener(
            'dragstart',
            (event) => {

              event.preventDefault();

            }
          );

        }
      );


    /* ========================================================
       MOUSE PARALLAX
       ======================================================== */

    track.addEventListener(
      'pointermove',
      (event) => {

        if (
          event.pointerType !==
          'mouse'
        ) {
          return;
        }


        if (isDragging) {
          return;
        }


        const slide =
          event.target.closest(
            '[data-forma-editorial-slide]'
          );


        if (!slide) return;


        const image =
          slide.querySelector(
            '.forma-editorial__image'
          );


        if (!image) return;


        const rect =
          slide.getBoundingClientRect();


        const percentage =
          (
            event.clientX -
            rect.left
          ) /
          rect.width -
          .5;


        image.style.setProperty(
          '--forma-parallax-x',
          `${percentage * -8}px`
        );

      }
    );


    /* ========================================================
       RESET PARALLAX
       ======================================================== */

    track.addEventListener(
      'pointerleave',
      () => {

        slides.forEach(
          (slide) => {

            const image =
              slide.querySelector(
                '.forma-editorial__image'
              );


            if (!image) return;


            image.style.setProperty(
              '--forma-parallax-x',
              '0px'
            );

          }
        );

      }
    );

  })();

</script>


{% schema %}

{
  "name": "FORMA Editorial Slider",

  "tag": "section",

  "class": "forma-editorial-slider-section",

  "settings": [

    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "max_width",
      "min": 1100,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Maximum width",
      "default": 1480
    },

    {
      "type": "range",
      "id": "desktop_height",
      "min": 55,
      "max": 85,
      "step": 1,
      "unit": "vh",
      "label": "Desktop height",
      "default": 74
    },

    {
      "type": "range",
      "id": "mobile_height",
      "min": 60,
      "max": 90,
      "step": 1,
      "unit": "vh",
      "label": "Mobile height",
      "default": 74
    },

    {
      "type": "range",
      "id": "slide_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Slide gap",
      "default": 16
    },

    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },

    {
      "type": "range",
      "id": "mobile_border_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Mobile border radius",
      "default": 0
    },

    {
      "type": "header",
      "content": "Spacing"
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top spacing",
      "default": 0
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 30
    },

    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Mobile top spacing",
      "default": 0
    },

    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Mobile bottom spacing",
      "default": 24
    }

  ],

  "blocks": [

    {
      "type": "slide",

      "name": "Slide",

      "settings": [

        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },

        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "FORMA EDIT"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The Forma Edit"
        },

        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Stories, places, brands and ideas worth knowing."
        },

        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Explore"
        },

        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }

      ]

    }

  ],

  "presets": [

    {
      "name": "FORMA Editorial Slider",

      "blocks": [

        {
          "type": "slide"
        },

        {
          "type": "slide"
        },

        {
          "type": "slide"
        },

        {
          "type": "slide"
        },

        {
          "type": "slide"
        }

      ]

    }

  ]

}

{% endschema %}