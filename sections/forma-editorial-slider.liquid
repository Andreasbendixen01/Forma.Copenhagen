{% comment %}
  ============================================================
  FORMA — EDITORIAL SLIDER
  ============================================================

  Native horizontal scroll architecture inspired by
  the FORMA Journal slider.

  Core:
  - Native horizontal scrolling
  - CSS scroll snap
  - scroll-snap-stop: always
  - Mouse drag
  - Touch swipe
  - Trackpad
  - Magic Mouse
  - Keyboard
  - No autoplay
  - No arrows
  - No cloned slides
  - No transform-based carousel engine

  Visual:
  - Large editorial imagery
  - Cinematic gradient
  - Subtle image zoom
  - Mouse parallax
  - Editorial typography
  - Progress indicator
  ============================================================
{% endcomment %}


<section
  id="forma-editorial-{{ section.id }}"
  class="forma-editorial"
>

  <div class="forma-editorial__viewport">

    <div
      class="forma-editorial__track"
      data-forma-editorial-track
    >

      {% for block in section.blocks %}

        <article
          class="forma-editorial__slide"
          data-forma-editorial-slide
          data-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.link != blank %}
            <a
              href="{{ block.settings.link }}"
              class="forma-editorial__slide-link"
              data-forma-slide-link
            >
          {% else %}
            <div class="forma-editorial__slide-link">
          {% endif %}


            <!-- ============================================
                 IMAGE
                 ============================================ -->

            <div class="forma-editorial__media">

              {% if block.settings.image != blank %}

                {{
                  block.settings.image
                  | image_url: width: 3200
                  | image_tag:
                    loading: 'lazy',
                    widths: '1000, 1400, 1800, 2200, 2600, 3000, 3200',
                    sizes: '(min-width: 1500px) 1440px, calc(100vw - 28px)',
                    class: 'forma-editorial__image',
                    alt: block.settings.image.alt | default: block.settings.title,
                    draggable: 'false'
                }}

              {% else %}

                {{ 'lifestyle-1' | placeholder_svg_tag: 'forma-editorial__placeholder' }}

              {% endif %}


              <div class="forma-editorial__overlay"></div>

              <div class="forma-editorial__gradient"></div>

            </div>


            <!-- ============================================
                 CONTENT
                 ============================================ -->

            <div class="forma-editorial__content">

              {% if block.settings.eyebrow != blank %}

                <div class="forma-editorial__eyebrow">
                  {{ block.settings.eyebrow }}
                </div>

              {% endif %}


              {% if block.settings.title != blank %}

                <h2 class="forma-editorial__title">
                  {{ block.settings.title }}
                </h2>

              {% endif %}


              {% if block.settings.description != blank %}

                <div class="forma-editorial__description">
                  {{ block.settings.description }}
                </div>

              {% endif %}


              {% if block.settings.button_text != blank %}

                <div class="forma-editorial__cta">

                  <span>
                    {{ block.settings.button_text }}
                  </span>

                  <span class="forma-editorial__cta-arrow">
                    ↗
                  </span>

                </div>

              {% endif %}

            </div>


            <!-- ============================================
                 SLIDE NUMBER
                 ============================================ -->

            <div class="forma-editorial__slide-number">

              <span>
                {{ forloop.index | prepend: '0' | slice: -2, 2 }}
              </span>

              <span class="forma-editorial__slide-number-line"></span>

              <span>
                {{ section.blocks.size | prepend: '0' | slice: -2, 2 }}
              </span>

            </div>


          {% if block.settings.link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}

        </article>

      {% endfor %}

    </div>

  </div>


  <!-- ========================================================
       BOTTOM META
       ======================================================== -->

  {% if section.blocks.size > 1 %}

    <div class="forma-editorial__bottom">

      <div class="forma-editorial__counter">

        <span data-forma-current>
          01
        </span>

        <span class="forma-editorial__counter-separator">
          /
        </span>

        <span>
          {{ section.blocks.size | prepend: '0' | slice: -2, 2 }}
        </span>

      </div>


      <div class="forma-editorial__progress">

        <div
          class="forma-editorial__progress-fill"
          data-forma-progress
        ></div>

      </div>


      <div class="forma-editorial__hint">
        <span class="forma-editorial__hint-line"></span>
        <span>Drag to explore</span>
      </div>

    </div>

  {% endif %}

</section>


<style>

  /* ============================================================
     SECTION
     ============================================================ */

  #forma-editorial-{{ section.id }} {

    --forma-max-width:
      {{ section.settings.max_width }}px;

    --forma-desktop-height:
      {{ section.settings.desktop_height }}vh;

    --forma-mobile-height:
      {{ section.settings.mobile_height }}vh;

    --forma-side-space:
      {{ section.settings.side_spacing }}px;

    --forma-gap:
      {{ section.settings.slide_gap }}px;

    --forma-radius:
      {{ section.settings.border_radius }}px;

    position: relative;

    width: 100%;

    margin: 0;

    padding-top:
      {{ section.settings.padding_top }}px;

    padding-bottom:
      {{ section.settings.padding_bottom }}px;

    overflow: hidden;

    background: #fff;

    color: #111;

  }


  /* ============================================================
     VIEWPORT
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__viewport {

    position: relative;

    width: 100%;

    overflow: hidden;

  }


  /* ============================================================
     TRACK

     THIS IS THE IMPORTANT PART.

     The slider itself is a native horizontal
     scroll container — exactly like the
     working Forma Journal slider.
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__track {

    display: flex;

    gap:
      var(--forma-gap);

    width: 100%;

    overflow-x: auto;

    overflow-y: hidden;

    padding:
      0
      var(--forma-side-space);

    margin: 0;

    scroll-behavior: smooth;

    scroll-snap-type: x mandatory;

    scroll-padding-left:
      var(--forma-side-space);

    scrollbar-width: none;

    -ms-overflow-style: none;

    overscroll-behavior-x: contain;

    cursor: grab;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__track::-webkit-scrollbar {

    display: none;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__track.is-dragging {

    cursor: grabbing;

    scroll-behavior: auto;

    user-select: none;

    -webkit-user-select: none;

  }


  /* ============================================================
     SLIDE
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__slide {

    position: relative;

    flex:
      0 0 min(
        calc(
          100vw -
          (var(--forma-side-space) * 2)
        ),
        var(--forma-max-width)
      );

    width:
      min(
        calc(
          100vw -
          (var(--forma-side-space) * 2)
        ),
        var(--forma-max-width)
      );

    height:
      var(--forma-desktop-height);

    min-height: 560px;

    overflow: hidden;

    scroll-snap-align: start;

    /*
      THIS prevents a fast gesture from
      skipping through multiple snap points.
    */

    scroll-snap-stop: always;

    flex-shrink: 0;

    border-radius:
      var(--forma-radius);

    background: #111;

    isolation: isolate;

  }


  /* ============================================================
     LINK
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__slide-link {

    position: absolute;

    inset: 0;

    display: block;

    color: inherit;

    text-decoration: none;

  }


  /* ============================================================
     MEDIA
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__media {

    position: absolute;

    inset: 0;

    overflow: hidden;

    z-index: 0;

  }


  /* ============================================================
     IMAGE
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__image {

    position: absolute;

    top: -3%;

    left: -3%;

    width: 106%;

    height: 106%;

    display: block;

    object-fit: cover;

    pointer-events: none;

    user-select: none;

    -webkit-user-select: none;

    transform:
      scale(1.001)
      translate3d(
        var(--forma-parallax-x, 0px),
        0,
        0
      );

    transition:
      transform
      1.2s
      cubic-bezier(.22,.61,.36,1);

    will-change: transform;

  }


  /* ============================================================
     HOVER IMAGE
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__slide:hover
  .forma-editorial__image {

    transform:
      scale(1.025)
      translate3d(
        var(--forma-parallax-x, 0px),
        0,
        0
      );

  }


  /* ============================================================
     OVERLAY
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__overlay {

    position: absolute;

    inset: 0;

    z-index: 1;

    background:
      rgba(0,0,0,.025);

    pointer-events: none;

  }


  /* ============================================================
     CINEMATIC GRADIENT
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__gradient {

    position: absolute;

    inset: 0;

    z-index: 2;

    pointer-events: none;

    background:
      linear-gradient(
        180deg,
        rgba(0,0,0,0) 25%,
        rgba(0,0,0,.025) 45%,
        rgba(0,0,0,.15) 63%,
        rgba(0,0,0,.76) 100%
      );

  }


  /* ============================================================
     CONTENT
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__content {

    position: absolute;

    left: 48px;

    right: 48px;

    bottom: 50px;

    z-index: 4;

    max-width: 1000px;

    color: #fff;

    pointer-events: none;

  }


  /* ============================================================
     EYEBROW
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__eyebrow {

    margin-bottom: 15px;

    font-size: 10px;

    line-height: 1;

    font-weight: 600;

    letter-spacing: .20em;

    text-transform: uppercase;

    color:
      rgba(255,255,255,.88);

  }


  /* ============================================================
     TITLE
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__title {

    margin: 0;

    max-width: 1000px;

    font-size:
      clamp(
        56px,
        7vw,
        112px
      );

    line-height: .86;

    font-weight: 400;

    letter-spacing: -.065em;

    color: #fff;

    text-wrap: balance;

  }


  /* ============================================================
     DESCRIPTION
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__description {

    max-width: 440px;

    margin-top: 20px;

    font-size: 14px;

    line-height: 1.5;

    color:
      rgba(255,255,255,.86);

  }


  /* ============================================================
     CTA
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__cta {

    display: inline-flex;

    align-items: center;

    gap: 10px;

    margin-top: 25px;

    padding-bottom: 7px;

    border-bottom:
      1px solid
      rgba(255,255,255,.65);

    font-size: 10px;

    line-height: 1;

    font-weight: 600;

    letter-spacing: .16em;

    text-transform: uppercase;

    transition:
      gap .35s ease,
      border-color .35s ease;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__slide:hover
  .forma-editorial__cta {

    gap: 17px;

    border-color: #fff;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__cta-arrow {

    font-size: 14px;

    line-height: .7;

  }


  /* ============================================================
     SLIDE NUMBER
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__slide-number {

    position: absolute;

    right: 30px;

    top: 30px;

    z-index: 5;

    display: flex;

    align-items: center;

    gap: 8px;

    font-size: 9px;

    line-height: 1;

    font-weight: 600;

    letter-spacing: .14em;

    color:
      rgba(255,255,255,.86);

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__slide-number-line {

    width: 24px;

    height: 1px;

    background:
      rgba(255,255,255,.55);

  }


  /* ============================================================
     BOTTOM META
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__bottom {

    display: flex;

    align-items: center;

    width:
      min(
        var(--forma-max-width),
        calc(
          100vw -
          (var(--forma-side-space) * 2)
        )
      );

    margin:
      17px auto 0;

    font-size: 9px;

    line-height: 1;

    font-weight: 600;

    letter-spacing: .14em;

    color:
      rgba(17,17,17,.65);

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__counter {

    min-width: 44px;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__counter-separator {

    margin:
      0 4px;

    opacity: .4;

  }


  /* ============================================================
     PROGRESS
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__progress {

    position: relative;

    flex: 1;

    height: 1px;

    margin:
      0 18px;

    overflow: hidden;

    background:
      rgba(17,17,17,.10);

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__progress-fill {

    position: absolute;

    top: 0;

    left: 0;

    width: 0;

    height: 100%;

    background: #111;

    transition:
      width
      .45s
      cubic-bezier(.22,.61,.36,1);

  }


  /* ============================================================
     DRAG HINT
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__hint {

    display: flex;

    align-items: center;

    gap: 8px;

    white-space: nowrap;

    opacity: .55;

  }


  #forma-editorial-{{ section.id }}
  .forma-editorial__hint-line {

    display: block;

    width: 24px;

    height: 1px;

    background: #111;

  }


  /* ============================================================
     PLACEHOLDER
     ============================================================ */

  #forma-editorial-{{ section.id }}
  .forma-editorial__placeholder {

    position: absolute;

    inset: 0;

    width: 100%;

    height: 100%;

    background: #e9e9e7;

  }


  /* ============================================================
     MOBILE
     ============================================================ */

  @media screen and (max-width: 749px) {

    #forma-editorial-{{ section.id }} {

      --forma-side-space: 14px;

      --forma-gap: 10px;

      padding-top:
        {{ section.settings.mobile_padding_top }}px;

      padding-bottom:
        {{ section.settings.mobile_padding_bottom }}px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__track {

      scroll-padding-left:
        14px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__slide {

      flex-basis:
        calc(100vw - 28px);

      width:
        calc(100vw - 28px);

      height:
        var(--forma-mobile-height);

      min-height: 520px;

      border-radius:
        {{ section.settings.mobile_border_radius }}px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__content {

      left: 24px;

      right: 24px;

      bottom: 30px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__eyebrow {

      margin-bottom: 12px;

      font-size: 9px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__title {

      font-size:
        clamp(
          44px,
          13vw,
          70px
        );

      line-height: .87;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__description {

      max-width: 310px;

      margin-top: 16px;

      font-size: 13px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__cta {

      margin-top: 20px;

      font-size: 9px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__slide-number {

      right: 20px;

      top: 20px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__bottom {

      width:
        calc(100vw - 28px);

      margin-top: 13px;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__hint {

      display: none;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__progress {

      margin-right: 0;

    }

  }


  /* ============================================================
     REDUCED MOTION
     ============================================================ */

  @media (
    prefers-reduced-motion: reduce
  ) {

    #forma-editorial-{{ section.id }}
    .forma-editorial__track {

      scroll-behavior: auto;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__image {

      transition: none;

    }


    #forma-editorial-{{ section.id }}
    .forma-editorial__progress-fill {

      transition: none;

    }

  }

</style>


<script>

  (() => {

    /* ==========================================================
       ROOT
       ========================================================== */

    const section =
      document.getElementById(
        'forma-editorial-{{ section.id }}'
      );

    if (!section) return;


    const track =
      section.querySelector(
        '[data-forma-editorial-track]'
      );


    const slides =
      Array.from(
        section.querySelectorAll(
          '[data-forma-editorial-slide]'
        )
      );


    const current =
      section.querySelector(
        '[data-forma-current]'
      );


    const progress =
      section.querySelector(
        '[data-forma-progress]'
      );


    if (
      !track ||
      slides.length === 0
    ) {
      return;
    }


    /* ==========================================================
       STATE
       ========================================================== */

    let isDragging = false;

    let startX = 0;

    let startScrollLeft = 0;

    let hasDragged = false;

    let suppressClick = false;


    /* ==========================================================
       GET CARD DISTANCE
       ========================================================== */

    function getSlideDistance() {

      const slide =
        slides[0];

      if (!slide) return 0;


      const styles =
        window.getComputedStyle(track);


      const gap =
        parseFloat(
          styles.columnGap ||
          styles.gap
        ) || 0;


      return (
        slide.getBoundingClientRect().width +
        gap
      );

    }


    /* ==========================================================
       GET CURRENT SLIDE
       ========================================================== */

    function getCurrentSlide() {

      const distance =
        getSlideDistance();


      if (!distance) return 0;


      return Math.round(
        track.scrollLeft /
        distance
      );

    }


    /* ==========================================================
       UPDATE UI
       ========================================================== */

    function updateUI() {

      const index =
        Math.max(
          0,
          Math.min(
            slides.length - 1,
            getCurrentSlide()
          )
        );


      if (current) {

        current.textContent =
          String(
            index + 1
          ).padStart(
            2,
            '0'
          );

      }


      if (progress) {

        const percentage =
          (
            (index + 1) /
            slides.length
          ) * 100;


        progress.style.width =
          `${percentage}%`;

      }


      slides.forEach(
        (slide, slideIndex) => {

          slide.classList.toggle(
            'is-current',
            slideIndex === index
          );

        }
      );

    }


    /* ==========================================================
       SCROLL
       ========================================================== */

    let scrollRAF = null;


    track.addEventListener(
      'scroll',
      () => {

        if (scrollRAF) return;


        scrollRAF =
          requestAnimationFrame(
            () => {

              scrollRAF = null;

              updateUI();

            }
          );

      },
      {
        passive: true
      }
    );


    /* ==========================================================
       MOUSE DRAG
       ==========================================================

       Trackpad and touch remain native.

       Only a physical mouse is handled here.
       This is important because it means
       trackpad scrolling doesn't fight with
       our drag engine.
       ========================================================== */

    track.addEventListener(
      'pointerdown',
      (event) => {

        if (
          event.pointerType !==
          'mouse'
        ) {
          return;
        }


        if (
          event.button !== 0
        ) {
          return;
        }


        isDragging = true;

        hasDragged = false;

        startX =
          event.clientX;

        startScrollLeft =
          track.scrollLeft;


        track.classList.add(
          'is-dragging'
        );


        track.setPointerCapture(
          event.pointerId
        );

      }
    );


    track.addEventListener(
      'pointermove',
      (event) => {

        if (!isDragging) {
          return;
        }


        const delta =
          event.clientX -
          startX;


        if (
          Math.abs(delta) > 5
        ) {

          hasDragged = true;

          suppressClick = true;

        }


        /*
          Directly manipulate native
          scrollLeft.

          No transform.
          No custom carousel position.
        */

        track.scrollLeft =
          startScrollLeft -
          delta;

      }
    );


    function finishMouseDrag(
      event
    ) {

      if (!isDragging) {
        return;
      }


      isDragging = false;


      track.classList.remove(
        'is-dragging'
      );


      try {

        track.releasePointerCapture(
          event.pointerId
        );

      } catch (error) {}


      if (!hasDragged) {
        return;
      }


      /*
        Snap to the nearest slide.

        This is only for mouse dragging.
        Trackpad uses native CSS snap.
      */

      const distance =
        getSlideDistance();


      if (!distance) return;


      const target =
        Math.round(
          track.scrollLeft /
          distance
        );


      track.scrollTo({

        left:
          target *
          distance,

        behavior:
          'smooth'

      });


      setTimeout(
        () => {

          suppressClick = false;

        },
        80
      );

    }


    track.addEventListener(
      'pointerup',
      finishMouseDrag
    );


    track.addEventListener(
      'pointercancel',
      finishMouseDrag
    );


    /* ==========================================================
       CLICK PROTECTION
       ========================================================== */

    section.addEventListener(
      'click',
      (event) => {

        if (
          suppressClick
        ) {

          event.preventDefault();

          event.stopPropagation();

          suppressClick = false;

        }

      },
      true
    );


    /* ==========================================================
       IMAGE DRAG PROTECTION
       ========================================================== */

    section
      .querySelectorAll('img')
      .forEach(
        (image) => {

          image.addEventListener(
            'dragstart',
            (event) => {

              event.preventDefault();

            }
          );

        }
      );


    /* ==========================================================
       KEYBOARD
       ========================================================== */

    section.addEventListener(
      'keydown',
      (event) => {

        if (
          event.key !==
          'ArrowLeft' &&
          event.key !==
          'ArrowRight'
        ) {
          return;
        }


        event.preventDefault();


        const distance =
          getSlideDistance();


        const currentSlide =
          getCurrentSlide();


        let target =
          currentSlide;


        if (
          event.key ===
          'ArrowRight'
        ) {

          target =
            Math.min(
              slides.length - 1,
              currentSlide + 1
            );

        }


        if (
          event.key ===
          'ArrowLeft'
        ) {

          target =
            Math.max(
              0,
              currentSlide - 1
            );

        }


        track.scrollTo({

          left:
            target *
            distance,

          behavior:
            'smooth'

        });

      }
    );


    /* ==========================================================
       MOUSE PARALLAX
       ========================================================== */

    track.addEventListener(
      'pointermove',
      (event) => {

        if (
          event.pointerType !==
          'mouse'
        ) {
          return;
        }


        if (isDragging) {
          return;
        }


        const slide =
          event.target.closest(
            '[data-forma-editorial-slide]'
          );


        if (!slide) {
          return;
        }


        const image =
          slide.querySelector(
            '.forma-editorial__image'
          );


        if (!image) {
          return;
        }


        const rect =
          slide.getBoundingClientRect();


        const percentage =
          (
            event.clientX -
            rect.left
          ) /
          rect.width -
          .5;


        image.style.setProperty(
          '--forma-parallax-x',
          `${percentage * -8}px`
        );

      }
    );


    /* ==========================================================
       RESET PARALLAX
       ========================================================== */

    track.addEventListener(
      'pointerleave',
      () => {

        slides.forEach(
          (slide) => {

            const image =
              slide.querySelector(
                '.forma-editorial__image'
              );


            if (!image) return;


            image.style.setProperty(
              '--forma-parallax-x',
              '0px'
            );

          }
        );

      }
    );


    /* ==========================================================
       INITIALIZE
       ========================================================== */

    updateUI();

  })();

</script>


