
{% comment %}
  FORMA EDITORIAL SLIDER
  Manual navigation, drag and swipe.
  No autoplay.
{% endcomment %}

<section id="forma-editorial-{{ section.id }}" class="forma-editorial">

  <div class="forma-editorial__viewport">
    <div class="forma-editorial__track" data-forma-track>

      {% for block in section.blocks %}
        <article class="forma-editorial__slide" {{ block.shopify_attributes }}>

          {% if block.settings.link != blank %}
            <a class="forma-editorial__slide-link" href="{{ block.settings.link }}">
          {% else %}
            <div class="forma-editorial__slide-link">
          {% endif %}

            <div class="forma-editorial__media">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 3000
                  | image_tag:
                    loading: 'lazy',
                    class: 'forma-editorial__image',
                    alt: block.settings.image.alt
                }}
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'forma-editorial__placeholder' }}
              {% endif %}

              <div class="forma-editorial__overlay"></div>
            </div>

            {% if block.settings.show_content %}
              <div class="forma-editorial__content content-{{ block.settings.alignment }}">

                {% if block.settings.eyebrow != blank %}
                  <div class="forma-editorial__eyebrow">
                    {{ block.settings.eyebrow }}
                  </div>
                {% endif %}

                {% if block.settings.title != blank %}
                  <h2 class="forma-editorial__title">
                    {{ block.settings.title }}
                  </h2>
                {% endif %}

                {% if block.settings.description != blank %}
                  <div class="forma-editorial__description">
                    {{ block.settings.description }}
                  </div>
                {% endif %}

                {% if block.settings.button_text != blank %}
                  <div class="forma-editorial__button">
                    <span>{{ block.settings.button_text }}</span>
                    <span class="forma-editorial__button-arrow">↗</span>
                  </div>
                {% endif %}

              </div>
            {% endif %}

          {% if block.settings.link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}

        </article>
      {% endfor %}

    </div>
  </div>

  {% if section.blocks.size > 1 %}
    <div class="forma-editorial__arrows">
      <button class="forma-editorial__arrow forma-editorial__arrow--prev" type="button" aria-label="Previous slide">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <button class="forma-editorial__arrow forma-editorial__arrow--next" type="button" aria-label="Next slide">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  {% endif %}

</section>


<style>
  #forma-editorial-{{ section.id }} {
    --slide-width: {{ section.settings.slide_width }}vw;
    --slide-gap: {{ section.settings.slide_gap }}px;
    --slide-height: {{ section.settings.desktop_height }}vh;

    --content-left: {{ section.settings.content_left }}px;
    --content-bottom: {{ section.settings.content_bottom }}px;

    --title-size: {{ section.settings.title_size }}px;
    --title-line-height: {{ section.settings.title_line_height }}%;
    --title-spacing: {{ section.settings.title_letter_spacing }}px;

    --eyebrow-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
    --cta-spacing: {{ section.settings.cta_letter_spacing }}px;

    position: relative;
    width: 100%;
    overflow: hidden;
    background: {{ section.settings.background }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #forma-editorial-{{ section.id }} *,
  #forma-editorial-{{ section.id }} *::before,
  #forma-editorial-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__viewport {
    width: 100%;
    overflow: hidden;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__track {
    display: flex;
    gap: var(--slide-gap);
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    overscroll-behavior-x: contain;
    cursor: grab;
    touch-action: pan-y;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__track::-webkit-scrollbar {
    display: none;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__track.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
    user-select: none;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__slide {
    position: relative;
    flex: 0 0 var(--slide-width);
    width: var(--slide-width);
    height: var(--slide-height);
    min-height: 450px;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    overflow: hidden;
    border-radius: {{ section.settings.border_radius }}px;
    background: #111;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__slide-link {
    position: absolute;
    inset: 0;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__media {
    position: absolute;
    inset: 0;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
    user-select: none;
    transition: transform 1s ease;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__slide:hover .forma-editorial__image {
    transform: scale(1.025);
  }

  #forma-editorial-{{ section.id }} .forma-editorial__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0) 15%,
      rgba(0,0,0,0.03) 40%,
      rgba(0,0,0,0.2) 65%,
      rgba(0,0,0,0.7) 100%
    );
    pointer-events: none;
  }

  /* CONTENT */

  #forma-editorial-{{ section.id }} .forma-editorial__content {
    position: absolute;
    bottom: var(--content-bottom);
    left: var(--content-left);
    z-index: 2;
    max-width: {{ section.settings.content_max_width }}px;
    color: #fff;
    pointer-events: none;
  }

  #forma-editorial-{{ section.id }} .content-center {
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
  }

  #forma-editorial-{{ section.id }} .content-right {
    left: auto;
    right: var(--content-left);
    text-align: right;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__eyebrow {
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: {{ section.settings.eyebrow_weight }};
    text-transform: uppercase;
    letter-spacing: var(--eyebrow-spacing);
    line-height: 1.2;
    margin-bottom: {{ section.settings.eyebrow_margin }}px;
    color: rgba(255,255,255,0.9);
  }

  #forma-editorial-{{ section.id }} .forma-editorial__title {
    margin: 0;
    color: #fff;
    font-size: clamp(
      {{ section.settings.title_min_size }}px,
      {{ section.settings.title_desktop_size }}vw,
      {{ section.settings.title_size }}px
    );
    font-weight: {{ section.settings.title_weight }};
    line-height: var(--title-line-height);
    letter-spacing: var(--title-spacing);
  }

  #forma-editorial-{{ section.id }} .forma-editorial__description {
    margin-top: {{ section.settings.description_margin }}px;
    max-width: {{ section.settings.description_width }}px;
    font-size: {{ section.settings.description_size }}px;
    line-height: {{ section.settings.description_line_height }}%;
    color: rgba(255,255,255,0.9);
  }

  #forma-editorial-{{ section.id }} .content-center .forma-editorial__description {
    margin-left: auto;
    margin-right: auto;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: {{ section.settings.cta_margin }}px;
    font-size: {{ section.settings.cta_size }}px;
    font-weight: {{ section.settings.cta_weight }};
    letter-spacing: var(--cta-spacing);
    text-transform: {{ section.settings.cta_transform }};
    padding-bottom: 5px;
    border-bottom: 1px solid rgba(255,255,255,0.8);
    color: #fff;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__button-arrow {
    transition: transform .25s ease;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__slide:hover .forma-editorial__button-arrow {
    transform: translate(3px,-3px);
  }

  /* ARROWS */

  #forma-editorial-{{ section.id }} .forma-editorial__arrows {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    outline: none;
    background: transparent;
    box-shadow: none;
    border-radius: 0;
    color: #fff;
    cursor: pointer;
    pointer-events: auto;
    padding: 0;
    transition: opacity .25s ease;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__arrow:hover {
    opacity: .6;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__arrow svg {
    width: 30px;
    height: 30px;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__arrow--prev {
    left: {{ section.settings.arrow_offset }}px;
  }

  #forma-editorial-{{ section.id }} .forma-editorial__arrow--next {
    right: {{ section.settings.arrow_offset }}px;
  }

  /* MOBILE */

  @media screen and (max-width: 749px) {

    #forma-editorial-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #forma-editorial-{{ section.id }} .forma-editorial__track {
      gap: {{ section.settings.mobile_slide_gap }}px;
    }

    #forma-editorial-{{ section.id }} .forma-editorial__slide {
      flex: 0 0 {{ section.settings.mobile_slide_width }}vw;
      width: {{ section.settings.mobile_slide_width }}vw;
      height: {{ section.settings.mobile_height }}vh;
      min-height: 400px;
      border-radius: {{ section.settings.mobile_border_radius }}px;
    }

    #forma-editorial-{{ section.id }} .forma-editorial__content {
      left: {{ section.settings.mobile_content_left }}px;
      right: {{ section.settings.mobile_content_right }}px;
      bottom: {{ section.settings.mobile_content_bottom }}px;
      max-width: none;
    }

    #forma-editorial-{{ section.id }} .content-right {
      left: auto;
      right: {{ section.settings.mobile_content_left }}px;
    }

    #forma-editorial-{{ section.id }} .content-center {
      left: 50%;
      right: auto;
      width: calc(100% - 40px);
      transform: translateX(-50%);
    }

    #forma-editorial-{{ section.id }} .forma-editorial__eyebrow {
      font-size: {{ section.settings.mobile_eyebrow_size }}px;
      margin-bottom: 10px;
    }

    #forma-editorial-{{ section.id }} .forma-editorial__title {
      font-size: {{ section.settings.mobile_title_size }}px;
      line-height: 0.95;
    }

    #forma-editorial-{{ section.id }} .forma-editorial__description {
      font-size: {{ section.settings.mobile_description_size }}px;
      margin-top: 12px;
    }

    #forma-editorial-{{ section.id }} .forma-editorial__button {
      font-size: {{ section.settings.mobile_cta_size }}px;
      margin-top: 20px;
    }

    #forma-editorial-{{ section.id }} .forma-editorial__arrow {
      width: 36px;
      height: 36px;
    }

    #forma-editorial-{{ section.id }} .forma-editorial__arrow svg {
      width: 24px;
      height: 24px;
    }
  }
</style>


<script>
(function() {
  const section = document.getElementById('forma-editorial-{{ section.id }}');
  if (!section || section.dataset.formaInitialized === 'true') return;
  section.dataset.formaInitialized = 'true';

  const track = section.querySelector('[data-forma-track]');
  const slides = Array.from(section.querySelectorAll('.forma-editorial__slide'));
  const prev = section.querySelector('.forma-editorial__arrow--prev');
  const next = section.querySelector('.forma-editorial__arrow--next');

  if (!track || !slides.length) return;

  function slideDistance() {
    if (slides.length < 2) {
      return slides[0].getBoundingClientRect().width;
    }

    return slides[1].offsetLeft - slides[0].offsetLeft;
  }

  function indexNow() {
    const distance = slideDistance();
    if (!distance) return 0;
    return Math.round(track.scrollLeft / distance);
  }

  function moveTo(index) {
    const distance = slideDistance();
    if (!distance) return;

    index = Math.max(0, Math.min(index, slides.length - 1));

    track.scrollTo({
      left: index * distance,
      behavior: 'smooth'
    });
  }

  if (prev) {
    prev.addEventListener('click', function() {
      moveTo(indexNow() - 1);
    });
  }

  if (next) {
    next.addEventListener('click', function() {
      moveTo(indexNow() + 1);
    });
  }

  /* Desktop drag */

  let dragging = false;
  let startX = 0;
  let startScroll = 0;
  let moved = false;
  let preventClick = false;

  track.addEventListener('pointerdown', function(e) {
    if (e.pointerType === 'touch') return;
    if (e.target.closest('button')) return;

    dragging = true;
    moved = false;
    startX = e.clientX;
    startScroll = track.scrollLeft;

    track.classList.add('is-dragging');

    try {
      track.setPointerCapture(e.pointerId);
    } catch(err) {}
  });

  track.addEventListener('pointermove', function(e) {
    if (!dragging) return;

    const delta = e.clientX - startX;

    if (Math.abs(delta) > 5) moved = true;

    if (moved) {
      track.scrollLeft = startScroll - delta;
    }
  });

  function endDrag(e) {
    if (!dragging) return;

    dragging = false;
    track.classList.remove('is-dragging');

    try {
      track.releasePointerCapture(e.pointerId);
    } catch(err) {}

    if (moved) {
      preventClick = true;
      moveTo(indexNow());

      setTimeout(function() {
        preventClick = false;
      }, 250);
    }
  }

  track.addEventListener('pointerup', endDrag);
  track.addEventListener('pointercancel', endDrag);

  section.addEventListener('click', function(e) {
    if (preventClick) {
      e.preventDefault();
      e.stopPropagation();
    }
  }, true);

})();
</script>



{% schema %}
{
  "name": "FORMA Editorial Slider",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "slide_width",
      "min": 35,
      "max": 100,
      "step": 1,
      "unit": "vw",
      "label": "Slide width",
      "default": 48
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 40,
      "max": 90,
      "step": 1,
      "unit": "vh",
      "label": "Slide height",
      "default": 68
