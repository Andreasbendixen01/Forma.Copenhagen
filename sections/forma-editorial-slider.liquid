      "min": 200,
      "max": 700,
      "step": 25,
      "unit": "px",
      "label": "Description width",
      "default": 440
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 14
    },
    {
      "type": "range",
      "id": "description_line_height",
      "min": 10,
      "max": 20,
      "step": 1,
      "label": "Description line height (tenths)",
      "default": 15
    },
    {
      "type": "range",
      "id": "description_margin",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Description top margin",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_description_size",
      "min": 10,
      "max": 20,
      "step": 1,
