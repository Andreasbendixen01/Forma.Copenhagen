{% comment %}
  ================================================================
  FORMA PLACES
  Editorial city / places carousel
  ================================================================
{% endcomment %}

<section
  id="forma-places-{{ section.id }}"
  class="forma-places"
>
  <div class="forma-places__header">

    <div class="forma-places__heading">

      <h2 class="forma-places__title">
        {{ section.settings.heading }}
      </h2>

      {% if section.settings.subheading != blank %}
        <p class="forma-places__subtitle">
          {{ section.settings.subheading }}
        </p>
      {% endif %}

    </div>

    {% if section.settings.view_all_text != blank %}
      <a
        href="{{ section.settings.view_all_link }}"
        class="forma-places__view-all"
      >
        {{ section.settings.view_all_text }}
      </a>
    {% endif %}

  </div>


  <div
    class="forma-places__track"
    data-forma-places-track
  >

    {% for block in section.blocks %}

      <article
        class="forma-place"
        {{ block.shopify_attributes }}
      >

        <a
          href="{{ block.settings.link | default: '#' }}"
          class="forma-place__link"
        >

          <div class="forma-place__image-wrapper">

            {% if block.settings.image != blank %}

              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  widths: '600, 900, 1200, 1600',
                  sizes: '(max-width: 699px) 82vw, 32vw',
                  class: 'forma-place__image'
              }}

            {% else %}

              {{ 'image' | placeholder_svg_tag: 'forma-place__placeholder' }}

            {% endif %}

            <div class="forma-place__editorial">

              <span class="forma-place__recommend">
                FORMA RECOMMENDS
              </span>

              <span class="forma-place__number">
                {{ forloop.index | prepend: '0' | slice: -2, 2 }}
              </span>

            </div>

          </div>


          <div class="forma-place__content">

            <div class="forma-place__top">

              {% if block.settings.city != blank %}
                <span class="forma-place__city">
                  {{ block.settings.city }}
                </span>
              {% endif %}

              <span class="forma-place__arrow">
                ↗
              </span>

            </div>


            {% if block.settings.title != blank %}
              <h3 class="forma-place__title">
                {{ block.settings.title }}
              </h3>
            {% endif %}


            {% if block.settings.category != blank %}
              <p class="forma-place__category">
                {{ block.settings.category }}
              </p>
            {% endif %}


            {% if block.settings.description != blank %}
              <p class="forma-place__description">
                {{ block.settings.description }}
              </p>
            {% endif %}

          </div>

        </a>

      </article>

    {% endfor %}

  </div>


  <style>

    /* ============================================================
       FORMA PLACES
       ============================================================ */

    #forma-places-{{ section.id }} {

      --places-gap: 14px;

      width: 100%;
      overflow: hidden;

      padding-top: 42px;
      padding-bottom: 54px;

    }


    /* ============================================================
       HEADER
       ============================================================ */

    #forma-places-{{ section.id }} .forma-places__header {

      display: flex;
      align-items: baseline;
      justify-content: space-between;

      width: 100%;

      padding: 0 12px 18px;

    }


    #forma-places-{{ section.id }} .forma-places__heading {

      display: flex;
      align-items: baseline;

      min-width: 0;

    }


    #forma-places-{{ section.id }} .forma-places__title {

      margin: 0;
      padding: 0;

      font-size: 17px;
      line-height: 1.2;

      font-weight: 400;
      letter-spacing: 0;
      
      font-family: Georgia, "Times New Roman", serif !important;

    }


    #forma-places-{{ section.id }} .forma-places__subtitle {

      margin: 0 0 0 16px;

      font-size: 13px;
      line-height: 1.2;

      font-weight: 400;

      opacity: 0.55;

    }


    /* ============================================================
       VIEW ALL
       ============================================================ */

    #forma-places-{{ section.id }} .forma-places__view-all {

      flex-shrink: 0;

      margin-left: auto;

      color: inherit;
      text-decoration: none;

      font-size: 13px;
      line-height: 1.2;

      font-weight: 400;

      transition: opacity 0.2s ease;

    }


    #forma-places-{{ section.id }} .forma-places__view-all:hover {

      opacity: 0.5;

    }


    /* ============================================================
       TRACK
       ============================================================ */

    #forma-places-{{ section.id }} .forma-places__track {

      display: flex;

      gap: var(--places-gap);

      width: 100%;

      overflow-x: auto;
      overflow-y: hidden;

      padding-left: 12px;
      padding-right: 12px;

      scroll-behavior: smooth;

      scrollbar-width: none;

      -webkit-overflow-scrolling: touch;

    }


    #forma-places-{{ section.id }} .forma-places__track::-webkit-scrollbar {

      display: none;

    }


    /* ============================================================
       CARDS
       ============================================================ */

    #forma-places-{{ section.id }} .forma-place {

      flex: 0 0 calc(
        (100% - (var(--places-gap) * 2) - 4vw) / 3.15
      );

      min-width: 0;

      scroll-snap-align: start;

    }


    #forma-places-{{ section.id }} .forma-place__link {

      display: block;

      color: inherit;
      text-decoration: none;

    }


    /* ============================================================
       IMAGE
       ============================================================ */

    #forma-places-{{ section.id }} .forma-place__image-wrapper {

      position: relative;

      width: 100%;

      aspect-ratio: 4 / 5;

      overflow: hidden;

      background: #f3f3f3;

    }


    #forma-places-{{ section.id }} .forma-place__image {

      display: block;

      width: 100%;
      height: 100%;

      object-fit: cover;

      transition:
        transform 0.7s cubic-bezier(.2,.6,.2,1);

    }


    #forma-places-{{ section.id }} .forma-place__link:hover
    .forma-place__image {

      transform: scale(1.025);

    }


    /* ============================================================
       EDITORIAL LABEL
       ============================================================ */

    #forma-places-{{ section.id }} .forma-place__editorial {

      position: absolute;

      top: 14px;
      left: 14px;
      right: 14px;

      display: flex;

      align-items: flex-start;
      justify-content: space-between;

      color: white;

      pointer-events: none;

    }


    #forma-places-{{ section.id }} .forma-place__recommend {

      font-size: 9px;
      line-height: 1.2;

      font-weight: 400;

      letter-spacing: 0.1em;

      text-transform: uppercase;

      padding: 7px 8px;

      background: rgba(0, 0, 0, 0.24);

      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);

    }


    #forma-places-{{ section.id }} .forma-place__number {

      font-size: 11px;
      line-height: 1;

      font-weight: 400;

      letter-spacing: 0.04em;

    }


    /* ============================================================
       CONTENT
       ============================================================ */

    #forma-places-{{ section.id }} .forma-place__content {

      padding-top: 11px;

    }


    #forma-places-{{ section.id }} .forma-place__top {

      display: flex;

      align-items: center;
      justify-content: space-between;

      margin-bottom: 5px;

    }


    #forma-places-{{ section.id }} .forma-place__city {

      font-size: 10px;
      line-height: 1.2;

      font-weight: 400;

      letter-spacing: 0.08em;

      text-transform: uppercase;

      opacity: 0.5;

    }


    #forma-places-{{ section.id }} .forma-place__arrow {

      font-size: 15px;

      opacity: 0;

      transform: translate(-3px, 3px);

      transition:
        opacity 0.2s ease,
        transform 0.2s ease;

    }


    #forma-places-{{ section.id }} .forma-place__link:hover
    .forma-place__arrow {

      opacity: 0.8;

      transform: translate(0, 0);

    }


    #forma-places-{{ section.id }} .forma-place__title {

      margin: 0;

      font-size: 19px;
      line-height: 1.15;

      font-weight: 400;

      letter-spacing: -0.015em;

    }


    #forma-places-{{ section.id }} .forma-place__category {

      margin: 5px 0 0;

      font-size: 11px;
      line-height: 1.25;

      font-weight: 400;

      opacity: 0.55;

    }


    #forma-places-{{ section.id }} .forma-place__description {

      margin: 4px 0 0;

      font-size: 12px;
      line-height: 1.3;

      opacity: 0.55;

    }


    /* ============================================================
       MOBILE
       ============================================================ */

    @media screen and (max-width: 699px) {

      #forma-places-{{ section.id }} {

        padding-top: 32px;
        padding-bottom: 40px;

      }


      #forma-places-{{ section.id }} .forma-places__header {

        align-items: baseline;

        padding: 0 12px 14px;

      }


      #forma-places-{{ section.id }} .forma-places__title {

        font-size: 16px;

      }


      #forma-places-{{ section.id }} .forma-places__subtitle {

        margin-left: 10px;

        font-size: 11px;

      }


      #forma-places-{{ section.id }} .forma-places__view-all {

        font-size: 12px;

      }


      #forma-places-{{ section.id }} .forma-places__track {

        gap: 12px;

        padding-left: 12px;
        padding-right: 12px;

      }


      #forma-places-{{ section.id }} .forma-place {

        flex: 0 0 82vw;

      }


      #forma-places-{{ section.id }} .forma-place__image-wrapper {

        aspect-ratio: 4 / 5;

      }


      #forma-places-{{ section.id }} .forma-place__title {

        font-size: 18px;

      }


      #forma-places-{{ section.id }} .forma-place__recommend {

        font-size: 8px;

        padding: 6px 7px;

      }

    }

  </style>


  {% schema %}

  {
    "name": "FORMA Places",
    "tag": "section",
    "class": "forma-places-section",

    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "FORMA Places"
      },
      {
        "type": "text",
        "id": "subheading",
        "label": "Subheading",
        "default": "Places we recommend."
      },
      {
        "type": "text",
        "id": "view_all_text",
        "label": "View all text",
        "default": "View all →"
      },
      {
        "type": "url",
        "id": "view_all_link",
        "label": "View all link"
      }
    ],

    "blocks": [
      {
        "type": "place",
        "name": "Place",

        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "city",
            "label": "City",
            "default": "Copenhagen"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Place name",
            "default": "Place name"
          },
          {
            "type": "text",
            "id": "category",
            "label": "Category",
            "default": "Café"
          },
          {
            "type": "text",
            "id": "description",
            "label": "Description"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Place link"
          }
        ]

      }
    ],

    "presets": [
      {
        "name": "FORMA Places",

        "blocks": [
          {
            "type": "place"
          },
          {
            "type": "place"
          },
          {
            "type": "place"
          },
          {
            "type": "place"
          },
          {
            "type": "place"
          }
        ]

      }
    ]

  }

  {% endschema %}

</section>