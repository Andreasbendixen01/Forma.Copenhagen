{% comment %}
  FORMA BLOG CAROUSEL
  Blog-driven version of FORMA Places. Preserves the original editorial carousel layout.
  Article tags can include: City: Copenhagen and Category: Restaurant
{% endcomment %}

<section id="forma-places-{{ section.id }}" class="forma-places">
  <div class="forma-places__header">
    <div class="forma-places__heading">
      <h2 class="forma-places__title">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="forma-places__subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    {% if section.settings.view_all_text != blank and section.settings.selected_blog != blank %}
      <a href="{{ section.settings.selected_blog.url }}" class="forma-places__view-all">
        {{ section.settings.view_all_text }}
      </a>
    {% elsif section.settings.view_all_text != blank and section.settings.view_all_link != blank %}
      <a href="{{ section.settings.view_all_link }}" class="forma-places__view-all">
        {{ section.settings.view_all_text }}
      </a>
    {% endif %}
  </div>

  <div class="forma-places__track" data-forma-places-track>
    {% if section.settings.selected_blog != blank %}
      {% for article in section.settings.selected_blog.articles limit: section.settings.article_count %}
        {% assign article_city = '' %}
        {% assign article_category = '' %}
        {% for article_tag in article.tags %}
          {% if article_tag contains 'City:' %}
            {% assign article_city = article_tag | remove: 'City:' | strip %}
          {% elsif article_tag contains 'Category:' %}
            {% assign article_category = article_tag | remove: 'Category:' | strip %}
          {% endif %}
        {% endfor %}

        <article class="forma-place">
          <a href="{{ article.url }}" class="forma-place__link">
            <div class="forma-place__image-wrapper">
              {% if article.image != blank %}
                {{
                  article.image
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'lazy',
                    widths: '600, 900, 1200, 1600',
                    sizes: '(max-width: 699px) 82vw, 31vw',
                    class: 'forma-place__image'
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'forma-place__placeholder' }}
              {% endif %}

              {% if section.settings.card_label != blank %}
                <span class="forma-place__recommend">{{ section.settings.card_label }}</span>
              {% endif %}

              {% if article_category != blank %}
                <span class="forma-place__category">{{ article_category }}</span>
              {% endif %}
            </div>

            <div class="forma-place__content">
              {% if article_city != blank %}
                <div class="forma-place__city">{{ article_city }}</div>
              {% endif %}

              <h3 class="forma-place__title">{{ article.title }}</h3>

              {% if article.excerpt != blank %}
                <p class="forma-place__description">{{ article.excerpt | strip_html | truncate: 160 }}</p>
              {% elsif section.settings.show_content_fallback %}
                <p class="forma-place__description">{{ article.content | strip_html | truncate: 160 }}</p>
              {% endif %}
            </div>
          </a>
        </article>
      {% endfor %}
    {% else %}
      <div class="forma-places__empty">Select a blog in this section's settings to display articles.</div>
    {% endif %}
  </div>

  <style>

  #shopify-section-{{ section.id }} {
    --fm-ink: #111111;
    --fm-muted: #6b6b6b;
    --fm-line: #e2e2e2;
    --fm-serif: "Cormorant Garamond", "Times New Roman", Georgia, serif;
    --fm-gap: clamp(28px, 4vw, 56px);
    --fm-pad: clamp(16px, 2.2vw, 32px);
    --fm-sticky-top: var(--sticky-area-height, 0px);
  }

    #shopify-section-{{ section.id }} {
      margin-left: 5px !important;
      margin-right: 5px !important;
      width: calc(100% - 10px) !important;
    }

    #forma-places-{{ section.id }} {
      --places-gap: 5px;
      width: 100%;
      overflow: hidden;
      padding-top: 0;
      padding-bottom: 0;
    }

    #forma-places-{{ section.id }} .forma-places__header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      width: 100%;
      padding: 0 5px 18px;
    }

    #forma-places-{{ section.id }} .forma-places__heading {
      display: flex;
      align-items: baseline;
      min-width: 0;
    }

    #forma-places-{{ section.id }} .forma-places__title {
      margin: 0;
      padding: 0;
      font-size: 17px;
      line-height: 1.2;
      font-weight: 400;
      letter-spacing: 0;
      font-family: Georgia, "Times New Roman", serif !important;
    }

    #forma-places-{{ section.id }} .forma-places__subtitle {
      margin: 0 0 0 16px;
      font-size: 13px;
      line-height: 1.2;
      font-weight: 400;
      opacity: 0.55;
    }

    #forma-places-{{ section.id }} .forma-places__view-all {
      flex-shrink: 0;
      margin-left: auto;
      color: inherit;
      text-decoration: none;
      font-size: 13px;
      line-height: 1.2;
      font-weight: 400;
      transition: opacity 0.25s ease;
    }

    #forma-places-{{ section.id }} .forma-places__view-all:hover { opacity: 0.5; }

    #forma-places-{{ section.id }} .forma-places__track {
      display: flex;
      gap: var(--places-gap);
      width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      padding-left: 0;
      padding-right: 12px;
      scroll-behavior: smooth;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    #forma-places-{{ section.id }} .forma-places__track::-webkit-scrollbar { display: none; }

    #forma-places-{{ section.id }} .forma-place {
      flex: 0 0 calc((100% - (var(--places-gap) * 2) - 4vw) / 3.15);
      min-width: 0;
      scroll-snap-align: start;
    }

    #forma-places-{{ section.id }} .forma-place__link {
      display: block;
      color: inherit;
      text-decoration: none;
    }

    #forma-places-{{ section.id }} .forma-place__image-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      background: #f3f3f3;
      transition: transform 0.5s cubic-bezier(.2,.6,.2,1), box-shadow 0.5s cubic-bezier(.2,.6,.2,1);
    }

    #forma-places-{{ section.id }} .forma-place__image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.7s cubic-bezier(.2,.6,.2,1);
    }

    #forma-places-{{ section.id }} .forma-place__recommend,
    #forma-places-{{ section.id }} .forma-place__category {
      position: absolute;
      display: inline-flex;
      align-items: center;
      padding: 7px 10px;
      color: rgba(255,255,255,0.96);
      font-size: 9px;
      font-weight: 500;
      line-height: 1;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      background: rgba(20,20,20,0.30);
      border: 1px solid rgba(255,255,255,0.20);
      backdrop-filter: blur(12px) saturate(120%);
      -webkit-backdrop-filter: blur(12px) saturate(120%);
      box-shadow: 0 4px 18px rgba(0,0,0,0.10);
      transition: background 0.35s ease, border-color 0.35s ease, transform 0.35s ease;
    }

    #forma-places-{{ section.id }} .forma-place__recommend { top: 14px; left: 14px; }
    #forma-places-{{ section.id }} .forma-place__category { right: 14px; bottom: 14px; }

    #forma-places-{{ section.id }} .forma-place__link:hover .forma-place__image-wrapper {
      transform: translateY(-3px);
      box-shadow: 0 14px 35px rgba(0,0,0,0.12);
    }

    #forma-places-{{ section.id }} .forma-place__link:hover .forma-place__image { transform: scale(1.035); }
    #forma-places-{{ section.id }} .forma-place__link:hover .forma-place__recommend,
    #forma-places-{{ section.id }} .forma-place__link:hover .forma-place__category {
      background: rgba(20,20,20,0.46);
      transform: translateY(-1px);
    }

    #forma-places-{{ section.id }} .forma-place__content { padding-top: 11px; }

    #forma-places-{{ section.id }} .forma-place__city {
      margin: 0 0 5px;
      padding: 0;
      font-size: 10px;
      line-height: 1.2;
      font-weight: 400;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      opacity: 0.45;
    }

    #forma-places-{{ section.id }} .forma-place__content .forma-place__title {
      margin: 0;
      font-size: 23px;
      line-height: 1.15;
      font-weight: 400;
        font-family: var(--fm-serif);
      letter-spacing: -0.015em;
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    #forma-places-{{ section.id }} .forma-place__link:hover .forma-place__content .forma-place__title { transform: translateX(2px); }

    #forma-places-{{ section.id }} .forma-place__description {
      margin: 4px 0 0;
      font-size: 12px;
      line-height: 1.3;
      opacity: 0.55;
    }

    #forma-places-{{ section.id }} .forma-places__empty {
      padding: 20px 5px;
      opacity: 0.6;
      font-size: 13px;
    }

    @media screen and (max-width: 699px) {
      #forma-places-{{ section.id }} { padding-top: 32px; padding-bottom: 40px; }
      #forma-places-{{ section.id }} .forma-places__header { align-items: baseline; padding: 0 12px 14px; }
      #forma-places-{{ section.id }} .forma-places__title { font-size: 16px; }
      #forma-places-{{ section.id }} .forma-places__subtitle { margin-left: 10px; font-size: 11px; }
      #forma-places-{{ section.id }} .forma-places__view-all { font-size: 12px; }
      #forma-places-{{ section.id }} .forma-places__track { gap: 12px; padding-left: 0; padding-right: 12px; }
      #forma-places-{{ section.id }} .forma-place { flex: 0 0 82vw; }
      #forma-places-{{ section.id }} .forma-place__image-wrapper { aspect-ratio: 4 / 5; }
      #forma-places-{{ section.id }} .forma-place__content .forma-place__title { font-size: 18px; }
      #forma-places-{{ section.id }} .forma-place__recommend,
      #forma-places-{{ section.id }} .forma-place__category { font-size: 8px; padding: 6px 7px; }
      #forma-places-{{ section.id }} .forma-place__recommend { top: 10px; left: 10px; }
      #forma-places-{{ section.id }} .forma-place__category { right: 10px; bottom: 10px; }
    }
  </style>
</section>

{% schema %}
{
  "name": "FORMA Blog Carousel",
  "tag": "section",
  "class": "forma-places-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FORMA Places"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Places we recommend."
    },
    {
      "type": "blog",
      "id": "selected_blog",
      "label": "Select blog"
    },
    {
      "type": "range",
      "id": "article_count",
      "label": "Number of articles",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "card_label",
      "label": "Image label",
      "default": "FORMA RECOMMENDS"
    },
    {
      "type": "checkbox",
      "id": "show_content_fallback",
      "label": "Show article content if excerpt is blank",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Fallback View all link (if no blog is selected)"
    }
  ],
  "presets": [
    {
      "name": "FORMA Blog Carousel"
    }
  ]
}
{% endschema %}

