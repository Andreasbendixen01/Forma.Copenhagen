<script>
  (() => {
    const section = document.getElementById('FormaCareers-{{ section.id }}');
    if (!section || section.dataset.formInitialized === 'true') return;
    section.dataset.formInitialized = 'true';

    const form = section.querySelector('#FormaCareersForm-{{ section.id }}');
    const frame = section.querySelector('#FormaCareersFrame-{{ section.id }}');
    if (!form || !frame) return;

    const message = form.querySelector('.forma-careers__form-message');
    const submit = form.querySelector('button[type="submit"]');
    const success = section.querySelector('#FormaCareersSuccess-{{ section.id }}');
    const successPanel = success ? success.querySelector('.forma-careers__success-panel') : null;
    const closeButtons = success ? success.querySelectorAll('[data-forma-success-close]') : [];
    const maxCombinedBytes = 4 * 1024 * 1024;
    let waitingForResponse = false;
    let previousFocus = null;

    const showMessage = (text, type) => {
      message.textContent = text;
      message.className = 'forma-careers__form-message' + (type ? ' ' + type : '');
    };
    const openSuccess = () => {
      if (!success) return;
      previousFocus = document.activeElement;
      success.classList.add('is-open');
      success.setAttribute('aria-hidden', 'false');
      document.documentElement.style.overflow = 'hidden';
      const close = success.querySelector('.forma-careers__success-close');
      if (close) close.focus();
    };
    const closeSuccess = () => {
      if (!success) return;
      success.classList.remove('is-open');
      success.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = '';
      if (previousFocus && typeof previousFocus.focus === 'function') previousFocus.focus();
    };

    closeButtons.forEach((button) => button.addEventListener('click', closeSuccess));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && success && success.classList.contains('is-open')) closeSuccess();
    });

    frame.addEventListener('load', () => {
      if (!waitingForResponse) return;
      waitingForResponse = false;
      submit.disabled = false;
      submit.querySelector('span').textContent = 'Submit application';
      form.reset();
      showMessage('', '');
      openSuccess();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      showMessage('', '');

      if (!form.reportValidity()) return;
      const honeypot = form.querySelector('[name="website"]');
      if (honeypot && honeypot.value.trim() !== '') return;

      const cvInput = form.querySelector('[name="cv"]');
      const portfolioInput = form.querySelector('[name="portfolio"]');
      const files = [cvInput.files[0], portfolioInput.files[0]].filter(Boolean);
      const totalBytes = files.reduce((total, file) => total + file.size, 0);
      if (totalBytes > maxCombinedBytes) {
        showMessage('The combined file size must be 4 MB or less. Please choose smaller files.', 'is-error');
        return;
      }

      const endpoint = form.getAttribute('action');
      if (!endpoint || endpoint.trim() === '') {
        showMessage('The application form is not connected yet. Please try again later.', 'is-error');
        return;
      }

      form.querySelector('[name="submitted_at"]').value = new Date().toISOString();
      waitingForResponse = true;
      submit.disabled = true;
      submit.querySelector('span').textContent = 'Sending your application‚Ä¶';
      form.submit();
    });

    section.querySelectorAll('.forma-careers__apply-button').forEach((button) => {
      button.addEventListener('click', () => {
        const job = button.closest('.forma-careers__job');
        const title = job ? job.querySelector('.forma-careers__job-main h3') : null;
        const position = form.querySelector('[name="position"]');
        if (!title || !position) return;
        const jobTitle = title.textContent.trim();
        let option = Array.from(position.options).find((item) => item.value === jobTitle);
        if (!option) {
          option = document.createElement('option');
          option.value = jobTitle;
          option.textContent = jobTitle;
          option.dataset.jobOption = 'true';
          position.appendChild(option);
        }
        position.value = jobTitle;
      });
    });
  })();
</script>

