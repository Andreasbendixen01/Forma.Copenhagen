{% comment %}
  FORMA CAREERS ‚Äî PREMIUM EDITORIAL EXPERIENCE
  Full-width white page, editorial hero, open roles, culture principles,
  compact application form, Make.com webhook and custom thank-you modal.
{% endcomment %}

<section id="FormaCareers-{{ section.id }}" class="fc-page">
  <div class="fc-hero">
    <div class="fc-hero__top">
      <span>{{ section.settings.eyebrow | escape }}</span>
      <span class="fc-hero__index">01 ‚Äî PEOPLE MAKE THE DIFFERENCE</span>
    </div>
    <div class="fc-hero__main">
      <div class="fc-hero__title-wrap">
        <h1>{{ section.settings.heading | escape }}</h1>
        <p class="fc-hero__subline">{{ section.settings.hero_subline | escape }}</p>
      </div>
      <div class="fc-hero__aside">
        <span class="fc-rule"></span>
        <div>{{ section.settings.intro }}</div>
        <a href="#FormaCareers-Positions-{{ section.id }}" class="fc-text-link">Explore opportunities <span>‚Üò</span></a>
      </div>
    </div>
    <div class="fc-hero__bottom">
      <span>INDEPENDENT THINKING. SHARED AMBITION.</span>
      <span>COPENHAGEN ¬∑ DENMARK</span>
    </div>
    <div class="fc-hero__scroll" aria-hidden="true"><span></span></div>
  </div>

  <section class="fc-positions" id="FormaCareers-Positions-{{ section.id }}">
    <div class="fc-section-top">
      <div>
        <p class="fc-kicker">01 / OPPORTUNITIES</p>
        <h2>{{ section.settings.positions_heading | escape }}</h2>
      </div>
      {% assign job_count = 0 %}
      {% for block in section.blocks %}{% if block.type == 'job' %}{% assign job_count = job_count | plus: 1 %}{% endif %}{% endfor %}
      <span class="fc-count">{{ job_count | prepend: '0' | slice: -2, 2 }} <small>{% if job_count == 1 %}OPEN ROLE{% else %}OPEN ROLES{% endif %}</small></span>
    </div>

    {% if job_count > 0 %}
      <div class="fc-job-list">
        {% for block in section.blocks %}
          {% if block.type == 'job' %}
            <article class="fc-job" {{ block.shopify_attributes }}>
              <details class="fc-job__details">
                <summary class="fc-job__summary">
                  <span class="fc-job__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                  <span class="fc-job__main">
                    <span class="fc-job__title">{{ block.settings.title | escape }}</span>
                    <span class="fc-job__meta">{% if block.settings.location != blank %}<span>{{ block.settings.location | escape }}</span>{% endif %}{% if block.settings.employment_type != blank %}<span>{{ block.settings.employment_type | escape }}</span>{% endif %}</span>
                    {% if block.settings.short_description != blank %}<span class="fc-job__short">{{ block.settings.short_description }}</span>{% endif %}
                  </span>
                  <span class="fc-job__action"><span class="fc-job__action-label">{{ block.settings.button_label | escape }}</span><span class="fc-job__plus" aria-hidden="true"></span></span>
                </summary>
                <div class="fc-job__body">
                  {% if block.settings.introduction != blank %}<div class="fc-job__intro">{{ block.settings.introduction }}</div>{% endif %}
                  <div class="fc-job__columns">
                    {% if block.settings.responsibilities != blank %}<div><h4>{{ block.settings.responsibilities_heading | escape }}</h4>{{ block.settings.responsibilities }}</div>{% endif %}
                    {% if block.settings.qualifications != blank %}<div><h4>{{ block.settings.qualifications_heading | escape }}</h4>{{ block.settings.qualifications }}</div>{% endif %}
                    {% if block.settings.offer != blank %}<div><h4>{{ block.settings.offer_heading | escape }}</h4>{{ block.settings.offer }}</div>{% endif %}
                  </div>
                  <a class="fc-button fc-button--dark fc-job__apply" href="#FormaCareers-Application-{{ section.id }}" data-job-title="{{ block.settings.title | escape }}">{{ block.settings.apply_label | escape }} <span>‚Üó</span></a>
                </div>
              </details>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="fc-no-roles"><p class="fc-kicker">GOOD PEOPLE ARE ALWAYS WELCOME</p><h3>{{ section.settings.empty_heading | escape }}</h3><p>{{ section.settings.empty_text | escape }}</p><a href="#FormaCareers-Application-{{ section.id }}" class="fc-text-link">Introduce yourself <span>‚Üò</span></a></div>
    {% endif %}
  </section>

  <section class="fc-manifesto">
    <div class="fc-manifesto__head"><p class="fc-kicker">02 / THE WAY WE SEE IT</p><p class="fc-manifesto__side">A DIFFERENT KIND OF PLATFORM.<br>A DIFFERENT KIND OF TEAM.</p></div>
    <h2>{{ section.settings.manifesto_heading | escape }}</h2>
    <div class="fc-manifesto__grid">
      <article><span>01</span><h3>Stay curious.</h3><p>Good ideas rarely come from standing still. We stay open, ask questions and look beyond the obvious.</p></article>
      <article><span>02</span><h3>Take ownership.</h3><p>We believe in people who care about the details, take initiative and make things happen.</p></article>
      <article><span>03</span><h3>Make it matter.</h3><p>We bring thoughtful people together to create work with purpose, perspective and lasting value.</p></article>
    </div>
  </section>

  <section class="fc-application" id="FormaCareers-Application-{{ section.id }}">
    <div class="fc-application__intro">
      <p class="fc-kicker">03 / YOUR NEXT CHAPTER</p>
      <p class="fc-application__eyebrow">{{ section.settings.application_eyebrow | escape }}</p>
      <h2>{{ section.settings.application_heading | escape }}</h2>
      <div class="fc-application__description">{{ section.settings.application_text }}</div>
      <div class="fc-application__note"><span class="fc-note-mark">F.</span><p>We are interested in people, not just r√©sum√©s. Tell us what makes you, you.</p></div>
    </div>

    <div class="fc-form-wrap">
      {% if section.settings.webhook_url != blank and section.settings.webhook_url contains 'hook.eu1.make.com/' and section.settings.webhook_url != 'PASTE_CUSTOM_WEBHOOK_URL_HERE' %}
        <form id="FormaCareersForm-{{ section.id }}" class="fc-form" action="{{ section.settings.webhook_url | escape }}" method="post" enctype="multipart/form-data" target="FormaCareersFrame-{{ section.id }}" novalidate>
          <input type="hidden" name="form_name" value="Forma Copenhagen Careers">
          <input type="hidden" name="source_page" value="{{ request.origin }}{{ request.path }}">
          <input type="hidden" name="submitted_at" value="">
          <div class="fc-honeypot" aria-hidden="true"><label for="FCWebsite-{{ section.id }}">Leave this field empty</label><input id="FCWebsite-{{ section.id }}" type="text" name="website" tabindex="-1" autocomplete="off"></div>
          <div class="fc-form__top"><span>LET'S GET TO KNOW YOU</span><span>* REQUIRED FIELDS</span></div>
          <div class="fc-form__grid">
            <div class="fc-field"><label for="FCName-{{ section.id }}">Full name <b>*</b></label><input id="FCName-{{ section.id }}" name="full_name" type="text" autocomplete="name" placeholder="Your name" required></div>
            <div class="fc-field"><label for="FCEmail-{{ section.id }}">Email address <b>*</b></label><input id="FCEmail-{{ section.id }}" name="email" type="email" autocomplete="email" placeholder="you@example.com" required></div>
            <div class="fc-field"><label for="FCPhone-{{ section.id }}">Phone number</label><input id="FCPhone-{{ section.id }}" name="phone" type="tel" autocomplete="tel" placeholder="Your phone number"></div>
            <div class="fc-field"><label for="FCPosition-{{ section.id }}">Position / area of interest <b>*</b></label><select id="FCPosition-{{ section.id }}" name="position" required><option value="">Select an area</option><option value="Open position">Open position</option><option value="Brand Partnerships">Brand Partnerships</option><option value="Marketing">Marketing</option><option value="Content & Editorial">Content & Editorial</option><option value="Creative & Design">Creative & Design</option><option value="Technology">Technology</option><option value="Operations">Operations</option><option value="Internship">Internship</option><option value="Other">Other</option></select></div>
          </div>
          <div class="fc-field fc-field--full"><label for="FCIntro-{{ section.id }}">Tell us about yourself <b>*</b></label><textarea id="FCIntro-{{ section.id }}" name="introduction" rows="5" required placeholder="A little about you, your experience and why you'd like to join Forma..."></textarea></div>
          <div class="fc-form__files">
            <div class="fc-field"><label for="FCCV-{{ section.id }}">CV <b>*</b></label><input id="FCCV-{{ section.id }}" name="cv" type="file" accept=".pdf,.doc,.docx" required><small>PDF, DOC or DOCX. Max. 4 MB combined.</small></div>
            <div class="fc-field"><label for="FCPortfolio-{{ section.id }}">Application / portfolio</label><input id="FCPortfolio-{{ section.id }}" name="portfolio" type="file" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg"><small>Optional. PDF, DOC, DOCX, PNG or JPG.</small></div>
          </div>
          <div class="fc-consent"><label for="FCPrivacy-{{ section.id }}"><input id="FCPrivacy-{{ section.id }}" name="privacy_consent" type="checkbox" value="Yes" required><span>I have read Forma's <a href="/policies/privacy-policy" target="_blank" rel="noopener">Privacy Policy</a> and agree that my information may be processed in connection with this application. <b>*</b></span></label></div>
          <p class="fc-message" role="status" aria-live="polite"></p>
          <button class="fc-button fc-button--dark fc-submit" type="submit"><span>Send your application</span><span class="fc-submit__arrow">‚Üó</span></button>
          <p class="fc-form__foot">THANK YOU FOR CONSIDERING FORMA. WE LOOK FORWARD TO MEETING YOU.</p>
        </form>
        <iframe name="FormaCareersFrame-{{ section.id }}" id="FormaCareersFrame-{{ section.id }}" class="fc-frame" title="Application submission" tabindex="-1"></iframe>
        <div class="fc-success" id="FormaCareersSuccess-{{ section.id }}" aria-hidden="true">
          <button class="fc-success__backdrop" type="button" data-fc-close aria-label="Close thank you message"></button>
          <div class="fc-success__panel" role="dialog" aria-modal="true" aria-labelledby="FCSuccessTitle-{{ section.id }}" aria-describedby="FCSuccessCopy-{{ section.id }}" tabindex="-1">
            <p class="fc-success__eyebrow">FORMA COPENHAGEN <span> / </span> CAREERS</p>
            <span class="fc-success__rule"></span>
            <h3 id="FCSuccessTitle-{{ section.id }}">Thank you for saying hello.</h3>
            <div id="FCSuccessCopy-{{ section.id }}" class="fc-success__copy"><p>Your application is on its way to us. And before anything else, we want to say thank you.</p><p>It means something that you can see yourself being part of what we are building. We'll take the time to get to know your introduction, your ideas and what you could bring to Forma.</p><p>Whatever happens next, we're glad our paths crossed.</p></div>
            <p class="fc-success__signoff">WARM REGARDS, THE FORMA TEAM</p>
            <button class="fc-button fc-button--dark fc-success__done" type="button" data-fc-close><span>Back to Forma</span><span>‚Üó</span></button>
          </div>
        </div>
      {% else %}
        <div class="fc-form-placeholder">The application form is not connected. Add your Make.com Custom Webhook URL in the Forma Careers section settings.</div>
      {% endif %}
    </div>
  </section>

  <footer class="fc-endmark"><span>FORMA</span><p>GOOD THINGS BEGIN WITH GOOD PEOPLE.</p></footer>
</section>

<style>
  #shopify-section-{{ section.id }} { --fc-ink:#20201e; --fc-muted:#777771; --fc-line:#deded8; --fc-paper:#f5f5f1; --fc-white:#fff; }
  #shopify-section-{{ section.id }} .fc-page { width:100%; overflow:hidden; background:#fff; color:var(--fc-ink); font-family:inherit; }
  #shopify-section-{{ section.id }} .fc-page * { box-sizing:border-box; }
  #shopify-section-{{ section.id }} .fc-hero { position:relative; min-height:660px; padding:54px clamp(28px,5.2vw,88px) 32px; display:flex; flex-direction:column; justify-content:space-between; background:#fff; }
  #shopify-section-{{ section.id }} .fc-hero__top,#shopify-section-{{ section.id }} .fc-hero__bottom { display:flex; justify-content:space-between; gap:20px; color:#999991; font-size:9px; font-weight:600; letter-spacing:.19em; text-transform:uppercase; }
  #shopify-section-{{ section.id }} .fc-hero__main { width:100%; max-width:1600px; margin:auto; padding:100px 0 105px; display:grid; grid-template-columns:minmax(0,1.35fr) minmax(280px,.65fr); align-items:end; gap:8vw; }
  #shopify-section-{{ section.id }} .fc-hero h1 { margin:0; font-size:clamp(90px,13.1vw,204px); line-height:.79; font-weight:400; letter-spacing:-.095em; }
  #shopify-section-{{ section.id }} .fc-hero__subline { margin:35px 0 0 8px; color:#999991; font-size:10px; letter-spacing:.2em; text-transform:uppercase; }
  #shopify-section-{{ section.id }} .fc-hero__aside { max-width:430px; margin:0 0 10px auto; font-size:16px; line-height:1.85; color:var(--fc-muted); }
  #shopify-section-{{ section.id }} .fc-rule { display:block; width:100%; height:1px; margin-bottom:27px; background:var(--fc-line); }
  #shopify-section-{{ section.id }} .fc-text-link { display:inline-flex; align-items:center; gap:24px; margin-top:30px; padding-bottom:8px; border-bottom:1px solid var(--fc-ink); color:var(--fc-ink); text-decoration:none; font-size:12px; transition:gap .25s ease, opacity .25s ease; }
  #shopify-section-{{ section.id }} .fc-text-link:hover { gap:34px; opacity:.65; }
  #shopify-section-{{ section.id }} .fc-hero__scroll { position:absolute; left:50%; bottom:0; width:1px; height:38px; background:var(--fc-line); overflow:hidden; }
  #shopify-section-{{ section.id }} .fc-hero__scroll span { display:block; width:1px; height:18px; background:var(--fc-ink); animation:fc-scroll 1.8s ease-in-out infinite; }
  @keyframes fc-scroll { 0%{transform:translateY(-20px)} 100%{transform:translateY(42px)} }
  #shopify-section-{{ section.id }} .fc-positions { max-width:1500px; width:calc(100% - 2*clamp(28px,10.3vw,160px)); margin:0 auto; padding:145px 0 150px; }
  #shopify-section-{{ section.id }} .fc-section-top { display:flex; justify-content:space-between; align-items:flex-end; padding-bottom:28px; border-bottom:1px solid var(--fc-line); }
  #shopify-section-{{ section.id }} .fc-kicker { margin:0 0 24px; color:#999991; font-size:9px; font-weight:600; letter-spacing:.2em; text-transform:uppercase; }
  #shopify-section-{{ section.id }} .fc-section-top h2 { margin:0; font-size:clamp(44px,5vw,72px); line-height:1; font-weight:400; letter-spacing:-.075em; }
  #shopify-section-{{ section.id }} .fc-count { display:flex; align-items:baseline; gap:10px; padding-bottom:7px; font-size:18px; }
  #shopify-section-{{ section.id }} .fc-count small { color:#999991; font-size:9px; letter-spacing:.15em; }
  #shopify-section-{{ section.id }} .fc-job { border-bottom:1px solid var(--fc-line); }
  #shopify-section-{{ section.id }} .fc-job__details summary { list-style:none; cursor:pointer; }
  #shopify-section-{{ section.id }} .fc-job__details summary::-webkit-details-marker { display:none; }
  #shopify-section-{{ section.id }} .fc-job__summary { display:grid; grid-template-columns:70px minmax(0,1fr) 180px; gap:20px; align-items:center; padding:34px 0; }
  #shopify-section-{{ section.id }} .fc-job__number { align-self:start; padding-top:8px; color:#aaa9a2; font-size:10px; letter-spacing:.14em; }
  #shopify-section-{{ section.id }} .fc-job__main { display:flex; flex-direction:column; gap:12px; }
  #shopify-section-{{ section.id }} .fc-job__title { font-size:clamp(22px,2.2vw,30px); letter-spacing:-.045em; }
  #shopify-section-{{ section.id }} .fc-job__meta { display:flex; flex-wrap:wrap; gap:20px; color:#999991; font-size:10px; }
  #shopify-section-{{ section.id }} .fc-job__short { max-width:700px; color:var(--fc-muted); font-size:13px; line-height:1.7; }
  #shopify-section-{{ section.id }} .fc-job__short p { margin:0; }
  #shopify-section-{{ section.id }} .fc-job__action { display:flex; justify-content:flex-end; align-items:center; gap:22px; font-size:11px; }
  #shopify-section-{{ section.id }} .fc-job__plus { position:relative; width:22px; height:22px; border:1px solid var(--fc-line); border-radius:50%; transition:transform .3s ease,background .3s ease; }
  #shopify-section-{{ section.id }} .fc-job__plus:before,#shopify-section-{{ section.id }} .fc-job__plus:after { content:""; position:absolute; top:10px; left:6px; width:8px; height:1px; background:var(--fc-ink); }
  #shopify-section-{{ section.id }} .fc-job__plus:after { transform:rotate(90deg); }
  #shopify-section-{{ section.id }} .fc-job__details[open] .fc-job__plus { transform:rotate(45deg); background:var(--fc-paper); }
  #shopify-section-{{ section.id }} .fc-job__body { padding:4px 0 48px 90px; animation:fc-reveal .35s ease both; }
  @keyframes fc-reveal { from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:translateY(0)} }
  #shopify-section-{{ section.id }} .fc-job__intro { max-width:760px; margin-bottom:34px; font-size:17px; line-height:1.7; }
  #shopify-section-{{ section.id }} .fc-job__columns { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:38px; }
  #shopify-section-{{ section.id }} .fc-job__columns h4 { margin:0 0 15px; font-size:11px; font-weight:600; }
  #shopify-section-{{ section.id }} .fc-job__columns div { color:var(--fc-muted); font-size:12px; line-height:1.8; }
  #shopify-section-{{ section.id }} .fc-job__columns ul { margin:0; padding-left:17px; }
  #shopify-section-{{ section.id }} .fc-button { display:flex; align-items:center; justify-content:space-between; gap:30px; min-height:56px; padding:0 20px; border:1px solid var(--fc-ink); text-decoration:none; font:inherit; font-size:12px; cursor:pointer; transition:background .25s ease,color .25s ease,border-color .25s ease; }
  #shopify-section-{{ section.id }} .fc-button--dark { background:var(--fc-ink); color:#fff; }
  #shopify-section-{{ section.id }} .fc-button--dark:hover { background:#fff; color:var(--fc-ink); }
  #shopify-section-{{ section.id }} .fc-job__apply { width:min(100%,310px); margin-top:35px; }
  #shopify-section-{{ section.id }} .fc-no-roles { padding:60px 0; max-width:650px; }
  #shopify-section-{{ section.id }} .fc-no-roles h3 { margin:0 0 15px; font-size:32px; font-weight:400; letter-spacing:-.05em; }
  #shopify-section-{{ section.id }} .fc-no-roles p:not(.fc-kicker) { color:var(--fc-muted); font-size:14px; line-height:1.8; }
  #shopify-section-{{ section.id }} .fc-manifesto { padding:100px clamp(28px,10.3vw,160px) 120px; background:var(--fc-paper); }
  #shopify-section-{{ section.id }} .fc-manifesto__head { display:flex; justify-content:space-between; gap:30px; }
  #shopify-section-{{ section.id }} .fc-manifesto__side { margin:0; color:#999991; text-align:right; font-size:9px; line-height:1.8; letter-spacing:.16em; }
  #shopify-section-{{ section.id }} .fc-manifesto h2 { max-width:1000px; margin:75px 0 90px; font-size:clamp(55px,8.5vw,124px); line-height:.94; font-weight:400; letter-spacing:-.085em; }
  #shopify-section-{{ section.id }} .fc-manifesto__grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8%; }
  #shopify-section-{{ section.id }} .fc-manifesto__grid article { border-top:1px solid #d6d6cf; padding-top:20px; }
  #shopify-section-{{ section.id }} .fc-manifesto__grid article span { color:#999991; font-size:10px; letter-spacing:.14em; }
  #shopify-section-{{ section.id }} .fc-manifesto__grid h3 { margin:35px 0 12px; font-size:25px; font-weight:400; letter-spacing:-.05em; }
  #shopify-section-{{ section.id }} .fc-manifesto__grid p { max-width:310px; margin:0; color:var(--fc-muted); font-size:13px; line-height:1.8; }
  #shopify-section-{{ section.id }} .fc-application { max-width:1450px; width:calc(100% - 2*clamp(28px,8vw,120px)); margin:0 auto; padding:155px 0 145px; display:grid; grid-template-columns:minmax(250px,.78fr) minmax(0,1.22fr); gap:clamp(50px,9vw,150px); align-items:start; }
  #shopify-section-{{ section.id }} .fc-application__intro { position:sticky; top:50px; }
  #shopify-section-{{ section.id }} .fc-application__eyebrow { margin:54px 0 17px; color:#999991; font-size:9px; font-weight:600; letter-spacing:.19em; }
  #shopify-section-{{ section.id }} .fc-application h2 { max-width:480px; margin:0; font-size:clamp(48px,5.5vw,78px); line-height:.98; font-weight:400; letter-spacing:-.08em; }
  #shopify-section-{{ section.id }} .fc-application__description { max-width:390px; margin-top:28px; color:var(--fc-muted); font-size:14px; line-height:1.85; }
  #shopify-section-{{ section.id }} .fc-application__description p { margin:0 0 12px; }
  #shopify-section-{{ section.id }} .fc-application__note { display:flex; gap:15px; align-items:center; max-width:360px; margin-top:55px; padding-top:20px; border-top:1px solid var(--fc-line); }
  #shopify-section-{{ section.id }} .fc-note-mark { display:grid; place-items:center; flex:0 0 34px; height:34px; border:1px solid var(--fc-line); border-radius:50%; font-family:Georgia,serif; font-size:15px; }
  #shopify-section-{{ section.id }} .fc-application__note p { margin:0; color:#999991; font-size:11px; line-height:1.6; }
  #shopify-section-{{ section.id }} .fc-form-wrap { min-width:0; padding:34px 38px 30px; background:var(--fc-paper); }
  #shopify-section-{{ section.id }} .fc-form { display:flex; flex-direction:column; gap:25px; }
  #shopify-section-{{ section.id }} .fc-form__top { display:flex; justify-content:space-between; gap:15px; padding-bottom:19px; border-bottom:1px solid var(--fc-line); color:#999991; font-size:9px; letter-spacing:.16em; }
  #shopify-section-{{ section.id }} .fc-form__grid,#shopify-section-{{ section.id }} .fc-form__files { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:23px 20px; }
  #shopify-section-{{ section.id }} .fc-field { min-width:0; display:flex; flex-direction:column; gap:9px; }
  #shopify-section-{{ section.id }} .fc-field label { font-size:11px; color:#454540; }
  #shopify-section-{{ section.id }} .fc-field label b,#shopify-section-{{ section.id }} .fc-consent b { color:#999991; font-weight:400; }
  #shopify-section-{{ section.id }} .fc-field input:not([type=file]),#shopify-section-{{ section.id }} .fc-field select,#shopify-section-{{ section.id }} .fc-field textarea { width:100%; min-height:49px; padding:13px 14px; border:1px solid #deded8; border-radius:0; background:#fff; color:var(--fc-ink); font:inherit; font-size:12px; outline:none; transition:border-color .2s ease,box-shadow .2s ease; }
  #shopify-section-{{ section.id }} .fc-field textarea { min-height:140px; resize:vertical; line-height:1.6; }
  #shopify-section-{{ section.id }} .fc-field input:focus,#shopify-section-{{ section.id }} .fc-field select:focus,#shopify-section-{{ section.id }} .fc-field textarea:focus { border-color:#777771; box-shadow:0 0 0 2px rgba(32,32,30,.06); }
  #shopify-section-{{ section.id }} .fc-field input[type=file] { width:100%; min-height:49px; padding:10px; border:1px solid #deded8; background:#fff; font:inherit; font-size:10px; }
  #shopify-section-{{ section.id }} .fc-field input[type=file]::file-selector-button { margin-right:10px; padding:8px 11px; border:0; background:var(--fc-paper); color:var(--fc-ink); font:inherit; cursor:pointer; }
