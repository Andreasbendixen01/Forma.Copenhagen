{% comment %}
  FORMA CAREERS
  Complete careers section:
  - Editable open positions
  - Expandable job descriptions
  - Apply buttons linking to the application form
  - Shopify app block area for an application form with file uploads
{% endcomment %}

<section id="FormaCareers-{{ section.id }}" class="forma-careers">
  <div class="forma-careers__inner">

    <!-- INTRO -->
    <header class="forma-careers__header">
      {% if section.settings.eyebrow != blank %}
        <p class="forma-careers__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      <h1 class="forma-careers__title">{{ section.settings.heading | escape }}</h1>

      {% if section.settings.intro != blank %}
        <div class="forma-careers__intro">{{ section.settings.intro }}</div>
      {% endif %}
    </header>

    <!-- OPEN POSITIONS -->
    <div class="forma-careers__positions">
      {% assign job_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'job' %}
          {% assign job_count = job_count | plus: 1 %}
        {% endif %}
      {% endfor %}

      <div class="forma-careers__section-heading">
        <h2>{{ section.settings.positions_heading | escape }}</h2>
        <span>
          {{ job_count }}
          {% if job_count == 1 %}position{% else %}positions{% endif %}
        </span>
      </div>

      {% if job_count > 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'job' %}
            <article class="forma-careers__job" {{ block.shopify_attributes }}>
              <details class="forma-careers__job-details">
                <summary class="forma-careers__job-summary">
                  <div class="forma-careers__job-main">
                    <h3>{{ block.settings.title | escape }}</h3>

                    <div class="forma-careers__job-meta">
                      {% if block.settings.location != blank %}
                        <span>{{ block.settings.location | escape }}</span>
                      {% endif %}
                      {% if block.settings.employment_type != blank %}
                        <span>{{ block.settings.employment_type | escape }}</span>
                      {% endif %}
                    </div>

                    {% if block.settings.short_description != blank %}
                      <div class="forma-careers__job-short-description">
                        {{ block.settings.short_description }}
                      </div>
                    {% endif %}
                  </div>

                  <span class="forma-careers__job-toggle">
                    <span class="forma-careers__job-toggle-text">
                      {{ block.settings.button_label | escape }}
                    </span>
                    <span class="forma-careers__job-toggle-icon" aria-hidden="true">+</span>
                  </span>
                </summary>

                <div class="forma-careers__job-expanded">
                  {% if block.settings.introduction != blank %}
                    <div class="forma-careers__job-introduction">
                      {{ block.settings.introduction }}
                    </div>
                  {% endif %}

                  {% if block.settings.responsibilities != blank %}
                    <div class="forma-careers__job-detail-block">
                      <h4>{{ block.settings.responsibilities_heading | escape }}</h4>
                      <div>{{ block.settings.responsibilities }}</div>
                    </div>
                  {% endif %}

                  {% if block.settings.qualifications != blank %}
                    <div class="forma-careers__job-detail-block">
                      <h4>{{ block.settings.qualifications_heading | escape }}</h4>
                      <div>{{ block.settings.qualifications }}</div>
                    </div>
                  {% endif %}

                  {% if block.settings.offer != blank %}
                    <div class="forma-careers__job-detail-block">
                      <h4>{{ block.settings.offer_heading | escape }}</h4>
                      <div>{{ block.settings.offer }}</div>
                    </div>
                  {% endif %}

                  <a class="forma-careers__apply-button" href="#FormaCareers-Application">
                    {{ block.settings.apply_label | escape }}
                    <span aria-hidden="true">‚Üì</span>
                  </a>
                </div>
              </details>
            </article>
          {% endif %}
        {% endfor %}
      {% else %}
        <div class="forma-careers__empty">
          <h3>{{ section.settings.empty_heading | escape }}</h3>
          <p>{{ section.settings.empty_text | escape }}</p>
        </div>
      {% endif %}
    </div>

    <!-- UNSOLICITED APPLICATIONS / APPLICATION FORM -->
    <div id="FormaCareers-Application" class="forma-careers__application">
      <div class="forma-careers__application-copy">
        {% if section.settings.application_eyebrow != blank %}
          <p class="forma-careers__eyebrow">
            {{ section.settings.application_eyebrow | escape }}
          </p>
        {% endif %}

        <h2>{{ section.settings.application_heading | escape }}</h2>

        <div class="forma-careers__application-text">
          {{ section.settings.application_text }}
        </div>
      </div>

      <div class="forma-careers__form">
        {% assign has_app_block = false %}

        {% for block in section.blocks %}
          {% if block.type == '@app' %}
            {% assign has_app_block = true %}
            {% render block %}
          {% endif %}
        {% endfor %}

        {% unless has_app_block %}
          <div class="forma-careers__form-placeholder">
            <p>
              Add your application form here through the Shopify Theme Editor.
              Choose an application form app block that supports file uploads.
            </p>
          </div>
        {% endunless %}
      </div>
    </div>

  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .forma-careers {
    --forma-careers-text: #20201e;
    --forma-careers-muted: #777771;
    --forma-careers-border: #deded8;
    background: #fff;
    color: var(--forma-careers-text);
    padding: 72px 32px 100px;
  }

  #shopify-section-{{ section.id }} .forma-careers__inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .forma-careers__header {
    max-width: 760px;
    margin: 0 auto 88px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .forma-careers__eyebrow {
    margin: 0 0 18px;
    font-size: 11px;
    letter-spacing: .16em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--forma-careers-muted);
  }

  #shopify-section-{{ section.id }} .forma-careers__title {
    margin: 0;
    font-size: clamp(40px, 6vw, 68px);
    font-weight: 400;
    letter-spacing: -.045em;
    line-height: 1.05;
  }

  #shopify-section-{{ section.id }} .forma-careers__intro {
    max-width: 580px;
    margin: 24px auto 0;
    font-size: 16px;
    line-height: 1.8;
    color: var(--forma-careers-muted);
  }

  #shopify-section-{{ section.id }} .forma-careers__section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--forma-careers-border);
  }

  #shopify-section-{{ section.id }} .forma-careers__section-heading h2,
  #shopify-section-{{ section.id }} .forma-careers__application h2 {
    margin: 0;
    font-size: clamp(25px, 3vw, 36px);
    font-weight: 400;
    letter-spacing: -.035em;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .forma-careers__section-heading > span {
    font-size: 12px;
    color: var(--forma-careers-muted);
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .forma-careers__job {
    padding: 0;
    border-bottom: 1px solid var(--forma-careers-border);
  }

  #shopify-section-{{ section.id }} .forma-careers__job-details {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .forma-careers__job-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    padding: 28px 0;
    cursor: pointer;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .forma-careers__job-summary::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .forma-careers__job-summary::marker {
    content: "";
  }

  #shopify-section-{{ section.id }} .forma-careers__job-main {
    flex: 1;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .forma-careers__job h3 {
    margin: 0 0 10px;
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -.02em;
  }

  #shopify-section-{{ section.id }} .forma-careers__job-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-size: 12px;
    color: var(--forma-careers-muted);
  }

  #shopify-section-{{ section.id }} .forma-careers__job-short-description {
    margin-top: 14px;
    max-width: 680px;
    font-size: 14px;
    line-height: 1.75;
    color: var(--forma-careers-muted);
  }

  #shopify-section-{{ section.id }} .forma-careers__job-toggle {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
    padding-bottom: 5px;
    border-bottom: 1px solid currentColor;
    font-size: 13px;
    color: var(--forma-careers-text);
    transition: opacity .2s ease;
  }

  #shopify-section-{{ section.id }} .forma-careers__job-summary:hover .forma-careers__job-toggle {
    opacity: .6;
  }

  #shopify-section-{{ section.id }} .forma-careers__job-toggle-icon {
    display: inline-block;
    font-size: 18px;
    line-height: 1;
    transition: transform .2s ease;
  }

  #shopify-section-{{ section.id }} .forma-careers__job-details[open] .forma-careers__job-toggle-icon {
    transform: rotate(45deg);
  }

  #shopify-section-{{ section.id }} .forma-careers__job-details[open] .forma-careers__job-toggle-text {
    font-size: 0;
  }

  #shopify-section-{{ section.id }} .forma-careers__job-details[open] .forma-careers__job-toggle-text::after {
    content: "Close";
    font-size: 13px;
  }

  #shopify-section-{{ section.id }} .forma-careers__job-expanded {
    max-width: 760px;
    padding: 0 0 34px;
    animation: forma-careers-reveal .25s ease;
  }

  @keyframes forma-careers-reveal {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  #shopify-section-{{ section.id }} .forma-careers__job-introduction {
    margin: 0 0 28px;
    font-size: 15px;
    line-height: 1.8;
    color: var(--forma-careers-muted);
  }

  #shopify-section-{{ section.id }} .forma-careers__job-detail-block {
    margin-top: 26px;
  }

  #shopify-section-{{ section.id }} .forma-careers__job-detail-block h4 {
    margin: 0 0 12px;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -.015em;
  }

  #shopify-section-{{ section.id }} .forma-careers__job-detail-block > div {
    font-size: 14px;
    line-height: 1.8;
    color: var(--forma-careers-muted);
  }

  #shopify-section-{{ section.id }} .forma-careers__job-detail-block ul {
    padding-left: 20px;
  }

  #shopify-section-{{ section.id }} .forma-careers__apply-button {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 30px;
    padding: 0 0 7px;
    border-bottom: 1px solid currentColor;
    color: var(--forma-careers-text);
    font-size: 13px;
    text-decoration: none;
    transition: opacity .2s ease;
  }

  #shopify-section-{{ section.id }} .forma-careers__apply-button:hover {
    opacity: .6;
  }

  #shopify-section-{{ section.id }} .forma-careers__empty {
    padding: 34px 0;
  }

  #shopify-section-{{ section.id }} .forma-careers__empty h3 {
    margin: 0 0 10px;
    font-size: 17px;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .forma-careers__empty p {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--forma-careers-muted);
  }

  #shopify-section-{{ section.id }} .forma-careers__application {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    gap: 64px;
    align-items: start;
    margin-top: 104px;
    padding-top: 64px;
    border-top: 1px solid var(--forma-careers-border);
    scroll-margin-top: 40px;
  }

  #shopify-section-{{ section.id }} .forma-careers__application-text {
    margin-top: 18px;
    max-width: 390px;
    font-size: 14px;
    line-height: 1.8;
    color: var(--forma-careers-muted);
  }

  #shopify-section-{{ section.id }} .forma-careers__form {
    min-width: 0;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .forma-careers__form-placeholder {
    padding: 28px;
    border: 1px dashed var(--forma-careers-border);
    font-size: 13px;
    line-height: 1.7;
    color: var(--forma-careers-muted);
  }

  #shopify-section-{{ section.id }} .forma-careers__form-placeholder p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .forma-careers__form input,
  #shopify-section-{{ section.id }} .forma-careers__form select,
  #shopify-section-{{ section.id }} .forma-careers__form textarea {
    max-width: 100%;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .forma-careers__application:target {
    scroll-margin-top: 40px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .forma-careers {
      padding: 48px 20px 64px;
    }

    #shopify-section-{{ section.id }} .forma-careers__header {
      margin-bottom: 60px;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .forma-careers__intro {
      margin-left: 0;
      font-size: 15px;
    }

    #shopify-section-{{ section.id }} .forma-careers__job-summary {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }

    #shopify-section-{{ section.id }} .forma-careers__job-toggle {
      align-self: flex-start;
    }

    #shopify-section-{{ section.id }} .forma-careers__application {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-top: 72px;
      padding-top: 44px;
    }
  }
</style>

{% schema %}
{
  "name": "Forma Careers",
  "tag": "section",
  "class": "section-forma-careers",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Intro label",
      "default": "FORMA COPENHAGEN / CAREERS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Join Forma."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>We're always interested in meeting talented people who share our passion for brands, creativity and building something meaningful.</p>"
    },
    {
      "type": "text",
      "id": "positions_heading",
      "label": "Positions heading",
      "default": "Open Positions"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "No positions heading",
      "default": "No open positions at the moment"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "No positions message",
      "default": "We don't have any open positions right now, but you're welcome to send us an unsolicited application below."
    },
    {
      "type": "text",
      "id": "application_eyebrow",
      "label": "Application label",
      "default": "MAKE YOUR INTRODUCTION"
    },
    {
      "type": "text",
      "id": "application_heading",
      "label": "Application heading",
      "default": "Unsolicited Applications"
    },
    {
      "type": "richtext",
      "id": "application_text",
      "label": "Application description",
      "default": "<p>Don't see a role that fits? Tell us a little about yourself, your experience and how you could contribute to Forma.</p><p>We look forward to hearing from you.</p>"
    }
  ],
  "blocks": [
    {
      "type": "job",
      "name": "Job listing",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Job title",
          "default": "Brand Partnerships Manager"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Copenhagen, Denmark"
        },
        {
          "type": "text",
          "id": "employment_type",
          "label": "Employment type",
          "default": "Full-time"
        },
        {
          "type": "richtext",
          "id": "short_description",
          "label": "Short description",
          "default": "<p>Help us build meaningful relationships with the brands shaping the future of Scandinavian lifestyle.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Expand button label",
          "default": "View position"
        },
        {
          "type": "richtext",
          "id": "introduction",
          "label": "Full job introduction",
          "default": "<p>We are looking for a talented person to join Forma Copenhagen and help us grow our platform and brand partnerships.</p>"
        },
        {
          "type": "text",
          "id": "responsibilities_heading",
          "label": "Responsibilities heading",
          "default": "The role"
        },
        {
          "type": "richtext",
          "id": "responsibilities",
          "label": "Responsibilities",
          "default": "<ul><li>Build and maintain relationships with partner brands.</li><li>Identify new opportunities and support Forma's growth.</li><li>Work closely with the team on partnerships and initiatives.</li></ul>"
        },
        {
          "type": "text",
          "id": "qualifications_heading",
          "label": "Qualifications heading",
          "default": "What we're looking for"
        },
        {
          "type": "richtext",
          "id": "qualifications",
          "label": "Qualifications",
          "default": "<ul><li>Strong communication and relationship-building skills.</li><li>A proactive and structured approach to work.</li><li>An interest in fashion, design and lifestyle brands.</li></ul>"
        },
        {
          "type": "text",
          "id": "offer_heading",
          "label": "What we offer heading",
          "default": "What we offer"
        },
        {
          "type": "richtext",
          "id": "offer",
          "label": "What we offer",
          "default": "<p>The opportunity to help shape an ambitious platform, take ownership and make a meaningful impact as Forma grows.</p>"
        },
        {
          "type": "text",
          "id": "apply_label",
          "label": "Apply button label",
          "default": "Apply for this position"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Forma Careers"
    }
  ]
}
{% endschema %}

