      margin-left: 0;
      font-size: 15px;
    }

    #shopify-section-{{ section.id }} .forma-careers__job-summary {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }

    #shopify-section-{{ section.id }} .forma-careers__job-toggle {
      align-self: flex-start;
    }

    #shopify-section-{{ section.id }} .forma-careers__application {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-top: 72px;
      padding-top: 44px;
    }

    #shopify-section-{{ section.id }} .forma-careers__field-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  (() => {
    const section = document.getElementById('FormaCareers-{{ section.id }}');
    if (!section || section.dataset.formInitialized === 'true') return;
    section.dataset.formInitialized = 'true';

    const form = section.querySelector('#FormaCareersForm-{{ section.id }}');
    const frame = section.querySelector('#FormaCareersFrame-{{ section.id }}');
    if (!form || !frame) return;

    const message = form.querySelector('.forma-careers__form-message');
    const submit = form.querySelector('button[type="submit"]');
    const maxCombinedBytes = 4 * 1024 * 1024;
    let waitingForResponse = false;

    const showMessage = (text, type) => {
      message.textContent = text;
      message.className = 'forma-careers__form-message ' + type;
    };

    frame.addEventListener('load', () => {
      if (!waitingForResponse) return;
      waitingForResponse = false;
      submit.disabled = false;
      submit.querySelector('span').textContent = 'Submit application';
      form.reset();
      showMessage('Thank you for your application. Your details have been submitted.', 'is-success');
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      showMessage('', '');

      if (!form.reportValidity()) return;

      const honeypot = form.querySelector('[name="website"]');
      if (honeypot && honeypot.value.trim() !== '') return;

      const files = [
        form.querySelector('[name="cv"]').files[0],
        form.querySelector('[name="portfolio"]').files[0]
      ].filter(Boolean);
      const totalBytes = files.reduce((total, file) => total + file.size, 0);

      if (totalBytes > maxCombinedBytes) {
        showMessage('The combined file size must be 4 MB or less. Please choose smaller files.', 'is-error');
        return;
      }

      form.querySelector('[name="submitted_at"]').value = new Date().toISOString();
      waitingForResponse = true;
      submit.disabled = true;
      submit.querySelector('span').textContent = 'Submitting...';
      form.submit();
    });

    section.querySelectorAll('.forma-careers__apply-button').forEach((button) => {
      button.addEventListener('click', () => {
        const job = button.closest('.forma-careers__job');
        const title = job ? job.querySelector('.forma-careers__job-main h3') : null;
        const position = form.querySelector('[name="position"]');
        if (title && position) {
          const jobTitle = title.textContent.trim();
          const matchingOption = Array.from(position.options).find((option) => option.value === jobTitle);
          if (matchingOption) position.value = jobTitle;
          else {
            let customOption = position.querySelector('option[data-job-option="true"]');
            if (!customOption) {
              customOption = document.createElement('option');
              customOption.dataset.jobOption = 'true';
              position.appendChild(customOption);
            }
            customOption.value = jobTitle;
            customOption.textContent = jobTitle;
            position.value = jobTitle;
          }
        }
      });
    });
  })();
</script>

