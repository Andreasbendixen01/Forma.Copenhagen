<script>
(() => {
  const section = document.getElementById('FormaCareers-{{ section.id }}');
  if (!section || section.dataset.fcReady === 'true') return;
  section.dataset.fcReady = 'true';
  const form = section.querySelector('#FormaCareersForm-{{ section.id }}');
  const frame = section.querySelector('#FormaCareersFrame-{{ section.id }}');
  if (!form || !frame) return;
  const submit = form.querySelector('.fc-submit');
  const message = form.querySelector('.fc-message');
  const success = section.querySelector('#FormaCareersSuccess-{{ section.id }}');
  const panel = success && success.querySelector('.fc-success__panel');
  let waiting = false;
  let previousFocus = null;
  const showError = (text) => { message.textContent = text; message.classList.add('is-error'); };
  const openSuccess = () => {
    if (!success) return;
    previousFocus = document.activeElement;
    success.classList.add('is-open');
    success.setAttribute('aria-hidden','false');
    document.documentElement.style.overflow = 'hidden';
    if (panel) panel.focus();
  };
  const closeSuccess = () => {
    if (!success) return;
    success.classList.remove('is-open');
    success.setAttribute('aria-hidden','true');
    document.documentElement.style.overflow = '';
    if (previousFocus && previousFocus.focus) previousFocus.focus();
  };
  success.querySelectorAll('[data-fc-close]').forEach((el) => el.addEventListener('click', closeSuccess));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && success.classList.contains('is-open')) closeSuccess(); });
  frame.addEventListener('load', () => {
    if (!waiting) return;
    waiting = false;
    submit.disabled = false;
    submit.querySelector('span').textContent = 'Send your application';
    form.reset();
    message.textContent = '';
    message.classList.remove('is-error');
    openSuccess();
  });
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    message.textContent = '';
    message.classList.remove('is-error');
    if (!form.reportValidity()) return;
    const honeypot = form.querySelector('[name="website"]');
    if (honeypot && honeypot.value.trim()) return;
    const cv = form.querySelector('[name="cv"]');
    const portfolio = form.querySelector('[name="portfolio"]');
    const files = [cv.files[0], portfolio.files[0]].filter(Boolean);
    const total = files.reduce((sum,file) => sum + file.size,0);
    if (total > 4 * 1024 * 1024) { showError('The combined file size must be 4 MB or less. Please choose smaller files.'); return; }
    const endpoint = form.getAttribute('action');
    if (!endpoint) { showError('The application form is not connected yet. Please try again later.'); return; }
    form.querySelector('[name="submitted_at"]').value = new Date().toISOString();
    waiting = true;
    submit.disabled = true;
    submit.querySelector('span').textContent = 'Sending your application‚Ä¶';
    form.submit();
  });
  section.querySelectorAll('.fc-job__apply').forEach((link) => link.addEventListener('click', () => {
    const title = link.dataset.jobTitle;
    const select = form.querySelector('[name="position"]');
    if (!title || !select) return;
    let option = Array.from(select.options).find((item) => item.value === title);
    if (!option) { option = new Option(title,title); select.add(option); }
    select.value = title;
  }));
})();
</script>

