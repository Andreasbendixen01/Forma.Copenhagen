{% comment %}
  FORMA CAREERS
  Complete careers section:
  - Editable open positions
  - Expandable job descriptions
  - Apply buttons linking to the application form
  - Custom application form connected to Make.com with file uploads
{% endcomment %}

<section id="FormaCareers-{{ section.id }}" class="forma-careers">
  <div class="forma-careers__inner">

    <!-- EDITORIAL HERO -->
    <header class="forma-careers__header">
      <div class="forma-careers__hero-inner">
        {% if section.settings.eyebrow != blank %}
          <p class="forma-careers__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <div class="forma-careers__hero-layout">
          <div class="forma-careers__hero-title-wrap">
            <h1 class="forma-careers__title">{{ section.settings.heading | escape }}</h1>
            <span class="forma-careers__hero-note">PEOPLE MAKE THE DIFFERENCE</span>
          </div>
          {% if section.settings.intro != blank %}
            <div class="forma-careers__hero-aside">
              <span class="forma-careers__hero-rule" aria-hidden="true"></span>
              <div class="forma-careers__intro">{{ section.settings.intro }}</div>
              <p class="forma-careers__hero-signoff">A NEW CHAPTER STARTS WITH A CONVERSATION.</p>
            </div>
          {% endif %}
        </div>
      </div>
    </header>

    <!-- OPEN POSITIONS -->
    <div class="forma-careers__positions">
      {% assign job_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'job' %}
          {% assign job_count = job_count | plus: 1 %}
        {% endif %}
      {% endfor %}

      <div class="forma-careers__section-heading">
        <h2>{{ section.settings.positions_heading | escape }}</h2>
        <span>
          {{ job_count }}
          {% if job_count == 1 %}position{% else %}positions{% endif %}
        </span>
      </div>

      {% if job_count > 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'job' %}
            <article class="forma-careers__job" {{ block.shopify_attributes }}>
              <details class="forma-careers__job-details">
                <summary class="forma-careers__job-summary">
                  <div class="forma-careers__job-main">
                    <h3>{{ block.settings.title | escape }}</h3>

                    <div class="forma-careers__job-meta">
                      {% if block.settings.location != blank %}
                        <span>{{ block.settings.location | escape }}</span>
                      {% endif %}
                      {% if block.settings.employment_type != blank %}
                        <span>{{ block.settings.employment_type | escape }}</span>
                      {% endif %}
                    </div>

                    {% if block.settings.short_description != blank %}
                      <div class="forma-careers__job-short-description">
                        {{ block.settings.short_description }}
                      </div>
                    {% endif %}
                  </div>

                  <span class="forma-careers__job-toggle">
                    <span class="forma-careers__job-toggle-text">
                      {{ block.settings.button_label | escape }}
                    </span>
                    <span class="forma-careers__job-toggle-icon" aria-hidden="true">+</span>
                  </span>
                </summary>

                <div class="forma-careers__job-expanded">
                  {% if block.settings.introduction != blank %}
                    <div class="forma-careers__job-introduction">
                      {{ block.settings.introduction }}
                    </div>
                  {% endif %}

                  {% if block.settings.responsibilities != blank %}
                    <div class="forma-careers__job-detail-block">
                      <h4>{{ block.settings.responsibilities_heading | escape }}</h4>
                      <div>{{ block.settings.responsibilities }}</div>
                    </div>
                  {% endif %}

                  {% if block.settings.qualifications != blank %}
                    <div class="forma-careers__job-detail-block">
                      <h4>{{ block.settings.qualifications_heading | escape }}</h4>
                      <div>{{ block.settings.qualifications }}</div>
                    </div>
                  {% endif %}

                  {% if block.settings.offer != blank %}
                    <div class="forma-careers__job-detail-block">
                      <h4>{{ block.settings.offer_heading | escape }}</h4>
                      <div>{{ block.settings.offer }}</div>
                    </div>
                  {% endif %}

                  <a class="forma-careers__apply-button" href="#FormaCareers-Application">
                    {{ block.settings.apply_label | escape }}
                    <span aria-hidden="true">‚Üó</span>
                  </a>
                </div>
              </details>
            </article>
          {% endif %}
        {% endfor %}
      {% else %}
        <div class="forma-careers__empty">
          <h3>{{ section.settings.empty_heading | escape }}</h3>
          <p>{{ section.settings.empty_text | escape }}</p>
        </div>
      {% endif %}
    </div>

    <!-- UNSOLICITED APPLICATIONS / APPLICATION FORM -->
    <div id="FormaCareers-Application" class="forma-careers__application">
      <div class="forma-careers__application-copy">
        <div class="forma-careers__application-index">01 <span>/</span> YOUR NEXT CHAPTER</div>
        {% if section.settings.application_eyebrow != blank %}
          <p class="forma-careers__eyebrow">{{ section.settings.application_eyebrow | escape }}</p>
        {% endif %}
        <h2>{{ section.settings.application_heading | escape }}</h2>
        <div class="forma-careers__application-text">{{ section.settings.application_text }}</div>
      </div>

      <div class="forma-careers__form">
        {% if section.settings.webhook_url != blank %}
          <form
            id="FormaCareersForm-{{ section.id }}"
            class="forma-careers__application-form"
            action="{{ section.settings.webhook_url | escape }}"
            method="post"
            enctype="multipart/form-data"
            target="FormaCareersFrame-{{ section.id }}"
            novalidate
          >
            <input type="hidden" name="form_name" value="Forma Copenhagen Careers">
            <input type="hidden" name="source_page" value="{{ request.origin }}{{ request.path }}">
            <input type="hidden" name="submitted_at" value="">
            <div class="forma-careers__honeypot" aria-hidden="true">
              <label for="FormaCareersWebsite-{{ section.id }}">Leave this field empty</label>
              <input id="FormaCareersWebsite-{{ section.id }}" type="text" name="website" tabindex="-1" autocomplete="off">
            </div>

            <div class="forma-careers__field-grid">
              <div class="forma-careers__field">
                <label for="FormaCareersName-{{ section.id }}">Full name <span>*</span></label>
                <input id="FormaCareersName-{{ section.id }}" name="full_name" type="text" autocomplete="name" required>
              </div>
              <div class="forma-careers__field">
                <label for="FormaCareersEmail-{{ section.id }}">Email address <span>*</span></label>
                <input id="FormaCareersEmail-{{ section.id }}" name="email" type="email" autocomplete="email" required>
              </div>
              <div class="forma-careers__field">
                <label for="FormaCareersPhone-{{ section.id }}">Phone number</label>
                <input id="FormaCareersPhone-{{ section.id }}" name="phone" type="tel" autocomplete="tel">
              </div>
              <div class="forma-careers__field">
                <label for="FormaCareersPosition-{{ section.id }}">Position / area of interest <span>*</span></label>
                <select id="FormaCareersPosition-{{ section.id }}" name="position" required>
                  <option value="">Select an area</option>
                  <option value="Open position">Open position</option>
                  <option value="Brand Partnerships">Brand Partnerships</option>
                  <option value="Marketing">Marketing</option>
                  <option value="Content & Editorial">Content & Editorial</option>
                  <option value="Creative & Design">Creative & Design</option>
                  <option value="Technology">Technology</option>
                  <option value="Operations">Operations</option>
                  <option value="Internship">Internship</option>
                  <option value="Other">Other</option>
                </select>
              </div>
            </div>

            <div class="forma-careers__field forma-careers__field--full">
              <label for="FormaCareersIntroduction-{{ section.id }}">Tell us about yourself <span>*</span></label>
              <textarea id="FormaCareersIntroduction-{{ section.id }}" name="introduction" rows="6" required placeholder="A little about you, your experience and why you'd like to join Forma..."></textarea>
            </div>

            <div class="forma-careers__field-grid forma-careers__uploads">
              <div class="forma-careers__field">
                <label for="FormaCareersCV-{{ section.id }}">CV <span>*</span></label>
                <input id="FormaCareersCV-{{ section.id }}" name="cv" type="file" accept=".pdf,.doc,.docx" required>
                <small>PDF, DOC or DOCX. Max. 4 MB combined for all files.</small>
              </div>
              <div class="forma-careers__field">
                <label for="FormaCareersPortfolio-{{ section.id }}">Application / portfolio</label>
                <input id="FormaCareersPortfolio-{{ section.id }}" name="portfolio" type="file" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg">
                <small>Optional. PDF, DOC, DOCX, PNG or JPG.</small>
              </div>
            </div>

            <div class="forma-careers__privacy">
              <label for="FormaCareersPrivacy-{{ section.id }}">
                <input id="FormaCareersPrivacy-{{ section.id }}" name="privacy_consent" type="checkbox" value="Yes" required>
                <span>I have read Forma's <a href="/policies/privacy-policy" target="_blank" rel="noopener">Privacy Policy</a> and agree that my information may be processed in connection with this application. <span>*</span></span>
              </label>
            </div>

            <p class="forma-careers__form-message" role="status" aria-live="polite"></p>

            <button class="forma-careers__submit" type="submit">
              <span>Submit application</span>
              <span aria-hidden="true">‚Üó</span>
            </button>
            <p class="forma-careers__required-note">* Required fields</p>
          </form>
          <iframe
            name="FormaCareersFrame-{{ section.id }}"
            id="FormaCareersFrame-{{ section.id }}"
            class="forma-careers__submit-frame"
            title="Application submission"
            tabindex="-1"
          ></iframe>
          <div class="forma-careers__success" id="FormaCareersSuccess-{{ section.id }}" aria-hidden="true">
            <button class="forma-careers__success-backdrop" type="button" data-forma-success-close aria-label="Close thank you message"></button>
            <div class="forma-careers__success-panel" role="dialog" aria-modal="true" aria-labelledby="FormaCareersSuccessTitle-{{ section.id }}" aria-describedby="FormaCareersSuccessText-{{ section.id }}" tabindex="-1">
              <button class="forma-careers__success-close" type="button" data-forma-success-close aria-label="Close">√ó</button>
              <p class="forma-careers__success-eyebrow">FORMA COPENHAGEN ¬∑ CAREERS</p>
              <span class="forma-careers__success-line" aria-hidden="true"></span>
              <h3 id="FormaCareersSuccessTitle-{{ section.id }}">Thank you for saying hello.</h3>
              <div id="FormaCareersSuccessText-{{ section.id }}" class="forma-careers__success-copy">
                <p>Your application is on its way to us. And before anything else, we want to say thank you.</p>
                <p>It means something that you can see yourself being part of what we are building. We‚Äôll take the time to get to know your introduction, your ideas and what you could bring to Forma.</p>
                <p>Whatever happens next, we‚Äôre glad our paths crossed.</p>
              </div>
              <p class="forma-careers__success-signoff">WARM regards, THE FORMA TEAM</p>
              <button class="forma-careers__success-done" type="button" data-forma-success-close>Back to Forma <span aria-hidden="true">‚Üó</span></button>
            </div>
          </div>
        {% else %}
          <div class="forma-careers__form-placeholder">
            <p>Add your Make.com webhook URL in the Forma Careers section settings to activate the application form.</p>
          </div>
        {% endif %}
      </div>
    </div>

  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .forma-careers {
    --forma-ink: #20201e;
    --forma-muted: #777771;
    --forma-line: #deded8;
    --forma-paper: #f5f5f1;
    position: relative;
    overflow-x: clip;
    padding: 0 0 112px;
    background: #fff;
    color: var(--forma-ink);
  }
  #shopify-section-{{ section.id }} .forma-careers__inner { width: 100%; max-width: 1600px; margin: 0 auto; }

  /* HERO ‚Äî full-bleed editorial introduction */
  #shopify-section-{{ section.id }} .forma-careers__header {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    box-sizing: border-box;
    padding: clamp(64px, 7vw, 112px) max(5vw, calc((100vw - 1440px) / 2)) clamp(66px, 7vw, 106px);
    background: var(--forma-paper);
    border-top: 1px solid #eeeee9;
    border-bottom: 1px solid #e9e9e3;
  }
  #shopify-section-{{ section.id }} .forma-careers__hero-inner { max-width: 1440px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .forma-careers__eyebrow {
    margin: 0;
    color: var(--forma-muted);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .2em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .forma-careers__hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, .65fr);
    align-items: end;
    gap: clamp(48px, 8vw, 140px);
    margin-top: clamp(54px, 7vw, 100px);
  }
  #shopify-section-{{ section.id }} .forma-careers__hero-title-wrap { min-width: 0; }
  #shopify-section-{{ section.id }} .forma-careers__title {
    max-width: 900px;
    margin: 0;
    color: var(--forma-ink);
    font-size: clamp(76px, 10.2vw, 150px);
    font-weight: 400;
    letter-spacing: -.085em;
    line-height: .82;
    text-wrap: balance;
  }
  #shopify-section-{{ section.id }} .forma-careers__hero-note {
    display: block;
    margin-top: 34px;
    color: #999991;
    font-size: 9px;
    letter-spacing: .2em;
  }
  #shopify-section-{{ section.id }} .forma-careers__hero-aside { max-width: 460px; padding-bottom: 2px; }
  #shopify-section-{{ section.id }} .forma-careers__hero-rule { display: block; width: 100%; height: 1px; margin-bottom: 25px; background: #d8d8d1; }
  #shopify-section-{{ section.id }} .forma-careers__intro { max-width: 440px; color: var(--forma-muted); font-size: 15px; line-height: 1.9; }
  #shopify-section-{{ section.id }} .forma-careers__intro p { margin: 0; }
  #shopify-section-{{ section.id }} .forma-careers__hero-signoff { margin: 30px 0 0; color: #999991; font-size: 9px; letter-spacing: .16em; line-height: 1.7; }

  /* OPEN POSITIONS */
  #shopify-section-{{ section.id }} .forma-careers__positions { max-width: 1280px; margin: 0 auto; padding: clamp(82px, 9vw, 132px) 40px 0; }
  #shopify-section-{{ section.id }} .forma-careers__section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; padding-bottom: 24px; border-bottom: 1px solid var(--forma-line); }
  #shopify-section-{{ section.id }} .forma-careers__section-heading h2 { margin: 0; font-size: clamp(34px, 4vw, 52px); font-weight: 400; letter-spacing: -.065em; line-height: 1; }
  #shopify-section-{{ section.id }} .forma-careers__section-heading > span { color: var(--forma-muted); font-size: 11px; white-space: nowrap; }
  #shopify-section-{{ section.id }} .forma-careers__job { border-bottom: 1px solid var(--forma-line); }
  #shopify-section-{{ section.id }} .forma-careers__job-summary { display: flex; align-items: center; justify-content: space-between; gap: 32px; padding: 32px 0; cursor: pointer; list-style: none; }
  #shopify-section-{{ section.id }} .forma-careers__job-summary::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} .forma-careers__job-summary::marker { content: ""; }
  #shopify-section-{{ section.id }} .forma-careers__job-main { flex: 1; min-width: 0; }
  #shopify-section-{{ section.id }} .forma-careers__job h3 { margin: 0 0 11px; font-size: 21px; font-weight: 500; letter-spacing: -.03em; }
  #shopify-section-{{ section.id }} .forma-careers__job-meta { display: flex; flex-wrap: wrap; gap: 8px 20px; color: var(--forma-muted); font-size: 11px; }
  #shopify-section-{{ section.id }} .forma-careers__job-short-description { max-width: 720px; margin-top: 14px; color: var(--forma-muted); font-size: 13px; line-height: 1.8; }
  #shopify-section-{{ section.id }} .forma-careers__job-toggle { display: inline-flex; align-items: center; gap: 14px; flex-shrink: 0; padding-bottom: 6px; border-bottom: 1px solid currentColor; color: var(--forma-ink); font-size: 12px; }
  #shopify-section-{{ section.id }} .forma-careers__job-toggle-icon { display: inline-block; font-size: 18px; line-height: 1; transition: transform .2s ease; }
  #shopify-section-{{ section.id }} .forma-careers__job-details[open] .forma-careers__job-toggle-icon { transform: rotate(45deg); }
  #shopify-section-{{ section.id }} .forma-careers__job-details[open] .forma-careers__job-toggle-text { font-size: 0; }
  #shopify-section-{{ section.id }} .forma-careers__job-details[open] .forma-careers__job-toggle-text::after { content: "Close"; font-size: 12px; }
  #shopify-section-{{ section.id }} .forma-careers__job-expanded { max-width: 780px; padding: 0 0 38px; animation: forma-careers-reveal .25s ease; }
  @keyframes forma-careers-reveal { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
  #shopify-section-{{ section.id }} .forma-careers__job-introduction { margin: 0 0 26px; color: var(--forma-muted); font-size: 14px; line-height: 1.9; }
  #shopify-section-{{ section.id }} .forma-careers__job-detail-block { margin-top: 24px; }
  #shopify-section-{{ section.id }} .forma-careers__job-detail-block h4 { margin: 0 0 10px; font-size: 16px; font-weight: 500; }
  #shopify-section-{{ section.id }} .forma-careers__job-detail-block > div { color: var(--forma-muted); font-size: 13px; line-height: 1.9; }
  #shopify-section-{{ section.id }} .forma-careers__job-detail-block ul { padding-left: 20px; }
  #shopify-section-{{ section.id }} .forma-careers__apply-button { display: inline-flex; align-items: center; gap: 14px; margin-top: 28px; padding: 0 0 7px; border-bottom: 1px solid currentColor; color: var(--forma-ink); font-size: 12px; text-decoration: none; }
  #shopify-section-{{ section.id }} .forma-careers__empty { padding: 32px 0; }
  #shopify-section-{{ section.id }} .forma-careers__empty h3 { margin: 0 0 10px; font-size: 18px; font-weight: 500; }
  #shopify-section-{{ section.id }} .forma-careers__empty p { margin: 0; color: var(--forma-muted); font-size: 13px; line-height: 1.8; }

  /* APPLICATION ‚Äî generous split layout */
  #shopify-section-{{ section.id }} .forma-careers__application { display: grid; grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); gap: clamp(44px, 6vw, 92px); align-items: start; width: 100%; max-width: 1440px; margin: clamp(104px, 12vw, 168px) auto 0; padding: 0 48px; box-sizing: border-box; scroll-margin-top: 40px; }
  #shopify-section-{{ section.id }} .forma-careers__application-copy { max-width: 500px; margin: 0; padding: 0; text-align: left; }
  #shopify-section-{{ section.id }} .forma-careers__application-index { margin: 0 0 26px; color: var(--forma-muted); font-size: 10px; letter-spacing: .18em; }
  #shopify-section-{{ section.id }} .forma-careers__application-index span { padding: 0 7px; color: #c5c5bd; }
  #shopify-section-{{ section.id }} .forma-careers__application-copy .forma-careers__eyebrow { margin: 0 0 17px; }
  #shopify-section-{{ section.id }} .forma-careers__application h2 { max-width: 480px; margin: 0; font-size: clamp(40px, 4.4vw, 60px); font-weight: 400; letter-spacing: -.07em; line-height: .98; }
  #shopify-section-{{ section.id }} .forma-careers__application-text { max-width: 420px; margin: 23px 0 0; color: var(--forma-muted); font-size: 14px; line-height: 1.9; }
  #shopify-section-{{ section.id }} .forma-careers__form { width: 100%; max-width: none; box-sizing: border-box; padding: clamp(26px, 3.3vw, 48px); background: var(--forma-paper); border: 1px solid #ecece6; }
  #shopify-section-{{ section.id }} .forma-careers__application-form { display: flex; flex-direction: column; gap: 23px; width: 100%; }
  #shopify-section-{{ section.id }} .forma-careers__field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 26px; }
  #shopify-section-{{ section.id }} .forma-careers__field { display: flex; flex-direction: column; gap: 9px; min-width: 0; }
  #shopify-section-{{ section.id }} .forma-careers__field label { color: var(--forma-ink); font-size: 11px; font-weight: 500; letter-spacing: .025em; }
  #shopify-section-{{ section.id }} .forma-careers__field label span, #shopify-section-{{ section.id }} .forma-careers__privacy label span span { color: #777771; }
  #shopify-section-{{ section.id }} .forma-careers__field input:not([type="file"]), #shopify-section-{{ section.id }} .forma-careers__field select, #shopify-section-{{ section.id }} .forma-careers__field textarea { width: 100%; max-width: 100%; min-height: 52px; box-sizing: border-box; padding: 14px 15px; border: 1px solid #deded8; border-radius: 0; background: #fff; color: var(--forma-ink); font: inherit; font-size: 13px; box-shadow: none; }
  #shopify-section-{{ section.id }} .forma-careers__field input:focus, #shopify-section-{{ section.id }} .forma-careers__field select:focus, #shopify-section-{{ section.id }} .forma-careers__field textarea:focus { outline: none; border-color: #777771; }
  #shopify-section-{{ section.id }} .forma-careers__field textarea { min-height: 160px; resize: vertical; line-height: 1.75; }
  #shopify-section-{{ section.id }} .forma-careers__field input[type="file"] { width: 100%; min-height: 54px; box-sizing: border-box; padding: 9px; border: 1px solid #deded8; background: #fff; color: var(--forma-ink); font-size: 11px; }
  #shopify-section-{{ section.id }} .forma-careers__field input[type="file"]::file-selector-button { margin-right: 12px; padding: 11px 14px; border: 0; background: #efefeb; color: var(--forma-ink); font: inherit; cursor: pointer; }
  #shopify-section-{{ section.id }} .forma-careers__field small, #shopify-section-{{ section.id }} .forma-careers__required-note { color: var(--forma-muted); font-size: 10px; line-height: 1.7; }
  #shopify-section-{{ section.id }} .forma-careers__privacy { padding-top: 2px; }
  #shopify-section-{{ section.id }} .forma-careers__privacy label { display: flex; align-items: flex-start; gap: 10px; color: var(--forma-muted); font-size: 11px; line-height: 1.75; }
  #shopify-section-{{ section.id }} .forma-careers__privacy input { flex: 0 0 auto; margin-top: 3px; }
  #shopify-section-{{ section.id }} .forma-careers__submit { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 62px; padding: 18px 21px; border: 1px solid var(--forma-ink); border-radius: 0; background: var(--forma-ink); color: #fff; font: inherit; font-size: 13px; cursor: pointer; transition: background .25s ease, color .25s ease; }
  #shopify-section-{{ section.id }} .forma-careers__submit:hover { background: transparent; color: var(--forma-ink); }
  #shopify-section-{{ section.id }} .forma-careers__submit:disabled { opacity: .6; cursor: wait; }
  #shopify-section-{{ section.id }} .forma-careers__form-message { margin: 0; font-size: 12px; line-height: 1.6; }
  #shopify-section-{{ section.id }} .forma-careers__form-message.is-error { color: #754b43; }
  #shopify-section-{{ section.id }} .forma-careers__form-message.is-success { color: #52634f; }
