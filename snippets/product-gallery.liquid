{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  PRODUCT GALLERY COMPONENT
  ----------------------------------------------------------------------------------------------------------------------

  This component is used to show the product gallery (used in product page and featured product section)

  ********************************************
  Supported variables
  ********************************************

  * product: the product to render (if empty, renders placeholder content)
  * product_form_id: the product form id
  * desktop_layout: the layout on desktop (can be "carousel_thumbnails_left", "carousel_thumbnails_bottom", "carousel_dots", "grid", "grid_2x" or "grid_2x_highlighted")
  * mobile_controls: the controls to show on mobile (can be "thumbnails", "dots", "arrows" or "free_scroll")
  * enable_media_autoplay: if set to true media are autoplayed when switched to
  * enable_video_looping: if set to true videos automatically loop when finished
  * enable_image_zoom: if set to true the gallery allow zoom
  * max_image_zoom_level: the maximum zoom level allowed (if enabled)
{%- endcomment -%}

<style>

  /* ============================================================
   FORMA PRODUCT GALLERY — CONTINUOUS EDITORIAL SLIDER
   ============================================================ */

.product-gallery--forma-auto {
  position: relative;
  width: 100%;
}

.product-gallery--forma-auto .product-gallery__image-list {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.product-gallery--forma-auto .product-gallery__carousel {
  display: flex;
  flex-wrap: nowrap;
  gap: 0;
  width: 100%;
  overflow-x: hidden;
  scroll-behavior: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.product-gallery--forma-auto .product-gallery__carousel::-webkit-scrollbar {
  display: none;
}

.product-gallery--forma-auto .product-gallery__media {
  flex: 0 0 72%;
  width: 72%;
  min-width: 72%;
  scroll-snap-align: none;
  position: relative;
}

.product-gallery--forma-auto .product-gallery__media img,
.product-gallery--forma-auto .product-gallery__media video,
.product-gallery--forma-auto .product-gallery__media model-viewer {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ------------------------------------------------------------
   Forma counter
   ------------------------------------------------------------ */

.forma-gallery-meta {
  position: absolute;
  z-index: 20;
  left: 2rem;
  bottom: 2rem;

  display: flex;
  align-items: center;
  gap: 1rem;

  color: #111;
  font-size: 11px;
  letter-spacing: .08em;
  text-transform: uppercase;

  pointer-events: none;
}

.forma-gallery-progress {
  display: block;
  width: 80px;
  height: 1px;
  background: rgba(17,17,17,.2);
  overflow: hidden;
}

.forma-gallery-progress__bar {
  display: block;
  width: 30%;
  height: 100%;
  background: #111;
}

/* ------------------------------------------------------------
   Controls
   ------------------------------------------------------------ */

.forma-gallery-controls {
  position: absolute;
  z-index: 20;
  right: 2rem;
  bottom: 1.5rem;

  display: flex;
  align-items: center;
  gap: .4rem;
}

.forma-gallery-controls button {
  width: 44px;
  height: 44px;

  display: grid;
  place-items: center;

  border: 1px solid rgba(17,17,17,.18);
  border-radius: 50%;

  background: rgba(255,255,255,.72);

  color: #111;

  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);

  cursor: pointer;

  transition:
    background .25s ease,
    color .25s ease,
    transform .25s ease;
}

.forma-gallery-controls button:hover {
  background: #111;
  color: #fff;
  transform: scale(1.04);
}

/* ------------------------------------------------------------
   Desktop
   ------------------------------------------------------------ */

@media screen and (min-width: 1000px) {

  .product-gallery--forma-auto .product-gallery__carousel {
    height: calc(100vh - var(--sticky-area-height, 0px));
    min-height: 680px;
    max-height: 900px;
  }

  .product-gallery--forma-auto .product-gallery__media {
    height: 100%;
    flex-basis: 62vw;
    min-width: 62vw;
  }

}

/* ------------------------------------------------------------
   Mobile
   ------------------------------------------------------------ */

@media screen and (max-width: 999px) {

  .product-gallery--forma-auto .product-gallery__carousel {
    height: auto;
  }

  .product-gallery--forma-auto .product-gallery__media {
    flex: 0 0 88vw;
    width: 88vw;
    min-width: 88vw;
  }

  .forma-gallery-meta {
    left: 1rem;
    bottom: 1rem;
  }

  .forma-gallery-controls {
    right: 1rem;
    bottom: .75rem;
  }

  .forma-gallery-controls button {
    width: 38px;
    height: 38px;
  }

}

  {%- if mobile_controls == 'free_scroll' -%}
    @media screen and (max-width: 999px) {
      #shopify-section-{{ section.id }} {
        --product-gallery-carousel-grid: auto / auto-flow min(28rem, 75vw);
        --product-gallery-carousel-gap: 0.125rem;
        --product-gallery-carousel-scroll-snap-type: none;
      }
    }
  {%- endif -%}

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      {%- if desktop_layout == 'carousel_thumbnails_left' or desktop_layout == 'grid' -%}
        /* Thumbnails on the left */
        --product-gallery-flex-direction: row-reverse;
        --product-gallery-thumbnail-list-grid-auto-flow: row;

        {%- if desktop_layout == 'carousel_thumbnails_left' -%}
          --product-gallery-thumbnail-list-max-height: 45rem;
        {%- endif -%}
      {%- endif -%}

      {%- if desktop_layout contains 'grid' -%}
        --product-gallery-carousel-grid: auto-flow dense / {% if desktop_layout == 'grid' %}auto{% else %}repeat(2, minmax(0, 1fr)){% endif %};
        --product-gallery-carousel-scroll-snap-type: none;
        --product-gallery-carousel-gap: {{ section.settings.desktop_media_grid_gap }}px;
      {%- endif -%}
    }

    {%- if desktop_layout == 'grid_2x_highlighted' -%}
      #shopify-section-{{ section.id }} .product-gallery__media:not([hidden]) {
        grid-column: span 2;
      }

      #shopify-section-{{ section.id }} .product-gallery__media:not([hidden]) ~ .product-gallery__media {
        grid-column: span 1;
      }
    {%- endif -%}
  }


/* =========================================================
   FORMA — PRODUCT GALLERY REFINEMENT
   Smooth presentation, responsive sizing and thumbnails
   ========================================================= */

#shopify-section-{{ section.id }} .product-gallery--forma-auto {
  position: relative;
  width: 100%;
  max-width: none;
  min-width: 0;
}

/* Gallery viewport */
#shopify-section-{{ section.id }} .product-gallery--forma-auto
.product-gallery__image-list {
  position: relative;
  width: 100%;
  min-width: 0;
  overflow: hidden;
}

/* Main horizontal slider */
#shopify-section-{{ section.id }} .product-gallery--forma-auto
.product-gallery__carousel {
  display: flex;
  flex-wrap: nowrap;
  align-items: stretch;
  gap: 0;
  width: 100%;
  min-width: 0;
  overflow-x: auto;
  overflow-y: hidden;
  scroll-behavior: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
  overscroll-behavior-x: contain;
}

#shopify-section-{{ section.id }} .product-gallery--forma-auto
.product-gallery__carousel::-webkit-scrollbar {
  display: none;
}

/* Individual slides */
#shopify-section-{{ section.id }} .product-gallery--forma-auto
.product-gallery__media {
  position: relative;
  flex: 0 0 62vw;
  width: 62vw;
  min-width: 0;
  max-width: none;
  height: clamp(520px, 78vh, 900px);
  overflow: hidden;
}

/* Images */
#shopify-section-{{ section.id }} .product-gallery--forma-auto
.product-gallery__media img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

/* Video and 3D media */
#shopify-section-{{ section.id }} .product-gallery--forma-auto
.product-gallery__media video,
#shopify-section-{{ section.id }} .product-gallery--forma-auto
.product-gallery__media model-viewer {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Gallery counter */
#shopify-section-{{ section.id }} .forma-gallery-meta {
  z-index: 5;
  pointer-events: none;
}

/* Slider controls */
#shopify-section-{{ section.id }} .forma-gallery-controls {
  z-index: 6;
}

#shopify-section-{{ section.id }} .forma-gallery-controls button {
  flex: 0 0 auto;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

/* Thumbnail rail: visible on desktop and mobile */
#shopify-section-{{ section.id }} .product-gallery__thumbnail-list {
  display: block;
  width: 100%;
  max-width: 100%;
  margin-top: 12px;
  overflow: hidden;
}

#shopify-section-{{ section.id }} .product-gallery__thumbnail-scroller {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  max-width: 100%;
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

#shopify-section-{{ section.id }} .product-gallery__thumbnail-scroller::-webkit-scrollbar {
  display: none;
}

#shopify-section-{{ section.id }} .product-gallery__thumbnail {
  display: block;
  position: relative;
  flex: 0 0 64px;
  width: 64px;
  min-width: 64px;
  height: 76px;
  padding: 0;
  overflow: hidden;
  border: 1px solid rgba(0, 0, 0, 0.14);
  border-radius: 2px;
  background: transparent;
  opacity: 0.72;
  cursor: pointer;
  transition: opacity 180ms ease, border-color 180ms ease;
}

#shopify-section-{{ section.id }} .product-gallery__thumbnail[aria-current="true"] {
  opacity: 1;
  border-color: #171717;
}

#shopify-section-{{ section.id }} .product-gallery__thumbnail img,
#shopify-section-{{ section.id }} .product-gallery__thumbnail svg {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

#shopify-section-{{ section.id }} .product-gallery__thumbnail:hover {
  opacity: 1;
}

/* Respect reduced-motion preferences */
@media (prefers-reduced-motion: reduce) {
  #shopify-section-{{ section.id }} .product-gallery__thumbnail {
    transition: none;
  }
}

/* Desktop */
@media screen and (min-width: 1000px) {
  #shopify-section-{{ section.id }} .product-gallery--forma-auto
  .product-gallery__carousel {
    height: clamp(520px, 78vh, 900px);
    min-height: 520px;
    max-height: 900px;
  }
}

/* Mobile */
@media screen and (max-width: 999px) {
  #shopify-section-{{ section.id }} .product-gallery--forma-auto
  .product-gallery__carousel {
    height: min(72vh, 680px);
    min-height: 420px;
    max-height: 680px;
  }

  #shopify-section-{{ section.id }} .product-gallery--forma-auto
  .product-gallery__media {
    flex: 0 0 88vw;
    width: 88vw;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .forma-gallery-meta {
    left: 16px;
    bottom: 16px;
  }

  #shopify-section-{{ section.id }} .forma-gallery-controls {
    right: 12px;
    bottom: 12px;
  }

  #shopify-section-{{ section.id }} .forma-gallery-controls button {
    width: 38px;
    height: 38px;
  }

  #shopify-section-{{ section.id }} .product-gallery__thumbnail-list {
    margin-top: 10px;
  }

  #shopify-section-{{ section.id }} .product-gallery__thumbnail {
    flex-basis: 54px;
    width: 54px;
    min-width: 54px;
    height: 64px;
  }
}

</style>

{%- comment -%}
  IMPLEMENTATION NOTE: Shopify does not natively offer a way to create a set of images per variant. This is often
  pretty limited when you have a lot of colors and would like to only see the images specific to a given color. To
  goes around that, Prestige offers a hack using alt tags whose usage is described here: https://support.maestrooo.com/article/721-variant-images-set
  The implementation is rather complex and inefficient due to a lot of string parsings, but it is, unfortunately, the
  only way to do it on Shopify right now.
{%- endcomment -%}

{% liquid
  assign default_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media
  assign product_gallery_carousel_id = 'product-gallery-carousel-' | append: product.id | append: '-' | append: section.id
  assign filtered_indexes = null | sort

  if product.variants.size > 1
    for media in product.media
      if media.alt contains '#' and media.alt != product.title
        assign alt_parts = media.alt | split: '#'
        assign media_group_parts = alt_parts.last | split: '_'
        assign option = product.options_by_name[media_group_parts.first]
        assign option_value = option.selected_value | downcase
        assign downcase_group_value = media_group_parts.last | strip | downcase

        if option_value != downcase_group_value and media != default_media
          assign media_position = media.position | sort
          assign filtered_indexes = filtered_indexes | concat: media_position
        endif
      endif
    endfor
  endif
%}

<product-gallery
  class="product-gallery product-gallery--forma-auto"
  data-forma-auto-slider="true"
  data-forma-auto-slider-speed="0.025"
  form="{{ product_form_id }}"
  filtered-indexes="{{ filtered_indexes | json }}"
  {% if enable_media_autoplay %}
    autoplay-media
  {% endif %}
  {% if enable_image_zoom %}
    allow-zoom="{{ max_image_zoom_level }}"
  {% endif %}
>
  {%- if enable_image_zoom -%}
    <open-lightbox-button class="contents">
      <button class="product-gallery__zoom-button circle-button circle-button--sm md:hidden">
        <span class="sr-only">{{ 'product.gallery.zoom' | t }}</span>
        {%- render 'icon' with 'zoom' -%}
      </button>
    </open-lightbox-button>
  {%- endif -%}

  <div class="product-gallery__image-list">

      {%- if product.media.size > 1 -%}
      <div class="forma-gallery-meta" aria-hidden="true">
        <span class="forma-gallery-counter">
          01 / {{ product.media.size }}
        </span>

        <span class="forma-gallery-progress">
          <span class="forma-gallery-progress__bar"></span>
        </span>
      </div>

      <div class="forma-gallery-controls">
        <button
          type="button"
          class="forma-gallery-prev"
          aria-label="Previous image"
        >
          <span aria-hidden="true">←</span>
        </button>

        <button
          type="button"
          class="forma-gallery-pause"
          aria-label="Pause image slideshow"
          aria-pressed="false"
        >
          <span aria-hidden="true">Ⅱ</span>
        </button>

        <button
          type="button"
          class="forma-gallery-next"
          aria-label="Next image"
        >
          <span aria-hidden="true">→</span>
        </button>
      </div>
    {%- endif -%}


    {%- comment -%}
      ----------------------------------------------------------------------------------------------------------------------
      CAROUSEL
      ----------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    <div class="{% if mobile_controls == 'arrows' %}product-gallery__carousel-with-arrows{% else %}contents{% endif %}">
      {%- if mobile_controls == 'arrows' -%}
        <carousel-prev-button aria-controls="{{ product_gallery_carousel_id }}" class="contents">
          <button type="button" class="tap-area sm:hidden">
            <span class="sr-only">{{ 'general.accessibility.previous' | t }}</span>
            {%- render 'icon' with 'arrow-left', direction_aware: true -%}
          </button>
        </carousel-prev-button>
      {%- endif -%}

      <scroll-carousel
        adaptive-height
        id="{{ product_gallery_carousel_id }}"
        class="product-gallery__carousel scroll-area {% unless mobile_controls == 'arrows' %}full-bleed md:unbleed{% endunless %}"
        role="region"
      >
        {%- if product != blank -%}
          {%- liquid
            capture sizes
              echo '(max-width: 699px) calc(100vw - 40px), (max-width: 999px) calc(100vw - 64px), '

              assign media_ratio = 100 | minus: section.settings.product_info_size

              if desktop_layout == 'grid_2x'
                assign media_ratio = media_ratio | divided_by: 2
              endif

              if section.settings.container_size == 'full'
                echo 'calc(' | append: media_ratio | append: 'vw - 96px)'
              else
                assign media_ratio = 1260 | times: media_ratio | divided_by: 100 | round

                if desktop_layout == 'grid_2x'
                  assign maximum_width = '560px'
                else
                  assign maximum_width = '1100px'
                endif

                echo 'min(' | append: maximum_width | append: ', ' | append: media_ratio | append: 'px - 96px)'
              endif
            endcapture
          -%}

          {%- for media in product.media -%}
            <div
              class="product-gallery__media snap-center {% if media == default_media %}is-initial{% endif %}"
              data-media-type="{{ media.media_type }}"
              data-media-id="{{ media.id }}"
              role="group"
              aria-label="{{ 'general.accessibility.item_nth_of_count' | t: index: media.position, count: product.media.size }}"
              {% if filtered_indexes contains media.position %}
                hidden
              {% endif %}
            >
              {%- if default_media == media -%}
                {%- assign preload = true -%}
              {%- else -%}
                {%- assign preload = false -%}
              {%- endif -%}

              {%- comment -%}
                NOTE: for the product gallery, the autoplay does not work in a similar way. It is always false at the product level,
                and the product-gallery component itself will autoplay (if needed)
              {%- endcomment -%}
              {%- render 'media',
                media: media,
                sizes: sizes,
                preload: preload,
                controls: true,
                playsinline: true,
                muted: enable_media_autoplay,
                loop: enable_video_looping,
                group: 'product',
                product: product
              -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            {%- capture placeholder_name -%}product-{{ i }}{%- endcapture -%}

            <div
              class="product-gallery__media snap-center {% if forloop.first %}is-initial{% endif %}"
              data-media-type="{{ media.media_type }}"
              data-media-position="{{ media.position }}"
              data-media-id="{{ media.id }}"
              role="group"
              aria-label="{{ 'general.accessibility.item_nth_of_count' | t: index: forloop.index, count: 3 }}"
            >
              {{- placeholder_name | placeholder_svg_tag: 'placeholder' -}}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </scroll-carousel>

      {%- if mobile_controls == 'arrows' -%}
        <carousel-next-button aria-controls="{{ product_gallery_carousel_id }}" class="contents">
          <button type="button" class="tap-area sm:hidden">
            <span class="sr-only">{{ 'general.accessibility.next' | t }}</span>
            {%- render 'icon' with 'arrow-right', direction_aware: true -%}
          </button>
        </carousel-next-button>
      {%- endif -%}
    </div>

    {%- comment -%}
      ----------------------------------------------------------------------------------------------------------------------
      VIEW IN YOUR SPACE
      ----------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}

    {%- if first_3d_model -%}
      <link rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css" media="print" onload="this.media='all'; this.onload = null">

      <button
        class="button w-full md:hidden"
        data-shopify-xr
        data-shopify-model3d-id="{{ first_3d_model.id }}"
        data-shopify-model3d-default-id="{{ first_3d_model.id }}"
        data-shopify-title="{{ product.title | escape }}"
        data-shopify-xr-hidden
      >
        <span class="text-with-icon justify-center">
          {%- render 'icon' with 'media-view-in-space' -%}
          {{- 'product.general.view_in_space' | t -}}
        </span>
      </button>
    {%- endif -%}
  </div>

  {%- comment -%}
    ----------------------------------------------------------------------------------------------------------------------
    CONTROLS
    ----------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

  {%- if product.media.size > 1 or product == blank -%}
    {%- liquid
      assign show_thumbnails_mobile = false
      assign show_thumbnails_desktop = false

      if mobile_controls == 'thumbnails'
        assign show_thumbnails_mobile = true
      endif

      if desktop_layout contains 'thumbnails' or desktop_layout == 'grid'
        assign show_thumbnails_desktop = true
      endif
    -%}

    {%- if product.media.size > 1 or show_thumbnails_mobile or show_thumbnails_desktop -%}
      <safe-sticky class="product-gallery__thumbnail-list">
        <product-gallery-navigation align-selected aria-controls="{{ product_gallery_carousel_id }}" class="product-gallery__thumbnail-scroller bleed md:unbleed">
          {%- if product != blank -%}
            {%- for media in product.media -%}
              <button
                type="button"
                class="product-gallery__thumbnail"
                {% if filtered_indexes contains media.position %}
                  hidden
                {% endif %}
                data-media-type="{{ media.media_type }}"
                data-media-position="{{ media.position }}"
                data-media-id="{{ media.id }}"
                aria-current="{% if media == default_media %}true{% else %}false{% endif %}"
                aria-label="{{ 'general.accessibility.go_to_item' | t: index: forloop.index | escape }}"
              >
                {{- media | image_url: width: media.preview_image.width | image_tag: sizes: '56px', widths: '56,112,168', class: 'object-contain' -}}

                {%- unless media.media_type == 'image' -%}
                  <div class="product-gallery__media-badge">
                    {%- if media.media_type == 'model' -%}
                      {%- render 'icon' with 'media-model-badge', width: 12 -%}
                    {%- else -%}
                      {%- render 'icon' with 'media-video-badge', width: 12 -%}
                    {%- endif -%}
                  </div>
                {% endunless %}
              </button>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..3) -%}
              {%- capture placeholder_name -%}product-{% cycle '1', '2', '3', '4', '5' %}{%- endcapture -%}

              <button
                type="button"
                class="product-gallery__thumbnail"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ 'general.accessibility.go_to_item' | t: index: forloop.index | escape }}"
              >
                {{- placeholder_name | placeholder_svg_tag: 'placeholder object-contain' -}}
              </button>
            {%- endfor -%}
          {%- endif -%}
        </product-gallery-navigation>
      </safe-sticky>
    {%- endif -%}

    {%- if mobile_controls == 'dots' or desktop_layout == 'carousel_dots' -%}
      <carousel-navigation
        class="page-dots align-self-center {% unless mobile_controls == 'dots' %}md-max:hidden{% endunless %} {% unless desktop_layout == 'carousel_dots' %}md:hidden{% endunless %}"
        aria-controls="{{ product_gallery_carousel_id }}"
      >
        {%- if product != blank -%}
          {%- for media in product.media -%}
            <button
              type="button"
              class="tap-area"
              {% if filtered_indexes contains media.position %}
                hidden
              {% endif %}
              aria-current="{% if media == default_media %}true{% else %}false{% endif %}"
            >
              <span class="sr-only">{{ 'general.accessibility.go_to_item' | t: index: media.position }}</span>
            </button>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            <button type="button" class="tap-area" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
              <span class="sr-only">{{ 'general.accessibility.go_to_item' | t: index: forloop.index }}</span>
            </button>
          {%- endfor -%}
        {%- endif -%}
      </carousel-navigation>
    {%- endif -%}
  {%- endif -%}

  <script>
(() => {
  const script = document.currentScript;
  const gallery = script?.closest('product-gallery');

  if (!gallery || gallery.dataset.formaSliderInitialized === 'true') {
    return;
  }

  const carousel = gallery.querySelector('.product-gallery__carousel');

  if (!carousel) return;

  const reducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  );

  const originalSlides = Array.from(
    carousel.querySelectorAll(
      '.product-gallery__media:not([hidden])'
    )
  ).filter(slide => !slide.classList.contains('forma-gallery-clone'));

  if (originalSlides.length < 2) return;

  gallery.dataset.formaSliderInitialized = 'true';

  let paused = false;
  let manuallyPaused = false;
  let frameId = null;
  let previousTime = 0;
  let originalWidth = 0;
  let resizeObserver = null;
  let resumeTimer = null;
  let destroyed = false;

  // Rolig, kontinuerlig bevægelse — pixels pr. millisekund.
  const SPEED = 0.025;

  // Undgå store spring efter tabskift eller langsomme frames.
  const MAX_FRAME_DELTA = 32;

  const pauseButton = gallery.querySelector('.forma-gallery-pause');
  const nextButton = gallery.querySelector('.forma-gallery-next');
  const previousButton = gallery.querySelector('.forma-gallery-prev');

  const getClones = () => Array.from(
    carousel.querySelectorAll('.forma-gallery-clone')
  );

  function updateOriginalWidth() {
    originalWidth = originalSlides.reduce((total, slide) => {
      return total + slide.getBoundingClientRect().width;
    }, 0);

    return originalWidth;
  }

  function updatePauseButton() {
    if (!pauseButton) return;

    pauseButton.innerHTML = paused
      ? '<span aria-hidden="true">▶</span>'
      : '<span aria-hidden="true">Ⅱ</span>';

    pauseButton.setAttribute(
      'aria-label',
      paused ? 'Start slideshow' : 'Pause slideshow'
    );

    pauseButton.setAttribute(
      'aria-pressed',
      String(paused)
    );
  }

  function setPaused(value) {
    paused = Boolean(value);
    previousTime = 0;
    updatePauseButton();
  }

  function removeClones() {
    getClones().forEach(clone => clone.remove());
  }

  function createClones() {
    removeClones();

    originalSlides.forEach(slide => {
      const clone = slide.cloneNode(true);

      clone.classList.add('forma-gallery-clone');
      clone.setAttribute('aria-hidden', 'true');
      clone.setAttribute('inert', '');

      // Undgå dublerede ID'er i klonede elementer.
      clone.querySelectorAll('[id]').forEach(element => {
        element.removeAttribute('id');
      });

      carousel.appendChild(clone);
    });

    updateOriginalWidth();
  }

  function animate(timestamp) {
    if (destroyed) return;

    if (previousTime === 0) {
      previousTime = timestamp;
    }

    const delta = Math.min(
      timestamp - previousTime,
      MAX_FRAME_DELTA
    );

    previousTime = timestamp;

    if (
      !paused &&
      !reducedMotion.matches &&
      originalWidth > 0
    ) {
      carousel.scrollLeft += SPEED * delta;

      // Loop kun, når vi har en gyldig måling.
      if (carousel.scrollLeft >= originalWidth) {
        carousel.scrollLeft -= originalWidth;
      }
    }

    frameId = window.requestAnimationFrame(animate);
  }

  function pauseTemporarily() {
    window.clearTimeout(resumeTimer);
    setPaused(true);

    if (!manuallyPaused) {
      resumeTimer = window.setTimeout(() => {
        setPaused(false);
      }, 1400);
    }
  }

  function moveBy(direction) {
    pauseTemporarily();

    const distance = Math.max(
      carousel.clientWidth * 0.55,
      160
    );

    carousel.scrollBy({
      left: direction * distance,
      behavior: reducedMotion.matches ? 'auto' : 'smooth'
    });
  }

  function onNext() {
    moveBy(1);
  }

  function onPrevious() {
    moveBy(-1);
  }

  function onPauseToggle() {
    manuallyPaused = !manuallyPaused;
    window.clearTimeout(resumeTimer);
    setPaused(manuallyPaused);
  }

  function onMouseEnter() {
    setPaused(true);
  }

  function onMouseLeave() {
    if (!manuallyPaused) {
      setPaused(false);
    }
  }

  function onTouchStart() {
    setPaused(true);
  }

  function onTouchEnd() {
    if (!manuallyPaused) {
      window.clearTimeout(resumeTimer);

      resumeTimer = window.setTimeout(() => {
        setPaused(false);
      }, 900);
    }
  }

  function onVisibilityChange() {
    previousTime = 0;

    if (document.hidden) {
      setPaused(true);
    } else if (!manuallyPaused && !reducedMotion.matches) {
      setPaused(false);
    }
  }

  function onReducedMotionChange(event) {
    if (event.matches) {
      setPaused(true);
    } else if (!manuallyPaused) {
      setPaused(false);
    }
  }

  function cleanup() {
    destroyed = true;

    if (frameId !== null) {
      window.cancelAnimationFrame(frameId);
    }

    window.clearTimeout(resumeTimer);

    resizeObserver?.disconnect();

    carousel.removeEventListener('mouseenter', onMouseEnter);
    carousel.removeEventListener('mouseleave', onMouseLeave);
    carousel.removeEventListener('touchstart', onTouchStart);
    carousel.removeEventListener('touchend', onTouchEnd);

    nextButton?.removeEventListener('click', onNext);
    previousButton?.removeEventListener('click', onPrevious);
    pauseButton?.removeEventListener('click', onPauseToggle);

    document.removeEventListener(
      'visibilitychange',
      onVisibilityChange
    );

    reducedMotion.removeEventListener(
      'change',
      onReducedMotionChange
    );

    delete gallery.dataset.formaSliderInitialized;
  }

  createClones();

  // Recalculate widths if images or viewport dimensions change.
  if ('ResizeObserver' in window) {
    resizeObserver = new ResizeObserver(() => {
      updateOriginalWidth();
    });

    originalSlides.forEach(slide => {
      resizeObserver.observe(slide);
    });

    resizeObserver.observe(carousel);
  } else {
    window.addEventListener('resize', updateOriginalWidth);
  }

  carousel.addEventListener('mouseenter', onMouseEnter);
  carousel.addEventListener('mouseleave', onMouseLeave);
  carousel.addEventListener('touchstart', onTouchStart, {
    passive: true
  });
  carousel.addEventListener('touchend', onTouchEnd, {
    passive: true
  });

  nextButton?.addEventListener('click', onNext);
  previousButton?.addEventListener('click', onPrevious);
  pauseButton?.addEventListener('click', onPauseToggle);

  document.addEventListener(
    'visibilitychange',
    onVisibilityChange
  );

  reducedMotion.addEventListener(
    'change',
    onReducedMotionChange
  );

  // Stop the animation if Shopify removes this section.
  document.addEventListener('shopify:section:unload', event => {
    if (event.target.contains(gallery)) {
      cleanup();
    }
  });

  if (reducedMotion.matches) {
    setPaused(true);
  } else {
    setPaused(false);
  }

  frameId = window.requestAnimationFrame(animate);
})();
</script>

  
</product-gallery>
