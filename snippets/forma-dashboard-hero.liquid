<header
  class="forma-dashboard__hero"
  data-forma-dashboard-hero
>

  <div class="forma-dashboard__hero-main">

    <p
      class="forma-dashboard__eyebrow"
      data-forma-hero-eyebrow
    >
      Your Forma
    </p>

    <h1 class="forma-dashboard__title">
      <span data-forma-hero-greeting>
        Welcome back
      </span><span data-forma-profile-name></span>.
    </h1>

    <p
      class="forma-dashboard__hero-message"
      data-forma-hero-message
    >
      Everything that makes your Forma yours.
    </p>

  </div>


  <div class="forma-dashboard__hero-footer">

    <div class="forma-dashboard__hero-context">

      <p
        class="forma-dashboard__hero-context"
        data-forma-hero-context
      >
        Curated by your journey.
      </p>

      <div
        class="forma-profile-progress"
        data-forma-profile-progress
      >

        <div class="forma-profile-progress__top">

          <span>
            Profile
          </span>

          <span
            data-forma-profile-progress-value
          >
            0%
          </span>

        </div>

        <div
          class="forma-profile-progress__track"
          aria-hidden="true"
        >
          <div
            class="forma-profile-progress__bar"
            data-forma-profile-progress-bar
            style="width: 0%;"
          ></div>
        </div>

        <p class="forma-profile-progress__text">
          Complete your profile to make Forma more personal.
        </p>

      </div>

    </div>


    <button
      type="button"
      class="forma-dashboard__edit-profile"
      data-forma-edit-profile
    >
      <span>Edit profile</span>
      <span aria-hidden="true">→</span>
    </button>

  </div>

</header>