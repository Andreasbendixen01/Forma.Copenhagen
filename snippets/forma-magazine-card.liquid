{%- doc -%}
  Article card for the Forma Magazine layouts (drafts 2 and 3).

  @param {object} article - The article
  @param {array} blocks - The section's blocks, used to find the category label
  @param {string} read_label - "Read the article" text
  @param {boolean} [show_blog_badge] - Fall back to the blog name when there is no label
  @param {object} [blog_1] - Blog setting 1
  @param {object} [blog_2] - Blog setting 2
  @param {object} [blog_3] - Blog setting 3
  @param {boolean} [snap_ratio] - Crop every image to 4:5 (portrait) or 1:1 (square and wider)
{%- enddoc -%}
{%- liquid
  assign tag_handles = ' '
  for tag in article.tags
    assign tag_handle = tag | handleize
    assign tag_handles = tag_handles | append: tag_handle | append: ' '
  endfor

  assign badge = ''
  for block in blocks
    if block.type == 'topic' and badge == ''
      assign topic_handle = block.settings.tag | default: block.settings.label | handleize
      assign needle = ' ' | append: topic_handle | append: ' '
      if tag_handles contains needle
        assign badge = block.settings.label
      endif
    endif
  endfor
  if badge == ''
    for brand in shop.metaobjects.forma_brand.values
      if badge == '' and brand.brand_name.value != blank
        assign brand_handle = brand.brand_name.value | handleize
        assign needle = ' ' | append: brand_handle | append: ' '
        if tag_handles contains needle
          assign badge = brand.brand_name.value
        endif
      endif
    endfor
  endif
  if badge == '' and article.tags.size > 0
    assign badge = article.tags.first
  endif
  if badge == '' and show_blog_badge
    if blog_1 != blank
      assign blog_prefix = blog_1.url | append: '/'
      if article.url contains blog_prefix
        assign badge = blog_1.title
      endif
    endif
    if badge == '' and blog_2 != blank
      assign blog_prefix = blog_2.url | append: '/'
      if article.url contains blog_prefix
        assign badge = blog_2.title
      endif
    endif
    if badge == '' and blog_3 != blank
      assign blog_prefix = blog_3.url | append: '/'
      if article.url contains blog_prefix
        assign badge = blog_3.title
      endif
    endif
  endif

  assign ratio = article.image.aspect_ratio | default: 0.8
  if ratio > 1
    assign ratio = 1
  endif
  if snap_ratio
    if ratio >= 0.9
      assign ratio = 1
    else
      assign ratio = 0.8
    endif
  endif
  if ratio < 0.6
    assign ratio = 0.6
  endif
-%}
<div class="fm-card" data-fm-card data-tags="{{ tag_handles }}" data-ratio="{{ ratio }}" style="--ratio: {{ ratio }};">
  <a class="fm-card__link" href="{{ article.url }}">
    <span class="fm-card__media">
      {%- if article.image != blank -%}
        {{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw', alt: article.image.alt | default: '' }}
      {%- endif -%}
    </span>
    {%- if badge != blank -%}
      <span class="fm-card__badge">{{ badge | escape }}</span>
    {%- endif -%}
    <span class="fm-card__caption">
      <span class="fm-card__title">{{ article.title | escape }}</span>
      <span class="fm-card__more">{{ read_label | escape }}</span>
    </span>
  </a>
</div>
